--- a/src/util/cache_ops_aarch64.c
+++ b/src/util/cache_ops_aarch64.c
@@ -29,9 +29,15 @@
 static uint32_t
 get_ctr_el0(void)
 {
+#if defined(__APPLE__)
+   /* pixel3-ios: XNU traps EL0 reads of CTR_EL0 (SIGILL). Kryo 385 (and the Mac host) have
+    * 64-byte lines: CWG = DminLine = 4 words log2 (as UniXNU, MIT). */
+   return (4u << 24) | (4u << 16);
+#else
    uint32_t ctr_el0;
    __asm("mrs\t%x0, ctr_el0" : "=r"(ctr_el0));
    return ctr_el0;
+#endif
 }
 

+
+#ifdef __APPLE__
+/* pixel3-ios: tu_physical_device_try_create without /dev/dri. bluedrm's drmOpenWithType("msm")
+ * opens the kernel's BlueGPU user client (an msm-compatible ABI, gpu/mesa-ios/blue_gpu_uapi.h). */
+VkResult
+tu_knl_drm_msm_enumerate_darwin(struct tu_instance *instance)
+{
+   int fd = drmOpenWithType("msm", NULL, 0);
+   if (fd < 0)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   drmVersionPtr version = drmGetVersion(fd);
+   if (!version) {
+      close(fd);
+      return vk_startup_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER, "bluedrm: no version");
+   }
+   struct tu_physical_device *device = NULL;
+   VkResult result = tu_knl_drm_msm_load(instance, fd, version, &device);
+   drmFreeVersion(version);
+   if (result != VK_SUCCESS) {
+      close(fd);
+      return result;
+   }
+   device->master_fd = -1;
+   device->kgsl_dma_fd = -1;
+   snprintf(device->fd_path, ARRAY_SIZE(device->fd_path), "%s", "bluegpu");
+   device->has_master = false;
+   device->has_local = true;     /* no node to stat: as vtest */
+   device->local_major = 226;
+   device->local_minor = 128;
+   result = tu_physical_device_init(device, instance);
+   if (result != VK_SUCCESS) {
+      close(fd);
+      vk_free(&instance->vk.alloc, device);
+      return result;
+   }
+   list_addtail(&device->vk.link, &instance->vk.physical_devices.list);
+   return VK_SUCCESS;
+}
+#endif

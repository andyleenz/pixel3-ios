   dep_libdrm = null_dep
 endif
-if host_machine.system() == 'darwin' and with_gallium_freedreno
+if host_machine.system() == 'darwin' and (with_gallium_freedreno or with_freedreno_vk)
   # pixel3-ios (blueline): no DRM on Darwin. freedreno's msm requests go to the kernel's
   # BlueGPU user client through a libdrm stand-in (src/bluedrm, copied in by
   # mesa-ios/build-mesa-ios.sh; approach from HakiOS tools/mesa/freedreno-darwin.patch, MIT).
@@ -824,6 +824,8 @@
     include_directories : include_directories('src/bluedrm'),
     link_args : ['-framework', 'IOKit', '-framework', 'CoreFoundation'],
   )
+  # the stand-in emulates DRM syncobjs, which Turnip's vk_drm_syncobj needs (u_sync_provider.c)
+  pre_args += '-DHAVE_BLUEDRM_SYNCOBJ=1'
 elif dep_libdrm.found()
   pre_args += '-DHAVE_LIBDRM'
   if with_dri_platform == 'drm' and with_dri

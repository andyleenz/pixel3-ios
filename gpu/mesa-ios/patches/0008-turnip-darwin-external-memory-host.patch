+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetMemoryHostPointerPropertiesEXT(VkDevice _device,
+                                     VkExternalMemoryHandleTypeFlagBits handleType,
+                                     const void *pHostPointer,
+                                     VkMemoryHostPointerPropertiesEXT *pMemoryHostPointerProperties)
+{
+   VK_FROM_HANDLE(tu_device, device, _device);
+   if (handleType != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT ||
+       !device->physical_device->has_host_import || ((uintptr_t) pHostPointer & 16383))
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   /* The caller's pages keep its own CPU mapping; the kernel cleans and invalidates them around
+    * each submit, so they are offered as the first (host-coherent) type. */
+   pMemoryHostPointerProperties->memoryTypeBits = 1u;
    return VK_SUCCESS;

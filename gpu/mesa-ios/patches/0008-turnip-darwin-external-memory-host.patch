+#ifdef __APPLE__
+/* pixel3-ios, VK_EXT_external_memory_host: BlueGPU's USERPTR (0x7d) wires the caller's pages (an
+ * IOSurface's, for the Metal frontend's no-copy buffers) as a BO. The CPU keeps the caller's mapping:
+ * bo->map is the pointer and is never unmapped here. The kernel cleans the pages at each submit and
+ * invalidates them at CPU_PREP, so the BO is as coherent as the first memory type promises. */
 static VkResult
+msm_bo_init_host(struct tu_device *dev, struct tu_bo **out_bo, void *pointer, uint64_t size)
+{
+   uint32_t gem_handle;
+   if (bluedrm_user_memory(dev->fd, pointer, size, &gem_handle))
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE, "bluedrm USERPTR: %s", strerror(errno));
+
+   u_rwlock_wrlock(&dev->dma_bo_lock);
+   struct tu_bo *bo = tu_device_lookup_bo(dev, gem_handle);
+   assert(bo->refcnt == 0);
+   uint64_t iova = 0;
+   VkResult result = tu_bo_init(dev, NULL, bo, gem_handle, size, iova, TU_BO_ALLOC_NO_FLAGS, "host import");
+   if (result == VK_SUCCESS) {
+      bo->map = pointer;
+      bo->never_unmap = true;
+      *out_bo = bo;
+   } else {
+      memset(bo, 0, sizeof(*bo));
+   }
+   u_rwlock_wrunlock(&dev->dma_bo_lock);
+   return result;
+}
+#endif
+
+static VkResult
 msm_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
 {
    uint64_t offset = tu_gem_info(dev, bo->gem_handle, MSM_INFO_GET_OFFSET);
@@ -896,7 +925,8 @@
    if (bo->map) {
       TU_RMV(bo_unmap, dev, bo);
       #ifdef __APPLE__
-      bluedrm_unmap(dev->fd, bo->gem_handle, bo->map, bo->size);
+      if (!bo->never_unmap)   /* a host import keeps the caller's mapping */
+         bluedrm_unmap(dev->fd, bo->gem_handle, bo->map, bo->size);
 #else
       munmap(bo->map, bo->size);
 #endif
@@ -1331,6 +1361,9 @@

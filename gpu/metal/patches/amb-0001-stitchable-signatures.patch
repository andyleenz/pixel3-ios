+/// (pixel3-ios) The `[[stitchable]]` functions of the AIR module `bytes`, as text for MTLFunction's `returnType` and
+/// `arguments`: per function a line `name\treturn type`, then a line `\targument name\ttype name` per argument. The
+/// text's length; 0 when the module cannot be decoded.
+///
+/// # Safety
+/// `bytes` holds `length` bytes, `text` has `capacity` writable bytes (or is null).
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_air_stitchable_signatures(bytes: *const c_void, length: usize, text: *mut c_char,
+                                                    capacity: usize) -> usize {
+    guard(0, || {
+        if bytes.is_null() || length == 0 { return Err("no module bytes".into()); }
+        // SAFETY: the caller's contract.
+        let bytes = unsafe { std::slice::from_raw_parts(bytes as *const u8, length) };
+        let mut s = String::new();
+        for f in metal2vulkan::library::stitchable_signatures(bytes).map_err(e("stitchable signatures"))? {
+            s += &format!("{}\t{}\n", f.name, f.return_type.unwrap_or_default());
+            for (name, ty) in f.arguments { s += &format!("\t{}\t{}\n", name, ty); }
+        }
+        Ok(copy_out(&s, text, capacity))
+    })
+}

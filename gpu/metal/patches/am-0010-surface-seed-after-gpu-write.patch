+// unlock bumps it. Not in the render server (its display buffers nobody else reads; the kernel's lazy clean would clean
+// them at its next submit). NMB_NO_SEED_BUMP=1 turns it off.
+static void bumpWrittenSurfaceSeeds(NSSet *surfaces,bool completed) {
+ static const bool off=getenv("NMB_NO_SEED_BUMP")!=nullptr || nativeIsRenderServer();
+ if(off || !completed || !surfaces.count)return;
+ for(NBTexture *texture in surfaces) {
+  IOSurfaceRef surface=texture.surface;
+  if(!surface || !(texture.descriptor.usage&(MTLTextureUsageRenderTarget|MTLTextureUsageShaderWrite)))continue;
+  if(IOSurfaceLock(surface,0,nullptr)==0)IOSurfaceUnlock(surface,0,nullptr);
+ }
+}

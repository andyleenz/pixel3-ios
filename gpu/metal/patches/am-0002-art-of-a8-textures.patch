+// NATIVE_METAL_ART=1 (pixel3-ios): the first 8 one-byte textures over buffers a fragment function samples, as the CPU sees their
+// buffer's bytes: size, offset, rows, the buffer's length and first bytes, then 64 columns of text art (cells of width/64 texels,
+// ' ' '.' '+' '#' by mean). Tells bytes laid out as declared from a fault in the copy or the sampling.
+static void artOfTexture(NBTexture *texture) {
+ static const bool on=getenv("NATIVE_METAL_ART")!=nullptr;
+ static std::atomic<int> printed{0};
+ if(!on || !texture.buffer || texture.width<64)return;
+ const MTLPixelFormat f=texture.pixelFormat;
+ if(f!=MTLPixelFormatA8Unorm && f!=MTLPixelFormatR8Unorm)return;
+ if(printed.fetch_add(1)>=8)return;
+ const uint8_t *base=(const uint8_t *)texture.buffer.contents;
+ const NSUInteger w=texture.width,h=texture.height,row=texture.rowBytes,off=texture.offset,len=texture.buffer.length;
+ fprintf(stderr,"nmb-art: fmt %lu %lux%lu off %lu row %lu buflen %lu need %lu%s\n",(unsigned long)f,(unsigned long)w,(unsigned long)h,

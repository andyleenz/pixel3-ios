+         p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8],p[9],p[10],p[11],p[12],p[13],p[14],p[15]);
+ const NSUInteger cw=w/64,ch=cw;
+ for(NSUInteger y=0;y+ch<=h;y+=ch) {
+  char line[65];
+  for(int c=0;c<64;c++) {
+   unsigned sum=0;
+   for(NSUInteger dy=0;dy<ch;dy++)for(NSUInteger dx=0;dx<cw;dx++)sum+=p[(y+dy)*row+c*cw+dx];
+   sum/=(unsigned)(cw*ch);
+   line[c]=sum>192?'#':sum>96?'+':sum>16?'.':' ';
+  }
+  line[64]=0;
+  fprintf(stderr,"nmb-art |%s|\n",line);
  }

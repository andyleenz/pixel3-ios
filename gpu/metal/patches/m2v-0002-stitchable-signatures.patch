+/// (pixel3-ios) One `[[stitchable]]` function of a module, as `MTLFunction`'s `returnType` and
+/// `arguments` describe it: from its `air.stitching_info`, the return value's and each stitched
+/// argument's MSL type name (from the type descriptors) and each argument's name. (The
+/// `air.visible_input` parameters are the arguments flattened: a `coreimage::Sampler` is its four
+/// fields, a destination its coordinate.)
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct StitchableSignature {
+    /// The function's name.
+    pub name: String,
+    /// The return value's type name (`None`: a `void` function, or not named).
+    pub return_type: Option<String>,
+    /// Each argument's name and type name (empty where the module names none).
+    pub arguments: Vec<(String, String)>,
+}
+
+/// (pixel3-ios) The `[[stitchable]]` functions of the AIR module `bitcode` (a metallib function's
+/// own module, or a module several share), decoded once. Refused with the decode's own errors.
+pub fn stitchable_signatures(bitcode: &[u8]) -> Result<Vec<StitchableSignature>, Error> {
+    let mut m = Meter::new(&Budget::standard());
+    crate::pipeline::compile::guarded(|| {
+        let decoded = crate::air::decode(bitcode, &mut m)?;
+        let text = |n: &Option<DiagName>| n.as_ref().map(|n| n.to_string());
+        Ok(decoded
+            .abi
+            .visible_functions
+            .iter()
+            .filter_map(|v| {
+                let st = v.stitching.as_ref()?;
+                Some(StitchableSignature {
+                    name: v.name.to_string(),
+                    return_type: text(&st.result_type_name),
+                    arguments: st
+                        .arguments
+                        .iter()
+                        .map(|a| (text(&a.name).unwrap_or_default(), text(&a.type_name).unwrap_or_default()))
+                        .collect(),
+                })
+            })
+            .collect())
+    })
+}

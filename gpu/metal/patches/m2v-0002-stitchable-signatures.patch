+/// (pixel3-ios) An MSL type descriptor's type name, as `MTLFunction`'s reflection names it: a struct
+/// `!{!"air.struct_type", size, align, _, !"name", fields}` by its name; a scalar
+/// `!{!"air.<scalar>_type", size, align, _}` as `<scalar>` (`float`, `half`, `bool`, `uint`, ...); a
+/// vector `!{!"air.vector_type", size, align, _, !elem, count}` as `<elem><count>`; a matrix
+/// `!{!"air.matrix_type", size, align, _, !elem, columns, rows}` as `<elem><columns>x<rows>`. Any
+/// other descriptor, or one not of that shape, is not named (lenient: the descriptor is no part of
+/// the module's strict grammar).
+fn descriptor_name(m: &Module, id: MdId, depth: u32) -> Option<String> {
+    let ops = node_ops(m, id)?;
+    let op = |i: usize| ops.get(i).copied().and_then(|o| tok(m, o));
+    let int = |i: usize| match op(i)? {
+        Tok::Int { value, .. } => Some(value),
+        _ => None,
+    };
+    let Tok::Str(kind) = op(0)? else { return None };
+    let kind = std::str::from_utf8(kind).ok()?;
+    match kind {
+        "air.struct_type" => match op(4)? {
+            Tok::Str(name) => std::str::from_utf8(name).ok().map(str::to_owned),
+            _ => None,
+        },
+        "air.vector_type" | "air.matrix_type" if depth == 0 => {
+            let Tok::Node(elem) = op(4)? else { return None };
+            let elem = descriptor_name(m, elem, depth + 1)?;
+            if kind == "air.vector_type" {
+                Some(format!("{elem}{}", int(5)?))
+            } else {
+                Some(format!("{elem}{}x{}", int(5)?, int(6)?))
+            }
+        }
+        _ => kind
+            .strip_prefix("air.")?
+            .strip_suffix("_type")
+            .filter(|s| !s.contains('.'))
+            .map(str::to_owned),
+    }
 }
 

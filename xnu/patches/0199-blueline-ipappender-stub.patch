diff -ruN a/iokit/Kernel/arm/MiniIPAppender.cpp b/iokit/Kernel/arm/MiniIPAppender.cpp
--- a/iokit/Kernel/arm/MiniIPAppender.cpp	1970-01-01 10:00:00
+++ b/iokit/Kernel/arm/MiniIPAppender.cpp	2026-11-23 14:36:15
@@ -0,0 +1,126 @@
+/*
+ * MiniIPAppender: a stand-in for AppleIPAppender, the cellular packet-data (PDP) driver that
+ * CommCenter reaches through ApplePDPHelper.framework.
+ *
+ * CommCenter runs in its no-baseband form (the job Wi-Fi-only iPads run; tools/iosroot-tweaks.py
+ * KEEP_KEYS), but still makes an ApplePDPHelperInterface. Without an AppleIPAppender service the
+ * interface stays half made ("Could not find %s service"), and its first callStructMethod locks
+ * a mutex through a NULL pointer: CommCenter dies with SIGSEGV and launchd starts it again,
+ * every few seconds.
+ *
+ * So: the service, a user client that can be opened, and a refusal of every method
+ * (kIOReturnUnsupported: "ApplePDPHelper: Performing '...' failed"). bluepdp=0 leaves it out.
+ * CommCenter still aborts later, on its baseband path ("Unable to communicate with AppleBaseband
+ * driver"); this only removes the SIGSEGV.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+extern "C" void MiniIPAppenderStart(void);
+
+class AppleIPAppender : public IOService
+{
+	OSDeclareDefaultStructors(AppleIPAppender);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleIPAppender, IOService);
+
+bool
+AppleIPAppender::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleIPAppenderUserClient");
+	registerService();
+	return true;
+}
+
+class AppleIPAppenderUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AppleIPAppenderUserClient);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * arguments,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleIPAppenderUserClient, IOUserClient);
+
+static unsigned gIPAOpens, gIPACalls;
+
+bool
+AppleIPAppenderUserClient::start(IOService * provider)
+{
+	char who[32] = "?";
+
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	if (gIPAOpens++ < 4) {
+		proc_selfname(who, sizeof(who));
+		IOLog("BLUE PDP: AppleIPAppender opened by %s\n", who);
+	}
+	return true;
+}
+
+IOReturn
+AppleIPAppenderUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleIPAppenderUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * arguments,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	IOReturn ret = kIOReturnUnsupported;
+
+	if (gIPACalls++ < 16) {
+		IOLog("BLUE PDP: method %u (scalars in %u, struct in %u, out %u): %s\n", selector,
+		    arguments ? arguments->scalarInputCount : 0,
+		    arguments ? arguments->structureInputSize : 0, arguments ? arguments->structureOutputSize : 0,
+		    "unsupported");
+	}
+	return ret;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+void
+MiniIPAppenderStart(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("bluepdp", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	IOService * resources = IOService::getResourceService();
+	AppleIPAppender * ipa = OSTypeAlloc(AppleIPAppender);
+
+	if (resources == NULL || ipa == NULL || !ipa->init() || !ipa->attach(resources)) {
+		OSSafeReleaseNULL(ipa);
+		IOLog("BLUE PDP: cannot create AppleIPAppender\n");
+		return;
+	}
+	if (!ipa->start(resources)) {
+		ipa->detach(resources);
+	} else {
+		IOLog("BLUE PDP: AppleIPAppender published (every method unsupported; bluepdp=0 leaves it out)\n");
+	}
+	ipa->release();
+}

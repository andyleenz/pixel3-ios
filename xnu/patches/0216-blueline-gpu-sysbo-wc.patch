+/* GEM_NEW with the pool full (lock not held): b->size, b->flags set; on success b is in c, lock released. */
 static IOReturn
+bg_sys_new(BGCtx *c, BGBo *b)
+{
+	b->size = (b->size + PAGE_SIZE - 1) & ~(uint64_t)PAGE_MASK;
+	IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache, b->size, PAGE_SIZE);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	b->kind = BG_SYS;
+	b->md = md;
+	b->kva = (uintptr_t)md->getBytesNoCopy();
+	bg_sys_attr(b->kva, b->size, BG_WIMG_WCOMB);
+	IOLockLock(g.lock);
+	IOReturn ret = bg_import_map(b, md, b->size, false);
+	if (ret == kIOReturnSuccess) {
+		ret = bg_insert(c, b);
+		if (ret != kIOReturnSuccess) {
+			blue_gmem_imp_unmap(b->gva, b->map_len);
+			(void)blue_gmem_sync();
+			blue_gmem_imp_free(b->gva, b->map_len);
+		}
+	}
+	if (ret == kIOReturnSuccess) {
+		g.n_new++;
+		g.sys_bytes += b->size;
+		if (!g.sys_said) {
+			g.sys_said = true;
+			printf("BLUEGPU UAPI: pool full: %s's BOs now in write-combined XNU pages (first %llu KiB)\n", c->comm,
+			    (unsigned long long)(b->size >> 10));
+		}
+	}
+	IOLockUnlock(g.lock);
+	if (ret != kIOReturnSuccess) {
+		bg_sys_attr(b->kva, b->size, BG_WIMG_DEFAULT);
+		md->release();
+		b->md = NULL;
+	}
+	return ret;
+}

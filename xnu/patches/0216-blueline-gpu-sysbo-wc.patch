+/* Set the cache attributes of every page of a wired kernel range (kva, page multiple). WCOMB: flush first, so the
+ * zeroes written through the cacheable view reach memory and no dirty line lands on the pages later. */
+static void
+bg_sys_attr(uintptr_t kva, uint64_t size, unsigned int wimg)
+{
+	if (wimg != BG_WIMG_DEFAULT) {
+		FlushPoC_DcacheRegion((vm_offset_t)kva, (size_t)size);
+	}
+	for (uint64_t o = 0; o < size; o += PAGE_SIZE) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(kva + o));
+		if (pn != 0) {
+			pmap_set_cache_attributes(pn, wimg);
+		}
+	}
+}

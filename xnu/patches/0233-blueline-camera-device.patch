+static void
+cam_thread(void *arg __unused, wait_result_t w __unused)
+{
+	lck_mtx_lock(&cam_hw_lock);
+	cam_groups(cam_mode);
+	lck_mtx_unlock(&cam_hw_lock);
+}
+
+/*
+ * ---- 0233: /dev/blueline-camera ----
+ * ABI and behaviour after ios-redfin's /dev/redwood-camera (patches 0923, 0926, 0931, 0934, MIT,
+ * github.com/DenialOfGravity/ios-redfin): sys/blueline_camera.h. One kernel thread runs the sessions:
+ * the first open wakes it, it powers the rear group up and streams (cam_groups(1) with dev_mode), the
+ * last close ends the frame loop and the same code powers everything down. A session that does not
+ * reach its frame loop, or ends on a fault, makes reads return EIO until the last close.
+ */
+__attribute__((noreturn)) static void
+dev_thread(void *arg __unused, wait_result_t w __unused)
+{
+	for (;;) {
+		lck_mtx_lock(&dev_lock);
+		while (!dev_open || dev_broken) {
+			(void)msleep(&dev_open, &dev_lock, PZERO, "blueline-camera-idle", NULL);
+		}
+		lck_mtx_unlock(&dev_lock);
+		lck_mtx_lock(&cam_hw_lock);
+		dev_mode = true;
+		dev_streamed = dev_fault = false;
+		printf("BLUE CAM: dev: session start\n");
+		cam_groups(1);
+		dev_mode = false;
+		lck_mtx_unlock(&cam_hw_lock);
+		bool failed = !dev_streamed || dev_fault;
+		printf("BLUE CAM: dev: session end%s\n", failed ? " (failed: EIO until the last close)" : "");
+		lck_mtx_lock(&dev_lock);
+		if (failed && dev_open) {
+			dev_broken = true;
+		}
+		lck_mtx_unlock(&dev_lock);
+		wakeup(&dev_frames);
+	}
+}
+
+static int
+camdev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{ extern void proc_name(int, char *, int); extern int proc_pid(struct proc *); int refuse = 0; char who[32] = "?"; proc_name(proc_pid(p), who, sizeof(who)); PE_parse_boot_argn("bluecamdev", &refuse, sizeof(refuse)); dev_sync_log = refuse == 3; printf("BLUE CAM: dev: opened by %s[%d]%s\n", who, proc_pid(p), refuse == 2 ? " (refused: bluecamdev=2)" : ""); if (refuse == 2) { return EBUSY; }
+	lck_mtx_lock(&dev_lock);
+	if (!dev_open) {
+		dev_broken = false;
+	}
+	dev_open = true;
+	lck_mtx_unlock(&dev_lock);
+	wakeup(&dev_open);
+	return 0;
+}
+
+/* (the last close only: no D_TRACKCLOSE) */
+static int
+camdev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	lck_mtx_lock(&dev_lock);
+	dev_open = false;
+	dev_broken = false;
+	lck_mtx_unlock(&dev_lock);
+	wakeup(&dev_frames);
+	return 0;
+}
+
+static int
+camdev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct blueline_camera_frame f;
+	uint64_t since = dev_ms();
+	int bi, error;
+
+	lck_mtx_lock(&dev_lock);
+	for (;;) {
+		if (dev_broken) {
+			lck_mtx_unlock(&dev_lock);
+			return EIO;
+		}
+		bi = -1;
+		for (int i = 0; i < DEV_RING; i++) {
+			if (dev_buf[i].state == BUF_READY && dev_buf[i].seq > dev_given &&
+			    (bi < 0 || dev_buf[i].seq > dev_buf[bi].seq)) {
+				bi = i;
+			}
+		}
+		if (bi >= 0) {
+			break;
+		}
+		if (dev_ms() - since >= 1000) {
+			lck_mtx_unlock(&dev_lock);
+			return EAGAIN;
+		}
+		struct timespec ts = { 0, 100 * NSEC_PER_MSEC };
+		error = msleep(&dev_frames, &dev_lock, PZERO | PCATCH, "blueline-camera", &ts);
+		if (error != 0 && error != EWOULDBLOCK) {
+			lck_mtx_unlock(&dev_lock);
+			return error;
+		}
+	}
+	struct dev_buf *d = &dev_buf[bi];
+	bool body = uio_resid(uio) > (user_ssize_t)sizeof(f);
+	bzero(&f, sizeof(f));
+	memcpy(f.magic, BLUELINE_CAMERA_MAGIC, 8);
+	f.header_bytes = sizeof(f);
+	f.width = dev_w;
+	f.height = dev_h;
+	f.stride = dev_stride;
+	f.format = BLUELINE_CAMERA_FORMAT_RAW10;
+	f.bayer = 0;			/* RGGB, as the 0196 colour snap */
+	f.black = DEV_BLACK;
+	f.sequence = d->seq;
+	f.time = d->time;
+	f.exposure_lines = d->lines;
+	f.line_ns = dev_line_ns;
+	f.gain = d->gain;
+	f.gain_unity = DEV_GAIN_UNITY;
+	f.gain_max = DEV_GAIN_MAX;
+	f.frame_lines = d->fll;
+	f.frame_lines_min = DEV_FLL_MIN;
+	f.frame_lines_max = DEV_FLL_MAX;
+	f.margin = DEV_MARGIN;
+	f.sensor = 1;
+	f.focus = BLUELINE_CAMERA_NO_FOCUS;
+	f.reserved[BLUELINE_CAMERA_R_FLAGS] = dev_given == 0 ? BLUELINE_CAMERA_FLAG_MODE_CHANGED : 0;
+	f.reserved[BLUELINE_CAMERA_R_FPS_MILLI] = (uint32_t)(1000000000000ull / ((uint64_t)dev_line_ns * DEV_FLL_MIN));
+	uint32_t n = MIN(dev_stride * dev_h, dev_buf_bytes);
+	if (body) {
+		d->readers++;
+		dev_given = d->seq;
+	}
+	lck_mtx_unlock(&dev_lock);
+
+	error = uiomove((caddr_t)&f, (int)MIN(sizeof(f), (size_t)uio_resid(uio)), uio);
+	if (body) {
+		if (error == 0 && uio_resid(uio) > 0) {
+			n = (uint32_t)MIN((uint64_t)n, (uint64_t)uio_resid(uio));
+			/* the IFE wrote past the caches: drop any lines of the frame first */
+			FlushPoC_DcacheRegion(d->va, n);	/* the write master wrote it behind the cache */
+			error = uiomove((caddr_t)d->va, (int)n, uio);
+		}
+		lck_mtx_lock(&dev_lock);
+		d->readers--;
+		dev_refill();
+		lck_mtx_unlock(&dev_lock);
+	}
+	return error;
+}
+
+static int
+camdev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct blueline_camera_command c;
+
+	if (uio_resid(uio) < (user_ssize_t)sizeof(c) || uiomove((caddr_t)&c, sizeof(c), uio) != 0) {
+		return EINVAL;
+	}
+	switch (c.command) {
+	case BLUELINE_CAMERA_EXPOSURE:
+		lck_mtx_lock(&dev_lock);
+		dev_ask.lines = c.a;
+		dev_ask.gain = c.b;
+		dev_ask.fll = c.c;
+		dev_ask.pending = true;
+		lck_mtx_unlock(&dev_lock);
+		return 0;
+	case BLUELINE_CAMERA_SENSOR:
+		return c.a == 1 ? 0 : ENODEV;
+	case BLUELINE_CAMERA_FORMAT:
+		return c.a == BLUELINE_CAMERA_FORMAT_RAW10 ? 0 : ENOTSUP;
+	case BLUELINE_CAMERA_FOCUS:
+		return 0;
+	case BLUELINE_CAMERA_KEEP:
+	case BLUELINE_CAMERA_FLASH:
+	case BLUELINE_CAMERA_COLOUR:
+		return ENOTSUP;
+	}
+	return EINVAL;
+}
+
+static const struct cdevsw camdev_cdevsw = {
+	.d_open = camdev_open, .d_close = camdev_close, .d_read = camdev_read, .d_write = camdev_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = 0,
+};
+
+static void
+camdev_make(void)
+{
+	int major = cdevsw_add(-24, &camdev_cdevsw);	/* (bsd_stubs.c: -24 is the safe start) */
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "blueline-camera") == NULL) {
+		printf("BLUE CAM: /dev/blueline-camera NOT made (%d)\n", major);
+		return;
+	}
+	thread_t th;
+	if (kernel_thread_start(dev_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("BLUE CAM: /dev/blueline-camera: no thread\n");
+		return;
+	}
+	thread_deallocate(th);
+	bool ring = dev_ring_alloc(); printf("BLUE CAM: /dev/blueline-camera made (rear IMX363, 2016x1512 RAW10)%s\n", ring ? "" : "; no ring yet");
+}
+

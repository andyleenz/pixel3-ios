+/*
+ * ---- 0233: a device session's frame loop ----
+ * No interrupt handler: the thread polls the IFE-lite's latched status, about once a frame period
+ * and then every millisecond until WM0's buf-done (bus status 1 bit 0; 0196's log: 0x00000001,
+ * with RDI0 SOF in top status 0 bit 27). The status is cleared as camss-vfe-170.c's vfe_isr does.
+ */
+static uint64_t
+dev_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
 
+/* IMX363 frame length, coarse integration time and analog gain code, in a group hold (0x0104) */
+static bool
+dev_exposure_write(const struct cam_bus *b, uint8_t addr, uint32_t lines, uint32_t gain, uint32_t fll)
+{
+	uint32_t code = 512u - (uint32_t)(512ull * DEV_GAIN_UNITY / gain);
+	const uint16_t w[][2] = {
+		{ 0x0104, 1 }, { 0x0340, (uint16_t)(fll >> 8) }, { 0x0341, (uint16_t)(fll & 0xff) },
+		{ 0x0202, (uint16_t)(lines >> 8) }, { 0x0203, (uint16_t)(lines & 0xff) },
+		{ 0x0204, (uint16_t)(code >> 8) }, { 0x0205, (uint16_t)(code & 0xff) }, { 0x0104, 0 },
+	};
+	for (size_t i = 0; i < sizeof(w) / sizeof(w[0]); i++) {
+		if (bus_write(b, addr, w[i][0], (uint8_t)w[i][1])) {
+			printf("BLUE CAM: dev: exposure write 0x%04x NACK\n", w[i][0]);
+			(void)bus_write(b, addr, 0x0104, 0);
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+dev_loop(const struct cam_bus *b, uint8_t addr, vm_offset_t vfe)
+{
+	uint64_t last = dev_ms(), period = 28, changed_at = 0, t2 = 0;
+	unsigned errs = 0;
+	const char *why = "closed";
+
+	dev_streamed = true;
+	printf("BLUE CAM: dev: streaming %ux%u RAW10 (stride %u); exposure %u lines, gain %u/256, frame %u lines\n",
+	    dev_w, dev_h, dev_stride, dev_now.lines, dev_now.gain, dev_now.fll);
+	for (;;) {
+		if (!dev_open) {
+			break;
+		}
+		uint64_t since = dev_ms() - last;
+		IOSleep(since + 4 < period ? (unsigned)(period - since - 3) : 1);
+		uint32_t top0 = rd32(vfe + 0x06c), top1 = rd32(vfe + 0x070);
+		uint32_t bus0 = rd32(vfe + 0x205c), bus1 = rd32(vfe + 0x2060), bus2 = rd32(vfe + 0x2064);
+		uint64_t now = dev_ms();
+		if (!(bus1 & 1u)) {
+			if (now - last > 1000) {
+				cap_status(vfe, "no frame");
+				why = "no frame for 1 s";
+				dev_fault = true;
+				break;
+			}
+			continue;
+		}
+		wr32(vfe + 0x064, top0);
+		wr32(vfe + 0x068, top1);
+		wr32(vfe + 0x058, 1);
+		wr32(vfe + 0x2050, bus0);
+		wr32(vfe + 0x2054, bus1);
+		wr32(vfe + 0x2058, bus2);
+		wr32(vfe + 0x2068, 1);
+		if (!(rd32(vfe + 0x2060) & 1u)) {
+			dev_bad = 0;	/* (three in a row, not three a session) */
+		} else {
+			/* a real next done is a frame away: the bit did not clear */
+			if (++dev_bad >= 3) {
+				cap_status(vfe, "done stays set");
+				why = "WM0 done does not clear";
+				dev_fault = true;
+				break;
+			}
+		}
+		if ((top1 & (1u << 7)) || (bus0 & (7u << 12))) {	/* violation; bus overwrite, overflow, violation */
+			if (errs++ < 5) {
+				printf("BLUE CAM: dev: frame %llu: IRQ 0x%08x 0x%08x bus 0x%08x, violation 0x%x\n", dev_frames + 1,
+				    top0, top1, bus0, rd32(vfe + 0x07c));
+			}
+		}
+		uint64_t at = mach_absolute_time();
+		if (dev_frames > 0 && now - last >= 5 && now - last <= 500) {
+			period = now - last;
+		}
+		last = now;
+
+		bool ask = false;
+		uint32_t al = 0, ag = 0, af = 0;
+		lck_mtx_lock(&dev_lock);
+		if (dev_hwn > 0) {
+			struct dev_buf *d = &dev_buf[dev_hwq[0]];
+			/* (a check: a missed done would leave the model one buffer behind the write master's address) */
+			uint32_t wa = rd32(vfe + 0x2200);
+			if (dev_hwn > 1 && wa != (uint32_t)dev_buf[dev_hwq[1]].pa && dev_mismatch++ < 5) {
+				printf("BLUE CAM: dev: frame %llu: WM0 at 0x%x, the model has 0x%llx next (done 0x%llx), period %llu ms\n",
+				    dev_frames + 1, wa, dev_buf[dev_hwq[1]].pa, d->pa, period);
+			}
+			dev_hwq[0] = dev_hwq[1];
+			dev_hwn--;
+			dev_frames++;
+			if (dev_next.from != 0 && dev_frames >= dev_next.from) {
+				dev_now = dev_next;
+				dev_next.from = 0;
+				changed_at = dev_frames;
+			}
+			d->state = BUF_READY;
+			d->seq = dev_frames;
+			d->time = at;
+			d->lines = dev_now.lines;
+			d->gain = dev_now.gain;
+			d->fll = dev_now.fll;
+		} else {
+			dev_late++;	/* a done with no address queued */
+		}
+		dev_refill();
+		if (dev_ask.pending) {
+			ask = true;
+			al = dev_ask.lines;
+			ag = dev_ask.gain;
+			af = dev_ask.fll;
+			dev_ask.pending = false;
+		}
+		uint64_t n = dev_frames;
+		lck_mtx_unlock(&dev_lock);
+		wakeup(&dev_frames);
+
+		/* line time from frames 2-18 at one frame length */
+		if (n == 2) {
+			t2 = at;
+		} else if (n == 18 && changed_at < 2 && t2) {
+			uint64_t ns;
+			absolutetime_to_nanoseconds(at - t2, &ns);
+			dev_line_ns = (uint32_t)(ns / 16 / dev_now.fll);
+			printf("BLUE CAM: dev: %llu.%03llu ms a frame, %u ns a line\n", ns / 16 / 1000000, ns / 16 / 1000 % 1000,
+			    dev_line_ns);
+		}
+		if (n == 1 || n % 900 == 0) {
+			printf("BLUE CAM: dev: frame %llu: %llu read, %llu without a buffer, period %llu ms\n", n, dev_given, dev_late,
+			    period);
+		}
+		if (ask) {
+			dev_limits(&al, &ag, &af);
+			if (al != dev_now.lines || ag != dev_now.gain || af != dev_now.fll) {
+				if (!dev_exposure_write(b, addr, al, ag, af)) {
+					why = "exposure not taken";
+					dev_fault = true;
+					break;
+				}
+				dev_next.lines = al;
+				dev_next.gain = ag;
+				dev_next.fll = af;
+				dev_next.from = n + 2;
+			}
+		}
+	}
+	lck_mtx_lock(&dev_lock);
+	dev_vfe = 0;
+	for (int i = 0; i < DEV_RING; i++) {
+		dev_buf[i].state = BUF_FREE;
+	}
+	dev_hwn = 0;
+	lck_mtx_unlock(&dev_lock);
+	wakeup(&dev_frames);
+	printf("BLUE CAM: dev: frames stopped (%s): %llu done, %llu read, %llu without a buffer\n", why, dev_frames, dev_given,
+	    dev_late);
+}

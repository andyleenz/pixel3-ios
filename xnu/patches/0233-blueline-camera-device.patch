+/* The ring: allocated once, kept for the rest of the boot (readers may still be copying after a close). */
 static bool
+dev_ring_alloc(void)
+{
+	/*
+	 * A carve-out below 4 GiB that XNU does not manage (as blueline_gpu_mem.c): the write master has 32-bit
+	 * addresses and XNU's RAM below 4 GiB (0xf4000000+) has no 4 MiB contiguous left even at boot. 16 MiB at
+	 * bluecam_pool (0xd0000000): inside the GPU pool's window, clear of the pool (0xc0000000 + 32 MiB) and
+	 * of Wi-Fi's 0xe0000000. Cacheable (write-combined reads ran at 38 MB/s: 100 ms a frame, camdev10), the one
+	 * mapping: each buffer is cleaned and invalidated before it is copied out.
+	 */
+	if (dev_pool_va) {
+		return true;
+	}
+	uint64_t base = 0xd0000000ull, size = (uint64_t)DEV_RING * DEV_BUF_BYTES;
+	(void)PE_parse_boot_argn("bluecam_pool", &base, sizeof(base));
+	if (base < 0xa4000000ull || base + size > 0xe0000000ull || (base & PAGE_MASK)) {
+		printf("BLUE CAM: dev: bluecam_pool 0x%llx outside 0xa4000000..0xe0000000\n", base);
+		return false;
+	}
+	for (uint64_t pa = base; pa < base + size; pa += PAGE_SIZE) {
+		if (pmap_valid_address(pa)) {
+			printf("BLUE CAM: dev: pool page 0x%llx is XNU memory\n", pa);
+			return false;
+		}
+	}
+	dev_pool_va = ml_io_map_unmappable((vm_offset_t)base, (vm_size_t)size, VM_WIMG_DEFAULT);
+	if (!dev_pool_va) {
+		printf("BLUE CAM: dev: pool 0x%llx not mapped\n", base);
+		return false;
+	}
+	for (int i = 0; i < DEV_RING; i++) {
+		dev_buf[i].va = dev_pool_va + (vm_offset_t)i * DEV_BUF_BYTES;
+		dev_buf[i].pa = base + (uint64_t)i * DEV_BUF_BYTES;
+		memset((void *)dev_buf[i].va, 0, DEV_BUF_BYTES);
+	}
+	FlushPoC_DcacheRegion(dev_pool_va, (size_t)size);
+	dev_buf_bytes = DEV_BUF_BYTES;
+	printf("BLUE CAM: dev: ring %d x %u MiB at 0x%llx (carve-out, cacheable)\n", DEV_RING, DEV_BUF_BYTES >> 20, base);
+	return true;
+}

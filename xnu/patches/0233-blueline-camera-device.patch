+#define DEV_BUF_BYTES	(4u << 20)
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);

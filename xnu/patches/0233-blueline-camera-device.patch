+/* dev_lock held: top the write master's queue up to two from the free or oldest done buffers. */
+static void
+dev_refill(void)
+{
+	while (dev_vfe && dev_hwn < 2) {
+		uint64_t newest = 0;
+		int c = -1;
+		for (int i = 0; i < DEV_RING; i++) {
+			if (dev_buf[i].state == BUF_READY && dev_buf[i].seq > newest) {
+				newest = dev_buf[i].seq;
+			}
+		}
+		for (int i = 0; i < DEV_RING; i++) {
+			struct dev_buf *b = &dev_buf[i];
+			if (b->state == BUF_QUEUED || b->readers || (b->state == BUF_READY && b->seq == newest)) {
+				continue;
+			}
+			if (c < 0 || (b->state == BUF_FREE && dev_buf[c].state != BUF_FREE) ||
+			    (b->state == dev_buf[c].state && b->seq < dev_buf[c].seq)) {
+				c = i;
+			}
+		}
+		if (c < 0) {
+			break;
+		}
+		dev_buf[c].state = BUF_QUEUED;
+		dev_hwq[dev_hwn++] = c;
+		wr32(dev_vfe + 0x2214, (uint32_t)dev_buf[c].pa);
+	}
+}

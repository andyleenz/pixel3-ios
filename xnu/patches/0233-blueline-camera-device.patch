+static void
+dev_limits(uint32_t *lines, uint32_t *gain, uint32_t *fll)
+{
+	*gain = *gain < DEV_GAIN_UNITY ? DEV_GAIN_UNITY : *gain > DEV_GAIN_MAX ? DEV_GAIN_MAX : *gain;

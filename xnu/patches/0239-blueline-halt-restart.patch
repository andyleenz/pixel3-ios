+/*
+ * (0239) iOS's own restart and shut down. Nothing on this board set PE_halt_restart, so reboot(2), launchd's
+ * reboot, SpringBoard's power off and thermalmonitord's emergency shut down all ended in halt_all_cpus()
+ * spinning with USB already down (therm8: off the bus for good, the watchdog still petted from the other
+ * CPUs). Now a restart is PSCI SYSTEM_RESET to recovery (iOS is RAM-booted: a plain boot never comes back
+ * to it); a halt is too in a test boot (bluereboot= or bluewdt_recovery=1), else PSCI SYSTEM_OFF.
+ * Panics keep 0148's path (the watchdog bites). Other types: -1 as before.
+ */
+#define PSCI_SYSTEM_OFF         0x84000008ull
+enum { BH_HALT = 0, BH_RESTART = 1, BH_UPS_HALT = 3 };	/* kPEHaltCPU, kPERestartCPU, kPEUPSDelayHaltCPU */
+static int bluehalt_test;
+
+static int
+bluehalt_restart(unsigned int type)
+{
+	if (type != BH_HALT && type != BH_RESTART && type != BH_UPS_HALT) {
+		return -1;
+	}
+	bool restart = type == BH_RESTART;
+	if (restart || bluehalt_test) {
+		if (br.reason == 0) {
+			br.reason = 1;
+		}
+		bluereboot_fire_how(restart ? "iOS restart" : "iOS halt (test boot: to recovery instead)", true);
+		return -1;
+	}
+	printf("BLUELINE REBOOT: iOS halt: PSCI SYSTEM_OFF\n");
+	blueline_wdt_suspend();
+	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_OFF;
+	__asm__ volatile ("smc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	    "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	blueline_wdt_resume();
+	return -1;
+}
+
+extern int (*PE_halt_restart)(unsigned int type);
+
+static void
+bluehalt_arm(void)
+{
+	uint32_t rec = 0;
+	(void)PE_parse_boot_argn("bluewdt_recovery", &rec, sizeof(rec));
+	bluehalt_test = br.when != BR_OFF || rec != 0;
+	if (PE_halt_restart == NULL) {
+		PE_halt_restart = bluehalt_restart;
+	}
+	printf("BLUELINE REBOOT: iOS restart -> recovery, halt -> %s\n", bluehalt_test ? "recovery" : "power off");
+}

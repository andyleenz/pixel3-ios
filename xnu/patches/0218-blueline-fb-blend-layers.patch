+	uintptr_t     fTarget;          /* 0218: where present() draws: fPixels, or fShadow when layers stack */
+	IOBufferMemoryDescriptor *fShadow;      /* 0218: cacheable panel-sized buffer (the panel is slow to read) */
 	IOMemoryMap  *fMap;
 	SweetSurface *fSurface;         /* the panel memory as an IOSurface */
 	IOLock       *fLock;            /* swaps and client list */
@@ -232,7 +257,7 @@

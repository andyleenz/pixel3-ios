+/*
+ * 0244 (boot-arg bluediag=1): the modem's DIAG over QRTR, as linux-msm/diag router/peripheral-qrtr.c and diag_cntl.c
+ * (BSD-3) do it. We publish service 4097 (DIAG_SERVICE_ID) as the master: CNTL (word 0) and DATA (word 2); the
+ * modem sends its feature mask to CNTL, we answer with ours, then message masks for every SSID range, then real-time
+ * mode. Its F3 messages come to DATA as non-HDLC frames (0x7e, 1, u16 length, packet, 0x7e) and are printed in hex
+ * ("BLUELINE DIAG: <" lines) for tools/diag-decode.py, which looks the QShrink hashes up in qdsp6m.qdb.
+ */
+#define DIAG_SERVICE		4097u
+#define DIAG_CNTL_PORT		0x13u
+#define DIAG_DATA_PORT		0x14u
+#define DIAG_CMD_PORT		0x15u	/* ours, for the modem's CMD server (4097 word 1) */
+#define DIAG_LINES_MAX		8000u
+static struct {
+	bool on, masks_sent, cmd_seen, cmds_sent;
+	uint32_t lines, dropped, frames, node, port, cmd_node, cmd_port, features, registers;
+	uint32_t opts;	/* bluediag: 1 on, | 2 no masks/mode/buffering packets, | 4 no CMD commands */
+	uint32_t level;	/* bluediag_level: the F3 levels CNTL and CMD masks enable (0x1e; 0: CMD sends no 0x7d) */
+} dg;
+
+static const uint16_t diag_ssid_first[] = { 0, 500, 1000, 2000, 3000, 4000, 4500, 4600, 5000, 5500, 6000, 6500, 7000, 7100,
+	7200, 8000, 8500, 9000, 9500, 10200, 10251, 10300, 10350, 10400, 0xc000 };
+static const uint16_t diag_ssid_last[] = { 120, 506, 1007, 2008, 3014, 4010, 4573, 4615, 5033, 5516, 6081, 6521, 7003, 7111,
+	7201, 8000, 8529, 9008, 9510, 10210, 10255, 10300, 10377, 10416, 0xc063 };
+
+static void
+diag_hex(const char *what, const uint8_t *d, uint32_t n)
+{
+	char hex[2 * 240 + 1];
+	uint32_t k = MIN(n, 240u);
+
+	if (dg.lines >= DIAG_LINES_MAX) {
+		dg.dropped++;
+		return;
+	}
+	dg.lines++;
+	for (uint32_t i = 0; i < k; i++) {
+		static const char hx[] = "0123456789abcdef";
+		hex[2 * i] = hx[d[i] >> 4];
+		hex[2 * i + 1] = hx[d[i] & 15];
+	}
+	hex[2 * k] = 0;
+	printf("BLUELINE DIAG: %s %u %s%s\n", what, n, hex, k < n ? "..." : "");
+}
+
+static void
+diag_cntl_send(const void *p, uint32_t len)
+{
+	(void)qrtr_send(Q_DATA, DIAG_CNTL_PORT, dg.node, dg.port, p, len);
+}
+
+/*
+ * Commands to the modem's CMD server, raw (APPS_HDLC_ENCODE agreed): 0x7c EXT_BUILD_ID (proves the path), then
+ * 0x7d EXT_MSG_CONFIG 5, set all SSIDs' masks (u16 reserved, u32 mask), as fgsect/scat enables F3 messages.
+ */
+static void
+diag_send_cmds(void)
+{
+	uint8_t build[1] = { 0x7c };
+	uint8_t all[8] = { 0x7d, 0x05, 0, 0, 0, 0, 0, 0 };
+
+	if (!dg.masks_sent || !dg.cmd_seen || dg.cmds_sent || (dg.opts & 4u)) {
+		return;
+	}
+	dg.cmds_sent = true;
+	(void)qrtr_send(Q_DATA, DIAG_CMD_PORT, dg.cmd_node, dg.cmd_port, build, sizeof(build));
+	memcpy(all + 4, &dg.level, 4);
+	if (dg.level) {
+		(void)qrtr_send(Q_DATA, DIAG_CMD_PORT, dg.cmd_node, dg.cmd_port, all, sizeof(all));
+	}
+	printf("BLUELINE DIAG: cmd: build id, all F3 masks %#x -> %u:%#x\n", dg.level, dg.cmd_node, dg.cmd_port);
+}
+
+static void
+diag_new_server(uint32_t service, uint32_t word, uint32_t node, uint32_t port)
+{
+	if (service != DIAG_SERVICE || (word & 0xffu) != 1u || node == QRTR_NODE_APPS) {
+		return;
+	}
+	dg.cmd_node = node;
+	dg.cmd_port = port;
+	dg.cmd_seen = true;
+	diag_send_cmds();
+}
+
+static void
+diag_send_masks(void)
+{
+	static uint8_t b[16 + 4 * 128];
+	/* struct diag_cntl_cmd_diag_mode (v1): cmd 3, len 36: version 1, sleep_vote, real_time, then zeros */
+	uint32_t mode[11] = { 3, 36, 1, 1, 1, 0, 0, 0, 0, 0, 0 };
+
+	for (unsigned r = 0; r < sizeof(diag_ssid_first) / sizeof(diag_ssid_first[0]); r++) {
+		uint32_t items = (uint32_t)(diag_ssid_last[r] - diag_ssid_first[r] + 1u), len, v;
+
+		items = MIN(items, 128u);
+		len = 8 + 3 + 4 + 4 + 4 * items;
+		/* struct diag_cntl_cmd_msg_mask: cmd 11, len; stream 1, status 3 (VALID), mode 0; range; count; masks */
+		v = 11;
+		memcpy(b, &v, 4);
+		v = len - 8;
+		memcpy(b + 4, &v, 4);
+		b[8] = 1;
+		b[9] = 3;
+		b[10] = 0;
+		memcpy(b + 11, &diag_ssid_first[r], 2);
+		v = (uint32_t)diag_ssid_first[r] + items - 1u;
+		memcpy(b + 13, &v, 2);
+		memcpy(b + 15, &items, 4);
+		v = dg.level;	/* default MED, HIGH, ERROR, FATAL (LOW is 1) */
+		for (uint32_t i = 0; i < items; i++) {
+			memcpy(b + 19 + 4 * i, &v, 4);
+		}
+		diag_cntl_send(b, len);
+	}
+	diag_cntl_send(mode, sizeof(mode));
+	{
+		/* BUFFERING_TX_MODE v1: cmd 17, len 6: version 1, stream 0, mode 0 (streaming) */
+		uint8_t buf[14] = { 17, 0, 0, 0, 6, 0, 0, 0, 1, 0, 0, 0, 0, 0 };
+		diag_cntl_send(buf, sizeof(buf));
+	}
+	dg.masks_sent = true;
+	diag_send_cmds();
+	printf("BLUELINE DIAG: masks sent (%u ranges, levels %#x), real-time mode\n",
+	    (unsigned)(sizeof(diag_ssid_first) / sizeof(diag_ssid_first[0])), dg.level);
+}
+
+static void
+diag_cntl(const struct qrtr_hdr *h, const uint8_t *d, uint32_t n)
+{
+	uint32_t off = 0;
+
+	dg.node = h->src_node;
+	dg.port = h->src_port;
+	while (off + 8 <= n) {
+		uint32_t cmd, len;
+
+		memcpy(&cmd, d + off, 4);
+		memcpy(&len, d + off + 4, 4);
+		if (off + 8 + len > n) {
+			printf("BLUELINE DIAG: cntl: truncated (cmd %u len %u of %u)\n", cmd, len, n - off);
+			return;
+		}
+		if (cmd == 8 && len >= 5) {	/* FEATURE_MASK: u32 mask_len, then that many mask bytes (the modem: 3) */
+			uint32_t mask = 0, mlen, ours;
+			/* as diag-router: FEATURE_MASK_SUPPORT, MASTER_SETS_COMMON_MASK, REQ_RSP, APPS_HDLC_ENCODE, SOCKETS,
+			 * DIAG_ID, DIAG_ID_FEATURE_MASK */
+			const uint32_t local = (1u << 0) | (1u << 1) | (1u << 4) | (1u << 6) | (1u << 13) | (1u << 15) | (1u << 19);
+			uint32_t pkt[4];
+
+			memcpy(&mlen, d + off + 8, 4);
+			memcpy(&mask, d + off + 12, MIN(MIN(mlen, 4u), len - 4u));
+			ours = mask & local;
+			printf("BLUELINE DIAG: cntl: modem %u:%#x feature mask %#x, ours %#x\n", h->src_node, h->src_port, mask, ours);
+			pkt[0] = 8;
+			pkt[1] = 8 + 2;
+			pkt[2] = 4;
+			pkt[3] = ours;
+			{
+				uint8_t fb[18] = { 0 };
+				memcpy(fb, pkt, sizeof(pkt));
+				diag_cntl_send(fb, sizeof(fb));
+			}
+			dg.features = ours;
+			if (dg.opts & 2u) {
+				dg.masks_sent = true;
+				printf("BLUELINE DIAG: no masks (bluediag & 2)\n");
+			} else {
+				diag_send_masks();
+			}
+		} else if (cmd == 1) {	/* REGISTER: the modem's command ranges */
+			dg.registers++;
+		} else if (cmd == 33 && len >= 9) {	/* DIAG_ID: version, diag_id, [v2: feature_len, mask], name */
+			static uint32_t next_id = 1;	/* DIAG_ID_APPS */
+			uint32_t ver, id, flen = 0, at = 16;
+			char name[32];
+			uint8_t rb[8 + 8 + sizeof(name)];
+			uint32_t nl, v;
+
+			memcpy(&ver, d + off + 8, 4);
+			memcpy(&id, d + off + 12, 4);
+			if ((dg.features & (1u << 19)) && ver >= 2 && len >= 12) {
+				memcpy(&flen, d + off + 16, 4);
+				at = 20 + flen;
+			}
+			nl = 0;
+			while (at + nl < 8 + len && nl + 1 < sizeof(name) && d[off + at + nl]) {
+				name[nl] = (char)d[off + at + nl];
+				nl++;
+			}
+			name[nl] = 0;
+			id = ver >= 3 ? id : ++next_id;
+			printf("BLUELINE DIAG: cntl: DIAG_ID v%u \"%s\" -> id %u (%u command registrations so far)\n", ver, name, id,
+			    dg.registers);
+			v = 33;
+			memcpy(rb, &v, 4);
+			v = 4 + 4 + nl + 1;
+			memcpy(rb + 4, &v, 4);
+			v = 1;
+			memcpy(rb + 8, &v, 4);
+			memcpy(rb + 12, &id, 4);
+			memcpy(rb + 16, name, nl + 1);
+			diag_cntl_send(rb, 16 + nl + 1);
+		} else {
+			printf("BLUELINE DIAG: cntl: cmd %u, %u bytes\n", cmd, len);
+			diag_hex("cntl", d + off, MIN(8 + len, 64u));
+		}
+		off += 8 + len;
+	}
+}
+
+static void
+diag_data(const uint8_t *d, uint32_t n)
+{
+	uint16_t len;
+
+	while (n > 0) {	/* one or more frames a packet */
+		dg.frames++;
+		if (n < 5 || d[0] != 0x7e || d[1] != 1) {
+			diag_hex("raw", d, n);
+			return;
+		}
+		memcpy(&len, d + 2, 2);
+		if (4u + len + 1u > n || d[4 + len] != 0x7e) {
+			diag_hex("bad", d, n);
+			return;
+		}
+		diag_hex("<", d + 4, len);
+		d += 5u + len;
+		n -= 5u + len;
+	}
+}
+
+static void
+diag_publish(void)
+{
+	uint32_t on = 0;
+
+	(void)PE_parse_boot_argn("bluediag", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	/* DIAG passes its instance as the version byte (peripheral-qrtr.c) */
+	if (qrtr_new_server(DIAG_SERVICE, 0, 0, DIAG_CNTL_PORT) || qrtr_new_server(DIAG_SERVICE, 2, 0, DIAG_DATA_PORT)) {
+		printf("BLUELINE DIAG: announcing failed\n");
+		return;
+	}
+	dg.on = true;
+	dg.opts = on;
+	dg.level = 0x1e;
+	(void)PE_parse_boot_argn("bluediag_level", &dg.level, sizeof(dg.level));
+	gtr.on = true;
+	printf("BLUELINE DIAG: serving DIAG cntl at 1:%#x, data at 1:%#x\n", DIAG_CNTL_PORT, DIAG_DATA_PORT);
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 19 Nov 2026 17:00:00 +0100
Subject: [PATCH] 0159: IOMobileFramebuffer SwapWait reports pending swaps

CoreAnimation (IOMFBDisplay::can_update_) polls SwapWait (selector 6,
flags 0x80000001) before it draws into the buffer a swap replaced, and
takes another buffer while it answers 0xe00002d5. SwapWait returned
success at once, so backboardd alternated two buffers and its next frame
waited for the DPU latch (0157). As IOMFB, a swap is now complete once its buffers
are released (a later swap's flip latched); blocking waits sleep up to
50 ms.
---
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -80,6 +80,7 @@
 /* blueline zero-copy present (BlueDPU.cpp, bluedpu_flip=1, patch 0145) */
 extern "C" int blue_dpu_flip_init(int fit);
 extern "C" int blue_dpu_latch_pending(void);  /* 0158 */
+static uint32_t sweet_fb_swapwait_n[2];        /* 0159: SwapWaits answered complete / pending */
 extern "C" int blue_dpu_flip(IOMemoryDescriptor *md, uintptr_t kva, uint32_t offset, uint32_t bpr,
     uint32_t w, uint32_t h, uint32_t fmt);
 extern "C" int blue_dpu_unflip(const char *why);
@@ -184,6 +185,17 @@
 	 */
 	SweetSurface *fShown;
 	SweetSurface *fRetiring;
+	/*
+	 * 0159 (under fLock): SwapWait. As IOMFB, a swap is complete when its
+	 * buffers are released: a later swap's flip has latched. CoreAnimation
+	 * polls a swap (flags bit 31) before it draws into that swap's buffer
+	 * again and takes another buffer while it is pending. Copied swaps
+	 * complete at once.
+	 */
+	uint32_t      fSwapPendingID;         /* flipped, latch not seen yet */
+	bool          fSwapPending;
+	uint32_t      fSwapLatchedID;         /* latest swap whose flip latched (shown) */
+	IOReturn swapWait(uint32_t id, uint32_t flags);
 	void displayHold(SweetSurface *s);
 	void displayDrop(bool all);
 
@@ -696,13 +708,16 @@
 {
 	if (!fFlip || !swapFlip(rec)) {
 		IOLockLock(fLock);
+		fSwapLatchedID = get32(rec, 0x50) + 1;  /* 0159: copied: complete */
+		fSwapPending = false;
 		memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
 		fDirty = true;
 		IOLockUnlock(fLock);
 	}
 	blue_dpu_stat(1, 0);
 	if ((++sweet_fb_swap_count % 1000) == 0) {
-		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
+		IOLog("SWEET FB: %llu swaps; SwapWait answered complete %u, pending %u\n", sweet_fb_swap_count,
+		    sweet_fb_swapwait_n[0], sweet_fb_swapwait_n[1]);
 	}
 }
 
@@ -752,6 +767,34 @@
 	if (all && fShown != NULL) {
 		sweet_surface_display_use(fShown, -1);
 		OSSafeReleaseNULL(fShown);
+	}
+}
+
+/* 0159: 0 when swap id is complete; 0xe00002d5 while pending and flags bit 31 (poll) */
+#define SWEET_FB_SWAP_PENDING   ((IOReturn)0xe00002d5)
+IOReturn
+AppleCLCD::swapWait(uint32_t id, uint32_t flags)
+{
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	for (;;) {
+		IOLockLock(fLock);
+		if (fSwapPending && !blue_dpu_latch_pending()) {
+			fSwapLatchedID = fSwapPendingID;
+			fSwapPending = false;
+		}
+		bool done = id == 0 || (int32_t)(id - fSwapLatchedID) < 0;
+		IOLockUnlock(fLock);
+		if (done) {
+			return kIOReturnSuccess;
+		}
+		if (flags & 0x80000000u) {
+			return SWEET_FB_SWAP_PENDING;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if (ns > 50ull * 1000 * 1000) {
+			return kIOReturnSuccess;        /* never block CoreAnimation for long on a lost latch */
+		}
+		IOSleep(1);
 	}
 }
 
@@ -797,6 +840,15 @@
 		displayHold(s);
 		consoleOnce();
 		IOLockLock(fLock);
+		/* 0159: the flip waited for the previous latch: that swap is shown (and its predecessor released) */
+		if (fSwapPending) {
+			fSwapLatchedID = fSwapPendingID;
+		}
+		fSwapPendingID = get32(rec, 0x50);
+		fSwapPending = blue_dpu_latch_pending() != 0;
+		if (!fSwapPending) {
+			fSwapLatchedID = fSwapPendingID;
+		}
 		memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);  /* the latest frame, for wake / fallback */
 		fDirty = false;
 		IOLockUnlock(fLock);
@@ -1099,6 +1151,16 @@
 		}
 		break;
 	case kSweetFBSwapWait:
+		if (args->scalarInputCount >= 2) {
+			ret = fFB->swapWait((uint32_t)args->scalarInput[0], (uint32_t)args->scalarInput[1]);
+			sweet_fb_swapwait_n[ret == kIOReturnSuccess ? 0 : 1]++;
+			if (sweet_fb_swapwait_n[0] + sweet_fb_swapwait_n[1] <= 24) {
+				IOLog("SWEET FB: SwapWait id %llu flags 0x%llx (in %u, shown id %u, pending id %u%s) -> 0x%x\n",
+				    args->scalarInput[0], args->scalarInput[1], args->scalarInputCount, fFB->fSwapLatchedID,
+				    fFB->fSwapPendingID,
+				    fFB->fSwapPending ? " pending" : "", ret);
+			}
+		}
 		break;
 	default:
 		blue_bl_iomfb(selector, args, out, &outCount);

From: Claude <noreply@anthropic.com>
Subject: [PATCH] blueline: boot-arg to log every swap's surfaces

bluefb_swaplog=N logs the first N swaps as they are shown: the layer mask,
each layer's IOSurface and whether the swap was flipped or copied. For
following which buffer the display showed, frame by frame, against the
GL library's per-frame lines (glframes=1). Default 16 keeps the old log;
0 silences the first-swaps lines.

--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -715,6 +715,9 @@
 }
 
 static uint32_t sweet_fb_swaps_logged;
+/* 0171: boot-arg bluefb_swaplog=N: the first N swaps logged (layers' surfaces, flipped or copied); default 16 */
+static TUNABLE(uint32_t, sweet_fb_swaplog, "bluefb_swaplog", 16);
+static uint32_t sweet_fb_shown_logged;
 static uint64_t sweet_fb_swap_count;
 
 /* Copy each enabled layer's surface into the panel memory (no scaling). */
@@ -779,7 +782,17 @@
 void
 AppleCLCD::showSwap(const uint8_t *rec)
 {
-	if (!fFlip || !swapFlip(rec)) {
+	bool flipped = fFlip && swapFlip(rec);
+	if (sweet_fb_swaplog > 16 && sweet_fb_shown_logged < sweet_fb_swaplog) {
+		uint32_t mask = get32(rec, 0x104);
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		sweet_fb_shown_logged++;
+		IOLog("SWEET FB: shown swap %u at %llu ms: mask %#x surfaces %u %u %u %u, %s\n", get32(rec, 0x50),
+		    ns / 1000000, mask, get32(rec, 0x54), get32(rec, 0x58), get32(rec, 0x5c), get32(rec, 0x60),
+		    flipped ? "flipped" : "copied");
+	}
+	if (!flipped) {
 		IOLockLock(fLock);
 		fSwapLatchedID = get32(rec, 0x50) + 1;  /* 0159: copied: complete */
 		fSwapPending = false;
@@ -946,7 +959,7 @@
 			continue;
 		}
 		SweetSurface *s = sweet_surface_copy(id);
-		if (sweet_fb_swaps_logged < 16) {
+		if (sweet_fb_swaps_logged < 16 && sweet_fb_swaplog != 0) {
 			sweet_fb_swaps_logged++;
 			IOLog("SWEET FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d %ux%u b %d,%d %dx%d\n",
 			    get32(rec, 0x50), layer, id, s ? s->width : 0, s ? s->height : 0,

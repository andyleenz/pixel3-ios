+static int
+amp_wr(const struct amp *a, uint32_t reg, uint32_t val)
+{
+	uint8_t b[8] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg,
+		(uint8_t)(val >> 24), (uint8_t)(val >> 16), (uint8_t)(val >> 8), (uint8_t)val };
+	return blueline_bbi2c_xfer(snd_bus, a->addr, b, 8, NULL, 0);
+}
+
+/* Read-modify-write; skips the write when nothing changes. */
+static int
+amp_upd(const struct amp *a, uint32_t reg, uint32_t mask, uint32_t val)
+{
+	uint32_t v;
+	int e = amp_rd(a, reg, &v);
+	if (e) {
+		return e;
+	}
+	uint32_t n = (v & ~mask) | (val & mask);
+	return n == v ? 0 : amp_wr(a, reg, n);
+}

+			ret = kIOReturnBadArgument;
+			break;
+		}
+		out[0] = SWEET_FB_FRAMEINFO_TAGS;
+		outCount = 1;
+		structName = sweet_fb_frameinfo_tags[args->scalarInput[0]];
+		break;
 	case kSweetFBRequestPowerChange:
 		if (args->scalarInputCount >= 1 && fFB->fPowerMode != 0) {
 			bool off = args->scalarInput[0] == 0;
@@ -1453,6 +1528,9 @@
 	}
 	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
 		bzero(args->structureOutput, args->structureOutputSize);
+		if (structName != NULL && args->structureOutputSize > 0) {
+			strlcpy((char *)args->structureOutput, structName, args->structureOutputSize);
+		}
 	}
 	if (selector >= 64 || !(sweet_fb_logged & (1ULL << selector))) {
 		if (selector < 64) {

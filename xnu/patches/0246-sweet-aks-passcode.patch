 /* The system (device) bag handle. */
 #define SWEET_AKS_SYSTEM_HANDLE 0
+/*
+ * keybagd changes the passcode in two phases (KBChangeSystemNonSeSecret): aks_change_secret returns a
+ * new temporary bag handle, keybagd saves that bag (3) with the passcode type ("OpaqueStuff") into
+ * /private/var/keybags/systembag.kb, makes it the system bag (5), ends the change (105) and unloads
+ * the old one (4). A 0 handle is "temp handle is invalid" and the change fails with -1. The stand-in
+ * has one bag, so the temporary handle is only a token.
+ */
+#define SWEET_AKS_TEMP_HANDLE   1
+/* What a saved bag holds: a marker; the passcode itself stays in kernel memory (lost at reboot). */
+static const uint8_t sweet_aks_bag_magic[16] = { 'P', 'X', '3', 'B', 'A', 'G', '1', 0 };
 

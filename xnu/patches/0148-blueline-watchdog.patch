+/*
+ * Emergency owner (patch 0148): once sweet_log_flush_emergency() has taken
+ * the host for a last log write (panic, software watchdog), only that CPU
+ * may issue commands; everyone else gets EIO. ufs_busy counts commands in
+ * flight, so it can wait for one to finish (seq_cst on both sides).
+ */
+static int _Atomic ufs_emergency_cpu = -1;
+static uint32_t _Atomic ufs_busy;
+
+static int ufs_scsi_cmd(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write);
+
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	os_atomic_inc(&ufs_busy, seq_cst);
+	int owner = os_atomic_load(&ufs_emergency_cpu, seq_cst);
+	int error = (owner >= 0 && owner != cpu_number()) ? EIO : ufs_scsi_cmd(cdb, cdb_len, len, write);
+	os_atomic_dec(&ufs_busy, seq_cst);
+	return error;
+}

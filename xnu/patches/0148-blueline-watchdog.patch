+/*
+ * Last log write before a reset (patch 0148), from panic or interrupt
+ * context: no mutex. Takes the host for this CPU for good (other CPUs'
+ * commands fail from now on), waits up to 2 s for a command in flight,
+ * then up to 5 s for slot 0's doorbell (its issuer halted mid-command),
+ * clears it if still set, and writes. Nothing else may use the UFS after
+ * this: the caller resets, or waits for the watchdog to.
+ */
+int sweet_log_flush_emergency(void);
+
+int
+sweet_log_flush_emergency(void)
+{
+	int me = cpu_number(), owner = -1;
+
+	if (!sweet_log_running || !su.ready) {
+		return ENXIO;
+	}
+	if (!os_atomic_cmpxchgv(&ufs_emergency_cpu, -1, me, &owner, seq_cst) && owner != me) {
+		return EBUSY;
+	}
+	uint64_t t, deadline;
+	nanoseconds_to_absolutetime(2 * NSEC_PER_SEC, &t);
+	deadline = mach_absolute_time() + t;
+	while (os_atomic_load(&ufs_busy, seq_cst) != 0 && mach_absolute_time() < deadline) {
+	}
+	if (os_atomic_load(&ufs_busy, seq_cst) != 0) {
+		nanoseconds_to_absolutetime(5 * NSEC_PER_SEC, &t);
+		deadline = mach_absolute_time() + t;
+		while ((ufs_rd(REG_UTRLDBR) & 1) && mach_absolute_time() < deadline) {
+		}
+		if (ufs_rd(REG_UTRLDBR) & 1) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+		}
+	}
+	return sweet_log_write_locked();
+}

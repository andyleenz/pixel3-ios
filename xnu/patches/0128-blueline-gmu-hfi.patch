+/*
+ * a6xx_gmu_hfi_start, then a6xx_hfi_start_v1 as far as GMU_INIT and
+ * FW_VERSION. Not sent: PERF_TABLE/BW_TABLE (they make the GMU vote), TEST.
+ * Linux's legacy path powers the GX rail and SPTPRAC first; not done here.
+ */
+static bool
+hfi_run(struct gmu_mem *m)
+{
+	uint32_t msg[5] = { 0 }, resp[HFI_RESP_WORDS] = { 0 };
+	int ms = 200;
+	(void)PE_parse_boot_argn("bluegpu_hfi_ms", &ms, sizeof(ms));
+	if (ms < 1 || ms > 2000) {
+		ms = 200;
+	}
+
+	printf("BLUELINE GPU: HFI start: ctrl_status %#x version_info %#x gmu2host %#x mask %#x host2gmu raw %#x\n",
+	    gmu_rd(GMU_HFI_CTRL_STATUS), gmu_rd(GMU_HFI_VERSION_INFO), gmu_rd(GMU_GMU2HOST_INTR_INFO),
+	    gmu_rd(GMU_GMU2HOST_INTR_MASK), gmu_rd(GMU_HOST2GMU_INTR_RAW_INFO));
+	wr(gmu + GMU_REG(GMU_GMU2HOST_INTR_CLR), 0xffffffffu);
+	gmu_wr(GMU_GMU2HOST_INTR_MASK, 0xffffffffu);	/* polled; nothing handles the HFI interrupt */
+	gmu_wr(GMU_HFI_CTRL_INIT, 1);
+	uint64_t t0 = mach_absolute_time(), ns;
+	uint32_t st = 0;
+	for (int t = 0; t < ms * 100 && (st = gmu_rd(GMU_HFI_CTRL_STATUS)) == 0; t++) {
+		delay(10);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("BLUELINE GPU: HFI ctrl_status %#x after %llu us: %s (version_info %#x, gmu2host %#x)\n", st,
+	    ns / 1000, st == 1 ? "HFI UP" : st == HFI_CTRL_REJECTED ? "FIRMWARE REJECTED THE QUEUE TABLE" :
+	    st ? "UNEXPECTED" : "TIMEOUT", gmu_rd(GMU_HFI_VERSION_INFO), gmu_rd(GMU_GMU2HOST_INTR_INFO));
+	if (st != 1) {
+		hfi_dump(m);
+		return false;
+	}
+
+	msg[1] = 0;				/* seg_id */
+	msg[2] = GMU_VA_DBG;			/* dbg_buffer_addr */
+	msg[3] = GM_BUF_SIZE;			/* dbg_buffer_size */
+	msg[4] = GMU_COLD_BOOT;			/* boot_state */
+	int r_init = hfi_send(m, HFI_H2F_MSG_INIT, msg, 5, resp, ms);
+	int r_ver = -2;
+	if (r_init != -2 && r_init != -4) {
+		msg[1] = HFI_SUPPORTED_V1_10;	/* supported_version: 1.10, as Linux */
+		r_ver = hfi_send(m, HFI_H2F_MSG_FW_VERSION, msg, 2, resp, ms);
+	}
+	printf("BLUELINE GPU: HFI GMU_INIT %s, FW_VERSION %s", r_init ? "FAILED" : "acked", r_ver ? "FAILED" : "acked");
+	if (r_ver == 0) {
+		printf(": firmware HFI %u.%u (%#x)", resp[3] >> 28, (resp[3] >> 16) & 0xfff, resp[3]);
+	}
+	printf(" (results %d %d)\n", r_init, r_ver);
+	hfi_dump(m);
+	return r_init == 0 && r_ver == 0;
+}

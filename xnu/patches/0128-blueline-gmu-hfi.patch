+static void
+hfi_dump(struct gmu_mem *m)
+{
+	for (int q = 0; q < HFI_QUEUES; q++) {
+		volatile uint32_t *h = hfi_qhdr(m, q);
+		printf("BLUELINE GPU: HFI q%d status %#x type %#x read %#x write %#x dropped %u\n", q, h[QH_STATUS],
+		    h[QH_TYPE], h[QH_READ], h[QH_WRITE], h[QH_DROPPED]);
+	}
+	volatile uint32_t *h = hfi_qhdr(m, 2), *d = hfi_qdata(m, 2);
+	uint32_t r = h[QH_READ] % HFI_Q_WORDS, w = h[QH_WRITE] % HFI_Q_WORDS;
+	printf("BLUELINE GPU: HFI debug queue:");
+	for (uint32_t k = 0; r != w && k < 64; k++, r = (r + 1) % HFI_Q_WORDS) {
+		printf(" %#x", d[r]);
+	}
+	printf("\n");
+	static const struct {
+		const char *name;
+		uint32_t off;
+	} bufs[2] = { { "dbg", GM_DBG_OFF }, { "log", GM_LOG_OFF } };
+	for (int b = 0; b < 2; b++) {
+		volatile uint32_t *p = (volatile uint32_t *)(m->va + bufs[b].off);
+		uint32_t nz = 0;
+		for (uint32_t i = 0; i < GM_BUF_SIZE / 4; i++) {
+			nz += p[i] != 0;
+		}
+		printf("BLUELINE GPU: GMU %s buffer: %u nonzero words; first: %#x %#x %#x %#x %#x %#x %#x %#x\n",
+		    bufs[b].name, nz, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+	}
+}

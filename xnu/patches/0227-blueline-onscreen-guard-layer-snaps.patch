--- a/iokit/Kernel/arm/SweetFramebuffer.cpp	2026-11-26 08:08:29
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp	2026-11-26 08:30:41
@@ -127,6 +127,64 @@
 	return sweet_fb_fake_latch || blue_dpu_latch_pending();

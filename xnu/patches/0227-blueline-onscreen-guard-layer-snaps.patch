+	fHash[2] = 0;
+	fHashFlip[1] = sweet_fb_rows_hash(s);
+	fHashDue = true;
 }
 
+/* 0227: the shown surfaces' flip latched: hash them as fetched. fPresentLock held. */
+void
+AppleCLCD::guardLatched(void)
+{
+	if (!fHashDue) {
+		return;
+	}
+	fHashDue = false;
+	SweetSurface *s[2] = { fShown, fShownU };
+	for (int l = 0; l < 2; l++) {
+		if (s[l] != NULL && fHash[2 * l] == 0 && fHashFlip[l] != 0) {
+			fHash[2 * l] = sweet_fb_rows_hash(s[l]);
+			sweet_fb_guard_n[l][2] += fHash[2 * l] != fHashFlip[l];
+		}
+	}
+}

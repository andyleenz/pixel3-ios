 static uint32_t sweet_fb_swapwait_n[2];        /* 0159: SwapWaits answered complete / pending */
+/*
+ * 0227: on-screen guard (bluefb_guard, default 1). A surface's 32 sample rows
+ * are hashed once its flip latched (the DPU fetches it from then on) and
+ * again when the flip replacing it is flushed: a different hash means
+ * something drew into it while it was fetched (tearing, the 0224 stripes).
+ * Checked once more on release ("changed retiring": between the replacing
+ * flip and the release, which may be after the latch). Counted per layer,
+ * the first ones logged. "Finished late": the rows also changed
+ * between the flip and its latch (the GPU still drawing when the swap came;
+ * shown complete only if it finished before the TE).
+ */
+extern "C" void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
+static uint32_t sweet_fb_guard = 1;
+static uint32_t sweet_fb_guard_n[2][4];        /* [top, under][checked, changed, finished late, changed retiring] */
+static uint64_t
+sweet_fb_rows_hash(SweetSurface *s)
+{
+	uintptr_t kva = s != NULL && sweet_fb_guard ? s->kernelAddress() : 0;
+	if (kva == 0 || s->height == 0 || s->bytesPerElement != 4) {
+		return 0;
+	}
+	uint32_t w8 = s->width * 4 / 8;
+	uint64_t x = 0xcbf29ce484222325ULL;
+	for (uint32_t i = 0; i < 32; i++) {
+		uint32_t y = (uint32_t)(((uint64_t)s->height * (2 * i + 1)) / 64);
+		uintptr_t row = kva + s->offset + (uint64_t)y * s->bytesPerRow;
+		FlushPoC_DcacheRegion((vm_offset_t)row, (size_t)w8 * 8);       /* the GPU wrote DRAM, not the cache */
+		const volatile uint64_t *q = (const volatile uint64_t *)row;
+		for (uint32_t k = 0; k < w8; k++) {
+			x = (x ^ q[k]) * 0x100000001b3ULL;
+		}
+	}
+	return x | 1;
+}
+
+/* on: s leaves the screen now (its replacement just flushed, or unflip); else s is released. The hash now. */
+static uint64_t
+sweet_fb_guard_check(SweetSurface *s, uint64_t hash, int under, bool on)
+{
+	if (s == NULL || hash == 0) {
+		return 0;
+	}
+	uint64_t now = sweet_fb_rows_hash(s);
+	if (!on) {
+		sweet_fb_guard_n[under][3] += now != hash;
+		return now;
+	}
+	sweet_fb_guard_n[under][0]++;
+	if (now != hash) {
+		if (sweet_fb_guard_n[under][1]++ < 16) {
+			uint64_t ns = 0;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			IOLog("SWEET FB: guard: surface %u (%ux%u, %s layer) changed while on screen, at %llu ms\n", s->id,
+			    s->width, s->height, under ? "under" : "top", ns / 1000000);
+		}
+	}
+	return now;
+}

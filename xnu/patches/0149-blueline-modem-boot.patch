+
+/*
+ * Read only, for other kernel drivers (blueline_wifi.c reads the modem
+ * firmware from modem_a / modem_b, patch 0149): len bytes at byte offset off
+ * of the LUN 0 GPT partition name into buf (any kernel address, also a
+ * device or write-combined mapping). READ(10) only, nothing is ever
+ * written, and the root partition (su.first_block / su.nblocks) is left
+ * alone. *part_bytes, if given, gets the partition size. 0 or an errno.
+ */
+int sweet_ufs_read_part(const char *name, uint64_t off, void *buf, uint32_t len, uint64_t *part_bytes);
+int
+sweet_ufs_read_part(const char *name, uint64_t off, void *buf, uint32_t len, uint64_t *part_bytes)
+{
+	static char cname[37];			/* last partition looked up, under sweet_ufs_lock */
+	static uint64_t cfirst, cblocks;
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint8_t *out = buf;
+	int error = 0;
+
+	if (!su.ready || !name || strlen(name) >= sizeof(cname)) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	if (strcmp(cname, name) != 0) {
+		uint64_t f = 0, n = 0;
+		error = ufs_gpt_lookup(name, &f, &n);
+		if (!error) {
+			strlcpy(cname, name, sizeof(cname));
+			cfirst = f;
+			cblocks = n;
+		}
+	}
+	uint64_t bytes = cblocks * UFS_BLOCK;
+	if (!error && part_bytes) {
+		*part_bytes = bytes;
+	}
+	if (!error && (off > bytes || len > bytes - off)) {
+		error = EINVAL;
+	}
+	while (!error && len) {
+		uint32_t skip = (uint32_t)(off % UFS_BLOCK);
+		uint32_t blocks = (uint32_t)MIN(((uint64_t)skip + len + UFS_BLOCK - 1) / UFS_BLOCK, BOUNCE_SIZE / UFS_BLOCK);
+		uint32_t take = MIN(len, blocks * UFS_BLOCK - skip);
+		error = ufs_read_blocks(cfirst + off / UFS_BLOCK, blocks);
+		if (!error) {
+			memcpy(out, b + skip, take);
+			out += take;
+			off += take;
+			len -= take;
+		}
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}

+/*
+ * 0241: /readonly/vendor/<path> from the ADT's /blueline-modemfs "files" (tools/mkadt.py --modem-fs): entries
+ * of u32 path bytes (with its NUL, rounded up to 4), u32 file bytes, the path, then the file rounded up to 4.
+ * These are the vendor image's /rfs/msm/mpss/readonly/vendor files (MCFG: mcfg.version, mbn/mcfg_hw/...).
+ */
+static bool
+t_open_vendor(struct tftp_xfer *x, const char *rel)
+{
+	DTEntry node;
+	void const *p = NULL;
+	unsigned int size = 0;
+
+	if (x->write || SecureDTLookupEntry(NULL, "/blueline-modemfs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "files", &p, &size) != kSuccess) {
+		return false;
+	}
+	const uint8_t *b = p, *end = b + size;
+	while ((size_t)(end - b) >= 8) {
+		uint32_t pl, fl;
+		memcpy(&pl, b, 4);
+		memcpy(&fl, b + 4, 4);
+		uint64_t fl4 = ((uint64_t)fl + 3) & ~3ull;
+		if (pl == 0 || (pl & 3) || (uint64_t)(end - b) < 8 + (uint64_t)pl + fl4) {
+			printf("BLUELINE WIFI: tftp: /blueline-modemfs files malformed\n");
+			return false;
+		}
+		const char *name = (const char *)(b + 8);
+		if (name[pl - 1] == 0 && strcmp(name, rel) == 0) {
+			x->src = b + 8 + pl;
+			x->size = fl;
+			return true;
+		}
+		b += 8 + pl + fl4;
+	}
+	return false;
+}

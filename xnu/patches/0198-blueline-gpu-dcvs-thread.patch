 static void
 rs_irq_attach(void)
@@ -5003,6 +5113,7 @@
 	rs.up = true;
 	rs.first_map = true;
 	rs.t_stat = rs.t_up = mach_absolute_time();
+	rs_dcvs_start();	/* 0198 */
 	if (rs.test_hang) {
 		uint64_t d;
 		nanoseconds_to_absolutetime((uint64_t)rs.test_hang * NSEC_PER_SEC, &d);
@@ -5979,7 +6090,9 @@
 	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
 	rs.cpu_ns += ns;
 	rs.cpu_max = MAX(rs.cpu_max, ns);
-	rs_dcvs_tick();
+	if (!rs.dcvs_thread) {
+		rs_dcvs_tick();
+	}
 	rs_stats();
 	return 1;
 }

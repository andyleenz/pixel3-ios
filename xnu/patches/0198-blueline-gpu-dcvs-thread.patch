+/*
+ * 0198: since 0189 iOS draws through user submits (0153), not presents, so the present-path tick
+ * never ran and the clock stayed where bluegpu_mhz left it. A thread ticks every 100 ms instead,
+ * with the ring lock (rs_recover takes it too), and every 10 s logs the time spent at each level.
+ */
+static void
+rs_dcvs_account(uint64_t now)
+{
+	uint64_t ns;
+
+	if (rs.dcvs_lvl_t) {
+		absolutetime_to_nanoseconds(now - rs.dcvs_lvl_t, &ns);
+		rs.dcvs_lvl_ns[gx.perf < GX_LEVELS ? gx.perf : 0] += ns;
+	}
+	rs.dcvs_lvl_t = now;
+}
+
+static void
+rs_dcvs_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t changes0 = 0;
+
+	for (;;) {
+		assert_wait_timeout((event_t)&rs.input_t, THREAD_UNINT, 100, NSEC_PER_MSEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);	/* 100 ms, or at once on input (blue_gpu_core_input) */
+		if (!blue_gpu_core_ready()) {
+			continue;
+		}
+		blue_gpu_ring_lock();
+		uint64_t now = mach_absolute_time(), ns;
+		rs_dcvs_account(now);
+		rs_dcvs_tick();
+		rs_dcvs_account(mach_absolute_time());
+		if (!rs.dcvs_sum_t) {
+			rs.dcvs_sum_t = now;
+		}
+		absolutetime_to_nanoseconds(now - rs.dcvs_sum_t, &ns);
+		if (ns >= 10ull * NSEC_PER_SEC) {
+			char line[160];
+			int o = 0;
+			for (int l = 1; l < GX_LEVELS; l++) {
+				o += snprintf(line + o, sizeof(line) - o, " %u:%llu%%", gpu_khz[l] / 1000,
+				    rs.dcvs_lvl_ns[l] * 100 / ns);
+				rs.dcvs_lvl_ns[l] = 0;
+			}
+			rs.dcvs_lvl_ns[0] = 0;
+			printf("BLUELINE GPU: DCVS 10s: busy %u%%, now %u MHz, %u changes, %u boosts; MHz:time%s\n", rs.busy_pct,
+			    gpu_khz[gx.perf] / 1000, rs.dcvs_changes - changes0, rs.dcvs_boosts, line);
+			rs.dcvs_boosts = 0;
+			changes0 = rs.dcvs_changes;
+			rs.dcvs_sum_t = now;
+		}
+		blue_gpu_ring_unlock();
+	}
+}
+
+static void
+rs_dcvs_start(void)
+{
+	thread_t th;
+
+	if (!rs.dcvs || rs.dcvs_thread) {
+		return;
+	}
+	if (kernel_thread_start(rs_dcvs_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("BLUELINE GPU: DCVS: no thread: ticks on presents only\n");
+		return;
+	}
+	thread_deallocate(th);
+	rs.dcvs_thread = true;
+	printf("BLUELINE GPU: DCVS: own thread, every 100 ms (0198); input boost to %d MHz for %d ms"
+	    " (bluegpu_dcvs_boost, _boost_ms), target busy %d%%\n", rs.dcvs_boost, rs.dcvs_boost_ms, rs.dcvs_target);
+}
+
+/* 0198: SweetHID on every touch event and key: note the time, wake the DCVS thread if below the boost. */
+void
+blue_gpu_core_input(void)
+{
+	__atomic_store_n(&rs.input_t, mach_absolute_time(), __ATOMIC_RELEASE);
+	if (rs.dcvs_thread && rs.dcvs_boost > 0 && gx.perf < gx_level_at(rs.dcvs_boost)) {
+		thread_wakeup((event_t)&rs.input_t);
+	}
+}
+

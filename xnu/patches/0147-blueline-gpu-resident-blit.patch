diff --git a/iokit/Kernel/arm/BlueGPUPresent.cpp b/iokit/Kernel/arm/BlueGPUPresent.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/BlueGPUPresent.cpp
@@ -0,0 +1,95 @@
+/*
+ * blueline (Pixel 3, SDM845): AppleCLCD's present through the Adreno 630's
+ * 2D engine, patch 0147 (bsd/dev/blueline_gpu.c, bluegpu=8).
+ *
+ * SweetFramebuffer.cpp's fit path calls blue_gpu_present() for each layer
+ * before its CPU copy; false means "copy with the CPU as before". This
+ * file only turns the SweetSurface into plain numbers for the C side and
+ * keeps the surfaces the GPU has mapped alive: blue_gpu_present_c names a
+ * surface to retain when it maps one into a slot and the one it evicted,
+ * which is released here (its pages are unmapped from the GPU by then).
+ * Surfaces of a hung GPU stay retained for the boot.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include "SweetSurface.h"
+
+/* Same layout as bsd/dev/blueline_gpu.c. */
+struct blue_gpu_src {
+	void *key;
+	uintptr_t kva;
+	uint64_t len;
+	uint32_t w, h, bpr, fmt, bpe, ew, eh;
+	int32_t sx, sy, dx, dy, lw, lh;
+};
+struct blue_gpu_dst {
+	uint64_t pa;
+	uint32_t w, h, stride, logical_w, logical_h;
+	int32_t fit_x, fit_w;
+};
+
+extern "C" int blue_gpu_present_c(const struct blue_gpu_src *s, const struct blue_gpu_dst *d, void **retain,
+    void **release);
+
+bool blue_gpu_present(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h,
+    uint64_t panel_pa, uint32_t panel_w, uint32_t panel_h, uint32_t panel_stride, int32_t fit_x, int32_t fit_w,
+    uint32_t logical_w, uint32_t logical_h);
+
+bool
+blue_gpu_present(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h,
+    uint64_t panel_pa, uint32_t panel_w, uint32_t panel_h, uint32_t panel_stride, int32_t fit_x, int32_t fit_w,
+    uint32_t logical_w, uint32_t logical_h)
+{
+	struct blue_gpu_src src;
+	struct blue_gpu_dst dst;
+	void *retain = NULL, *release = NULL;
+
+	/* Only kernel buffers (wired, cacheable): not physical surfaces such as the panel's own. */
+	if (s == NULL || OSDynamicCast(IOBufferMemoryDescriptor, s->memory) == NULL) {
+		return false;
+	}
+	uintptr_t base = s->kernelAddress();
+	uint64_t mlen = s->memory->getLength();
+	if (base == 0 || s->offset >= mlen) {
+		return false;
+	}
+	bzero(&src, sizeof(src));
+	src.key = s;
+	src.kva = base + s->offset;
+	src.len = mlen - s->offset;
+	src.w = s->width;
+	src.h = s->height;
+	src.bpr = s->bytesPerRow;
+	src.fmt = s->pixelFormat;
+	src.bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+	src.ew = s->elementWidth;
+	src.eh = s->elementHeight;
+	src.sx = sx;
+	src.sy = sy;
+	src.dx = dx;
+	src.dy = dy;
+	src.lw = w;
+	src.lh = h;
+	bzero(&dst, sizeof(dst));
+	dst.pa = panel_pa;
+	dst.w = panel_w;
+	dst.h = panel_h;
+	dst.stride = panel_stride;
+	dst.logical_w = logical_w;
+	dst.logical_h = logical_h;
+	dst.fit_x = fit_x;
+	dst.fit_w = fit_w;
+	int done = blue_gpu_present_c(&src, &dst, &retain, &release);
+	if (retain != NULL) {
+		((SweetSurface *)retain)->retain();
+	}
+	if (release != NULL) {
+		((SweetSurface *)release)->release();
+	}
+	return done != 0;
+}
+#endif /* SWEET */

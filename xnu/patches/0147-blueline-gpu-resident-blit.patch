+/* 0147: bluegpu=8 brings the GPU up on its own thread (boot goes on; presents use the CPU until it is up). */
+static void
+gpu_bringup_thread(void *arg, wait_result_t wr_)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+
+	(void)arg;
+	(void)wr_;
+	printf("BLUELINE GPU: resident bring-up thread started\n");
+	gpu_bringup();
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("BLUELINE GPU: resident bring-up thread done after %llu ms: %s\n", ns / 1000000,
+	    rs.up ? "GPU RESIDENT" : "not resident (everything undone as at bluegpu=7)");
+}
+
+void
+blueline_gpu_probe(void)
+{
+	int level = 0;
+	thread_t th;
+
+	(void)PE_parse_boot_argn("bluegpu", &level, sizeof(level));
+	if (level < 8) {
+		gpu_bringup();
+		return;
+	}
+	rs_prepare();
+	gx_resident = true;
+	if (kernel_thread_start(gpu_bringup_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("BLUELINE GPU: no bring-up thread: resident bring-up skipped, CPU presents\n");
+		rs.req = false;
+		return;
+	}
+	thread_deallocate(th);
+}

+/*
+ * kern.bluesnap (read): the screen now, for the Mac over the USB link (tools/bluesh.py snap): a struct
+ * bluesnap_header (index 0, why "live") then the pixels, as one snap in the area. Needs no UFS area: works on
+ * any boot. Scale and bpp as bluesnap_scale= / bluesnap_bpp= (2 and 16 by default).
+ */
+static int
+sysctl_bluesnap SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	uintptr_t px, fpx;
+	uint32_t w, h, stride, ow, oh, fw, fh, fbpr, ms;
+	int32_t sb_ms, fit_x, fit_w;
+	int error;
+
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	if (!blue_fb_snapinfo(&px, &w, &h, &stride) || w < 4 || h < 4) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&bluesnap_lock);
+	if (bs.scale == 0) {
+		bs.scale = 2;
+		bs.bpp = 16;
+	}
+	uint32_t need_bytes = (w / bs.scale) * (h / bs.scale) * (bs.bpp / 8);
+	if (req->oldptr == USER_ADDR_NULL) {
+		lck_mtx_unlock(&bluesnap_lock);
+		return SYSCTL_OUT(req, NULL, sizeof(struct bluesnap_header) + need_bytes);
+	}
+	vm_size_t want = round_page((vm_size_t)((need_bytes + 63u) & ~63u) + (vm_size_t)bs.scale * w * 4);
+	if (bs.bufsize < want) {
+		if (bs.buf) {
+			kmem_free(kernel_map, bs.buf, bs.bufsize);
+			bs.buf = 0;
+			bs.bufsize = 0;
+		}
+		if (kmem_alloc(kernel_map, &bs.buf, want, KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			bs.buf = 0;
+			lck_mtx_unlock(&bluesnap_lock);
+			return ENOMEM;
+		}
+		bs.bufsize = want;
+	}
+	blue_when_now(&ms, &sb_ms);
+	bool flipped = blue_dpu_snapinfo(&fpx, &fw, &fh, &fbpr, &fit_x, &fit_w) != 0;
+	uint32_t bytes = flipped ? bluesnap_convert_flipped(fpx, fw, fh, fbpr, fit_x, fit_w, w, h, &ow, &oh) :
+	    bluesnap_convert(px, w, h, stride, &ow, &oh);
+	struct bluesnap_header hd = {
+		.magic = { 'B', 'L', 'U', 'E', 'S', 'N', 'A', 'P' },
+		.nonce = 0, .version = 1, .index = 0, .width = ow, .height = oh,
+		.bpp = bs.bpp, .scale = bs.scale, .bytes = bytes, .ms = ms, .sb_ms = sb_ms,
+		.src_w = w, .src_h = h,
+	};
+	strlcpy(hd.why, "live", sizeof(hd.why));
+	error = SYSCTL_OUT(req, &hd, sizeof(hd));
+	if (!error) {
+		error = SYSCTL_OUT(req, (const void *)bs.buf, bytes);
+	}
+	lck_mtx_unlock(&bluesnap_lock);
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, bluesnap, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0, sysctl_bluesnap,
+    "S", "the screen now (struct bluesnap_header, then the pixels)");
+

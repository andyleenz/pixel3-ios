+/*
+ * kern.bluetouch (write a script, as bluetouchscript=, at most 1023 bytes): run it now, on a thread of its own,
+ * for driving the running phone from the Mac (tools/bluesh.py touch). Steps with time 0 run one after another at
+ * once; "wait,MS" spaces them. Writes while one runs are refused (EBUSY).
+ */
+static volatile uint32_t touch_live_busy;
+static void
+touchscript_live_thread(void *arg, wait_result_t wr)
+{
+	touchscript_thread(arg, wr);
+	kfree_data(arg, 1024);
+	touch_live_busy = 0;
+}
+
+static int
+sysctl_bluetouch SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2, oidp)
+	char *script;
+	thread_t thread;
+	int error;
+
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, "", 1);
+	}
+	if (req->newlen == 0 || req->newlen > 1023) {
+		return EINVAL;
+	}
+	if (!os_atomic_cmpxchg(&touch_live_busy, 0, 1, acq_rel)) {
+		return EBUSY;
+	}
+	script = kalloc_data(1024, Z_WAITOK | Z_ZERO);
+	if (script == NULL) {
+		touch_live_busy = 0;
+		return ENOMEM;
+	}
+	error = SYSCTL_IN(req, script, req->newlen);
+	if (error != 0 || kernel_thread_start(touchscript_live_thread, script, &thread) != KERN_SUCCESS) {
+		kfree_data(script, 1024);
+		touch_live_busy = 0;
+		return error != 0 ? error : ENOMEM;
+	}
+	thread_deallocate(thread);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, bluetouch, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_bluetouch,
+    "A", "run a touch script now (bluetouchscript= syntax)");
 

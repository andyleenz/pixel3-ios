+	bool pmicRead(const char *what, uint16_t ppid, uint8_t off, uint8_t *buf, unsigned len,
+	    bool trace);
+	bool readAll(BlueBattReading *r, bool trace);
+	bool refresh(void);
+	void publish(const BlueBattReading *r);
+	void armRefresh(void);
+	static void refreshCallout(thread_call_param_t p0, thread_call_param_t p1);
+
+	thread_call_t refreshCall;
+	uint32_t refreshSecs, logCount, refreshCount, errorCount;
+	bool dry, swapVI, logged;

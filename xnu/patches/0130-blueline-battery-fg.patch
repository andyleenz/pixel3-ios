+/* IOPMCopyBatteryInfo's per-source compatibility dictionary */
+void
+BlueBattery::putLegacy(UInt32 mah, UInt32 mV, SInt32 mA, UInt32 flags)
+{
+	OSDictionary *legacy = OSDictionary::withCapacity(6);
+	if (!legacy) {
+		return;
+	}
+	const char *keys[] = { kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+		               kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+		               kIOBatteryFlagsKey };
+	UInt32 values[] = { mah, BLUE_BATTERY_MAH, mV, (UInt32)mA, 0, flags };
+	for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+		OSNumber *number = OSNumber::withNumber(values[i], 32);
+		if (number) {
+			legacy->setObject(keys[i], number);
+			number->release();
+		}
+	}
+	setLegacyIOBatteryInfo(legacy);
+	legacy->release();
+}
+
+/* One read; logs before the access when tracing, and (rate-limited) failures. */
+bool
+BlueBattery::pmicRead(const char *what, uint16_t ppid, uint8_t off, uint8_t *buf, unsigned len,
+    bool trace)
+{
+	uint16_t addr = (uint16_t)(((ppid & 0xffu) << 8) | off);
+
+	if (trace) {
+		IOLog("BLUELINE BATTERY: about to read %s, SID %u 0x%04x, %u byte(s)\n", what,
+		    ppid >> 8, addr, len);
+	}
+	int error = blueline_spmi_read_sid((uint8_t)(ppid >> 8), addr, buf, len);
+	if (error) {
+		errorCount++;
+		if (errorCount <= 5 || (errorCount % 100) == 0) {
+			IOLog("BLUELINE BATTERY: read %s (SID %u 0x%04x) failed: error %d "
+			    "(%u errors)\n", what, ppid >> 8, addr, error, errorCount);
+		}
+		return false;
+	}
+	return true;
+}
+
+/* PMIC identity and arbiter channels; false keeps the static battery. */
+bool
+BlueBattery::pmicSetup(void)
+{
+	static const struct {
+		const char *name;
+		uint16_t ppid;
+	} periph[] = {
+		{ "REVID", PMI_REVID }, { "SCHG_CHGR", PMI_CHGR }, { "SCHG_USB", PMI_USBIN },
+		{ "SCHG_DC", PMI_DCIN }, { "SCHG_MISC", PMI_MISC }, { "FG_BATT_SOC", PMI_FG_SOC },
+		{ "FG_BATT_INFO", PMI_FG_INFO },
+	};
+	bool fgOk = true;
+
+	for (unsigned i = 0; i < sizeof(periph) / sizeof(periph[0]); i++) {
+		uint16_t apid;
+		uint8_t owner;
+		int error = blueline_spmi_apid((uint8_t)(periph[i].ppid >> 8),
+		    (uint8_t)(periph[i].ppid & 0xffu), &apid, &owner);
+		if (error) {
+			IOLog("BLUELINE BATTERY: %s PPID %#x: no APID\n", periph[i].name, periph[i].ppid);
+		} else {
+			IOLog("BLUELINE BATTERY: %s PPID %#x: APID %u, owner EE %u%s\n", periph[i].name,
+			    periph[i].ppid, apid, owner, owner ? " (not apps; reads still work)" : "");
+		}
+		if (error && (periph[i].ppid == PMI_REVID || periph[i].ppid == PMI_FG_SOC ||
+		    periph[i].ppid == PMI_FG_INFO)) {
+			fgOk = false;
+		}
+	}
+	if (!fgOk) {
+		IOLog("BLUELINE BATTERY: REVID or fuel gauge not reachable; static battery\n");
+		return false;
+	}
+	uint8_t rev[3] = { 0, 0, 0 };	/* REVISION4, TYPE, SUBTYPE */
+	if (!pmicRead("REVID", PMI_REVID, 0x03, rev, 3, true)) {
+		IOLog("BLUELINE BATTERY: REVID read failed; static battery\n");
+		return false;
+	}
+	if (rev[2] != PMI8998_SUBTYPE) {
+		IOLog("BLUELINE BATTERY: SID 2 REVID rev4 %#x type %#x subtype %#x is not a "
+		    "PMI8998 (0x15); static battery\n", rev[0], rev[1], rev[2]);
+		return false;
+	}
+	/* qpnp-fg-gen3 PMI8998_V1_REV_WA: VBATT/IBATT LSB and MSB swapped before v2.0 */
+	swapVI = rev[0] < PMI8998_V2P0_REV4;
+	IOLog("BLUELINE BATTERY: PMI8998 rev4 %#x type %#x%s\n", rev[0], rev[1],
+	    swapVI ? " (v1: VBATT/IBATT bytes swapped)" : "");
+	return true;
+}
+
+static const char *const chgStateName[8] = {
+	"trickle", "pre-charge", "fast", "full-on", "taper", "terminated", "inhibited", "disabled",
+};
+
+bool
+BlueBattery::readAll(BlueBattReading *r, bool trace)
+{
+	bzero(r, sizeof(*r));
+
+	/*
+	 * MONOTONIC_SOC and its shadow copy: retry until both agree (qpnp-fg-gen3
+	 * fg_get_msoc_raw(), 5 tries); else take the lower (mainline qcom_fg).
+	 */
+	unsigned tries = 0;
+	do {
+		if (!pmicRead("FG MONOTONIC_SOC", PMI_FG_SOC, 0x09, r->soc, 2, trace && tries == 0)) {
+			return false;
+		}
+	} while (r->soc[0] != r->soc[1] && ++tries < 5);
+	if (!pmicRead("FG_BATT_SOC INT_RT_STS", PMI_FG_SOC, 0x10, &r->socRt, 1, trace) ||
+	    !pmicRead("FG BATT_TEMP_STS/SYS_BATT", PMI_FG_INFO, 0x06, r->infoSts, 2, trace) ||
+	    !pmicRead("FG_BATT_INFO INT_RT_STS", PMI_FG_INFO, 0x10, &r->infoRt, 1, trace) ||
+	    !pmicRead("FG BATT_TEMP", PMI_FG_INFO, 0x50, r->temp, 2, trace) ||
+	    !pmicRead("FG VBATT/IBATT", PMI_FG_INFO, 0xa0, r->vi, 4, trace) ||
+	    !pmicRead("SCHG BATTERY_CHARGER_STATUS_1/2", PMI_CHGR, 0x06, r->chg, 2, trace) ||
+	    !pmicRead("SCHG USBIN INT_RT_STS", PMI_USBIN, 0x10, &r->usbin, 1, trace) ||
+	    !pmicRead("SCHG DCIN INT_RT_STS", PMI_DCIN, 0x10, &r->dcin, 1, trace) ||
+	    !pmicRead("SCHG ICL_STATUS", PMI_MISC, 0x07, &r->icl, 1, trace) ||
+	    !pmicRead("SCHG POWER_PATH_STATUS", PMI_MISC, 0x0b, &r->path, 1, trace)) {
+		return false;
+	}
+
+	/* 0 and 255 are 0 % and 100 %, 1..254 scale to 1..99 (fg_get_msoc()) */
+	unsigned raw = r->soc[0] < r->soc[1] ? r->soc[0] : r->soc[1];
+	r->percent = raw == 255 ? 100 : raw == 0 ? 0 : ((raw - 1) * 98 + 126) / 253 + 1;
+
+	/* 11 bits, 0.25 K -> deci-degrees C, rounded (fg_get_battery_temp()) */
+	int t = ((r->temp[1] & 0x07) << 8) | r->temp[0];
+	int x = (t - 273 * 4) * 10;
+	r->deciC = x >= 0 ? (x + 2) / 4 : (x - 2) / 4;
+
+	uint8_t vlo = swapVI ? r->vi[1] : r->vi[0], vhi = swapVI ? r->vi[0] : r->vi[1];
+	uint8_t ilo = swapVI ? r->vi[3] : r->vi[2], ihi = swapVI ? r->vi[2] : r->vi[3];
+	uint64_t vraw = (uint64_t)((vhi << 8) | vlo);
+	r->mV = (unsigned)(vraw * 122070u / 1000000u);
+	int64_t iraw = (int16_t)(uint16_t)((ihi << 8) | ilo);
+	r->mA = (int)(iraw * 488281 / 1000000);
+
+	r->chgState = r->chg[0] & 0x07u;
+	r->plugged = ((r->usbin | r->dcin) & PLUGIN_RT_STS_BIT) != 0;
+	/* qcom_smbx smb_get_prop_status(): 0..4 charging, 5/6 full, 7 not charging */
+	r->charging = r->plugged && r->chgState <= 4 && !(r->chg[1] & BAT_OV_STS_BIT);
+	r->full = r->plugged && (r->chgState == 5 || r->chgState == 6);
+	return true;
+}
+
+void
+BlueBattery::publish(const BlueBattReading *r)
+{
+	/* Rounded up, so powerd's CurrentCapacity / MaxCapacity gives r->percent back. */
+	UInt32 mah = (r->percent * BLUE_BATTERY_MAH + 99) / 100;
+	SInt32 amperage = -r->mA;	/* Apple sign: negative = discharging */
+	UInt32 flags = kIOBatteryInstalled;
+
+	if (r->plugged) {
+		flags |= kIOBatteryChargerConnect;
+	}
+	if (r->charging) {
+		flags |= kIOBatteryCharge;
+	}
+	setCurrentCapacity(mah);
+	setMaxCapacity(BLUE_BATTERY_MAH);
+	setExternalConnected(r->plugged);
+	setExternalChargeCapable(r->plugged);
+	setIsCharging(r->charging);
+	setAtWarnLevel(!r->plugged && r->percent <= 10);
+	setAtCriticalLevel(!r->plugged && r->percent <= 5);
+	setVoltage(r->mV);
+	setAmperage(amperage);
+	putBool("FullyCharged", r->full || (r->plugged && r->percent == 100 && !r->charging));
+	putBool("AppleRawExternalConnected", r->plugged);
+	putNumber("AppleRawCurrentCapacity", mah);
+	putNumber("InstantAmperage", (UInt32)amperage);
+	putNumber("Temperature", (UInt32)(r->deciC * 10));	/* centidegrees */
+	putLegacy(mah, r->mV, amperage, flags);
+	updateStatus();
+}
+
+bool
+BlueBattery::refresh(void)
+{
+	BlueBattReading r;
+	bool trace = refreshCount == 0;
+	unsigned n = ++refreshCount;
+
+	if (!readAll(&r, trace)) {
+		return false;
+	}
+	bool missing = (r.infoRt & BT_MISS_RT_STS_BIT) != 0;
+	bool sane = !missing && r.mV >= 2500 && r.mV <= 4800 && r.deciC > -400 && r.deciC < 900;
+	bool changed = !logged || r.percent != lastPercent || r.plugged != lastPlugged ||
+	    r.charging != lastCharging || r.full != lastFull;
+	int absDeci = r.deciC < 0 ? -r.deciC : r.deciC;
+
+	if (n <= logCount) {
+		IOLog("BLUELINE BATTERY: #%u raw soc %02x/%02x rt %02x | info sts %02x sys %02x rt %02x "
+		    "temp %02x %02x v/i %02x %02x %02x %02x | chg %02x %02x usbin %02x dcin %02x "
+		    "icl %02x path %02x\n", n, r.soc[0], r.soc[1], r.socRt, r.infoSts[0], r.infoSts[1],
+		    r.infoRt, r.temp[0], r.temp[1], r.vi[0], r.vi[1], r.vi[2], r.vi[3], r.chg[0],
+		    r.chg[1], r.usbin, r.dcin, r.icl, r.path);
+	}
+	if (n <= logCount || changed || !sane) {
+		IOLog("BLUELINE BATTERY: #%u %u%% %u mV %d mA (FG, + = discharging) %s%d.%d C, "
+		    "%s%s, charger %s%s%s%s\n", n, r.percent, r.mV, r.mA, r.deciC < 0 ? "-" : "",
+		    absDeci / 10, absDeci % 10, (r.usbin & PLUGIN_RT_STS_BIT) ? "USB in" : "USB out",
+		    (r.dcin & PLUGIN_RT_STS_BIT) ? ", wireless in" : "", chgStateName[r.chgState],
+		    r.charging ? ", charging" : "", r.full ? ", full" : "",
+		    !sane ? (missing ? ", BATTERY MISSING: not published" :
+		    ", implausible: not published") : dry ? " (dry run: static values kept)" : "");
+	}
+	if (!sane) {
+		return false;
+	}
+	logged = true;
+	lastPercent = r.percent;
+	lastPlugged = r.plugged;
+	lastCharging = r.charging;
+	lastFull = r.full;
+	if (!dry) {
+		publish(&r);
+	}
+	return true;
+}
+
+void
+BlueBattery::armRefresh(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(refreshSecs, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(refreshCall, deadline);
+}
+
+void
+BlueBattery::refreshCallout(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	BlueBattery *self = (BlueBattery *)p0;
+	self->refresh();
+	self->armRefresh();
+}

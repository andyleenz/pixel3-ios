 /*
- * Pixel 3 (blueline) battery for iOS, static for now: 100 %, on external
+ * Pixel 3 (blueline) battery for iOS. By default static: 100 %, on external
  * power, full, not charging (2915 mAh, the Pixel 3's design capacity).
  * Without any IOPMPowerSource iOS shows an empty battery and no percentage.
- * Nothing is read from the PMIC yet (PMI8998 fuel gauge: later). Pattern as
- * ios-sweet's SweetBattery (0062): matched on IOResources, the complete
- * source published before registerService() wakes powerd.
+ * Pattern as ios-sweet's SweetBattery (0062): matched on IOResources, the
+ * complete source published before registerService() wakes powerd.
+ *
+ * Boot-arg bluebatt=1 (patch 0130): real values from the PMI8998 (SPMI SID 2),
+ * read-only, through blueline_spmi_read_sid() (bsd/dev/blueline_keys.c), at start
+ * and then every bluebatt_secs (default 30) seconds:
+ *   FG_BATT_SOC  0x4000: MONOTONIC_SOC 0x4009 (+ shadow copy 0x400a), the
+ *                        percentage Linux's qpnp-fg-gen3 reports
+ *   FG_BATT_INFO 0x4100: BATT_TEMP 0x4150/51 (0.25 K), VBATT 0x41a0/a1
+ *                        (122.07 uV), IBATT 0x41a2/a3 (488.281 uA, signed,
+ *                        positive = discharging); LSB/MSB swapped on v1.x
+ *   SCHG         0x1000: BATTERY_CHARGER_STATUS_1/2 0x1006/07 (charge state),
+ *                        USBIN/DCIN INT_RT_STS 0x1310/0x1410 bit 4 (plugged)
+ * No FG SRAM (memif) access, nothing written, no interrupts. Boot-args:
+ * bluebatt_secs=N (10..600), bluebatt_log=N (full logs for the first N
+ * reads, default 5; then one line when %, plug or charge state changes),
+ * bluebatt_dry=1 (read and log, but keep publishing the static values).
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <IOKit/IOLib.h>
 #include <IOKit/pwr_mgt/IOPMPowerSource.h>
 #include <libkern/c++/OSCollectionIterator.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <pexpert/pexpert.h>
 
 #define BLUE_BATTERY_MAH	2915u
 
+/* bsd/dev/blueline_keys.c (0129 observer-channel reads; SID argument from 0130) */
+extern "C" int blueline_spmi_read_sid(uint8_t sid, uint16_t addr, uint8_t *buf, unsigned len);
+extern "C" int blueline_spmi_apid(uint8_t sid, uint8_t periph, uint16_t *apid, uint8_t *owner);
+
+/* PMI8998 peripherals, PPID = (SID 2 << 8) | peripheral */
+#define PMI_REVID		0x201u	/* REVISION4 0x03, TYPE 0x04, SUBTYPE 0x05 */
+#define PMI_CHGR		0x210u	/* BATTERY_CHARGER_STATUS_1 0x06, _2 0x07 */
+#define PMI_USBIN		0x213u	/* INT_RT_STS 0x10 */
+#define PMI_DCIN		0x214u	/* INT_RT_STS 0x10 (wireless charger input) */
+#define PMI_MISC		0x216u	/* ICL_STATUS 0x07, POWER_PATH_STATUS 0x0b */
+#define PMI_FG_SOC		0x240u	/* MONOTONIC_SOC 0x09/0x0a, INT_RT_STS 0x10 */
+#define PMI_FG_INFO		0x241u	/* TEMP_STS 0x06, SYS_BATT 0x07, INT_RT_STS 0x10, ... */
+#define PMI8998_SUBTYPE		0x15u	/* qcom-spmi-pmic.c: PM8998 0x14, PMI8998 0x15 */
+#define PMI8998_V2P0_REV4	0x02u
+
+#define PLUGIN_RT_STS_BIT	0x10u	/* USBIN/DCIN INT_RT_STS */
+#define BT_MISS_RT_STS_BIT	0x08u	/* FG_BATT_INFO INT_RT_STS */
+#define BAT_OV_STS_BIT		0x20u	/* BATTERY_CHARGER_STATUS_2 */
+
+struct BlueBattReading {
+	uint8_t soc[2], socRt, infoSts[2], infoRt, temp[2], vi[4], chg[2], usbin, dcin, icl, path;
+	unsigned percent, mV, chgState;
+	int mA;			/* FG sign: positive = out of the battery */
+	int deciC;
+	bool plugged, charging, full;
+};

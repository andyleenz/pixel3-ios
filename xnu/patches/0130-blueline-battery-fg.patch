Subject: [PATCH] 0130: battery state from the PMI8998 fuel gauge (bluebatt=1)

---
 bsd/dev/blueline_keys.c          |  37 +++-
 iokit/Kernel/arm/BlueBattery.cpp | 360 +++++++++++++++++++++++++++++--
 2 files changed, 372 insertions(+), 25 deletions(-)

diff --git a/bsd/dev/blueline_keys.c b/bsd/dev/blueline_keys.c
index 0095799..30d50fc 100644
--- a/bsd/dev/blueline_keys.c
+++ b/bsd/dev/blueline_keys.c
@@ -35,6 +35,8 @@ extern void sweet_hid_key(int key, int down);
 void blueline_keys_init(void);
 int blueline_pon_set_reboot_reason(uint8_t reason, uint8_t *before, uint8_t *after);
 int blueline_spmi_read(uint16_t addr, uint8_t *buf, unsigned len);
+int blueline_spmi_read_sid(uint8_t sid, uint16_t addr, uint8_t *buf, unsigned len);
+int blueline_spmi_apid(uint8_t sid, uint8_t periph, uint16_t *apid, uint8_t *owner);
 
 #define ARB_CORE_PA	0x0c440000u	/* version, features, APID -> PPID map */
 #define ARB_OBS_PA	0x0e600000u	/* read-only observer channels */
@@ -216,24 +218,25 @@ blueline_pon_set_reboot_reason(uint8_t reason, uint8_t *before, uint8_t *after)
 }
 
 /*
- * Read len (1..4) registers of PMIC SID 0 starting at addr (peripheral =
- * addr >> 8, PPID = addr >> 8 for SID 0), through the observer channel and
+ * Read len (1..4) registers of PMIC slave sid starting at addr (peripheral =
+ * addr >> 8, PPID = (sid << 8) | peripheral), through the observer channel and
  * under the arbiter lock. Read-only: no ownership needed. Thread context
  * only (takes a mutex). 0, or EINVAL / ENXIO (no arbiter, peripheral not in
  * the APID table) / EIO (no answer, or an error status).
+ * blueline_spmi_read() is SID 0 (PM8998); 0130 adds SID 2 (PMI8998).
  */
 int
-blueline_spmi_read(uint16_t addr, uint8_t *buf, unsigned len)
+blueline_spmi_read_sid(uint8_t sid, uint16_t addr, uint8_t *buf, unsigned len)
 {
 	static uint16_t last_ppid = NO_APID, last_apid = NO_APID;
 
-	if (!buf || len < 1 || len > 4 || ((addr & 0xffu) + len) > 0x100u) {
+	if (!buf || sid > 0xfu || len < 1 || len > 4 || ((addr & 0xffu) + len) > 0x100u) {
 		return EINVAL;
 	}
 	if (!arb_setup()) {
 		return ENXIO;
 	}
-	uint16_t ppid = addr >> 8;
+	uint16_t ppid = (uint16_t)(((unsigned)sid << 8) | (addr >> 8));
 	lck_mtx_lock(&blueline_arb_lock);
 	if (ppid != last_ppid) {
 		last_apid = arb_apid(ppid, arb_count);
@@ -248,6 +251,30 @@ blueline_spmi_read(uint16_t addr, uint8_t *buf, unsigned len)
 	return ok ? 0 : EIO;
 }
 
+int
+blueline_spmi_read(uint16_t addr, uint8_t *buf, unsigned len)
+{
+	return blueline_spmi_read_sid(0, addr, buf, len);
+}
+
+/* APID of PPID (sid << 8) | periph and its owner EE (0 = apps), for logs. 0 or ENXIO. */
+int
+blueline_spmi_apid(uint8_t sid, uint8_t periph, uint16_t *apid, uint8_t *owner)
+{
+	*apid = NO_APID;
+	*owner = 0xff;
+	if (sid > 0xfu || !arb_setup()) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&blueline_arb_lock);
+	*apid = arb_apid((uint16_t)(((unsigned)sid << 8) | periph), arb_count);
+	if (*apid != NO_APID) {
+		*owner = (uint8_t)(arb_rd(arb_cnfg, 0x700u + 4u * *apid) & 7u);
+	}
+	lck_mtx_unlock(&blueline_arb_lock);
+	return *apid == NO_APID ? ENXIO : 0;
+}

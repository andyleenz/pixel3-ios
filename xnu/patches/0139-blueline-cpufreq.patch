+
+static void
+tsens_dump(const char *when)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("bluecpu_tsens", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	bool first = !tm[0];
+	if (first) {
+		printf(TAG "about to map/read TSENS TM %#x %#x SROT %#x %#x\n", TSENS0_TM, TSENS1_TM,
+		    TSENS0_SROT, TSENS1_SROT);
+		tm[0] = ml_io_map(TSENS0_TM, 0x200);
+		tm[1] = ml_io_map(TSENS1_TM, 0x200);
+		srot[0] = ml_io_map(TSENS0_SROT, 0x100);
+		srot[1] = ml_io_map(TSENS1_SROT, 0x100);
+		if (!tm[0] || !tm[1] || !srot[0] || !srot[1]) {
+			printf(TAG "TSENS map failed\n");
+			tm[0] = 0;
+			return;
+		}
+	}
+	for (uint32_t t = 0; t < 2; t++) {
+		char line[256];
+		int n = snprintf(line, sizeof(line), TAG "tsens%u %s (C):", t, when);
+		for (uint32_t s = 0; s < tsens_n[t] && n > 0 && n < (int)sizeof(line); s++) {
+			uint32_t st = rd(tm[t], TM_STATUS + 4 * s);
+			int dc = (int)(st & 0xfffu);
+			if (dc & 0x800) {
+				dc -= 0x1000;		/* 12-bit signed, 0.1 C */
+			}
+			int a = dc < 0 ? -dc : dc;
+			n += snprintf(line + n, sizeof(line) - (size_t)n, (st >> 21) & 1u ?
+			    " s%u %s%d.%d%s" : " s%u ?", s, dc < 0 ? "-" : "", a / 10, a % 10,
+			    (st >> 19) & 1u ? "!" : "");
+		}
+		printf("%s\n", line);
+		if (first) {
+			char th[256];
+			int m = snprintf(th, sizeof(th), TAG "tsens%u SROT_CTRL %#x INT_EN %#x "
+			    "CRIT_INT_MASK %#x crit thresholds:", t, rd(srot[t], SROT_CTRL),
+			    rd(tm[t], TM_INT_EN), rd(tm[t], TM_CRIT_INT_MASK));
+			for (uint32_t s = 0; s < tsens_n[t] && m > 0 && m < (int)sizeof(th); s++) {
+				m += snprintf(th + m, sizeof(th) - (size_t)m, " %#x",
+				    rd(tm[t], TM_CRIT_THRESH + 4 * s) & 0xfffu);
+			}
+			printf("%s\n", th);
+		}
+	}
+	if (first) {
+		printf(TAG "tsens0 sensors: cpu0-3 = s1-s4, cpu4-7 = s7-s10 (mainline thermal "
+		    "zones); '!' = critical status\n");
+	}
+}

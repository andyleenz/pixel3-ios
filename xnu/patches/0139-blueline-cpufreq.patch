+/* ---- loop timing on a bound core ---- */
+
+#define LOOP_ITERS	65536u
+#define ADDS_PER_ITER	64u
+
+struct meas {
+	int cpu;
+	volatile int done;
+	int ran_on;
+	uint64_t mpidr, midr, ticks;
+	uint32_t osm_cycles;
+	bool have_cycles;
+};
+static struct meas meas_slot[8];
+static uint32_t meas_used;
+static volatile uint64_t meas_sink;
+
+/* 64 dependent adds per iteration: one add per cycle on Kryo 385 Gold and Silver. */
+static uint64_t __attribute__((noinline))
+add_chain(uint64_t iters)
+{
+	uint64_t x = 0;
+	__asm__ volatile (
+		"1:\n"
+		".rept 64\n"
+		"add %0, %0, #1\n"
+		".endr\n"
+		"subs %1, %1, #1\n"
+		"b.ne 1b\n"
+		: "+r"(x), "+r"(iters) :: "cc");
+	return x;
+}
+
+static void
+meas_thread(void *arg, wait_result_t wr __unused)
+{
+	struct meas *m = arg;
+	processor_t prev = thread_bind(cpu_to_processor(m->cpu));
+	thread_block(THREAD_CONTINUE_NULL);		/* migrate to the bound core */
+
+	uint64_t best = UINT64_MAX;
+	for (int r = 0; r < 3; r++) {
+		boolean_t s = ml_set_interrupts_enabled(FALSE);
+		int c = cpu_number();
+		const struct osm_dom *d = &doms[c < 4 ? D_SILVER : D_GOLD];
+		vm_offset_t cyc = 0;
+		if (d->base) {
+			cyc = d->base + REG_CYCLES + (d->per_core ? 4u * ((uint32_t)c & 3u) : 0u);
+		}
+		uint32_t c0 = cyc ? *(volatile uint32_t *)cyc : 0;
+		uint64_t t0 = cntvct();
+		meas_sink += add_chain(LOOP_ITERS);
+		uint64_t t1 = cntvct();
+		uint32_t c1 = cyc ? *(volatile uint32_t *)cyc : 0;
+		uint64_t mpidr, midr;
+		__asm__ volatile ("mrs %0, mpidr_el1" : "=r"(mpidr));
+		__asm__ volatile ("mrs %0, midr_el1" : "=r"(midr));
+		ml_set_interrupts_enabled(s);
+		if (t1 - t0 < best) {
+			best = t1 - t0;
+			m->ran_on = c;
+			m->mpidr = mpidr;
+			m->midr = midr;
+			m->osm_cycles = c1 - c0;
+			m->have_cycles = cyc != 0;
+		}
+	}
+	m->ticks = best;
+	thread_bind(prev);
+	__asm__ volatile ("dmb ish" ::: "memory");
+	m->done = 1;
+}
+
+static void
+measure(int cpu, const char *when)
+{
+	if (cpu < 0 || (unsigned)cpu >= ml_get_cpu_count() || cpu_to_processor(cpu) == PROCESSOR_NULL) {
+		printf(TAG "%s: cpu%d not running (%u cpus); not measured\n", when, cpu,
+		    ml_get_cpu_count());
+		return;
+	}
+	if (meas_used >= sizeof(meas_slot) / sizeof(meas_slot[0])) {
+		return;
+	}
+	struct meas *m = &meas_slot[meas_used++];
+	m->cpu = cpu;
+	printf(TAG "%s: timing %u dependent adds on cpu%d (bound thread)\n", when,
+	    LOOP_ITERS * ADDS_PER_ITER, cpu);
+	thread_t th;
+	if (kernel_thread_start(meas_thread, m, &th) != KERN_SUCCESS) {
+		printf(TAG "%s: kernel_thread_start failed\n", when);
+		return;
+	}
+	thread_deallocate(th);
+	for (int ms = 0; ms < 2000 && !m->done; ms++) {
+		delay(1000);
+	}
+	if (!m->done) {
+		printf(TAG "%s: cpu%d measurement timed out after 2 s (thread left bound)\n", when, cpu);
+		return;
+	}
+	uint64_t adds = (uint64_t)LOOP_ITERS * ADDS_PER_ITER;
+	uint64_t mhz10 = m->ticks ? adds * 192u / m->ticks : 0;	/* adds * 19.2 MHz / ticks, x10 */
+	uint64_t osm10 = m->ticks ? (uint64_t)m->osm_cycles * 192u / m->ticks : 0;
+	uint32_t part = (uint32_t)(m->midr >> 4) & 0xfffu;
+	printf(TAG "%s: cpu%d ran on cpu%d MPIDR %#llx MIDR %#llx (%s): %llu ticks of 19.2 MHz "
+	    "= %llu.%llu MHz by the add loop; OSM cycle counter %s%u = %llu.%llu MHz\n", when,
+	    cpu, m->ran_on, m->mpidr, m->midr, part == 0x802 ? "Kryo 385 Gold" :
+	    part == 0x803 ? "Kryo 385 Silver" : "?", m->ticks, mhz10 / 10, mhz10 % 10,
+	    m->have_cycles ? "+" : "(unmapped) ", m->osm_cycles, osm10 / 10, osm10 % 10);
+}
+
+/* ---- requests (bluecpu=2) ---- */
+
+struct undo {
+	bool valid;
+	uint32_t n, old[4];
+};
+static struct undo undo_log[D_COUNT];
+
+static void
+osm_request(uint32_t di, uint32_t idx, bool mxok)
+{
+	struct osm_dom *d = &doms[di];
+	if (!d->base || !d->enabled) {
+		printf(TAG "%s: not enabled; no request\n", d->name);
+		return;
+	}
+	if (idx >= d->rows) {
+		printf(TAG "%s: index %u out of range (%u levels); no request\n", d->name, idx, d->rows);
+		return;
+	}
+	struct osm_level *l = &d->lut[idx];
+	uint32_t cur_khz = osm_cur_lval(d) * XO_KHZ;
+	if (d->mx_turbo_khz && l->khz >= d->mx_turbo_khz && cur_khz < d->mx_turbo_khz && !mxok) {
+		printf(TAG "%s: level %u (%u MHz) needs MX at TURBO (downstream votes it; running "
+		    "%u MHz now); skipped, bluecpu_mxok=1 to force\n", d->name, idx, l->khz / 1000u,
+		    cur_khz / 1000u);
+		return;
+	}
+	struct undo *u = &undo_log[di];
+	u->n = (d->per_core && di != D_L3) ? 4u : 1u;
+	for (uint32_t i = 0; i < u->n; i++) {
+		u->old[i] = rd(d->base, REG_PERF_STATE + 4 * i);
+	}
+	u->valid = true;
+	printf(TAG "%s: about to write PERF_STATE %#x (x%u) = %u (%u MHz, cores %u, %u mV), was %u\n",
+	    d->name, d->pa + REG_PERF_STATE, u->n, idx, l->khz / 1000u, l->cores, l->mv, u->old[0]);
+	for (uint32_t i = 0; i < u->n; i++) {
+		wr(d->base, REG_PERF_STATE + 4 * i, idx);
+	}
+	uint32_t us = 0, lv = osm_cur_lval(d);
+	while (lv != l->lval && us < 5000) {
+		delay(50);
+		us += 50;
+		lv = osm_cur_lval(d);
+	}
+	printf(TAG "%s: running L_VAL %u (%u MHz) after %u us: %s; readback PERF_STATE %u, "
+	    "CURRENT_VOTE limit %u MHz\n", d->name, lv, lval_mhz(lv), us,
+	    lv == l->lval ? "reached" : "NOT reached in 5 ms", rd(d->base, REG_PERF_STATE),
+	    lval_mhz(rd(d->base, REG_CURRENT_VOTE) & 0x3ffu));
+}
+
+static void
+osm_undo(void)
+{
+	for (int di = D_COUNT - 1; di >= 0; di--) {
+		struct undo *u = &undo_log[di];
+		if (!u->valid) {
+			continue;
+		}
+		for (int i = (int)u->n - 1; i >= 0; i--) {
+			wr(doms[di].base, REG_PERF_STATE + 4u * (uint32_t)i, u->old[i]);
+		}
+		delay(1000);
+		printf(TAG "%s: undo: PERF_STATE back to %u, running L_VAL %u (%u MHz)\n",
+		    doms[di].name, u->old[0], osm_cur_lval(&doms[di]),
+		    lval_mhz(osm_cur_lval(&doms[di])));
+	}
+}
+
+static void
+bluecpu_run(int mode)
+{
+	int scpu = 1, gcpu = 4, mxok = 0, turbo = 0, undo = 0;
+	(void)PE_parse_boot_argn("bluecpu_scpu", &scpu, sizeof(scpu));
+	(void)PE_parse_boot_argn("bluecpu_gcpu", &gcpu, sizeof(gcpu));
+	(void)PE_parse_boot_argn("bluecpu_mxok", &mxok, sizeof(mxok));
+	(void)PE_parse_boot_argn("bluecpu_turbo", &turbo, sizeof(turbo));
+	(void)PE_parse_boot_argn("bluecpu_undo", &undo, sizeof(undo));
+	if ((unsigned)scpu >= ml_get_cpu_count()) {
+		scpu = 0;
+	}
+	uint64_t cntfrq;
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(cntfrq));
+	printf(TAG "bluecpu=%d (%s), %u cpus, CNTFRQ %llu; 0106's automatic request skipped\n", mode,
+	    mode >= 2 ? "request levels" : "read only", ml_get_cpu_count(), cntfrq);
+
+	for (uint32_t di = 0; di < D_COUNT; di++) {
+		if (osm_probe(&doms[di], true)) {
+			osm_status(&doms[di], "boot");
+			osm_raw(&doms[di]);
+		}
+	}
+	lmh_dump();
+	tsens_dump("before");
+	measure(scpu, "silver before");
+	measure(gcpu, "gold before");
+	if (mode < 2) {
+		tsens_dump("after timing");
+		return;
+	}
+
+	int s = (int)osm_top(&doms[D_SILVER], turbo), g = (int)osm_top(&doms[D_GOLD], turbo), l3 = -1;
+	(void)PE_parse_boot_argn("bluecpu_silver", &s, sizeof(s));
+	(void)PE_parse_boot_argn("bluecpu_gold", &g, sizeof(g));
+	(void)PE_parse_boot_argn("bluecpu_l3", &l3, sizeof(l3));
+	if (doms[D_SILVER].base && s >= 0) {
+		osm_request(D_SILVER, (uint32_t)s, mxok);
+	}
+	if (doms[D_GOLD].base && g >= 0) {
+		osm_request(D_GOLD, (uint32_t)g, mxok);
+	}
+	if (doms[D_L3].base && l3 >= 0) {
+		osm_request(D_L3, (uint32_t)l3, mxok);
+	}
+	delay(20000);
+	for (uint32_t di = 0; di < D_COUNT; di++) {
+		if (doms[di].base) {
+			osm_status(&doms[di], "after request");
+		}
+	}
+	measure(scpu, "silver after");
+	measure(gcpu, "gold after");
+	tsens_dump("after");
+	if (undo) {
+		osm_undo();
+	} else {
+		printf(TAG "levels kept (bluecpu_undo=1 restores the old ones)\n");
+	}
+}
+
+/* 0106 behaviour, unchanged: top non-turbo level on both clusters. */
+static void
+cpufreq_legacy(unsigned c, uint32_t di)
+{
+	struct osm_dom *d = &doms[di];
+	if (!osm_probe(d, false)) {
+		return;
+	}
+	if (!d->enabled) {
+		printf("BLUELINE CPUFREQ: cluster %u controller not enabled; left as is\n", c);
+		return;
+	}
+	uint32_t best = osm_top(d, false);
+	uint32_t old = rd(d->base, REG_PERF_STATE);
+	for (uint32_t i = 0; i < (d->per_core ? 4u : 1u); i++) {
+		wr(d->base, REG_PERF_STATE + 4 * i, best);
+	}
 	printf("BLUELINE CPUFREQ: cluster %u: %u levels, was %u, now %u = %u MHz%s\n",
-	    d, rows, old, best, best_khz / 1000, per_core ? " (per core)" : "");
+	    c, d->rows, old, best, d->lut[best].khz / 1000u, d->per_core ? " (per core)" : "");
 }
 
 void
 blueline_cpufreq_init(void)
 {
+	int mode = 0;
+	(void)PE_parse_boot_argn("bluecpu", &mode, sizeof(mode));
+	if (mode > 0) {
+		bluecpu_run(mode);
+		return;
+	}
 	int enabled = 1;
 	(void)PE_parse_boot_argn("bluecpufreq", &enabled, sizeof(enabled));
 	if (!enabled) {
 		printf("BLUELINE CPUFREQ: left at the bootloader's levels (bluecpufreq=0)\n");
 		return;
 	}
-	cpufreq_domain(0, 0x17d43000u);		/* Silver: cpu0-3 */
-	cpufreq_domain(1, 0x17d45800u);		/* Gold: cpu4-7 */
+	cpufreq_legacy(0, D_SILVER);
+	cpufreq_legacy(1, D_GOLD);
 }

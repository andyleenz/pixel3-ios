From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 19 Nov 2026 14:30:00 +0100
Subject: [PATCH] 0155: bluesnap sees flipped frames

While 0145 flips, the display pipes fetch an iOS surface and the panel
buffer that bluesnap read is stale. blue_dpu_snapinfo() returns the pool
buffer being fetched and its geometry on the panel (fit or crop), and a
snap samples it where the panel shows it (nearest, black outside).
---
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1129,6 +1129,7 @@
 };
 
 extern int blue_fb_snapinfo(uintptr_t *pixels, uint32_t *w, uint32_t *h, uint32_t *stride);
+extern int blue_dpu_snapinfo(uintptr_t *kva, uint32_t *w, uint32_t *h, uint32_t *bpr, int32_t *fit_x, int32_t *fit_w);
 int bluesnap_take(const char *why);
 
 static LCK_MTX_DECLARE(bluesnap_lock, &sweet_ufs_grp);
@@ -1210,7 +1211,58 @@
 	}
 	return bytes;
 }
+
+/*
+ * 0155: the same picture while the display pipes scan out an iOS surface
+ * (0145 flip): each output pixel samples the surface where the panel shows it
+ * (nearest; fit = fit_w columns from fit_x scaled to the panel height, crop =
+ * centred), black outside it. The panel buffer is stale while flipped.
+ */
+static uint32_t
+bluesnap_convert_flipped(uintptr_t px, uint32_t sw, uint32_t sh, uint32_t sbpr, int32_t fit_x, int32_t fit_w,
+    uint32_t w, uint32_t h, uint32_t *ow, uint32_t *oh)
+{
+	uint32_t sc = bs.scale;
+	*ow = w / sc;
+	*oh = h / sc;
+	uint32_t bytes = *ow * *oh * (bs.bpp / 8);
+	uint8_t *out = (uint8_t *)bs.buf;
 
+	for (uint32_t oy = 0; oy < *oh; oy++) {
+		int64_t py = (int64_t)oy * sc + sc / 2;
+		for (uint32_t ox = 0; ox < *ow; ox++) {
+			int64_t pxl = (int64_t)ox * sc + sc / 2, sx, sy;
+			if (fit_w > 0) {
+				sx = (pxl - fit_x) * (int64_t)sw / fit_w;
+				sy = py * (int64_t)sh / h;
+			} else {
+				sx = pxl + ((int64_t)sw - w) / 2;
+				sy = py + ((int64_t)sh - h) / 2;
+			}
+			uint8_t b = 0, g = 0, rd = 0;
+			if (sx >= 0 && sy >= 0 && sx < sw && sy < sh) {
+				const uint8_t *p = (const uint8_t *)(px + (uint64_t)sy * sbpr + (uint64_t)sx * 4);
+				b = p[0];
+				g = p[1];
+				rd = p[2];
+			}
+			if (bs.bpp == 16) {
+				uint16_t v = (uint16_t)((rd >> 3) << 11 | (g >> 2) << 5 | (b >> 3));
+				out[0] = (uint8_t)v;
+				out[1] = (uint8_t)(v >> 8);
+				out += 2;
+			} else {
+				out[0] = b;
+				out[1] = g;
+				out[2] = rd;
+				out[3] = 0xff;
+				out += 4;
+			}
+		}
+	}
+	return bytes;
+}
+
 /* One snap now. Thread context only (it sleeps on locks and UFS commands). */
 int
 bluesnap_take(const char *why)
@@ -1253,7 +1305,12 @@
 
 	blue_when_now(&ms, &sb_ms);
 	uint64_t t = mach_absolute_time();
-	uint32_t bytes = bluesnap_convert(px, w, h, stride, &ow, &oh);
+	uintptr_t fpx;
+	uint32_t fw, fh, fbpr;
+	int32_t fit_x, fit_w;
+	bool flipped = blue_dpu_snapinfo(&fpx, &fw, &fh, &fbpr, &fit_x, &fit_w) != 0;	/* 0155 */
+	uint32_t bytes = flipped ? bluesnap_convert_flipped(fpx, fw, fh, fbpr, fit_x, fit_w, w, h, &ow, &oh) :
+	    bluesnap_convert(px, w, h, stride, &ow, &oh);
 	uint32_t conv_ms = blue_abs_to_ms(mach_absolute_time() - t);
 
 	uint64_t at = bs.area + bs.used;
@@ -1292,9 +1349,9 @@
 		bs.on = false;
 	} else {
 		printf("BLUELINE SNAP: #%u %s at %u.%03u s (SpringBoard %d ms): %ux%u, %u bpp, %u KiB "
-		    "at block 0x%llx; %u ms to read, %u ms to write\n",
+		    "at block 0x%llx; %u ms to read, %u ms to write%s\n",
 		    bs.count, why, ms / 1000, ms % 1000, sb_ms, ow, oh, bs.bpp, bytes >> 10, at,
-		    conv_ms, write_ms);
+		    conv_ms, write_ms, flipped ? "; from the flipped iOS surface" : "");
 		bs.count++;

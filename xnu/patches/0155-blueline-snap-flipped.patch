 /*
+ * 0155: for screenshots (bluesnap, sweet_ufs.c): the pool buffer the pipes are
+ * fetching while flipped, with the geometry it is shown at on the panel
+ * (fit: fit_w columns from fit_x, all rows; crop: fit_w = 0, centred). 0 when
+ * not flipped (the panel buffer is what is shown).
+ */
+int
+blue_dpu_snapinfo(uintptr_t *kva, uint32_t *w, uint32_t *h, uint32_t *bpr, int32_t *fit_x, int32_t *fit_w)
+{
+	if (bd_flip_lock == NULL || !bd_flipped) {
+		return 0;
+	}
+	IOLockLock(bd_flip_lock);
+	int ok = 0;
+	for (int i = 0; bd_flipped && i < bd_pool_n; i++) {
+		if (bd_pool[i] != NULL && bd_pool_pa[i] == bd_flip_pa && bd_fplan_stride != 0) {
+			*kva = (uintptr_t)bd_pool[i]->getBytesNoCopy();
+			*w = bd_lw;
+			*h = bd_lh;
+			*bpr = bd_fplan_stride;
+			ok = *kva != 0;
+			break;
+		}
+	}
+	IOLockUnlock(bd_flip_lock);
+	if (ok) {
+		/* as bd_plan_fit: the whole surface height on the panel's, width to scale, centred */
+		uint32_t pw = bd_w, ph = bd_h;
+		*fit_w = bd_fit ? (int32_t)(((uint64_t)*w * ph) / *h) : 0;
+		*fit_x = bd_fit ? ((int32_t)pw - *fit_w) / 2 : 0;
+	}
+	return ok;
+}
+
+/*
  * About once a second while flipped (vsync timer): a new INTF underrun, a
  * change of the MDP streams' SMMU fault state, or no frame sent since the
  * last check turns the flip off. 1 if it did (the caller redraws the panel

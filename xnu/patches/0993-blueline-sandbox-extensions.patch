From: pixel3-ios
Subject: [PATCH] 0993 blueline: sandbox extensions issued and consumed (TCC)

tccd takes a failed sandbox_extension_issue for a refusal, so every TCC
service was denied (TCCAccessPreflight 1, AVCaptureDeviceInput "Cannot use
Back Camera"). Issue (op 5) writes a token into the caller's buffer and
succeeds; consume (op 6) gives handle 1. Port of ios-redfin 0924 (MIT,
DenialOfGravity/ios-redfin).

---
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -280,13 +280,54 @@
  * launchd reports mach lookups as "error = 159: Sandbox restriction"
  * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
  * "profile not found"). SWEET runs without a sandbox: operations succeed
- * (checks allow, profile init is accepted); the few that must return
- * data (container paths, extension tokens) fail with ENOENT. The first
- * use of each operation number is logged.
+ * (checks allow, profile init is accepted); container paths fail with
+ * ENOENT except for app extensions (below), extensions are issued and
+ * consumed (below). The first use of each operation number is logged.
  */
 static uint64_t sweet_sandbox_seen;
 
 /*
+ * Extension tokens (after ios-redfin's patch 0924, MIT). tccd gives each
+ * process it allows a sandbox extension for the service
+ * (sandbox_extension_issue_generic("com.apple.tcc.kTCCServiceCamera") and
+ * the like) and takes a failure to issue one for a refusal: TCCAccessPreflight
+ * said denied for every grant, and AVCaptureDeviceInput failed "Cannot use
+ * Back Camera" (cam5-26). With no sandbox an extension enforces nothing:
+ * issue writes a token of ours into the caller's buffer, consume gives
+ * handle 1.
+ *
+ * libsystem_sandbox (iOS 16), issue (op 5): { u64 class, u64 type, u64 path,
+ * u64 flags, u64 token buffer (malloc 2048), u64 pid, u64 pid version };
+ * the buffer is the token when the call succeeds. Consume (op 6):
+ * { u64 token, u64 length + 1, u64 handle out }.
+ */
+#define BLUE_SANDBOX_TOKEN "0000000000000000000000000000000000000000;00;00000000;00000000;blueline"
+
+static int
+sweet_sandbox_issue(user_addr_t arg)
+{
+	uint64_t a[7];
+	int error = copyin(arg, a, sizeof(a));
+
+	if (error == 0) {
+		error = a[4] ? copyout(BLUE_SANDBOX_TOKEN, (user_addr_t)a[4], sizeof(BLUE_SANDBOX_TOKEN)) : EINVAL;
+	}
+	return error;
+}
+
+static int
+sweet_sandbox_consume(user_addr_t arg)
+{
+	uint64_t a[3], handle = 1;
+	int error = copyin(arg, a, sizeof(a));
+
+	if (error == 0 && a[2] != 0) {
+		error = copyout(&handle, (user_addr_t)a[2], sizeof(handle));
+	}
+	return error;
+}
+
+/*
  * Op 4, container path of a pid: arg -> {int64 pid; 0; char *buf; u64 len; 0}.
  * PlugInKit's checkEnvironment aborts every app extension ("plugin has
  * invalid sandbox or container: error 2") without one (speech synthesizer
@@ -341,7 +382,9 @@
 	case 4:         /* container path (pid) */
 		return sweet_sandbox_container_path(arg);
 	case 5:         /* extension issue */
+		return sweet_sandbox_issue(arg);
 	case 6:         /* extension consume */
+		return sweet_sandbox_consume(arg);
 	case 0x43:      /* container expected */
 		return ENOENT;
 	default:

 			    nf - bd_last_flip, nf, nu - bd_last_unflip, nf ? bd_clean_us / nf : 0, nf ? bd_latch_us / nf : 0,
-			    bd_latch_max_us, bd_flipped ? "flipped" : "on the panel buffer", bd_flip_on ? "flip on" : "flip off");

 static uint64_t bd_flip_pa;             /* buffer being fetched */
+/*
+ * 0157: a flip returns without waiting for the DPU to latch it (backboardd
+ * spent ~7 ms of every frame in that wait). Safe while backboardd cycles 3+
+ * buffers: the next flip waits for this one's latch first, so the buffer it
+ * replaced is free before it is drawn into again. Two buffers (a flip of the
+ * buffer replaced one flip ago) put it back to waiting for the boot.
+ */
+static uint64_t bd_flip_pa_prev;        /* buffer fetched before bd_flip_pa */
+static bool bd_latch_pending;           /* bd_flip_pa flushed, latch not seen yet */
+static bool bd_flip_sync;               /* wait for every latch (bluedpu_flip_sync=1) */
+static uint32_t bd_n_cycle2, bd_n_cycle3;       /* flips of the buffer replaced 1 / 2+ flips ago */
+static char bd_slots[48];               /* pool slot of the first flips, for the log */
+static uint32_t bd_n_settle, bd_settle_max_us;  /* GPU frames held for a latch */
+static uint64_t bd_settle_us;
 static IOBufferMemoryDescriptor *bd_pool[BD_POOL_MAX];
 static uint64_t bd_pool_pa[BD_POOL_MAX];
 static bool bd_pool_used[BD_POOL_MAX];
@@ -1568,11 +1583,37 @@
 		bd_fplan_stride = bpr;
 		bd_plan_log(bd_fit ? "flip plan (fit)" : "flip plan (crop)", &bd_fplan);
 	}
+	/* 0157: the previous flip's latch, if it is still pending (rarely: a frame takes > 1 vsync) */
+	int64_t lat = 0;
 	if (mdp_rd(CTL_BASE(bd_st.ctl) + CTL_FLUSH) & bd_fplan.flush) {
-		IOLockUnlock(bd_flip_lock);
-		bd_once("a flush is still pending", NULL);
-		return 0;
+		uint64_t tw = mach_absolute_time();
+		while ((mdp_rd(CTL_BASE(bd_st.ctl) + CTL_FLUSH) & bd_fplan.flush) != 0 &&
+		    bd_us(mach_absolute_time() - tw) < (uint64_t)BD_FLIP_WAIT_MS * 1000) {
+			IODelay(200);
+		}
+		lat = (int64_t)bd_us(mach_absolute_time() - tw);

-	int64_t lat = bd_flush(&bd_st, bd_fplan.flush, first ? "first flip" : NULL, true, BD_FLIP_WAIT_MS);
+	if (wait) {
+		lat = bd_flush(&bd_st, bd_fplan.flush, first ? "first flip" : NULL, true, BD_FLIP_WAIT_MS);
+	} else {
+		(void)bd_flush(&bd_st, bd_fplan.flush, NULL, true, 0);
+		bd_latch_pending = true;
+	}
 	if (lat < 0) {
 		bd_flip_off("flush did not latch");
 		IOLockUnlock(bd_flip_lock);
@@ -1623,6 +1673,36 @@
 	return was;
 }
 
+/*
+ * 0157: called before the GPU runs work that draws into an IOSurface
+ * (BlueGPUUserClient.cpp): with a flip still waiting for its latch, the
+ * buffer it replaces may still be fetched, and backboardd draws its next
+ * frame into exactly that buffer (it alternates two). The wait overlaps
+ * CoreAnimation's CPU work for the frame instead of following the flip.
+ */
+uint32_t
+blue_dpu_flip_settle(void)
+{
+	if (bd_flip_lock == NULL || !bd_latch_pending) {
+		return 0;
+	}
+	IOLockLock(bd_flip_lock);
+	uint64_t t0 = mach_absolute_time();
+	while (bd_latch_pending && (mdp_rd(CTL_BASE(bd_st.ctl) + CTL_FLUSH) & bd_fplan.flush) != 0 &&
+	    bd_us(mach_absolute_time() - t0) < (uint64_t)BD_FLIP_WAIT_MS * 1000) {
+		IODelay(200);
+	}
+	uint32_t us = (uint32_t)bd_us(mach_absolute_time() - t0);
+	if (bd_latch_pending) {
+		bd_latch_pending = false;
+		bd_n_settle++;
+		bd_settle_us += us;
+		bd_settle_max_us = us > bd_settle_max_us ? us : bd_settle_max_us;
+	}
+	IOLockUnlock(bd_flip_lock);
+	return us;
+}

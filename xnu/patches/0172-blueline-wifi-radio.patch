+static void
+radio_summary(void)
+{
+	if (!ce_up) {
+		return;
+	}
+	RLOG("summary: ce rx %u/%u/%u/%u/%u/%u/%u/%u/%u/%u/%u/%u, tx %u/%u/%u (full %u/%u/%u); htc ready %d setup %d; wmi init %d ready %d; htt %u msgs; wmi credits %u queue %u; "
+	    "%u scans, %u networks, %u frames", ce[0].rx, ce[1].rx, ce[2].rx, ce[3].rx, ce[4].rx, ce[5].rx, ce[6].rx, ce[7].rx,
+	    ce[8].rx, ce[9].rx, ce[10].rx, ce[11].rx, ce[0].tx, ce[3].tx, ce[4].tx, ce[0].tx_full, ce[3].tx_full, ce[4].tx_full,
+	    htc_ready, htc_setup, wmi_init_sent, wmi_ready, htt_msgs, wmi_eid != 0xFF ? ep[wmi_eid].credits : 0, wmiq_tail - wmiq_head, scans, nbss, scan_frames);
+}

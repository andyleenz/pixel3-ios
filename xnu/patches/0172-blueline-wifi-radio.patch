+	WLFW_INI = 0x2f, WLFW_MSA_INFO = 0x2d, WLFW_MSA_READY = 0x2e, WLFW_MAC_ADDR = 0x33, WLFW_HOST_CAP = 0x34, WLFW_FW_INIT_DONE_IND = 0x38,
 };
 

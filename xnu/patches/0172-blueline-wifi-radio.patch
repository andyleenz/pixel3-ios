+#define RADIO_SMMU_SIZE		0x00080000u
+#define RADIO_SID		0x040u
+#define RADIO_SID_MASK		0x1u
+#define RADIO_CB_CBAR		0x0001f000u	/* S1_TRANS_S2_FAULT, S1 memattr WB */
+#define RADIO_CB_CBA2R		0x00000001u	/* VA64 */
+#define RADIO_CB_SCTLR		0x000000e0u	/* CFCFG|CFIE|CFRE, M=0: no translation */
+#define RADIO_POOL_PA		0xe0000000ull
+#define RADIO_POOL_SIZE		0x01000000ull
+#define RADIO_WLAN_PA		0x18800000ull
 

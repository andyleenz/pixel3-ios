+/*
+ * 0144 diagnostic: RB perf counters around a fill (a6xx_rb_perfcounter_select,
+ * a6xx.xml RB_PERFCTR_RB_SEL / RBBM_PERFCTR_RB; RBBM_PERFCTR_CNTL = 1 is in
+ * hw_init) and CP counter 0 (CP_PERFCTR_CP_SEL0 = 0, ALWAYS_COUNT) to show
+ * the counters run at all. Selects written by the CPU with the CP idle, as
+ * KGSL's a6xx perfcounter enable does.
+ */
+#define R_RB_PERFCTR_RB_SEL	0x8e10u		/* [0..7] */
+#define GXR_RBBM_PERFCTR_CP0	0x0400u		/* LO, HI */
+#define GXR_RBBM_PERFCTR_RB0	0x04d6u		/* [i] at + 2i: LO, HI */
+#define DR_NPERF		4u
+
+static const struct {
+	uint32_t sel;
+	const char *name;
+} dr_perf_sel[DR_NPERF] = {
+	{ 23, "2D_ALIVE_CYCLES" },
+	{ 28, "2D_VALID_PIXELS" },
+	{ 40, "2D_OUTPUT_RB_DST_TRANS" },
+	{ 15, "C_WRITE" },
+};
+
+static uint64_t
+dr_ctr(uint32_t lo)
+{
+	uint32_t hi = cp_rd(lo + 1), l = cp_rd(lo), hi2 = cp_rd(lo + 1);
+	if (hi2 != hi) {
+		l = cp_rd(lo);
+	}
+	return ((uint64_t)hi2 << 32) | l;
+}
+
+/* base[0..3] = RB counters, base[4] = CP counter 0 */
+static void
+dr_perf_start(uint64_t base[DR_NPERF + 1])
+{
+	printf("BLUELINE GPU: about to select RB perf counters 0..%u (RB_PERFCTR_RB_SEL %#x):", DR_NPERF - 1,
+	    R_RB_PERFCTR_RB_SEL);
+	for (uint32_t i = 0; i < DR_NPERF; i++) {
+		cp_wr(R_RB_PERFCTR_RB_SEL + i, dr_perf_sel[i].sel);
+		printf(" %s=%u (reads %u)", dr_perf_sel[i].name, dr_perf_sel[i].sel, cp_rd(R_RB_PERFCTR_RB_SEL + i));
+	}
+	printf("\n");
+	for (uint32_t i = 0; i < DR_NPERF; i++) {
+		base[i] = dr_ctr(GXR_RBBM_PERFCTR_RB0 + 2 * i);
+	}
+	base[DR_NPERF] = dr_ctr(GXR_RBBM_PERFCTR_CP0);
+}
+
+static void
+dr_perf_report(const char *what, const uint64_t base[DR_NPERF + 1], uint32_t pixels)
+{
+	uint64_t d[DR_NPERF + 1];
+	uint32_t st = cp_rd(GXR_RBBM_STATUS);
+
+	for (uint32_t i = 0; i < DR_NPERF; i++) {
+		d[i] = dr_ctr(GXR_RBBM_PERFCTR_RB0 + 2 * i) - base[i];
+	}
+	d[DR_NPERF] = dr_ctr(GXR_RBBM_PERFCTR_CP0) - base[DR_NPERF];
+	printf("BLUELINE GPU: %s: rbbm status %#x (A2D_BUSY %u CCU_BUSY %u RB_BUSY %u VBIF_BUSY %u CP_BUSY %u)"
+	    " status1 %#x status2 %#x status3 %#x\n", what, st, (st >> 9) & 1u, (st >> 8) & 1u, (st >> 7) & 1u,
+	    (st >> 4) & 1u, (st >> 2) & 1u, cp_rd(GXR_RBBM_STATUS + 1), cp_rd(GXR_RBBM_STATUS + 2),
+	    cp_rd(GXR_RBBM_STATUS + 3));
+	printf("BLUELINE GPU: %s perf deltas: CP ALWAYS_COUNT %llu", what, (unsigned long long)d[DR_NPERF]);
+	for (uint32_t i = 0; i < DR_NPERF; i++) {
+		printf(", %s %llu", dr_perf_sel[i].name, (unsigned long long)d[i]);
+	}
+	printf(" (%u pixels asked for): %s\n", pixels,
+	    !d[DR_NPERF] ? "COUNTERS NOT RUNNING, no conclusion" :
+	    !d[0] && !d[1] ? "THE 2D ENGINE NEVER RAN" :
+	    d[1] && (d[2] || d[3]) ? "the 2D engine made pixels and the RB wrote them out" :
+	    d[1] ? "the 2D engine made pixels, NO RB OUTPUT COUNTED" : "the 2D engine ran, NO VALID PIXELS");
+}
+
+static uint32_t
+dr_pixels(const struct dr_rect *r, uint32_t n)
+{
+	uint32_t p = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		p += r[i].w * r[i].h;
+	}
+	return p;
+}

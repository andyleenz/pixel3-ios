diff --git a/bsd/conf/files b/bsd/conf/files
index d94b227b9..18e214747 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -109,6 +109,7 @@ bsd/dev/sweet_sample.c			standard
 bsd/dev/blueline_keys.c			standard
 bsd/dev/blueline_touch.c		standard
 bsd/dev/blueline_cpufreq.c		standard

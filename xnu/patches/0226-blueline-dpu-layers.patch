 }
 
 /* Something is wrong: no more flips this boot (flip lock held). */
@@ -1549,10 +1688,29 @@
 blue_dpu_flip(IOMemoryDescriptor *md, uintptr_t kva, uint32_t offset, uint32_t bpr, uint32_t w, uint32_t h,
     uint32_t fmt)
 {
+	return blue_dpu_flip_layers(md, kva, offset, bpr, w, h, fmt, NULL, 0, 0, 0, 0, 0, 0, 0, 0);
+}
+
+/*
+ * 0226: the same, with umd (rows sy..sy+sh of a full-width app buffer) shown
+ * under it at canvas row dy, blended by the layer mixers. umd NULL: no layer
+ * under. 0: the caller composes on the CPU.
+ */
+int
+blue_dpu_flip_layers(IOMemoryDescriptor *md, uintptr_t kva, uint32_t offset, uint32_t bpr, uint32_t w, uint32_t h,
+    uint32_t fmt, IOMemoryDescriptor *umd, uintptr_t ukva, uint32_t ubpr, uint32_t uw, uint32_t uh, uint32_t ufmt,
+    uint32_t sy, uint32_t sh, uint32_t dy)
+{
 	char detail[128];
 	if (!bd_flip_on) {
 		return 0;
 	}
+	if (umd != NULL && (bd_layers_n == 0 || !bd_fit || uw != bd_lw || ufmt != BD_FMT_BGRA || ukva == 0 ||
+	    (ubpr & 15) || ubpr < uw * 4 || sh == 0 || sy + sh > uh || dy + sh > bd_lh)) {
+		snprintf(detail, sizeof(detail), "%ux%u fmt 0x%x bpr %u rows %u+%u at %u", uw, uh, ufmt, ubpr, sy, sh, dy);
+		bd_once("layer the DPU cannot show", detail);
+		return 0;
+	}
 	if (w != bd_lw || h != bd_lh || fmt != BD_FMT_BGRA || md == NULL || kva == 0) {
 		snprintf(detail, sizeof(detail), "%ux%u fmt 0x%x", w, h, fmt);
 		bd_once("not a full-screen BGRA surface", detail);
@@ -1588,6 +1746,18 @@
 		IOLockUnlock(bd_flip_lock);
 		return 0;
 	}
+	int uslot = -1;
+	uint64_t upa = 0;
+	if (umd != NULL) {
+		uslot = bd_pool_index(umd);
+		uint64_t useg = 0, ulen = (uint64_t)ubpr * uh;
+		upa = uslot >= 0 ? umd->getPhysicalSegment(0, &useg, kIOMemoryMapperNone) : 0;
+		if (uslot < 0 || upa != bd_pool_pa[uslot] || useg < ulen || upa + ulen > 0x100000000ULL) {
+			IOLockUnlock(bd_flip_lock);
+			bd_once("layer not from the scanout pool", NULL);
+			return 0;
+		}
+	}
 	if (bd_fplan_stride != bpr) {
 		if (bd_flipped) {
 			bd_unflip_locked("new stride");
@@ -1602,7 +1772,26 @@
 		}
 		bd_fplan_stride = bpr;
 		bd_plan_log(bd_fit ? "flip plan (fit)" : "flip plan (crop)", &bd_fplan);
+		bd_ugeom = false;
+		bd_ukey[0] = 0;
 	}
+	if (umd != NULL && (!bd_ugeom || bd_ukey[0] != ubpr || bd_ukey[1] != sy || bd_ukey[2] != sh || bd_ukey[3] != dy)) {
+		const char *bad = bd_plan_under(&bd_st, &bd_fplan, ubpr, sy, sh, dy, &bd_uplan);
+		if (bad != NULL) {
+			IOLockUnlock(bd_flip_lock);
+			snprintf(detail, sizeof(detail), "%s (rows %u+%u at %u)", bad, sy, sh, dy);
+			bd_once("layer plan", detail);
+			return 0;
+		}
+		bd_ugeom = false;
+		bd_ukey[0] = ubpr;
+		bd_ukey[1] = sy;
+		bd_ukey[2] = sh;
+		bd_ukey[3] = dy;
+		if (bd_n_layered < 4) {
+			bd_plan_log("layer plan", &bd_uplan);
+		}
+	}
 	/* 0157: the previous flip's latch, if it is still pending (rarely: a frame takes > 1 vsync) */
 	int64_t lat = 0;
 	if (mdp_rd(CTL_BASE(bd_st.ctl) + CTL_FLUSH) & bd_fplan.flush) {
@@ -1638,6 +1827,10 @@
 	/* The DPU is not IO-coherent: the frame has to be in DRAM before it is fetched. */
 	uint64_t t0 = mach_absolute_time();
 	CleanPoC_DcacheRegion((vm_offset_t)kva, (size_t)len);
+	if (umd != NULL && !bd_pool_clean[uslot]) {
+		CleanPoC_DcacheRegion((vm_offset_t)ukva, (size_t)ubpr * uh);    /* GPU-drawn: once, for the CPU's zeroing */
+		bd_pool_clean[uslot] = true;
+	}
 	bd_dsb();
 	uint64_t t1 = mach_absolute_time();
 	if (!bd_geom) {
@@ -1647,6 +1840,24 @@
 	bool first = bd_n_flip == 0;
 	bool wait = first || !bd_geom || bd_flip_sync;
 	bd_plan_write(&bd_fplan, pa, !bd_geom);
+	uint32_t bits = bd_fplan.flush;
+	if (umd != NULL) {
+		bd_plan_write(&bd_uplan, upa, !bd_ugeom);
+		bd_ugeom = true;
+		bits |= bd_uplan.flush;
+		if (!bd_layered) {
+			bits |= bd_layer_stage(true);

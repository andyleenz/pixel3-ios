+/*
+ * 0226: a second layer under the flipped one (bluedpu_layers=N). backboardd
+ * hands a full-screen CAMetalLayer to the display as layer 0 (detached) and
+ * its own buffer, mostly clear, as layer 1. Each LM gets an idle VIG pipe
+ * for layer 0 at blend stage 0 (opaque), and the flipped pipe moves to stage
+ * 1, premultiplied source over (dpu_crtc.c _dpu_crtc_setup_blend_cfg).
+ * Layer 0 is full width at canvas row dy, from a contiguous app buffer
+ * (blue_dpu_pool_take_app); the same horizontal split and scale as the top.
+ */
+#define LM_BLEND_STAGE(n)       (0x20 + 0x18 * (n))     /* sdm845_lm_sblk blendstage_base */
+#define LM_BLEND_OP             0x00
+#define LM_BLEND_CONST_ALPHA    0x04                    /* combined alpha: fg << 16 | bg */
+#define BLEND_OPAQUE            0x100                   /* FG_ALPHA_FG_CONST | BG_ALPHA_BG_CONST */
+#define BLEND_PREMULT           0x600                   /* FG_ALPHA_FG_CONST | BG_ALPHA_FG_PIXEL | BG_INV_ALPHA */
+#define CTL_FLUSH_CTL           (1u << 17)
+#define CTL_MIXER_BORDER_OUT    (1u << 24)
+
+static int bd_layers_n;                 /* app buffers (bluedpu_layers) */
+static bool bd_layered;                 /* a layer is staged under the flipped one */
+static bool bd_ugeom;                   /* bd_uplan's geometry written */
+static struct bd_plan bd_uplan;
+static uint32_t bd_ukey[4];             /* bpr, sy, sh, dy bd_uplan was made for */
+static int bd_upipe[4];                 /* per top rect: its under pipe */
+static uint32_t bd_n_layered, bd_n_unlayered;
+
+static uint32_t
+bd_lm_flush(int lm)
+{
+	static const uint32_t bits[4] = { 1u << 6, 1u << 7, 1u << 8, 1u << 20 };       /* LM0 1 2 5 */
+	return bits[lm];
+}
+
+/* The under-layer plan for rows sy..sy+sh of a bpr-stride buffer shown at canvas row dy. NULL or why not. */
+static const char *
+bd_plan_under(const struct bd_state *st, const struct bd_plan *top, uint32_t bpr, uint32_t sy, uint32_t sh,
+    uint32_t dy, struct bd_plan *pl)
+{
+	bzero(pl, sizeof(*pl));
+	if (!top->fit || top->n != st->nsrc || top->n > 2) {
+		return "top plan is not a fit plan with one rect per LM";
+	}
+	uint32_t y0 = top->src_y0, yh = top->src_h;
+	uint32_t c0 = dy > y0 ? dy : y0, c1 = dy + sh < y0 + yh ? dy + sh : y0 + yh;
+	if (c1 <= c0) {
+		return "layer outside the shown rows";
+	}
+	uint32_t o0 = (uint32_t)(((uint64_t)(c0 - y0) * bd_h + yh / 2) / yh);
+	uint32_t o1 = (uint32_t)(((uint64_t)(c1 - y0) * bd_h + yh / 2) / yh);
+	if (o1 <= o0 || o1 > bd_h) {
+		return "layer maps to no panel rows";
+	}
+	uint32_t rows = c1 - c0, srow = sy + (c0 - dy);
+	pl->fit = true;
+	pl->stride = bpr;
+	pl->src_y0 = srow;
+	pl->src_h = rows;
+	int used = 0;
+	for (int s = 0; s < st->nsrc; s++) {
+		used |= 1 << st->src[s].pipe;
+	}
+	int next = 0;
+	for (int i = 0; i < top->n; i++) {
+		while (next < 4 && (used & (1 << next))) {
+			next++;
+		}
+		if (next >= 4) {
+			return "no idle VIG pipe";
+		}
+		int pipe = next++;
+		const struct bd_pipe_desc *p = &bd_pipes[pipe];
+		if (mdp_rd(p->base + SSPP_MULTIRECT_OPMODE) != 0 || (mdp_rd(p->base + SSPP_QSEED3 + QS3_HW_VERSION) >> 8) == 0) {
+			return "idle VIG pipe not usable";
+		}
+		const struct bd_rect_plan *t = &top->r[i];
+		uint32_t oh = o1 - o0;
+		bd_upipe[i] = pipe;
+		pl->r[pl->n++] = (struct bd_rect_plan){
+			.base = p->base, .rect = 0,
+			.addr_off = p->base + SSPP_SRC0_ADDR, .xy_off = p->base + SSPP_SRC_XY,
+			.byte_off = 0, .xy = srow << 16 | (t->xy & 0xffff),
+			.fit = true,
+			.src_size = rows << 16 | (t->src_size & 0xffff),
+			.out_size = oh << 16 | (t->out_size & 0xffff),
+			.out_xy = o0 << 16 | (t->out_xy & 0xffff),
+			.step_h = t->step_h,
+			.step_v = (uint32_t)(((uint64_t)rows << QS3_PHASE_SHIFT) / oh),
+		};
+		pl->flush |= p->flush;
+	}
+	return NULL;
+}
+
+/* Stage (on) or unstage the under layer on each LM; registers only. Flush bits to add. */
+static uint32_t
+bd_layer_stage(bool on)
+{
+	uint32_t bits = CTL_FLUSH_CTL;
+	for (int i = 0; i < bd_st.nsrc; i++) {
+		const struct bd_src *src = &bd_st.src[i];
+		const struct bd_pipe_desc *tp = &bd_pipes[src->pipe], *up = &bd_pipes[bd_upipe[i]];
+		uint32_t lmb = bd_lms[src->lm].base;
+		uint32_t mix = CTL_MIXER_BORDER_OUT | 3u << tp->sh0;
+		if (on) {
+			/* format, fetch and QoS as the top pipe's (ABL's) */
+			static const uint32_t copy[] = {
+				SSPP_SRC_FORMAT, SSPP_SRC_UNPACK, SSPP_SRC_OP_MODE, 0x3c, SSPP_FETCH_CONFIG, 0x60, 0x64, 0x68,
+				SSPP_QOS_CTRL, 0x74, 0x78, 0x130, 0x134, 0x150,
+			};
+			for (size_t k = 0; k < sizeof(copy) / sizeof(copy[0]); k++) {
+				bd_set(up->base + copy[k], mdp_rd(tp->base + copy[k]));
+			}
+			mix |= 2u << up->sh0;
+			bits |= up->flush;
+		}
+		bd_set(CTL_BASE(bd_st.ctl) + CTL_LAYER(bd_lms[src->lm].id), mix);
+		bd_set(lmb + LM_BLEND_STAGE(0) + LM_BLEND_OP, BLEND_OPAQUE);
+		bd_set(lmb + LM_BLEND_STAGE(0) + LM_BLEND_CONST_ALPHA, 0xffu << 16);
+		bd_set(lmb + LM_BLEND_STAGE(1) + LM_BLEND_OP, BLEND_PREMULT);
+		bd_set(lmb + LM_BLEND_STAGE(1) + LM_BLEND_CONST_ALPHA, 0xffu << 16);
+		bits |= bd_lm_flush(src->lm) | tp->flush;
+	}
+	bd_layered = on;
+	bd_extra_flush |= bits;
+	return bits;
+}
+

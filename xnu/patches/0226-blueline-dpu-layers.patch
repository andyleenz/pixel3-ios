 }
 
+/* 0226: an app's full-width BGRA surface (a CAMetalLayer drawable) the DPU can show as a layer */
+IOBufferMemoryDescriptor *
+blue_dpu_pool_take_app(uint32_t w, uint32_t h, uint32_t bpr, uint32_t fmt, uint32_t planes, uint32_t offset,
+    uint64_t size)
+{
+	if (!bd_flip_on || bd_flip_lock == NULL || bd_layers_n == 0 || w != bd_lw || h > bd_lh || h < bd_lh / 2 ||
+	    fmt != BD_FMT_BGRA || planes != 0 || offset != 0 || (bpr & 15) || size > bd_pool_size ||
+	    (uint64_t)bpr * h > bd_pool_size) {
+		return NULL;
+	}
+	IOBufferMemoryDescriptor *md = NULL;
+	IOLockLock(bd_flip_lock);
+	for (int i = 0; i < bd_pool_n && md == NULL; i++) {
+		if (bd_pool_app[i] && !bd_pool_used[i]) {
+			bd_pool_used[i] = true;
+			bd_pool_clean[i] = false;
+			md = bd_pool[i];
+			md->retain();
+			IOLog("BLUE DPU: app pool buffer %d (0x%llx) -> %ux%u bpr %u surface\n", i, bd_pool_pa[i], w, h, bpr);
+		}
+	}
+	IOLockUnlock(bd_flip_lock);
+	if (md == NULL) {
+		bd_once("app pool empty", NULL);
+	}
+	return md;
+}
+
 void
 blue_dpu_pool_put(IOMemoryDescriptor *md)
 {
@@ -1945,6 +2184,28 @@
 	if (bd_pool_n < 2) {
 		IOLog("BLUE DPU: flip: off: %d pool buffers, need 2\n", bd_pool_n);
 		return 0;
+	}
+	int layers = 0;
+	PE_parse_boot_argn("bluedpu_layers", &layers, sizeof(layers));
+	layers = layers < 0 ? 0 : (layers > BD_POOL_MAX - bd_pool_n ? BD_POOL_MAX - bd_pool_n : layers);
+	for (int i = 0; i < layers; i++) {
+		IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous |
+		    kIOMemoryHostPhysicallyContiguous, bd_pool_size, 0x00000000ffffc000ULL);
+		uint64_t seg = 0, pa = md != NULL ? md->getPhysicalSegment(0, &seg, kIOMemoryMapperNone) : 0;
+		if (md == NULL || pa == 0 || seg < bd_pool_size || pa + bd_pool_size > 0x100000000ULL ||
+		    md->getBytesNoCopy() == NULL) {
+			IOLog("BLUE DPU: layers: app buffer %d: no contiguous %llu bytes below 4 GiB\n", i, bd_pool_size);
+			OSSafeReleaseNULL(md);
+			break;
+		}
+		bd_pool_app[bd_pool_n] = true;
+		bd_pool[bd_pool_n] = md;
+		bd_pool_pa[bd_pool_n++] = pa;
+		bd_layers_n++;
+	}
+	if (layers > 0) {
+		IOLog("BLUE DPU: layers: %d app buffers of %llu bytes\n", bd_layers_n, bd_pool_size);
 	}
 	bd_health_baseline(&bd_st, "flip baseline");
 	return 1;

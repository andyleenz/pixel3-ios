+	uint32_t len = blueline_cmddb_aux(id, b, sizeof(b));
+	int n = (int)((len < sizeof(b) ? len : sizeof(b)) / 2);
+	uint16_t lv[32];
+	for (int i = 0; i < n; i++) {

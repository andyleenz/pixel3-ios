+/*
+ * bluetimers=1 (diagnostic): every 10 s, the timers that fired most, from
+ * timer_queue_expire_with_options (timer calls; a thread's own wait timeout,
+ * thread_timer_expire, is counted per thread with its process name) and
+ * thread_call_delayed_timer (thread calls). Function addresses are unslid,
+ * for nm on kernel.development.sweet.
+ */
+#define TC_N 96
+static struct tc_ent {
+	uintptr_t key, func;
+	uint32_t n;
+	uint8_t kind;			/* 0 timer call, 1 thread call, 2 thread wait timeout */
+	uint64_t tid;
+	uintptr_t ev, cont;		/* a waiting thread's wait event and continuation */
+	uintptr_t pcs[6];		/* ... and where it blocked */
+	char name[17];
+} tc[TC_N], tc_copy[TC_N];
+static uint32_t tc_lock, tc_total, tc_drop;
+static bool tc_on;
+extern void thread_timer_expire(void *p0, void *p1);
+extern task_t get_threadtask(thread_t th);
+extern void *get_bsdtask_info(task_t t);
+extern char *proc_name_address(void *p);
+void blue_tc_note(int kind, void *func, void *p0);
+
+/* A blocked thread's saved lr and frame-pointer chain, kept inside its kernel stack. */
 static void
+tc_stack(thread_t th, uintptr_t *pcs, int n)
+{
+	vm_offset_t lo = th->kernel_stack, hi = lo + kernel_stack_size;
+	if (lo == 0 || th->machine.kstackptr < lo || th->machine.kstackptr >= hi) {
+		return;
+	}
+	struct arm_kernel_saved_state *ss = &((thread_kernel_state_t)th->machine.kstackptr)->machine.ss;
+	uintptr_t fp = ss->fp;
+	int k = 0;
+	pcs[k++] = ss->lr;
+	while (k < n && fp >= lo && fp + 16 <= hi && (fp & 7) == 0) {
+		pcs[k++] = ((uintptr_t *)fp)[1];
+		uintptr_t nfp = ((uintptr_t *)fp)[0];
+		if (nfp <= fp) {
+			break;
+		}
+		fp = nfp;
+	}
+}
+
+/* Timer context, interrupts off. */
+void
+blue_tc_note(int kind, void *func, void *p0)
+{
+	if (!tc_on) {
+		return;
+	}
+	uintptr_t key = (uintptr_t)func;
+	if (kind == 0 && func == (void *)thread_timer_expire && p0 != NULL) {
+		kind = 2;
+		key = (uintptr_t)p0;
+	}
+	while (os_atomic_xchg(&tc_lock, 1u, acquire)) {
+		__builtin_arm_yield();
+	}
+	tc_total++;
+	int i;
+	for (i = 0; i < TC_N; i++) {
+		if (tc[i].n == 0 || (tc[i].key == key && tc[i].kind == kind)) {
+			break;
+		}
+	}
+	if (i == TC_N) {
+		tc_drop++;
+	} else {
+		if (tc[i].n == 0) {
+			tc[i].key = key;
+			tc[i].func = (uintptr_t)func;
+			tc[i].kind = (uint8_t)kind;
+			tc[i].tid = 0;
+			tc[i].name[0] = 0;
+			if (kind == 2) {
+				thread_t th = (thread_t)p0;
+				tc[i].tid = thread_tid(th);
+				tc[i].ev = (uintptr_t)th->wait_event;
+				tc[i].cont = (uintptr_t)th->continuation;
+				bzero(tc[i].pcs, sizeof(tc[i].pcs));
+				tc_stack(th, tc[i].pcs, 6);
+				task_t t = get_threadtask(th);
+				void *p = t ? get_bsdtask_info(t) : NULL;
+				if (p) {
+					strlcpy(tc[i].name, proc_name_address(p), sizeof(tc[i].name));
+				} else {
+					strlcpy(tc[i].name, "kernel", sizeof(tc[i].name));
+				}
+			}
+		}
+		tc[i].n++;
+	}
+	os_atomic_store(&tc_lock, 0u, release);
+}
+
+static void
+tc_report_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static uint32_t dummy;
+	static const char *kinds[3] = { "timer_call", "thread_call", "wait" };
+
+	for (;;) {
+		assert_wait_timeout(&dummy, THREAD_UNINT, 10000, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+
+		boolean_t ie = ml_set_interrupts_enabled(FALSE);
+		while (os_atomic_xchg(&tc_lock, 1u, acquire)) {
+			__builtin_arm_yield();
+		}
+		memcpy(tc_copy, tc, sizeof(tc));
+		bzero(tc, sizeof(tc));
+		uint32_t total = tc_total, drop = tc_drop;
+		tc_total = tc_drop = 0;
+		os_atomic_store(&tc_lock, 0u, release);
+		ml_set_interrupts_enabled(ie);
+
+		printf("BLUELINE TIMERS: 10s: %u fired (%u not tallied)\n", total, drop);
+		for (int k = 0; k < 20; k++) {
+			int best = -1;
+			for (int i = 0; i < TC_N; i++) {
+				if (tc_copy[i].n && (best < 0 || tc_copy[i].n > tc_copy[best].n)) {
+					best = i;
+				}
+			}
+			if (best < 0) {
+				break;
+			}
+			struct tc_ent *e = &tc_copy[best];
+			if (e->kind == 2) {
+				printf("BLUELINE TIMERS:  %5u wait   thread %llu (%s) event %#lx (unslid %#lx) continuation %#lx\n", e->n, e->tid,
+				    e->name, (unsigned long)e->ev, (unsigned long)VM_KERNEL_UNSLIDE(e->ev), (unsigned long)VM_KERNEL_UNSLIDE(e->cont));
+				printf("BLUELINE TIMERS:         stack %#lx %#lx %#lx %#lx %#lx %#lx\n",
+				    (unsigned long)VM_KERNEL_UNSLIDE(e->pcs[0]), (unsigned long)VM_KERNEL_UNSLIDE(e->pcs[1]),
+				    (unsigned long)VM_KERNEL_UNSLIDE(e->pcs[2]), (unsigned long)VM_KERNEL_UNSLIDE(e->pcs[3]),
+				    (unsigned long)VM_KERNEL_UNSLIDE(e->pcs[4]), (unsigned long)VM_KERNEL_UNSLIDE(e->pcs[5]));
+			} else {
+				printf("BLUELINE TIMERS:  %5u %s %#lx\n", e->n, kinds[e->kind],
+				    (unsigned long)VM_KERNEL_UNSLIDE(e->func));
+			}
+			e->n = 0;
+		}
+	}
+}
+
+static inline vm_offset_t
+tcs_cmd(int tcs, int cmd, uint32_t reg)
+{
+	return bi.rsc + RSC_TCS_BASE + RSC_TCS_STRIDE * (uint32_t)tcs + reg + RSC_CMD_STRIDE * (uint32_t)cmd;
+}
+
+/* From blueline_rpmh_write after an active vote: keep the wake set in step. */
+void blue_sleepset_note(uint32_t addr, uint32_t data);
+void
+blue_sleepset_note(uint32_t addr, uint32_t data)
+{
+	for (int i = 0; i < bi.ss_n; i++) {
+		if (bi.ss_addr[i] == addr) {
+			bi.ss_wake[i] = data;
+			if (bi.ss_on) {
+				*(volatile uint32_t *)tcs_cmd(TCS_WAKE, i, TCS_CMD_DATA) = data;
+			}
+		}
+	}
+}
+
+extern uint32_t blueline_cmddb_addr(const char *id);
+
+/* From blue_bw_park (0211): 1 once the panel sleeps, 0 before it wakes. */
+void blue_sleepset_panel(int off);
+void
+blue_sleepset_panel(int off)
+{
+	if (!bi.ss_on) {
+		return;
+	}
+	uint32_t m = off ? (1u << bi.ss_n) - 1 : 0;
+	if (!off) {
+		bi.ss_armed = false;
+		__builtin_arm_dmb(DMB_ISH);
+	}
+	*(volatile uint32_t *)(bi.rsc + RSC_TCS_BASE + RSC_TCS_STRIDE * TCS_SLEEP + TCS_CMD_ENABLE) = m;
+	__builtin_arm_dsb(DSB_SY);
+	if (off) {
+		bi.ss_armed = true;
+	}
+	printf(TAG "sleep set %s (panel %s)\n", off ? "armed" : "disarmed", off ? "asleep" : "waking");
+}
+
+static void
+ss_add(const char *name, uint32_t sleep, uint32_t wake)
+{
+	uint32_t a = blueline_cmddb_addr(name);
+	if (a == 0 || bi.ss_n >= 12) {
+		printf(TAG "sleep set: %s not in cmd-db\n", name);
+		return;
+	}
+	bi.ss_addr[bi.ss_n] = a;
+	bi.ss_sleep[bi.ss_n] = sleep;
+	bi.ss_wake[bi.ss_n] = wake;
+	bi.ss_n++;
+}
+
+extern uint32_t blueline_cmddb_aux(const char *id, uint8_t *buf, uint32_t max);
+
+/* Index of the first cmd-db aux level >= want (the top one if none is). */
+static uint32_t
+arc_idx(const char *id, uint16_t want)
+{

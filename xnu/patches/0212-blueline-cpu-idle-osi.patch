+	}
+	while (n > 0 && lv[n - 1] == 0) {
+		n--;
+	}
+	printf(TAG "sleep set: %s levels:", id);
+	for (int i = 0; i < n; i++) {
+		printf(" %u", lv[i]);
+	}
+	printf("\n");
+	for (int i = 0; i < n; i++) {
+		if (lv[i] >= want) {
+			return (uint32_t)i;
+		}
+	}
+	return n > 0 ? (uint32_t)(n - 1) : 0;

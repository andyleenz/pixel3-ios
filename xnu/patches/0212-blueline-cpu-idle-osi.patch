+		*(volatile uint32_t *)tcs_cmd(TCS_SLEEP, i, TCS_CMD_DATA) = bi.ss_sleep[i];
+		*(volatile uint32_t *)tcs_cmd(TCS_WAKE, i, TCS_CMD_MSGID) = 8u | (1u << 16) | (1u << 8);	/* write, response */

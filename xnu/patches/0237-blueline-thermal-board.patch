+/*
+ * 0237: board temperatures from the PM8998 ADC (ADC5 rev2 at SPMI sid 0, 0x3100), as Linux qcom-spmi-adc5.c
+ * reads a thermistor channel: ratiometric calibration, decimation 1024, 200 us settle, one sample; the code
+ * to mV (1875 mV full scale = 0x4000), then the NTCG104EF104 100k pull-up table (qcom-vadc-common.c
+ * adcmap_100k_104ef_104fb_1875_vref). Apple's PMU tdev sensors are board thermistors (30-45 C in use);
+ * fed from SDM845 die sensors (0235) they read 55-69 C at boot and thermalmonitord went to "serious".
+ * One conversion a channel a second at most (cached); each a few ms of SPMI.
+ */
+extern "C" int blueline_spmi_read_sid(uint8_t sid, uint16_t addr, uint8_t *buf, unsigned len);
+extern "C" int blueline_spmi_write_sid(uint8_t sid, uint16_t addr, uint8_t val);
+extern "C" int blueline_spmi_apid(uint8_t sid, uint8_t periph, uint16_t *apid, uint8_t *owner);
+#define BLUE_ADC		0x3100u
+#define BLUE_ADC_STATUS1	0x08u
+#define BLUE_ADC_DIG_PARAM	0x42u	/* .. 0x46 written in order, then CONV_REQ 0x47 */
+#define BLUE_ADC_DATA0		0x50u
+
+static const int16_t blue_ntc_mv[] = {	/* -40 C to 125 C in 5 C steps */
+	1831, 1814, 1791, 1761, 1723, 1675, 1616, 1545, 1463, 1370, 1268, 1160, 1049, 937, 828, 726, 630,
+	544, 467, 399, 340, 290, 247, 209, 179, 153, 130, 112, 96, 82, 71, 62, 53, 46,
+};
+#define BLUE_NTC_N	(sizeof(blue_ntc_mv) / sizeof(blue_ntc_mv[0]))
+
+static IOLock *blue_adc_lock;
+static struct { uint8_t ch; bool ok; int dc; uint64_t at; } blue_adc_cache[4];
+
+/* mV to 0.1 C by linear steps through the table; false outside it */
+static bool
+blue_ntc(int mv, int *dc)
+{
+	if (mv > blue_ntc_mv[0] || mv < blue_ntc_mv[BLUE_NTC_N - 1]) {
+		return false;
+	}
+	for (unsigned i = 1; i < BLUE_NTC_N; i++) {
+		if (mv >= blue_ntc_mv[i]) {
+			int hi = blue_ntc_mv[i - 1], lo = blue_ntc_mv[i];
+			*dc = -400 + 50 * (int)(i - 1) + (hi - mv) * 50 / (hi - lo);
+			return true;
+		}
+	}
+	return false;
+}
+
+/* One conversion: the raw code, or false (SPMI error, no end of conversion, invalid data). */
+static bool
+blue_adc_convert(uint8_t ch, uint16_t *code)
+{
+	uint8_t b[6];
+	if (blueline_spmi_read_sid(0, BLUE_ADC + BLUE_ADC_DIG_PARAM, b, 5)) {
+		return false;
+	}
+	b[0] = (uint8_t)((b[0] & ~0x7cu) | (1u << 4) | (2u << 2));	/* CAL_VAL 0, CAL_SEL ratiometric, DEC_RATIO 1024 */
+	b[1] = (uint8_t)(b[1] & ~0x07u);			/* FAST_AVG: one sample */
+	b[2] = ch;						/* CH_SEL */
+	b[3] = (uint8_t)((b[3] & ~0x0fu) | 2u);			/* HW settle 200 us */
+	b[4] |= 0x80u;						/* EN_CTL1: ADC on */
+	for (unsigned i = 0; i < 5; i++) {
+		if (blueline_spmi_write_sid(0, (uint16_t)(BLUE_ADC + BLUE_ADC_DIG_PARAM + i), b[i])) {
+			return false;
+		}
+	}
+	if (blueline_spmi_write_sid(0, BLUE_ADC + BLUE_ADC_DIG_PARAM + 5, 0x80u)) {	/* CONV_REQ */
+		return false;
+	}
+	for (unsigned t = 0; t < 40; t++) {	/* Linux: 400 x 263 us; a conversion at 1024 is ~1-2 ms */
+		IODelay(300);
+		uint8_t st;
+		if (blueline_spmi_read_sid(0, BLUE_ADC + BLUE_ADC_STATUS1, &st, 1)) {
+			return false;
+		}
+		if ((st & 0x3u) == 0x1u) {	/* EOC, no request pending */
+			uint8_t d[2];
+			if (blueline_spmi_read_sid(0, BLUE_ADC + BLUE_ADC_DATA0, d, 2)) {
+				return false;
+			}
+			*code = (uint16_t)(d[0] | (d[1] << 8));
+			return *code != 0x8000u;
+		}
+	}
+	return false;
+}
 
+/* A thermistor channel in 0.1 C, cached for a second */
+static bool
+blue_board(uint8_t ch, int *dc)
+{
+	if (!blue_adc_lock) {
+		return false;
+	}
+	uint64_t now = mach_absolute_time(), sec;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	IOLockLock(blue_adc_lock);
+	unsigned i = 0;
+	while (i < 4 && blue_adc_cache[i].ch && blue_adc_cache[i].ch != ch) {
+		i++;
+	}
+	bool ok = false;
+	if (i < 4) {
+		if (blue_adc_cache[i].ch == ch && now - blue_adc_cache[i].at < sec) {
+			ok = blue_adc_cache[i].ok;
+			*dc = blue_adc_cache[i].dc;
+		} else {
+			uint16_t code;
+			int v = 0;
+			ok = blue_adc_convert(ch, &code) && code <= 0x7fffu && blue_ntc((int)((uint32_t)code * 1875u / 0x4000u), &v);
+			blue_adc_cache[i].ch = ch;
+			blue_adc_cache[i].ok = ok;
+			blue_adc_cache[i].dc = v;
+			blue_adc_cache[i].at = now;
+			*dc = v;
+		}
+	}
+	IOLockUnlock(blue_adc_lock);
+	return ok;
+}

+
+/*
+ * Test-loop reboot (patch 0127): end a hardware test boot on its own, with
+ * the console log on UFS, in fastboot or in recovery.
+ *
+ *   bluereboot=bootloader|recovery   (also fastboot, or 2|1); off by default
+ *   bluereboot_after=gpu             right after blueline_gpu_probe() (default)
+ *                   =springboard     once a process named SpringBoard exists
+ *                   =N               N seconds after this driver started
+ *   bluereboot_delay=S               S more seconds after the event (default 0)
+ *   bluereboot_timeout=S             springboard: reboot anyway after S s (300)
+ *
+ * When it fires: sync the file systems (not at gpu: no root yet), set the
+ * reboot reason both ways the crosshatch kernel does (msm-poweroff.c):
+ * PM8998 PON SOFT_RB_SPARE reason << 1 (blueline_keys.c) and the IMEM
+ * restart_reason cookie (0x146bf65c = 0x77665500 bootloader / 0x77665502
+ * recovery), print one line, write the console ring to UFS synchronously
+ * (sweet_log_write_locked) and, still holding the UFS lock so no command
+ * is in flight, PSCI SYSTEM_RESET. Nothing else is written: no download
+ * mode cookie, no misc partition, no PS_HOLD.
+ *
+ * Recovery is the active slot's: keep slot B (LineageOS) active and
+ * `fastboot boot` the test kernel, or recovery means boot_a.
+ */
+#define BLUE_IMEM_PA            0x146bf000u     /* qcom,msm-imem@146bf000 */
+#define BLUE_IMEM_RESTART       0x65cu          /* restart_reason@65c */
+#define PSCI_SYSTEM_RESET       0x84000009ull
+
+enum { BR_OFF, BR_GPU, BR_SPRINGBOARD, BR_TIMER };
+
+extern int blueline_pon_set_reboot_reason(uint8_t reason, uint8_t *before, uint8_t *after);
+extern int sync_internal(void);
+
+static struct {
+	int when;
+	uint8_t reason;                         /* PON: 1 recovery, 2 bootloader */
+	uint32_t secs, delay, timeout;
+} br;
+static int bluereboot_chan;
+
+static bool
+bluereboot_number(const char *s, uint32_t *out)
+{
+	uint32_t v = 0;
+	if (*s == 0) {
+		return false;
+	}
+	for (; *s; s++) {
+		if (*s < '0' || *s > '9' || v > 100000) {
+			return false;
+		}
+		v = v * 10 + (uint32_t)(*s - '0');
+	}
+	*out = v;
+	return true;
+}
+
+static void
+bluereboot_sleep(uint32_t secs)
+{
+	if (secs) {
+		(void)tsleep(&bluereboot_chan, PZERO, "bluereboot", (int)secs * hz);
+	}
+}
+
+static const char *
+bluereboot_target(void)
+{
+	return br.reason == 2 ? "bootloader" : "recovery";
+}
+
+static void
+bluereboot_fire(const char *why)
+{
+	uint8_t before = 0, after = 0;
+
+	if (br.when != BR_GPU) {
+		(void)sync_internal();          /* waits for the sync, at most 5 s */
+		bluereboot_sleep(1);            /* as sweet_usb.c "reboot": journal */
+	}
+	int pon = blueline_pon_set_reboot_reason(br.reason, &before, &after);
+	uint32_t cookie = br.reason == 2 ? 0x77665500u : 0x77665502u;
+	vm_offset_t imem = ml_io_map(BLUE_IMEM_PA, 0x1000);
+	if (imem) {
+		*(volatile uint32_t *)(imem + BLUE_IMEM_RESTART) = cookie;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	printf("BLUELINE REBOOT: %s: to %s, PON SOFT_RB_SPARE 0x%02x -> 0x%02x (%d), "
+	    "IMEM restart_reason %s 0x%08x, log %s; PSCI SYSTEM_RESET\n",
+	    why, bluereboot_target(), before, after, pon, imem ? "=" : "unmapped", cookie,
+	    sweet_log_running ? "flushing" : "not on UFS");
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = sweet_log_running ? sweet_log_write_locked() : 0;
+	if (!error) {
+		register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+		__asm__ volatile ("smc #0" : "+r"(x0) : :
+		    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+		    "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+		error = (int)(int32_t)x0;
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	/* Only on failure: carry on booting rather than poke PS_HOLD. */
+	printf("BLUELINE REBOOT: did not reset (log write or PSCI result %d)\n", error);
+}
+
+static int
+bluereboot_find_springboard(proc_t p, void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, "SpringBoard") == 0) {
+		*(bool *)arg = true;
+	}
+	return PROC_RETURNED;
+}
+
+static void
+bluereboot_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	const char *why = "timer";
+
+	if (br.when == BR_TIMER) {
+		bluereboot_sleep(br.secs);
+	} else {
+		why = "SpringBoard timeout";
+		for (uint32_t t = 0; t < br.timeout; t++) {
+			bool found = false;
+			proc_iterate(PROC_ALLPROCLIST, bluereboot_find_springboard, &found, NULL, NULL);
+			if (found) {
+				why = "SpringBoard";
+				printf("BLUELINE REBOOT: SpringBoard is running (~%us), rebooting in %us\n",
+				    t, br.delay);
+				break;
+			}
+			bluereboot_sleep(1);
+		}
+	}
+	bluereboot_sleep(br.delay);
+	bluereboot_fire(why);
+}
+
+static void
+bluereboot_arm(void)
+{
+	char v[32] = "", a[32] = "gpu";
+	thread_t thread;
+
+	if (!PE_parse_boot_arg_str("bluereboot", v, sizeof(v)) || v[0] == 0) {
+		return;
+	}
+	if (!strcmp(v, "bootloader") || !strcmp(v, "fastboot") || !strcmp(v, "2")) {
+		br.reason = 2;
+	} else if (!strcmp(v, "recovery") || !strcmp(v, "1")) {
+		br.reason = 1;
+	} else {
+		printf("BLUELINE REBOOT: bluereboot=%s is not bootloader|recovery; off\n", v);
+		return;
+	}
+	(void)PE_parse_boot_arg_str("bluereboot_after", a, sizeof(a));
+	br.timeout = 300;
+	(void)PE_parse_boot_argn("bluereboot_delay", &br.delay, sizeof(br.delay));
+	(void)PE_parse_boot_argn("bluereboot_timeout", &br.timeout, sizeof(br.timeout));
+	if (!strcmp(a, "gpu")) {
+		br.when = BR_GPU;
+	} else if (!strcmp(a, "springboard") || !strcmp(a, "SpringBoard")) {
+		br.when = BR_SPRINGBOARD;
+	} else if (bluereboot_number(a, &br.secs)) {
+		br.when = BR_TIMER;
+	} else {
+		printf("BLUELINE REBOOT: bluereboot_after=%s is not gpu|springboard|seconds; off\n", a);
+		return;
+	}
+	printf("BLUELINE REBOOT: armed: to %s after %s%s, +%us%s\n", bluereboot_target(), a,
+	    br.when == BR_TIMER ? " s" : "", br.delay,
+	    sweet_log_running ? "" : " (log not on UFS: needs ufsrw=1)");
+	if (br.when != BR_GPU &&
+	    kernel_thread_start(bluereboot_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+static void
+bluereboot_after_gpu(void)
+{
+	if (br.when == BR_GPU) {
+		bluereboot_sleep(br.delay);
+		bluereboot_fire("after GPU probe");
 	}
 }
 

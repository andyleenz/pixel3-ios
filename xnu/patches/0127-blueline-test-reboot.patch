+/* Map the arbiter and find the PON APID, once (keys, or the reboot path alone). */
+static bool
+arb_setup(void)
+{
+	static bool done, ok;
+	if (done) {
+		return ok;
+	}
+	done = true;
+	arb_core = ml_io_map(ARB_CORE_PA, 0x2000);
+	arb_cnfg = ml_io_map(ARB_CNFG_PA, 0x1000);
+	arb_obs = ml_io_map(ARB_OBS_PA, 0x10000);
+	if (!arb_core || !arb_cnfg || !arb_obs) {
+		return false;
+	}
+	uint32_t version = arb_rd(arb_core, 0);
+	arb_count = arb_rd(arb_core, 4) & 0x7ffu;
+	if (version < 0x50000000u || version >= 0x70000000u || arb_count == 0 || arb_count > 512) {
+		return false;
+	}
+	pon_apid = arb_apid(PPID_PON, arb_count);
+	ok = true;
+	return true;
+}
+
+/*
+ * Reboot reason for ABL: PM8998 PON SOFT_RB_SPARE (0x88f) bits 7:1 = reason,
+ * bit 0 kept, as Linux writes it (qpnp_pon_set_restart_reason(), PON gen2,
+ * GENMASK(7, 1), reason << 1; mainline qcom-pon.c "qcom,pm8998-pon"
+ * GEN2_REASON_SHIFT 1, pm8998.dtsi mode-recovery = 1, mode-bootloader = 2).
+ * Only 1 (recovery) and 2 (bootloader) are accepted here. The register is
+ * kept over a PMIC hard reset; ABL's reset-reason protocol reads and clears
+ * it on the next boot. Returns 0 when the read-back matches.
+ */
+int
+blueline_pon_set_reboot_reason(uint8_t reason, uint8_t *before, uint8_t *after)
+{
+	uint8_t old = 0, now = 0;
+
+	*before = *after = 0;
+	if (reason != 1 && reason != 2) {
+		return EINVAL;
+	}
+	if (!arb_setup() || pon_apid == NO_APID) {
+		return ENXIO;
+	}
+	if (!arb_pon_chnl) {
+		arb_pon_chnl = ml_io_map(ARB_CHNLS_PA + 0x10000u * pon_apid, 0x1000);
+	}
+	int error = 0;
+	lck_mtx_lock(&blueline_arb_lock);
+	if (!arb_read(pon_apid, PON_SOFT_RB_SPARE, &old)) {
+		error = EIO;
+	} else {
+		*before = old;
+		uint8_t val = (uint8_t)((old & 0x01u) | (uint8_t)(reason << 1));
+		if (!arb_write(arb_pon_chnl, pon_apid, PON_SOFT_RB_SPARE, val)) {
+			error = EPERM;  /* not owned by the apps EE, or the write failed */
+		} else if (!arb_read(pon_apid, PON_SOFT_RB_SPARE, &now)) {
+			error = EIO;
+		} else {
+			*after = now;
+			error = (now == val) ? 0 : EIO;
+		}
+	}
+	lck_mtx_unlock(&blueline_arb_lock);
+	return error;
+}

+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * mkdir and unlink of a kernel-space path in ctx, for files pushed into the
+ * root at boot (patch 0152, bsd/dev/blueline_payload.c).
+ */
+int blue_kern_mkdir(const char *path, mode_t mode, vfs_context_t ctx);
+int blue_kern_unlink(const char *path, vfs_context_t ctx);
 
+int
+blue_kern_mkdir(const char *path, mode_t mode, vfs_context_t ctx)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & ACCESSPERMS);
+	return mkdir1at(ctx, CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
+
+int
+blue_kern_unlink(const char *path, vfs_context_t ctx)
+{
+	return unlink1(ctx, NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+}
+#endif

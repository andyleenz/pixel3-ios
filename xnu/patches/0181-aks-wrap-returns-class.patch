--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -208,6 +208,17 @@
 	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
 		args->scalarOutput[i] = 0;
 	}
+	/*
+	 * 0181: aks_wrap_key's one scalar out is the class the key was wrapped
+	 * with (scalars in: keybag handle, class). securityd stores it in every
+	 * item (SecDbKeychainItemV7 keyclass) and in metadatakeys.actualKeyclass,
+	 * and looks the item's metadata key up by it. Answering 0 wrote class 0
+	 * everywhere: on the next boot there is no class-0 metadata key, so every
+	 * item read was "corrupt" and deleted (the saved Wi-Fi password among them).
+	 */
+	if (wrap && args->scalarOutputCount >= 1 && args->scalarInputCount >= 2) {
+		args->scalarOutput[0] = args->scalarInput[1];
+	}
 	return sweet_aks_struct_out(args, out, m);
 }
 

+
+/*
+ * ---- 0194: one frame to memory (bluecam_stream=3): IFE-lite RDI0 write master 0, MIPI raw ----
+ * camss-vfe-17x.c's reset, vfe_wm_start and reg update; the IFE's four stream IDs (Linux sdm845.dtsi
+ * camss iommus) in SMMU bypass. The write master keeps writing every frame to the same buffer
+ * (frame increment 0); after the stream stops, the last frame is in it.
+ */
+#define VFE_LITE_PA		0x0acc4000u
+#define CAP_BYTES		(2u << 20)
+#define CAP_W			820u
+#define CAP_H			616u
+extern bool blueline_smmu_identity(uint32_t sid, uint32_t mask, const char *who);	/* blueline_wifi.c */
+extern int bluesnap_put(const char *why, const void *bgra, uint32_t w, uint32_t h);	/* sweet_ufs.c */
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+static vm_offset_t cap_buf;
+static uint64_t cap_pa;
+static bool cap_axi_set, cap_noc_set;
+
+static bool
+cap_prepare(vm_offset_t vfe)
+{
+	bool r1 = false, r2 = false;
+	cap_axi_set = branch_on(gcc_cam + 0x020, "gcc_camera_axi", &r1);
+	cap_noc_set = branch_on(camcc + 0xb124, "camnoc_axi", &r2);
+	(void)rcg_to(0xb004, 5u << 8 | 1, "ife_lite 384 MHz");
+	static const uint32_t sid[4][2] = { { 0x808, 0 }, { 0x810, 8 }, { 0xc08, 0 }, { 0xc10, 8 } };
+	for (int i = 0; i < 4; i++) {
+		if (!blueline_smmu_identity(sid[i][0], sid[i][1], "IFE")) {
+			printf("BLUE CAM: cap: SMMU stream 0x%x not in bypass\n", sid[i][0]);
+			return false;
+		}
+	}
+	if (!cap_buf && kmem_alloc_contig(kernel_map, &cap_buf, CAP_BYTES, PAGE_MASK, 0xfffff, 0, KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		cap_buf = 0;
+		printf("BLUE CAM: cap: no 2 MiB below 4 GiB\n");
+		return false;
+	}
+	cap_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)cap_buf));
+	memset((void *)cap_buf, 0xa5, CAP_BYTES);
+	flush_dcache64((addr64_t)cap_pa, CAP_BYTES, TRUE);
+
+	printf("BLUE CAM: cap: IFE-lite version 0x%x; buffer at 0x%llx\n", rd32(vfe), cap_pa);
+	wr32(vfe + 0x05c, 1u << 31);
+	wr32(vfe + 0x018, 0x3f9fu);			/* core, CAMIF, bus, BDG, registers, TG, DSP, CGC, RDI0-3 */
+	bool ok = poll32(vfe + 0x06c, 1u << 31, 1u << 31, 100000);
+	wr32(vfe + 0x064, ~0u);
+	wr32(vfe + 0x068, ~0u);
+	wr32(vfe + 0x058, 1);
+	printf("BLUE CAM: cap: IFE-lite reset %s\n", ok ? "done" : "TIMED OUT");
+	if (!ok) {
+		return false;
+	}
+	wr32(vfe + 0x05c, ~0u);
+	wr32(vfe + 0x060, ~0u);
+	wr32(vfe + 0x2044, ~0u);
+	wr32(vfe + 0x2048, ~0u);
+	wr32(vfe + 0x204c, ~0u);
+	/* vfe_wm_start(wm 0) */
+	wr32(vfe + 0x226c, 1u << 1 | 1u << 7);
+	wr32(vfe + 0x2080, 0);
+	wr32(vfe + 0x200c, 0xfffff);
+	wr32(vfe + 0x211c, 0);
+	wr32(vfe + 0x2084, 0xffffff);			/* BIT(24) - 1: no address sync for any client */
+	wr32(vfe + 0x225c, 0xf);
+	wr32(vfe + 0x221c, 0xff01);
+	wr32(vfe + 0x2220, 0);
+	wr32(vfe + 0x2224, 0);
+	wr32(vfe + 0x2228, 0xff01);
+	wr32(vfe + 0x2214, (uint32_t)cap_pa);		/* image address */
+	wr32(vfe + 0x2258, 0);				/* frame increment: every frame to the same place */
+	wr32(vfe + 0x2208, 1u << 0 | 1u << 1);		/* enable, MIPI raw */
+	wr32(vfe + 0x04ac, 1u << 1);			/* reg update RDI0 */
+	return true;
+}
+
+static void
+cap_status(vm_offset_t vfe, const char *when)
+{
+	printf("BLUE CAM: cap: %s: IRQ 0x%08x 0x%08x, bus 0x%08x 0x%08x 0x%08x, WM0 0x%x 0x%x, violation 0x%x\n", when,
+	    rd32(vfe + 0x06c), rd32(vfe + 0x070), rd32(vfe + 0x205c), rd32(vfe + 0x2060), rd32(vfe + 0x2064),
+	    rd32(vfe + 0x2200), rd32(vfe + 0x2204), rd32(vfe + 0x07c));
+}
+
+/* 4 pixels in 5 bytes: the high 8 bits of each, then their low 2 bits */
+static inline uint32_t
+raw10(const uint8_t *row, uint32_t x)
+{
+	const uint8_t *g = row + (x >> 2) * 5;
+	return (uint32_t)g[x & 3] << 2 | (g[4] >> ((x & 3) * 2) & 3);
+}
+
+static void
+cap_finish(vm_offset_t vfe)
+{
+	wr32(vfe + 0x2208, 0);
+	wr32(vfe + 0x04ac, 1u << 1);
+	IOSleep(20);
+	cap_status(vfe, "after stop");
+	flush_dcache64((addr64_t)cap_pa, CAP_BYTES, TRUE);
+	const uint8_t *b = (const uint8_t *)cap_buf;
+	uint32_t changed = 0, last = 0;
+	for (uint32_t i = 0; i < CAP_BYTES; i++) {
+		if (b[i] != 0xa5) {
+			changed++;
+			last = i;
+		}
+	}
+	printf("BLUE CAM: cap: %u bytes written, last at %u; first bytes %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    changed, last, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9]);
+	if (changed < CAP_W * CAP_H) {
+		return;
+	}
+	/* line stride from the extent: the packed line is 1025 bytes; the IFE may pad it */
+	uint32_t stride = (last + CAP_H) / CAP_H;
+	printf("BLUE CAM: cap: stride %u bytes per line (%u written / %u lines)\n", stride, last + 1, CAP_H);
+	if (stride < CAP_W * 5 / 4) {
+		return;
+	}
+	uint32_t hist[16] = { 0 }, maxv = 0;
+	for (uint32_t y = 0; y < CAP_H; y++) {
+		for (uint32_t x = 0; x < CAP_W; x++) {
+			uint32_t v = raw10(b + y * stride, x);
+			hist[v >> 6]++;
+			maxv = v > maxv ? v : maxv;
+		}
+	}
+	printf("BLUE CAM: cap: levels (1/16 of 1023):");
+	for (int i = 0; i < 16; i++) {
+		printf(" %u", hist[i]);
+	}
+	printf("; max %u\n", maxv);
+	/* scale so the 99.5th percentile is white */
+	uint32_t total = CAP_W * CAP_H, acc = 0, top = 1023;
+	for (int i = 15; i >= 0; i--) {
+		acc += hist[i];
+		if (acc > total / 200) {
+			top = (uint32_t)(i + 1) * 64;
+			break;
+		}
+	}
+	vm_offset_t img = 0;
+	if (kmem_alloc(kernel_map, &img, round_page(CAP_W * CAP_H * 4), KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return;
+	}
+	uint8_t *o = (uint8_t *)img;
+	for (uint32_t y = 0; y < CAP_H; y++) {
+		for (uint32_t x = 0; x < CAP_W; x++, o += 4) {
+			uint32_t v = raw10(b + y * stride, x) * 255 / top;
+			o[0] = o[1] = o[2] = (uint8_t)(v > 255 ? 255 : v);
+			o[3] = 0xff;
+		}
+	}
+	(void)bluesnap_put("camera raw", (const void *)img, CAP_W, CAP_H);
+	/* RGGB, 2x2 per pixel */
+	o = (uint8_t *)img;
+	for (uint32_t y = 0; y < CAP_H / 2; y++) {
+		const uint8_t *r0 = b + 2 * y * stride, *r1 = r0 + stride;
+		for (uint32_t x = 0; x < CAP_W / 2; x++, o += 4) {
+			uint32_t r = raw10(r0, 2 * x), g = (raw10(r0, 2 * x + 1) + raw10(r1, 2 * x)) / 2, bl = raw10(r1, 2 * x + 1);
+			r = r * 255 / top;
+			g = g * 255 / top;
+			bl = bl * 255 / top;
+			o[0] = (uint8_t)(bl > 255 ? 255 : bl);
+			o[1] = (uint8_t)(g > 255 ? 255 : g);
+			o[2] = (uint8_t)(r > 255 ? 255 : r);
+			o[3] = 0xff;
+		}
+	}
+	(void)bluesnap_put("camera colour", (const void *)img, CAP_W / 2, CAP_H / 2);
+	kmem_free(kernel_map, img, round_page(CAP_W * CAP_H * 4));
+}

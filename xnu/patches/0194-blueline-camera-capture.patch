+/*
+ * 0194: a picture made by another driver (the camera) into the snap area as one more snap:
+ * w x h pixels, B G R A. Same format and pull as bluesnap_take(); needs the area armed.
+ */
+int bluesnap_put(const char *why, const void *bgra, uint32_t w, uint32_t h);
+
+int
+bluesnap_put(const char *why, const void *bgra, uint32_t w, uint32_t h)
+{
+	uint32_t ms;
+	int32_t sb_ms;
+	int error = 0;
+
+	if (!bs.on) {
+		printf("BLUELINE SNAP: %s: snaps not armed (bluesnap_on_reboot=1), not saved\n", why);
+		return ENXIO;
+	}
+	uint32_t bytes = w * h * 4;
+	uint32_t blocks = 1 + (bytes + UFS_BLOCK - 1) / UFS_BLOCK;
+	lck_mtx_lock(&bluesnap_lock);
+	if (bs.count >= BLUESNAP_MAX || bs.used + blocks > BLUESNAP_BLOCKS) {
+		printf("BLUELINE SNAP: %s: area full (%u snaps), not saved\n", why, bs.count);
+		lck_mtx_unlock(&bluesnap_lock);
+		return ENOSPC;
+	}
+	blue_when_now(&ms, &sb_ms);
+	uint64_t at = bs.area + bs.used;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	struct bluesnap_header hd = {
+		.magic = { 'B', 'L', 'U', 'E', 'S', 'N', 'A', 'P' },
+		.nonce = bs.nonce, .version = 1, .index = bs.count, .width = w, .height = h,
+		.bpp = 32, .scale = 1, .bytes = bytes, .ms = ms, .sb_ms = sb_ms,
+		.src_w = w, .src_h = h,
+	};
+	strlcpy(hd.why, why, sizeof(hd.why));
+	lck_mtx_lock(&sweet_ufs_lock);
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &hd, sizeof(hd));
+	error = ufs_write_blocks(at, 1);
+	for (uint32_t off = 0; !error && off < bytes; off += BOUNCE_SIZE) {
+		uint32_t n = MIN(BOUNCE_SIZE, bytes - off);
+		uint32_t nb = (n + UFS_BLOCK - 1) / UFS_BLOCK;
+		memcpy(bounce, (const uint8_t *)bgra + off, n);
+		bzero((char *)bounce + n, nb * UFS_BLOCK - n);
+		error = ufs_write_blocks(at + 1 + off / UFS_BLOCK, nb);
+	}
+	if (!error) {
+		error = bluesnap_write_area_locked(bs.count + 1, bs.used + blocks);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		printf("BLUELINE SNAP: %s: UFS write failed (%d)\n", why, error);
+	} else {
+		printf("BLUELINE SNAP: #%u %s: %ux%u, 32 bpp, %u KiB at block 0x%llx\n", bs.count, why, w, h, bytes >> 10, at);
+		bs.count++;
+		bs.used += blocks;
+	}
+	lck_mtx_unlock(&bluesnap_lock);
+	return error;
+}

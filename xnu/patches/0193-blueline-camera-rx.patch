--- a/bsd/dev/blueline_camera_probe.c
+++ b/bsd/dev/blueline_camera_probe.c
@@ -572,6 +572,7 @@
 /* ---- 0192: stream the front IMX355 (bluecam_stream=1) ---- */
 
 static int cam_stream;
+static int cam_settle = 11;
 

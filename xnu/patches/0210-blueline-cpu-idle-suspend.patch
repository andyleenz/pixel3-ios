@@ -482,6 +482,11 @@
  *	Routine:	cpu_idle
  *	Function:
  */
+#if defined(SWEET)
+/* blueline_idle.c: PSCI CPU_SUSPEND in place of WFI (bluecpu_idle=1) */
+extern bool blue_idle_enter(int cpu, uint64_t deadline);
+#endif
+
 void __attribute__((noreturn))
 cpu_idle(void)
 {
@@ -595,6 +600,10 @@
 #if HAS_RETENTION_STATE
 		arm64_retention_wfi();
 #else
+#if defined(SWEET)
+		/* Powered down instead (if the core lost its state, it wakes in arm_init_idle_cpu). */
+		if (!blue_idle_enter(cpu_data_ptr->cpu_number, cpu_data_ptr->rtcPop))
+#endif
 		__builtin_arm_wfi();
 #endif
 

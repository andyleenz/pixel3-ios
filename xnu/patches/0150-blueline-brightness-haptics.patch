+/*
+ * Pixel 3 (blueline) haptics (patch 0150): Cirrus Logic CS40L20 boosted
+ * haptic driver with a HALO DSP.
+ *
+ * Hardware, from the production device tree overlay (stock dtbo.img entry 8,
+ * "B1 DVT1.1"; the DRV2624 nodes are only on the dev/proto entries 0-2, and
+ * PMI8998's haptics block is disabled):
+ *   cs40l20@43 on qupv3_se5_i2c (i2c@894000): SDA GPIO 85, SCL GPIO 86 (TLMM
+ *   east tile), reset GPIO 87 (active high, pinctrl default output-low),
+ *   no VA/VP supplies listed (always on), boost 1.0 uH / 4 uF / 4.5 A peak,
+ *   f0-default 0x265c50, redc-default 0x50030, gpio1-mode 2 (auto).
+ * Firmware: vendor /firmware/cs40l20.wmfw (the DSP program) and cs40l20.bin
+ * (the wavetable, "WMDR"). Not redistributable: tools/mkadt.py --haptic-fw
+ * copies them into the ADT (/blueline-haptic "wmfw", "wavetable").
+ *
+ * The sequence is the one Linux's drivers/misc/cs40l2x.c (Cirrus Logic,
+ * GPL) runs for revision A0, used here only as a description of the chip
+ * (register addresses, values, file layouts); this file is written from
+ * scratch: reset pulse, OTP boot done, DEVID 0x35A40 / REVID 0xA0, the A0
+ * register fixes, OTP trim unpack (trim tables: register, shift, width,
+ * from that driver's cs40l2x-tables.c), boost, signal routing, DSP memory
+ * protection opened, program and wavetable written, DSP started, playback
+ * timeout set. Playback: an index into the wavetable on MBOX 1 (a click,
+ * ends by itself), or MBOX 2 = 0 for the continuous "vibe" waveform, ended
+ * by the firmware's ENDPLAYBACK control.
+ *
+ * The bus is bit-banged on the SE's pins (blueline_touch.c's
+ * blueline_bbi2c_*, as the MAX1720x in 0141): 32-bit register addresses and
+ * values, big-endian, auto-increment. Program and wavetable go in 16-byte
+ * writes (interrupts are masked per transfer), about 40 KB in all: several
+ * seconds, on a thread of its own. Any failure parks the chip in reset.
+ *
+ * Boot-args:
+ *   bluehaptic=0      off (default)
+ *   bluehaptic=1      probe only: log pins 85-87, pulse reset, wait for OTP
+ *                     boot, read DEVID/REVID/OTPID, put the reset pin back
+ *                     as found
+ *   bluehaptic=2      full bring-up (needs the ADT firmware), then
+ *                     /dev/bluehaptic
+ *   bluehaptic_test=1 after bring-up: three 50 ms buzzes, 300 ms apart
+ *   bluehaptic_test=2 after bring-up: each wavetable entry (click) once, 400 ms apart
+ *   bluehaptic_amp=N  not used yet (the firmware's default gain)
+ * /dev/bluehaptic (0666) takes text lines: "click N" (wavetable entry
+ * N >= 1), "vibe MS" (continuous, capped at 1000 ms, then stopped), "stop".
+ * Log prefix "BLUE HAPTIC:".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <sys/stat.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/thread_call.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern void *blueline_bbi2c_open(uint32_t tlmm_pa, int sda, int scl);	/* blueline_touch.c */
+extern int blueline_bbi2c_xfer(void *bus, uint8_t addr, const uint8_t *w, uint32_t wlen, uint8_t *r,
+    uint32_t rlen);
+extern void IOSleep(unsigned int milliseconds);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+void blueline_haptic_start(void);
+
+#define HAP_TLMM_PA	0x03500000u	/* TLMM east: GPIO 85, 86, 87 */
+#define HAP_SDA		85
+#define HAP_SCL		86
+#define HAP_RESET	87
+#define GPIO_CFG(n)	(0x1000u * (n))
+#define GPIO_IO(n)	(0x1000u * (n) + 4u)
+#define HAP_ADDR	0x43u
+#define HAP_CHUNK	16u		/* bytes per bulk write */
+
+/* CS40L20 registers */
+#define R_DEVID			0x00000000u
+#define R_REVID			0x00000004u
+#define R_OTPID			0x00000010u
+#define R_TEST_KEY_CTL		0x00000040u
+#define R_CTRL_ASYNC1		0x00000054u
+#define R_OTP_MEM0		0x00000400u
+#define R_PWR_CTRL1		0x00002014u
+#define R_PLL_LOOP_PARAM	0x00003008u
+#define R_PLL_MISC_CTRL		0x00003014u
+#define R_BST_PEAK_CUR		0x00003808u
+#define R_BST_COEFF		0x00003810u
+#define R_BST_SLOPE_LBST	0x00003814u
+#define R_BST_DCM_CTRL		0x0000381cu
+#define R_OTP_TRIM_30		0x00007418u
+#define R_DAC_PCM1_SRC		0x00004c00u
+#define R_DSP1_RX2_SRC		0x00004c44u
+#define R_DSP1_RX3_SRC		0x00004c48u
+#define R_DSP1_RX4_SRC		0x00004c4cu
+#define R_IRQ1_STATUS3		0x00010018u
+#define R_IRQ1_STATUS4		0x0001001cu
+#define R_IRQ1_DB3		0x00010318u
+#define R_IRQ2_DB3		0x00010b18u
+#define R_MBOX_TRIGGERINDEX	0x00013020u
+#define R_MBOX_TRIGGER_MS	0x00013024u
+#define R_XMEM_PACK0		0x02000000u
+#define R_XMEM_UNPACK24		0x02800000u
+#define R_XM_FW_ID		(R_XMEM_UNPACK24 + 12u)
+#define R_XM_NUM_ALGOS		(R_XMEM_UNPACK24 + 36u)
+#define R_DSP1_CCM_CORE_CTRL	0x02bc1000u
+#define R_MPU_LOCK_CONFIG	0x02bc3140u
+#define R_YMEM_PACK0		0x02c00000u
+#define R_YMEM_UNPACK24		0x03400000u
+#define R_PMEM0			0x03800000u
+
+#define DEVID_L20		0x035a40u
+#define REVID_A0		0xa0u
+#define FW_REV_MIN		0x040200u
+#define ALGO_LIST_TERM		0xbedeadu
+#define HALO_RUNNING		2u
+#define T_XM_UNPACKED		0x05u
+#define T_YM_UNPACKED		0x06u
+#define T_PM_PACKED		0x10u
+#define T_XM_PACKED		0x11u
+#define T_YM_PACKED		0x12u
+#define T_ALGO_INFO		0xf2u
+#define HAP_TIMEOUT_MS		2000u	/* DSP playback cap (Linux uses ~174 s) */
+#define HAP_VIBE_MAX_MS		1000u
+
+#define F0_DEFAULT		0x265c50u
+#define REDC_DEFAULT		0x050030u
+
+struct hap_trim {
+	uint32_t reg;
+	uint8_t shift, size;
+};
+
+/* OTP map 0xC trims (map 0xD: entry 93 is 0x4000 bit 11; map 0xE: also 0x3010 bits 7:2 at the end). */
+static const struct hap_trim hap_trims[] = {
+	{ 0x2030,  0,  4 }, { 0x2030,  7,  1 }, { 0x208c, 24,  6 }, { 0x2090, 14,  4 },
+	{ 0x2090, 10,  4 }, { 0x300c, 11,  4 }, { 0x394c, 23,  2 }, { 0x3950,  0,  7 },
+	{ 0x3950,  8,  7 }, { 0x3950, 16,  8 }, { 0x3950, 24,  8 }, { 0x3954,  0,  7 },
+	{ 0x3954,  8,  7 }, { 0x3954, 16,  8 }, { 0x3954, 24,  8 }, { 0x3958,  0,  7 },
+	{ 0x3958,  8,  7 }, { 0x3958, 16,  8 }, { 0x3958, 24,  8 }, { 0x395c,  0,  7 },
+	{ 0x395c,  8,  7 }, { 0x395c, 16,  8 }, { 0x395c, 24,  8 }, { 0x416c,  0,  8 },
+	{ 0x4160,  0,  7 }, { 0x416c,  8,  8 }, { 0x4160, 16, 10 }, { 0x416c, 16, 12 },
+	{ 0x416c, 28,  1 }, { 0x4170,  0,  6 }, { 0x4170,  6,  1 }, { 0x4170,  8,  6 },
+	{ 0x4170, 14,  1 }, { 0x4170, 16,  9 }, { 0x4360,  0,  5 }, { 0x4360,  6,  9 },
+	{ 0x4448,  0,  8 }, { 0x4448,  8,  8 }, { 0x4448, 16,  8 }, { 0x4448, 24,  8 },
+	{ 0x444c,  0,  3 }, { 0x6e30,  0,  5 }, { 0x6e30,  8,  5 }, { 0x6e30, 16,  5 },
+	{ 0x6e30, 24,  5 }, { 0x6e34,  0,  5 }, { 0x6e34,  8,  5 }, { 0x6e34, 16,  5 },
+	{ 0x6e34, 24,  5 }, { 0x6e38,  0,  5 }, { 0x6e38,  8,  5 }, { 0x6e38, 16,  5 },
+	{ 0x6e38, 24,  5 }, { 0x6e3c,  0,  5 }, { 0x6e3c,  8,  5 }, { 0x6e3c, 16,  5 },
+	{ 0x6e3c, 24,  5 }, { 0x6e40,  0,  5 }, { 0x6e40,  8,  5 }, { 0x6e40, 16,  5 },
+	{ 0x6e40, 24,  5 }, { 0x6e44,  0,  5 }, { 0x6e48,  0, 10 }, { 0x6e48, 10, 10 },
+	{ 0x6e48, 20, 10 }, { 0x6e4c,  0, 10 }, { 0x6e4c, 10, 10 }, { 0x6e4c, 20, 10 },
+	{ 0x6e50,  0, 10 }, { 0x6e50, 10, 10 }, { 0x6e50, 20, 10 }, { 0x6e54,  0, 10 },
+	{ 0x6e54, 10, 10 }, { 0x6e54, 20, 10 }, { 0x6e58,  0, 10 }, { 0x6e58, 10, 10 },
+	{ 0x6e58, 20, 10 }, { 0x6e5c,  0, 10 }, { 0x6e5c, 10, 10 }, { 0x6e5c, 20, 10 },
+	{ 0x6e60,  0, 10 }, { 0x6e60, 10, 10 }, { 0x6e60, 20, 10 }, { 0x6e64,  0, 10 },
+	{ 0x7418,  7,  5 }, { 0x741c,  0,  5 }, { 0x741c, 11,  4 }, { 0x741c, 19,  4 },
+	{ 0x7434, 17,  1 }, { 0x7434, 18,  7 }, { 0x7068,  0,  9 }, { 0x410c,  7,  1 },
+	{ 0x400c,  0,  7 }, { 0x0000,  0,  1 }, { 0x17040,  0,  8 }, { 0x17040,  8,  8 },
+	{ 0x17040, 16,  8 }, { 0x17040, 24,  8 }, { 0x17044,  0, 24 },
+};
+#define HAP_NTRIMS	(sizeof(hap_trims) / sizeof(hap_trims[0]))
+_Static_assert(HAP_NTRIMS == 99, "cs40l2x trim table C has 99 entries");
+
+/* Firmware controls (coefficients) named by the .wmfw's algorithm blocks. */
+struct hap_coeff {
+	uint32_t algo;
+	uint16_t offset, type;
+	uint32_t reg;
+	char name[32];
+};
+#define HAP_MAX_COEFFS	96
+
+static struct {
+	void *bus;
+	vm_offset_t rst;		/* GPIO 87's registers */
+	uint32_t rst_cfg, rst_io;	/* as found */
+	struct hap_coeff coeff[HAP_MAX_COEFFS];
+	int ncoeff;
+	uint32_t vibegen_id, vibegen_rev;
+	uint32_t wt_limit_xm, wt_limit_ym;
+	uint32_t nwaves;
+	uint32_t r_endplayback;		/* 0 until running */
+	bool ready;
+	int errors;
+} hap;
+
+static int hap_mode, hap_test;
+LCK_GRP_DECLARE(hap_lck_grp, "blueline_haptic");
+LCK_MTX_DECLARE(hap_lock, &hap_lck_grp);
+static thread_call_t hap_stop_call;
+
+static uint32_t
+rd32(vm_offset_t a)
+{
+	uint32_t v = *(volatile uint32_t *)a;
+	__asm__ volatile ("dmb osh" ::: "memory");
+	return v;
+}
+
+static void
+wr32(vm_offset_t a, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)a = v;
+}
+
+/* GPIO 87: plain GPIO output, 2 mA, no pull. */
+static void
+hap_reset_pin(int high)
+{
+	wr32(hap.rst + 4u, high ? 2u : 0u);
+	wr32(hap.rst, 1u << 9);
+}
+
+/* ---- registers ---- */
+
+static int
+hap_rd(uint32_t reg, uint32_t *val)
+{
+	uint8_t a[4] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg };
+	uint8_t v[4];
+	int err = blueline_bbi2c_xfer(hap.bus, HAP_ADDR, a, 4, v, 4);
+	if (err == 0) {
+		*val = (uint32_t)v[0] << 24 | (uint32_t)v[1] << 16 | (uint32_t)v[2] << 8 | v[3];
+	} else {
+		*val = 0;
+		if (hap.errors++ < 8) {
+			printf("BLUE HAPTIC: read 0x%08x: NACK (%d)\n", reg, err);
+		}
+	}
+	return err;
+}
+
+/* len bytes (a multiple of 4), as stored (big-endian words), from reg on. */
+static int
+hap_raw(uint32_t reg, const uint8_t *data, uint32_t len)
+{
+	uint8_t buf[4 + HAP_CHUNK];
+	for (uint32_t i = 0; i < len; i += HAP_CHUNK) {
+		uint32_t n = len - i < HAP_CHUNK ? len - i : HAP_CHUNK;
+		uint32_t r = reg + i;
+		buf[0] = (uint8_t)(r >> 24);
+		buf[1] = (uint8_t)(r >> 16);
+		buf[2] = (uint8_t)(r >> 8);
+		buf[3] = (uint8_t)r;
+		memcpy(buf + 4, data + i, n);
+		int err = blueline_bbi2c_xfer(hap.bus, HAP_ADDR, buf, 4 + n, NULL, 0);
+		if (err) {
+			if (hap.errors++ < 8) {
+				printf("BLUE HAPTIC: write 0x%08x (+%u bytes): NACK (%d)\n", r, n, err);
+			}
+			return err;
+		}
+	}
+	return 0;
+}
+
+static int
+hap_wr(uint32_t reg, uint32_t val)
+{
+	uint8_t v[4] = { (uint8_t)(val >> 24), (uint8_t)(val >> 16), (uint8_t)(val >> 8), (uint8_t)val };
+	return hap_raw(reg, v, 4);
+}
+
+static int
+hap_upd(uint32_t reg, uint32_t mask, uint32_t val)
+{
+	uint32_t old;
+	int err = hap_rd(reg, &old);
+	if (err == 0 && ((old & ~mask) | (val & mask)) != old) {
+		err = hap_wr(reg, (old & ~mask) | (val & mask));
+	}
+	return err;
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint32_t
+hap_coeff_reg(const char *name, uint16_t type)
+{
+	for (int i = 0; i < hap.ncoeff; i++) {
+		if (hap.coeff[i].type == type && hap.coeff[i].reg != 0 && !strcmp(hap.coeff[i].name, name)) {
+			return hap.coeff[i].reg;
+		}
+	}
+	return 0;
+}
+
+static void
+hap_park(const char *why)
+{
+	hap.ready = false;
+	hap.r_endplayback = 0;
+	hap_reset_pin(0);
+	printf("BLUE HAPTIC: %s: chip parked in reset\n", why);
+}
+
+/* ---- bring-up steps ---- */
+
+/* Reset pulse, OTP boot. Returns REVID, or 0. */
+static uint32_t
+hap_boot(void)
+{
+	uint32_t v = 0, devid = 0, revid = 0, otpid = 0, st3 = 0;
+	hap_reset_pin(0);
+	IOSleep(3);
+	hap_reset_pin(1);
+	IOSleep(2);
+	int i;
+	for (i = 0; i < 10; i++) {
+		IOSleep(10);
+		if (hap_rd(R_IRQ1_STATUS4, &v) == 0 && (v & 2u)) {
+			break;
+		}
+	}
+	hap_rd(R_IRQ1_STATUS3, &st3);
+	hap_rd(R_DEVID, &devid);
+	hap_rd(R_REVID, &revid);
+	hap_rd(R_OTPID, &otpid);
+	printf("BLUE HAPTIC: after reset: OTP boot %s (status4 0x%x, %d ms), status3 0x%x%s, DEVID 0x%x%s"
+	    " REVID 0x%x%s OTPID 0x%x\n", (v & 2u) ? "done" : "NOT done", v, (i + 1) * 10, st3,
+	    (st3 & (1u << 31)) ? " (OTP ERROR)" : "", devid, devid == DEVID_L20 ? " (CS40L20)" : " (unexpected)",
+	    revid, revid == REVID_A0 ? " (A0)" : " (unexpected)", otpid);
+	if (!(v & 2u) || (st3 & (1u << 31)) || devid != DEVID_L20) {
+		return 0;
+	}
+	return revid;
+}
+
+static int
+hap_otp_unpack(void)
+{
+	uint32_t otpid, otp[32];
+	if (hap_rd(R_OTPID, &otpid)) {
+		return EIO;
+	}
+	otpid &= 0xfu;
+	if (otpid != 0xc && otpid != 0xd && otpid != 0xe) {
+		printf("BLUE HAPTIC: OTP map 0x%x unknown (untrimmed part?)\n", otpid);
+		return ENODEV;
+	}
+	for (int i = 0; i < 32; i++) {
+		if (hap_rd(R_OTP_MEM0 + 4u * i, &otp[i])) {
+			return EIO;
+		}
+	}
+	if (hap_wr(R_TEST_KEY_CTL, 0x55) || hap_wr(R_TEST_KEY_CTL, 0xaa)) {
+		return EIO;
+	}
+	uint32_t row = 2, col = 16, n = HAP_NTRIMS + (otpid == 0xe ? 1 : 0), written = 0;
+	int err = 0;
+	for (uint32_t i = 0; i < n && !err; i++) {
+		struct hap_trim t = i < HAP_NTRIMS ? hap_trims[i] : (struct hap_trim){ 0x3010, 2, 6 };
+		if (i == 93 && otpid != 0xc) {
+			t = (struct hap_trim){ 0x4000, 11, 1 };
+		}
+		if (row >= 32) {
+			err = EINVAL;
+			break;
+		}
+		uint64_t pair = (uint64_t)otp[row] | (row + 1 < 32 ? (uint64_t)otp[row + 1] << 32 : 0);
+		uint32_t val = (uint32_t)((pair >> col) & ((1ull << t.size) - 1));
+		col += t.size;
+		if (col > 31) {
+			col -= 32;
+			row++;
+		}
+		if (t.reg == 0) {
+			continue;
+		}
+		uint32_t mask = (uint32_t)(((1ull << t.size) - 1) << t.shift);
+		err = hap_upd(t.reg, mask, val << t.shift);
+		written++;
+	}
+	hap_wr(R_TEST_KEY_CTL, 0xcc);
+	hap_wr(R_TEST_KEY_CTL, 0x33);
+	printf("BLUE HAPTIC: OTP map 0x%x: %u trims written%s\n", otpid, written, err ? ", FAILED" : "");
+	return err;
+}
+
+static int
+hap_chip_init(void)
+{
+	static const uint32_t a0_fix[][2] = {
+		{ R_OTP_TRIM_30, 0x9091a1c8u }, { R_PLL_LOOP_PARAM, 0x000c1837u },
+		{ R_PLL_MISC_CTRL, 0x03008e0eu }, { R_BST_DCM_CTRL, 0x51u },
+		{ R_CTRL_ASYNC1, 4u }, { R_IRQ1_DB3, 0 }, { R_IRQ2_DB3, 0 },
+	};
+	for (unsigned i = 0; i < sizeof(a0_fix) / sizeof(a0_fix[0]); i++) {
+		if (hap_wr(a0_fix[i][0], a0_fix[i][1])) {
+			return EIO;
+		}
+	}
+	int err = hap_otp_unpack();
+	if (err) {
+		return err;
+	}
+	/* Boost: 1.0 uH, 4 uF (K1 = K2 = 0x24, slope 0x75), 4500 mA peak ((4500 - 1600) / 50 + 0x10). */
+	err = hap_upd(R_BST_COEFF, 0xffu, 0x24u) ||
+	    hap_upd(R_BST_COEFF, 0xff00u, 0x24u << 8) ||
+	    hap_upd(R_BST_SLOPE_LBST, 0xff00u, 0x75u << 8) ||
+	    hap_upd(R_BST_SLOPE_LBST, 0x3u, 0) ||
+	    hap_upd(R_BST_PEAK_CUR, 0x7fu, 0x4au) ||
+	    /* DAC from DSP TX1; DSP RX2..4 from VMON, IMON, VPMON */
+	    hap_upd(R_DAC_PCM1_SRC, 0x7fu, 0x32u) ||
+	    hap_upd(R_DSP1_RX2_SRC, 0x7fu, 0x18u) ||
+	    hap_upd(R_DSP1_RX3_SRC, 0x7fu, 0x19u) ||
+	    hap_upd(R_DSP1_RX4_SRC, 0x7fu, 0x28u);
+	if (err) {
+		return EIO;
+	}
+	/* DSP memory protection: everything accessible. */
+	static const uint16_t mpu[] = {
+		0x3000, 0x3004, 0x3008, 0x300c, 0x3014, 0x3020, 0x3024, 0x302c,
+		0x3038, 0x303c, 0x3044, 0x3050, 0x3054, 0x305c,
+	};
+	err = hap_wr(R_MPU_LOCK_CONFIG, 0x5555) || hap_wr(R_MPU_LOCK_CONFIG, 0xaaaa);
+	for (unsigned i = 0; i < sizeof(mpu) / sizeof(mpu[0]) && !err; i++) {
+		err = hap_wr(0x02bc0000u + mpu[i], 0xffffffffu);
+	}
+	err = err || hap_wr(R_MPU_LOCK_CONFIG, 0);
+	printf("BLUE HAPTIC: A0 fixes, trims, boost (1.0 uH, 4 uF, 4.5 A), routing, MPU open%s\n",
+	    err ? ": FAILED" : "");
+	return err ? EIO : 0;
+}
+
+static void
+hap_algo_info(const uint8_t *d, uint32_t len)
+{
+	if (len < 12) {
+		return;
+	}
+	uint32_t pos = 0, id = le32(d);
+	pos += 4;
+	pos += (d[pos] / 4u) * 4u + 4u;                         /* name */
+	if (pos + 2 > len) {
+		return;
+	}
+	pos += ((uint32_t)(d[pos] | d[pos + 1] << 8) / 4u) * 4u + 4u;   /* description */
+	if (pos + 4 > len) {
+		return;
+	}
+	uint32_t count = le32(d + pos);
+	pos += 4;
+	for (uint32_t i = 0; i < count && pos + 9 <= len; i++) {
+		uint16_t off = (uint16_t)(d[pos] | d[pos + 1] << 8);
+		uint16_t type = (uint16_t)(d[pos + 2] | d[pos + 3] << 8);
+		uint32_t blen = le32(d + pos + 4);
+		uint32_t nlen = d[pos + 8];
+		if (hap.ncoeff < HAP_MAX_COEFFS) {
+			struct hap_coeff *c = &hap.coeff[hap.ncoeff++];
+			c->algo = id;
+			c->offset = off;
+			c->type = type;
+			c->reg = 0;
+			uint32_t m = nlen < sizeof(c->name) - 1 ? nlen : sizeof(c->name) - 1;
+			if (pos + 9 + m > len) {
+				m = 0;
+			}
+			memcpy(c->name, d + pos + 9, m);
+			c->name[m] = 0;
+		}
+		pos += 8 + blen;
+	}
+}
+
+static int
+hap_load_wmfw(const uint8_t *fw, uint32_t size)
+{
+	if (size < 40 || memcmp(fw, "WMFW", 4)) {
+		printf("BLUE HAPTIC: wmfw: not a WMFW file\n");
+		return EINVAL;
+	}
+	uint32_t pos = 40, blocks = 0, bytes = 0;
+	uint64_t t0 = mach_absolute_time();
+	while (pos + 8 <= size) {
+		uint32_t off = (uint32_t)fw[pos] | (uint32_t)fw[pos + 1] << 8 | (uint32_t)fw[pos + 2] << 16;
+		uint8_t type = fw[pos + 3];
+		uint32_t len = le32(fw + pos + 4);
+		pos += 8;
+		if (len > size - pos) {
+			printf("BLUE HAPTIC: wmfw: block at %u runs past the end\n", pos - 8);
+			return EINVAL;
+		}
+		uint32_t reg = 0;
+		switch (type) {
+		case T_PM_PACKED: reg = R_PMEM0 + off * 5u; break;
+		case T_XM_PACKED: reg = R_XMEM_PACK0 + off * 3u; break;
+		case T_YM_PACKED: reg = R_YMEM_PACK0 + off * 3u; break;
+		case T_ALGO_INFO: hap_algo_info(fw + pos, len); break;
+		default: break;
+		}
+		if (reg != 0) {
+			if (len & 3u) {
+				printf("BLUE HAPTIC: wmfw: type 0x%x block of %u bytes\n", type, len);
+				return EINVAL;
+			}
+			if (hap_raw(reg, fw + pos, len)) {
+				return EIO;
+			}
+			blocks++;
+			bytes += len;
+		}
+		pos += len;
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("BLUE HAPTIC: wmfw: %u blocks, %u bytes written in %llu ms, %d controls\n", blocks, bytes,
+	    ns / 1000000, hap.ncoeff);
+	return 0;
+}
+
+/* Algorithm list in XM: place the controls, find VIBEGEN's wavetable. */
+static int
+hap_coeff_init(void)
+{
+	uint32_t num, reg = R_XM_FW_ID, term = 0;
+	if (hap_rd(R_XM_NUM_ALGOS, &num) || num > 16) {
+		printf("BLUE HAPTIC: algorithm count %u bad\n", num);
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < num + 1; i++) {
+		uint32_t e[6];
+		for (int k = 0; k < 6; k++) {
+			if (hap_rd(reg + 4u * k, &e[k])) {
+				return EIO;
+			}
+		}
+		printf("BLUE HAPTIC: algo %u: id 0x%x rev %u.%u.%u XM base 0x%x size 0x%x YM base 0x%x size 0x%x\n",
+		    i, e[0], (e[1] >> 16) & 0xff, (e[1] >> 8) & 0xff, e[1] & 0xff, e[2], e[3], e[4], e[5]);
+		if (i == 0 && e[1] < FW_REV_MIN) {
+			printf("BLUE HAPTIC: firmware revision below 4.2.0\n");
+			return EINVAL;
+		}
+		for (int c = 0; c < hap.ncoeff; c++) {
+			struct hap_coeff *co = &hap.coeff[c];
+			if (co->algo != e[0]) {
+				continue;
+			}
+			if (co->type == T_XM_UNPACKED) {
+				co->reg = R_XMEM_UNPACK24 + e[2] * 4u + co->offset * 4u;
+				if (!strcmp(co->name, "WAVETABLE")) {
+					hap.wt_limit_xm = (e[3] - co->offset) * 4u;
+					hap.vibegen_id = e[0];
+					hap.vibegen_rev = e[1];
+				}
+			} else if (co->type == T_YM_UNPACKED) {
+				co->reg = R_YMEM_UNPACK24 + e[4] * 4u + co->offset * 4u;
+				if (!strcmp(co->name, "WAVETABLEYM")) {
+					hap.wt_limit_ym = (e[5] - co->offset) * 4u;
+				}
+			}
+		}
+		reg += i ? 24u : 28u;
+	}
+	hap_rd(reg, &term);
+	if (term != ALGO_LIST_TERM) {
+		printf("BLUE HAPTIC: algorithm list terminator 0x%x\n", term);
+		return EINVAL;
+	}
+	printf("BLUE HAPTIC: wavetable room %u bytes XM, %u YM (VIBEGEN 0x%x)\n", hap.wt_limit_xm,
+	    hap.wt_limit_ym, hap.vibegen_id);
+	return hap.vibegen_id ? 0 : ENOENT;
+}
+
+static int
+hap_load_wavetable(const uint8_t *wt, uint32_t size)
+{
+	if (size < 16 || memcmp(wt, "WMDR", 4)) {
+		printf("BLUE HAPTIC: wavetable: not a WMDR file\n");
+		return EINVAL;
+	}
+	uint32_t pos = 16;
+	while (pos + 20 <= size) {
+		uint32_t type = (uint32_t)wt[pos + 2] | (uint32_t)wt[pos + 3] << 8;
+		uint32_t algo = le32(wt + pos + 4), rev = le32(wt + pos + 8), len = le32(wt + pos + 16);
+		pos += 20;
+		if (len > size - pos) {
+			printf("BLUE HAPTIC: wavetable: block runs past the end\n");
+			return EINVAL;
+		}
+		if (type == T_XM_UNPACKED || type == T_YM_UNPACKED) {
+			bool xm = type == T_XM_UNPACKED;
+			uint32_t reg = hap_coeff_reg(xm ? "WAVETABLE" : "WAVETABLEYM", (uint16_t)type);
+			uint32_t limit = xm ? hap.wt_limit_xm : hap.wt_limit_ym;
+			if (algo != hap.vibegen_id || ((rev >> 8) & 0xff0000u) != (hap.vibegen_rev & 0xff0000u) ||
+			    reg == 0 || len > limit || (len & 3u)) {
+				printf("BLUE HAPTIC: wavetable %s block: algo 0x%x rev 0x%x, %u bytes (room %u, reg 0x%x):"
+				    " does not fit this firmware\n", xm ? "XM" : "YM", algo, rev, len, limit, reg);
+				return EINVAL;
+			}
+			if (hap_raw(reg, wt + pos, len)) {
+				return EIO;
+			}
+			printf("BLUE HAPTIC: wavetable %s: %u bytes at 0x%x\n", xm ? "XM" : "YM", len, reg);
+		}
+		pos += len;
+	}
+	return 0;
+}
+
+static int
+hap_dsp_start(void)
+{
+	uint32_t r_gpio = hap_coeff_reg("GPIO_ENABLE", T_XM_UNPACKED);
+	uint32_t r_halo = hap_coeff_reg("HALO_STATE", T_XM_UNPACKED);
+	uint32_t r_tmo = hap_coeff_reg("TIMEOUT_MS", T_XM_UNPACKED);
+	uint32_t r_nw = hap_coeff_reg("NUMBEROFWAVES", T_XM_UNPACKED);
+	uint32_t r_f0 = hap_coeff_reg("F0_STORED", T_XM_UNPACKED);
+	uint32_t r_redc = hap_coeff_reg("REDC_STORED", T_XM_UNPACKED);
+	uint32_t r_end = hap_coeff_reg("ENDPLAYBACK", T_XM_UNPACKED);
+	printf("BLUE HAPTIC: controls: GPIO_ENABLE 0x%x HALO_STATE 0x%x TIMEOUT_MS 0x%x NUMBEROFWAVES 0x%x"
+	    " F0_STORED 0x%x REDC_STORED 0x%x ENDPLAYBACK 0x%x\n", r_gpio, r_halo, r_tmo, r_nw, r_f0, r_redc, r_end);
+	if (!r_halo || !r_tmo || !r_nw || !r_end) {
+		return ENOENT;
+	}
+	if (r_gpio && hap_wr(r_gpio, 0)) {                      /* GPIO1 button trigger off */
+		return EIO;
+	}
+	if (hap_upd(R_PWR_CTRL1, 1u, 1u) || hap_upd(R_DSP1_CCM_CORE_CTRL, 0x201u, 0x201u)) {
+		return EIO;
+	}
+	uint32_t st = 0;
+	int i;
+	for (i = 0; i < 10; i++) {
+		IOSleep(10);
+		if (hap_rd(r_halo, &st) == 0 && st == HALO_RUNNING) {
+			break;
+		}
+	}
+	if (st != HALO_RUNNING) {
+		printf("BLUE HAPTIC: DSP state %u after 100 ms, not running\n", st);
+		return ETIMEDOUT;
+	}
+	if (hap_wr(r_tmo, HAP_TIMEOUT_MS) || hap_rd(r_nw, &hap.nwaves)) {
+		return EIO;
+	}
+	if ((r_f0 && hap_wr(r_f0, F0_DEFAULT)) || (r_redc && hap_wr(r_redc, REDC_DEFAULT))) {
+		return EIO;
+	}
+	printf("BLUE HAPTIC: DSP running after %d ms, %u waveforms, playback cap %u ms, f0 0x%x ReDC 0x%x\n",
+	    (i + 1) * 10, hap.nwaves, HAP_TIMEOUT_MS, F0_DEFAULT, REDC_DEFAULT);
+	if (hap.nwaves == 0) {
+		return ENOENT;
+	}
+	hap.r_endplayback = r_end;
+	return 0;
+}
+
+/* ---- playback (hap_lock held) ---- */
+
+static int
+hap_stop_locked(void)
+{
+	if (!hap.ready) {
+		return ENXIO;
+	}
+	for (int i = 0; i < 10; i++) {
+		if (hap_wr(hap.r_endplayback, 1) == 0) {
+			return 0;
+		}
+		IOSleep(10);
+	}
+	hap_park("ENDPLAYBACK not taken");
+	return EIO;
+}
+
+static int
+hap_click_locked(uint32_t index)
+{
+	if (!hap.ready) {
+		return ENXIO;
+	}
+	if (index < 1 || index > hap.nwaves || index > 0x7fff) {
+		return EINVAL;
+	}
+	return hap_wr(R_MBOX_TRIGGERINDEX, index) ? EIO : 0;
+}
+
+static int
+hap_vibe_locked(uint32_t ms)
+{
+	if (!hap.ready) {
+		return ENXIO;
+	}
+	if (ms == 0) {
+		return hap_stop_locked();
+	}
+	if (ms > HAP_VIBE_MAX_MS) {
+		ms = HAP_VIBE_MAX_MS;
+	}
+	if (hap_wr(R_MBOX_TRIGGER_MS, 0)) {                     /* index 0: the continuous waveform */
+		return EIO;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	thread_call_enter_delayed(hap_stop_call, deadline);
+	return 0;
+}
+
+static void
+hap_stop_fired(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	lck_mtx_lock(&hap_lock);
+	hap_stop_locked();
+	lck_mtx_unlock(&hap_lock);
+}
+
+/* ---- /dev/bluehaptic ---- */
+
+static uint32_t hap_cmds;
+
+static int
+hap_dev_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return 0;
+}
+
+static int
+hap_dev_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return 0;
+}
+
+static int
+hap_dev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	char buf[64];
+	user_ssize_t n = uio_resid(uio);
+	if (n <= 0) {
+		return 0;
+	}
+	if (n > (user_ssize_t)sizeof(buf) - 1) {
+		n = sizeof(buf) - 1;
+	}
+	int err = uiomove(buf, (int)n, uio);
+	if (err) {
+		return err;
+	}
+	buf[n] = 0;
+	uio_setresid(uio, 0);                                   /* the rest of a long write is dropped */
+	char *nl = strchr(buf, '\n');
+	if (nl != NULL) {
+		*nl = 0;
+	}
+	uint32_t arg = 0;
+	const char *num = strchr(buf, ' ');
+	if (num != NULL) {
+		while (*num == ' ') {
+			num++;
+		}
+		while (*num >= '0' && *num <= '9' && arg < 1000000) {
+			arg = arg * 10 + (uint32_t)(*num++ - '0');
+		}
+	}
+	lck_mtx_lock(&hap_lock);
+	if (!strncmp(buf, "click", 5)) {
+		err = hap_click_locked(arg);
+	} else if (!strncmp(buf, "vibe", 4)) {
+		err = hap_vibe_locked(arg);
+	} else if (!strncmp(buf, "stop", 4)) {
+		thread_call_cancel(hap_stop_call);
+		err = hap_stop_locked();
+	} else {
+		err = EINVAL;
+	}
+	uint32_t c = ++hap_cmds;
+	lck_mtx_unlock(&hap_lock);
+	if (c <= 32 || err) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		printf("BLUE HAPTIC: %s: \"%s\" -> %d\n", name, buf, err);
+	}
+	return err;
+}
+
+static const struct cdevsw hap_cdevsw = {
+	.d_open = hap_dev_open, .d_close = hap_dev_close,
+	.d_read = eno_rdwrt, .d_write = hap_dev_write, .d_ioctl = eno_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc, .d_type = 0,
+};
+
+/* ---- bring-up thread ---- */
+
+static void
+hap_log_pins(const char *when)
+{
+	vm_offset_t t = ml_io_map(HAP_TLMM_PA + GPIO_CFG(HAP_SDA), 0x3000);
+	if (t == 0) {
+		return;
+	}
+	printf("BLUE HAPTIC: pins %s: SDA85 cfg 0x%x io 0x%x, SCL86 cfg 0x%x io 0x%x, RST87 cfg 0x%x io 0x%x\n",
+	    when, rd32(t), rd32(t + 4), rd32(t + 0x1000), rd32(t + 0x1004), rd32(t + 0x2000), rd32(t + 0x2004));
+}
+
+static void
+hap_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int err = 0;
+	hap_log_pins("as found");
+	hap.rst = ml_io_map(HAP_TLMM_PA + GPIO_CFG(HAP_RESET), 0x1000);
+	if (hap.rst == 0) {
+		printf("BLUE HAPTIC: no TLMM mapping\n");
+		return;
+	}
+	hap.rst_cfg = rd32(hap.rst);
+	hap.rst_io = rd32(hap.rst + 4u);
+	hap.bus = blueline_bbi2c_open(HAP_TLMM_PA, HAP_SDA, HAP_SCL);
+	if (hap.bus == NULL) {
+		printf("BLUE HAPTIC: no bit-banged bus (BBI2C_MAX_BUSES?)\n");
+		return;
+	}
+	lck_mtx_lock(&hap_lock);
+	uint32_t revid = hap_boot();
+	if (hap_mode == 1 || revid == 0) {
+		wr32(hap.rst + 4u, hap.rst_io);
+		wr32(hap.rst, hap.rst_cfg);
+		lck_mtx_unlock(&hap_lock);
+		hap_log_pins("restored");
+		printf("BLUE HAPTIC: probe %s, reset pin restored (cfg 0x%x io 0x%x)\n",
+		    revid ? "done" : "FAILED", hap.rst_cfg, hap.rst_io);
+		return;
+	}
+	if (revid != REVID_A0) {
+		lck_mtx_unlock(&hap_lock);
+		hap_park("only revision A0 (cs40l20.wmfw) is handled");
+		return;
+	}
+
+	DTEntry node;
+	void const *wmfw = NULL, *wt = NULL;
+	unsigned wmfw_size = 0, wt_size = 0;
+	if (SecureDTLookupEntry(NULL, "/blueline-haptic", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "wmfw", &wmfw, &wmfw_size) != kSuccess ||
+	    SecureDTGetProperty(node, "wavetable", &wt, &wt_size) != kSuccess) {
+		lck_mtx_unlock(&hap_lock);
+		hap_park("no /blueline-haptic wmfw + wavetable in the ADT (tools/mkadt.py --haptic-fw)");
+		return;
+	}
+	printf("BLUE HAPTIC: ADT wmfw %u bytes, wavetable %u bytes\n", wmfw_size, wt_size);
+	err = hap_chip_init();
+	err = err ? err : hap_load_wmfw(wmfw, wmfw_size);
+	err = err ? err : hap_coeff_init();
+	err = err ? err : hap_load_wavetable(wt, wt_size);
+	err = err ? err : hap_dsp_start();
+	if (err) {
+		lck_mtx_unlock(&hap_lock);
+		hap_park("bring-up failed");
+		return;
+	}
+	hap.ready = true;
+	lck_mtx_unlock(&hap_lock);
+
+	int major = cdevsw_add(-1, &hap_cdevsw);
+	if (major >= 0) {
+		devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "bluehaptic");
+	}
+	printf("BLUE HAPTIC: ready, /dev/bluehaptic %s (\"click N\" 1..%u, \"vibe MS\" <= %u, \"stop\")\n",
+	    major >= 0 ? "made" : "NOT made", hap.nwaves, HAP_VIBE_MAX_MS);
+
+	if (hap_test == 1) {
+		for (int i = 0; i < 3; i++) {
+			lck_mtx_lock(&hap_lock);
+			err = hap_wr(R_MBOX_TRIGGER_MS, 0) ? EIO : 0;
+			lck_mtx_unlock(&hap_lock);
+			IOSleep(50);
+			lck_mtx_lock(&hap_lock);
+			int err2 = hap_stop_locked();
+			lck_mtx_unlock(&hap_lock);
+			printf("BLUE HAPTIC: test buzz %d/3 (50 ms): start %d stop %d\n", i + 1, err, err2);
+			IOSleep(300);
+		}
+	} else if (hap_test == 2) {
+		for (uint32_t i = 1; i <= hap.nwaves && i <= 64; i++) {
+			lck_mtx_lock(&hap_lock);
+			err = hap_click_locked(i);
+			lck_mtx_unlock(&hap_lock);
+			printf("BLUE HAPTIC: test click %u/%u: %d\n", i, hap.nwaves, err);
+			IOSleep(400);
+		}
+	}
+}
+
+/* bsd/dev/sweet_ufs.c, after the touchscreen. */
+void
+blueline_haptic_start(void)
+{
+	PE_parse_boot_argn("bluehaptic", &hap_mode, sizeof(hap_mode));
+	PE_parse_boot_argn("bluehaptic_test", &hap_test, sizeof(hap_test));
+	if (hap_mode <= 0) {
+		return;
+	}
+	hap_stop_call = thread_call_allocate(hap_stop_fired, NULL);
+	thread_t th;
+	if (hap_stop_call == NULL || kernel_thread_start(hap_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("BLUE HAPTIC: no thread\n");
+		return;
+	}
+	thread_deallocate(th);
+	printf("BLUE HAPTIC: bluehaptic=%d test=%d: CS40L20 at 0x43 on GPIO 85/86, reset GPIO 87\n", hap_mode, hap_test);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */

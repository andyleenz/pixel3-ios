new file mode 100644
index 000000000..b00e0c4fc
--- /dev/null
+++ b/iokit/Kernel/arm/BlueBacklight.cpp
@@ -0,0 +1,646 @@
+/*
+ * Pixel 3 (blueline) display brightness (patch 0150).
+ *
+ * The panel: LG SW43408 AMOLED, DSC, DSI command mode on DSI0 (0xae94000),
+ * brightness by the DCS command SET_DISPLAY_BRIGHTNESS (0x51) with two
+ * parameter bytes, most significant first. Downstream crosshatch
+ * dsi-panel-sw43408-dsc-fhd-cmd.dtsi: qcom,mdss-dsi-bl-pmic-control-type =
+ * "bl_ctrl_dcs" (no PWM, no WLED), bl-min-level 0x8 ("2.74 nits"),
+ * bl-max-level 0x384 = 900 ("399.81 nits"), up to 0x3ff in its HBM range;
+ * its own lp-mode commands write "39 .. 03 51 03 87" (0x387, big-endian).
+ * Mainline panel-lg-sw43408.c: mipi_dsi_dcs_set_display_brightness_large()
+ * (big-endian u16). No WRCTRLD (0x53) is sent here: ABL's init sequence
+ * (the dtsi's on-command, "53 0C 30") already enables brightness control.
+ *
+ * The write: a DCS long write (data type 0x39, 3 bytes: 51 hi lo) from the
+ * DSI0 command FIFO, low-power mode, as 0123's short writes (dcsWrite() in
+ * SweetFramebuffer.cpp; downstream dsi_ctrl_hw_cmn_kickoff_fifo_command(),
+ * header bytes as upstream dsi_host.c dsi_cmd_dma_add(): WC lo, WC hi,
+ * VC|DT, flags 0x80 last | 0x40 long; payload padded with 0xff). Before it,
+ * the MDP's autorefresh on the pingpong feeding DSI0 is stopped and the
+ * frame in flight drained, and it is put back afterwards (a command-mode
+ * panel keeps showing its own frame memory meanwhile).
+ *
+ * All DSI writes run on AppleCLCD's vsync workloop thread (blue_bl_tick()),
+ * so they never overlap 0123's display off/on DCS writes, and (with the
+ * 0145 flip on) only while the framebuffer's present lock is free. A request
+ * only records the wanted level; the tick sends the latest one at most
+ * every BL_MIN_TICKS vsyncs. Never while the display is off: the level is
+ * sent again once it is back on. Any write that does not complete turns
+ * the DCS path off for the boot (autorefresh restored); requests are still
+ * logged.
+ *
+ * Where iOS asks (none confirmed yet; everything is logged so the first
+ * boot with the brightness slider moved says which):
+ *   - backboardd/SpringBoard (CoreBrightness CBDisplayContaineriOS, PowerLog,
+ *     BiometricKit) look for an "AppleARMBacklight" service matching
+ *     IOPropertyMatch { backlight-control = true } (seen on this phone:
+ *     "matching ... backlight-control -> 0 found"). bluebl=2 publishes one,
+ *     with IODisplayParameters { brightness { min 0, max 65536, value } },
+ *     and takes setProperties: "brightness" (or IODisplayParameters'
+ *     brightness, a number or { value }) as a fraction of max; nits keys
+ *     ("brightness-nits", "DisplayNits", "IOMFBBrightnessLevel", "nits"; 16.16
+ *     fixed point when above 0xffff) as nits, 400 nits = level 900.
+ *   - the IOMobileFramebuffer service (AppleCLCD) itself: the same keys
+ *     through its setProperties (bluebl=1 and up).
+ *   - IOMobileFramebuffer user-client selectors 50 SetBrightnessCorrection,
+ *     66 SPLCSetBrightness, 67 SPLCGetBrightness and 68 SetParameter
+ *     (backboardd calls 50 and 68 on every boot): arguments logged, nothing
+ *     applied (the scale is unknown).
+ *
+ * Boot-args:
+ *   bluebl=0         off (no DSI access, no hooks)
+ *   bluebl=1         default: DCS backend and the AppleCLCD hooks
+ *   bluebl=2         also publish AppleARMBacklight (experimental: what
+ *                    CoreBrightness does with it is not known yet)
+ *   bluebl_min=N     lowest level ever sent (default 32 of 900, about 14 nits;
+ *                    never below 8, the panel's minimum): the screen is never
+ *                    turned fully dark by a brightness request
+ *   bluebl_max=N     level for 100 % (default 900, at most 1023)
+ *   bluebl_test=1    5 s after the framebuffer starts: 100 % -> 20 % -> 100 %
+ *                    in 10 % steps, 0.5 s each, 2 s at 20 %, every write logged
+ *   bluebl_log=N     log the first N requests individually (default 64), then
+ *                    one line in 32
+ * Log prefix "BLUE BL:".
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <sys/proc.h>
+#include <pexpert/pexpert.h>
+#include <machine/atomic.h>     /* DSB_SY */
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* Registers as 0123 (SweetFramebuffer.cpp): DSI 6G offsets, SDM845 PINGPONG_0..3. */
+#define BL_DSI0_PA              0x0ae94000ULL
+#define BL_PP_PAGE_PA           0x0ae70000ULL   /* 16K page: PINGPONG_0..3 at +0x1000 + 0x800 * n */
+#define BL_PANEL_LINES          2160
+
+#define DSI_CTRL_REG            0x004
+#define DSI_STATUS_REG          0x008
+#define DSI_CMD_DMA_CTRL        0x03c
+#define DSI_DMA_CMD_LENGTH      0x04c
+#define DSI_TRIG_CTRL           0x084
+#define DSI_DMA_SW_TRIGGER      0x090
+#define DSI_INT_CTRL            0x110
+#define DSI_TPG_CTRL            0x15c
+#define DSI_TPG_CMD_DMA_INIT    0x17c
+#define DSI_TPG_DMA_FIFO_RESET  0x1ec
+
+#define PP_SYNC_CONFIG_VSYNC    0x004
+#define PP_LINE_COUNT           0x02c
+#define PP_AUTOREFRESH_CONFIG   0x030
+
+#define BL_PANEL_MIN            8       /* qcom,mdss-dsi-bl-min-level */
+#define BL_PANEL_MAX            900     /* qcom,mdss-dsi-bl-max-level, 399.81 nits */
+#define BL_HW_MAX               1023    /* 0x3ff, the HBM range's top */
+#define BL_NITS_AT_MAX          400
+#define BL_MIN_TICKS            2       /* at most one write every 2 vsyncs (33 ms) */
+#define BL_TEST_START_TICKS     300     /* 5 s */
+#define BL_TEST_STEP_TICKS      30      /* 0.5 s */
+#define BL_FRACTION_ONE         65536   /* published IODisplayParameters brightness max */
+
+static int gBlMode;                     /* bluebl */
+static uint32_t gBlMin = 32, gBlMax = BL_PANEL_MAX;
+static int gBlTest;
+static uint32_t gBlLogN = 64;
+static bool gBlDcsOk;                   /* DSI0 as expected, no failed write yet */
+static volatile uint32_t *gDsi;
+static volatile uint32_t *gPP;          /* the pingpong ABL left on autorefresh */
+static IOLock *gBlLock;                 /* the request fields below */
+static uint32_t gBlWant;                /* level wanted, 0 = none yet */
+static uint32_t gBlSent;                /* level last sent, 0 = none */
+static uint32_t gBlRequests;            /* requests recorded */
+static uint32_t gBlMerged;              /* requests since the last write */
+static const char *gBlFrom = "none";
+static uint64_t gBlTicks, gBlLastWriteTick;
+static uint32_t gBlWrites, gBlFails;
+static IOService *gBlService;           /* AppleARMBacklight (bluebl=2) */
+static IOService *gBlFb;                /* AppleCLCD until then */
+
+/* Called from SweetFramebuffer.cpp. */
+void blue_bl_start(IOService *fb);
+void blue_bl_tick(IOLock *present);
+void blue_bl_display_on(void);
+bool blue_bl_set_properties(OSObject *props);
+void blue_bl_iomfb(uint32_t selector, IOExternalMethodArguments *args, uint64_t *out, uint32_t *outCount);
+
+#define DSI_R(off)      (gDsi[(off) / 4])
+#define DSI_W(off, v)   (gDsi[(off) / 4] = (v))
+#define PP_R(off)       (gPP[(off) / 4])
+#define PP_W(off, v)    (gPP[(off) / 4] = (v))
+
+/*
+ * One DCS write of len bytes (data[0] the command) from the DSI command
+ * FIFO in low-power mode: short (0x05 / 0x15) for 1 or 2 bytes, long
+ * (0x39) for more. False if the DMA did not complete in 20 ms.
+ */
+static bool
+bl_dcs_write(const uint8_t *data, uint32_t len)
+{
+	uint32_t words[4] = { 0, 0, 0, 0 };
+	uint32_t nwords, bytes;
+
+	if (len == 0 || len > 8) {
+		return false;
+	}
+	if (len <= 2) {
+		uint32_t dt = len == 1 ? 0x05u : 0x15u;
+		words[0] = 1u << 31 | dt << 16 | (len == 2 ? (uint32_t)data[1] << 8 : 0u) | data[0];
+		nwords = 2;                     /* the FIFO takes an even number of words */
+		bytes = 4;
+	} else {
+		words[0] = 1u << 31 | 1u << 30 | 0x39u << 16 | len;    /* WC hi = 0 */
+		uint8_t pay[8];
+		memset(pay, 0xff, sizeof(pay));
+		memcpy(pay, data, len);
+		uint32_t pw = (len + 3) / 4;
+		for (uint32_t i = 0; i < pw; i++) {
+			words[1 + i] = (uint32_t)pay[4 * i] | (uint32_t)pay[4 * i + 1] << 8 |
+			    (uint32_t)pay[4 * i + 2] << 16 | (uint32_t)pay[4 * i + 3] << 24;
+		}
+		bytes = 4 + 4 * pw;
+		nwords = (1 + pw + 1) & ~1u;
+	}
+
+	uint32_t dmactrl = DSI_R(DSI_CMD_DMA_CTRL);
+	DSI_W(DSI_INT_CTRL, (DSI_R(DSI_INT_CTRL) & ~(1u << 24)) | 1u);  /* clear a stale DMA done */
+	DSI_W(DSI_TPG_CTRL, 3u << 16 | 1u << 2 | 1u << 1);     /* FIFO pattern, FIFO mode, CMD DMA TPG on */
+	for (uint32_t i = 0; i < nwords; i++) {
+		DSI_W(DSI_TPG_CMD_DMA_INIT, words[i]);
+	}
+	DSI_W(DSI_CMD_DMA_CTRL, (dmactrl & ~(3u << 30)) | 1u << 28 | 1u << 26);
+	DSI_W(DSI_DMA_CMD_LENGTH, bytes);
+	__builtin_arm_dsb(DSB_SY);
+	DSI_W(DSI_DMA_SW_TRIGGER, 1);
+	__builtin_arm_dsb(DSB_SY);
+	bool done = false;
+	for (int i = 0; i < 400 && !done; i++) {
+		done = (DSI_R(DSI_INT_CTRL) & 1u) != 0;
+		if (!done) {
+			IODelay(50);
+		}
+	}
+	DSI_W(DSI_INT_CTRL, (DSI_R(DSI_INT_CTRL) & ~(1u << 24)) | 1u);
+	DSI_W(DSI_TPG_CTRL, 0);
+	DSI_W(DSI_TPG_DMA_FIFO_RESET, 1);
+	__builtin_arm_dsb(DSB_SY);
+	IODelay(1);
+	DSI_W(DSI_TPG_DMA_FIFO_RESET, 0);
+	DSI_W(DSI_CMD_DMA_CTRL, dmactrl);
+	__builtin_arm_dsb(DSB_SY);
+	if (!done) {
+		IOLog("BLUE BL: DCS 0x%02x (%u bytes) not done (int 0x%x status 0x%x)\n", data[0], len,
+		    DSI_R(DSI_INT_CTRL), DSI_R(DSI_STATUS_REG));
+	}
+	return done;
+}
+
+/* Autorefresh off, wait (100 ms at most) until no frame is in flight. Returns the old config in *ar. */
+static bool
+bl_pp_idle(uint32_t *ar)
+{
+	*ar = PP_R(PP_AUTOREFRESH_CONFIG);
+	uint32_t sync = PP_R(PP_SYNC_CONFIG_VSYNC);
+	PP_W(PP_SYNC_CONFIG_VSYNC, sync & ~(1u << 20));         /* external TE off */
+	PP_W(PP_AUTOREFRESH_CONFIG, 0);
+	__builtin_arm_dsb(DSB_SY);
+	bool idle = false;
+	for (int i = 0; i < 1000 && !idle; i++) {
+		uint32_t line = PP_R(PP_LINE_COUNT) & 0xffff;
+		idle = (line == 0 || line >= BL_PANEL_LINES) && !(DSI_R(DSI_STATUS_REG) & (1u << 2));
+		if (!idle) {
+			IODelay(100);
+		}
+	}
+	PP_W(PP_SYNC_CONFIG_VSYNC, sync);
+	__builtin_arm_dsb(DSB_SY);
+	return idle;
+}
+
+/* SET_DISPLAY_BRIGHTNESS level, vsync workloop thread. */
+static bool
+bl_send(uint32_t level, uint64_t *us)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint32_t ar = 0;
+	if (!(PP_R(PP_AUTOREFRESH_CONFIG) & (1u << 31))) {
+		IOLog("BLUE BL: autorefresh off (0x%x), DCS off for this boot\n", PP_R(PP_AUTOREFRESH_CONFIG));
+		gBlDcsOk = false;
+		return false;
+	}
+	bool idle = bl_pp_idle(&ar);
+	const uint8_t cmd[3] = { 0x51, (uint8_t)(level >> 8), (uint8_t)level };
+	bool ok = idle && bl_dcs_write(cmd, sizeof(cmd));
+	PP_W(PP_AUTOREFRESH_CONFIG, ar);
+	__builtin_arm_dsb(DSB_SY);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, us);
+	*us /= 1000;
+	if (!ok) {
+		IOLog("BLUE BL: level %u: %s, autorefresh 0x%x restored, DCS off for this boot\n", level,
+		    idle ? "DCS write failed" : "pingpong did not go idle", ar);
+		gBlDcsOk = false;
+	}
+	return ok;
+}
+
+static uint32_t
+bl_clamp(uint32_t level)
+{
+	if (level < gBlMin) {
+		level = gBlMin;
+	}
+	if (level > gBlMax) {
+		level = gBlMax;
+	}
+	return level;
+}
+
+/* Record a wanted level (any thread). */
+static void
+bl_request(uint32_t level, const char *from, uint64_t raw)
+{
+	if (gBlMode == 0 || gBlLock == NULL) {
+		return;
+	}
+	level = bl_clamp(level);
+	IOLockLock(gBlLock);
+	uint32_t n = ++gBlRequests;
+	gBlWant = level;
+	gBlFrom = from;
+	gBlMerged++;
+	IOLockUnlock(gBlLock);
+	if (n <= gBlLogN || (n % 32) == 0) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("BLUE BL: request %u from %s (%s): raw %llu -> level %u (%u%%)%s\n", n, name, from, raw,
+		    level, level * 100 / gBlMax, gBlDcsOk ? "" : ", no DCS: not sent");
+	}
+}
+
+static void
+bl_request_fraction(uint64_t value, uint64_t max, const char *from)
+{
+	if (max == 0) {
+		return;
+	}
+	if (value > max) {
+		value = max;
+	}
+	bl_request((uint32_t)((value * gBlMax + max / 2) / max), from, value);
+}
+
+static void
+bl_request_nits(uint64_t value, const char *from)
+{
+	uint64_t nits16 = value > 0xffff ? value : value << 16;  /* 16.16 */
+	uint64_t level = (nits16 * BL_PANEL_MAX / BL_NITS_AT_MAX + 0x8000) >> 16;
+	bl_request((uint32_t)MIN(level, (uint64_t)BL_HW_MAX), from, value);
+}
+
+/* Short description of a property value for the log. */
+static void
+bl_describe(const OSObject *v, char *buf, size_t size)
+{
+	const OSNumber *n = OSDynamicCast(OSNumber, v);
+	const OSString *s = OSDynamicCast(OSString, v);
+	const OSBoolean *b = OSDynamicCast(OSBoolean, v);
+	const OSDictionary *d = OSDynamicCast(OSDictionary, v);
+	if (n != NULL) {
+		snprintf(buf, size, "%llu (0x%llx)", n->unsigned64BitValue(), n->unsigned64BitValue());
+	} else if (s != NULL) {
+		snprintf(buf, size, "\"%s\"", s->getCStringNoCopy());
+	} else if (b != NULL) {
+		snprintf(buf, size, "%s", b->isTrue() ? "true" : "false");
+	} else if (d != NULL) {
+		snprintf(buf, size, "dict of %u", d->getCount());
+	} else {
+		snprintf(buf, size, "%s", v != NULL ? v->getMetaClass()->getClassName() : "null");
+	}
+}
+
+static const char *const kNitsKeys[] = { "brightness-nits", "DisplayNits", "IOMFBBrightnessLevel", "nits", NULL };
+
+/*
+ * setProperties() of AppleCLCD and AppleARMBacklight: log every key (and one
+ * level of a dictionary's keys), act on the brightness ones. Returns true
+ * if a key was used.
+ */
+static bool
+bl_properties(OSObject *props, const char *who, int depth)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, props);
+	if (dict == NULL || depth > 2) {
+		return false;
+	}
+	bool used = false;
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return false;
+	}
+	static uint32_t logged;
+	while (OSSymbol *key = OSDynamicCast(OSSymbol, it->getNextObject())) {
+		OSObject *v = dict->getObject(key);
+		const char *k = key->getCStringNoCopy();
+		if (logged < 4 * gBlLogN) {
+			char desc[64];
+			bl_describe(v, desc, sizeof(desc));
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			IOLog("BLUE BL: %s setProperties from %s:%s %s = %s\n", who, name, depth ? " (nested)" : "", k, desc);
+			logged++;
+		}
+		OSNumber *n = OSDynamicCast(OSNumber, v);
+		OSDictionary *d = OSDynamicCast(OSDictionary, v);
+		if (!strcmp(k, "brightness")) {
+			if (d != NULL) {
+				n = OSDynamicCast(OSNumber, d->getObject("value"));
+			}
+			if (n != NULL) {
+				bl_request_fraction(n->unsigned64BitValue(), BL_FRACTION_ONE, "brightness");
+				used = true;
+			}
+		} else if (!strcmp(k, "IODisplayParameters") && d != NULL) {
+			used = bl_properties(d, who, depth + 1) || used;
+		} else if (n != NULL) {
+			for (int i = 0; kNitsKeys[i] != NULL; i++) {
+				if (!strcmp(k, kNitsKeys[i])) {
+					bl_request_nits(n->unsigned64BitValue(), kNitsKeys[i]);
+					used = true;
+				}
+			}
+		} else if (d != NULL && depth == 0) {
+			used = bl_properties(d, who, depth + 1) || used;
+		}
+	}
+	it->release();
+	return used;
+}
+
+/* ---- AppleARMBacklight (bluebl=2) ---- */
+
+class AppleARMBacklight : public IOService
+{
+	OSDeclareDefaultStructors(AppleARMBacklight);
+public:
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static void
+bl_publish_value(uint32_t level)
+{
+	if (gBlService == NULL) {
+		return;
+	}
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *bright = OSDictionary::withCapacity(3);
+	OSNumber *mn = OSNumber::withNumber(0ULL, 32);
+	OSNumber *mx = OSNumber::withNumber((unsigned long long)BL_FRACTION_ONE, 32);
+	OSNumber *val = OSNumber::withNumber((unsigned long long)level * BL_FRACTION_ONE / gBlMax, 32);
+	if (params != NULL && bright != NULL && mn != NULL && mx != NULL && val != NULL) {
+		bright->setObject("min", mn);
+		bright->setObject("max", mx);
+		bright->setObject("value", val);
+		params->setObject("brightness", bright);
+		gBlService->setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(params);
+	OSSafeReleaseNULL(bright);
+	OSSafeReleaseNULL(mn);
+	OSSafeReleaseNULL(mx);
+	OSSafeReleaseNULL(val);
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	bl_properties(properties, "AppleARMBacklight", 0);
+	return kIOReturnSuccess;        /* accept everything: the keys are only being discovered */
+}
+
+/* ---- interface for AppleCLCD (SweetFramebuffer.cpp) ---- */
+
+/* AppleCLCD::start, after powerStart(). provider: the AppleCLCD. */
+void
+blue_bl_start(IOService *fb)
+{
+	gBlMode = 1;
+	PE_parse_boot_argn("bluebl", &gBlMode, sizeof(gBlMode));
+	PE_parse_boot_argn("bluebl_min", &gBlMin, sizeof(gBlMin));
+	PE_parse_boot_argn("bluebl_max", &gBlMax, sizeof(gBlMax));
+	PE_parse_boot_argn("bluebl_test", &gBlTest, sizeof(gBlTest));
+	PE_parse_boot_argn("bluebl_log", &gBlLogN, sizeof(gBlLogN));
+	if (gBlMode <= 0) {
+		gBlMode = 0;
+		return;
+	}
+	if (gBlMax > BL_HW_MAX) {
+		gBlMax = BL_HW_MAX;
+	}
+	if (gBlMax < 64) {
+		gBlMax = BL_PANEL_MAX;
+	}
+	if (gBlMin < BL_PANEL_MIN) {
+		gBlMin = BL_PANEL_MIN;
+	}
+	if (gBlMin > gBlMax / 2) {
+		gBlMin = gBlMax / 2;
+	}
+	gBlLock = IOLockAlloc();
+	gDsi = (volatile uint32_t *)ml_io_map(BL_DSI0_PA, 0x4000);
+	volatile uint32_t *page = (volatile uint32_t *)ml_io_map(BL_PP_PAGE_PA, 0x4000);
+	if (gBlLock == NULL || gDsi == NULL || page == NULL) {
+		IOLog("BLUE BL: setup failed (lock %p, DSI %p, PP %p), off\n", gBlLock, gDsi, page);
+		gBlMode = 0;
+		return;
+	}
+	int pp = -1;
+	for (uint32_t i = 0; i < 4; i++) {
+		volatile uint32_t *p = page + (0x1000 + 0x800 * i) / 4;
+		if (gPP == NULL && (p[PP_AUTOREFRESH_CONFIG / 4] & (1u << 31))) {
+			gPP = p;
+			pp = (int)i;
+		}
+	}
+	uint32_t ctrl = DSI_R(DSI_CTRL_REG), trig = DSI_R(DSI_TRIG_CTRL), dma = DSI_R(DSI_CMD_DMA_CTRL);
+	gBlDcsOk = gPP != NULL && (ctrl & 0x5) == 0x5 && (trig & 0x7) == 4;
+	IOLog("BLUE BL: DSI0 ctrl 0x%x trig 0x%x dma_ctrl 0x%x status 0x%x, autorefresh PP_%d 0x%x: DCS %s;"
+	    " levels %u..%u (panel 8..900, 0x51 big-endian), bluebl=%d test=%d\n",
+	    ctrl, trig, dma, DSI_R(DSI_STATUS_REG), pp, gPP != NULL ? PP_R(PP_AUTOREFRESH_CONFIG) : 0,
+	    gBlDcsOk ? "ready" : "OFF (DSI0 not command mode + sw trigger, or no autorefresh)",
+	    gBlMin, gBlMax, gBlMode, gBlTest);
+
+	if (gBlMode >= 2) {
+		gBlFb = fb;                     /* published from the 60th vsync on, once AppleCLCD is registered */
+		fb->retain();
+	}
+}
+
+static void
+bl_publish_service(void)
+{
+	IOService *fb = gBlFb;
+	gBlFb = NULL;
+	AppleARMBacklight *bl = OSTypeAlloc(AppleARMBacklight);
+	if (bl != NULL && bl->init() && bl->attach(fb)) {
+		bl->setName("backlight");
+		bl->setProperty("backlight-control", true);
+		gBlService = bl;
+		bl_publish_value(gBlSent != 0 ? gBlSent : gBlMax);
+		bl->registerService();
+		IOLog("BLUE BL: AppleARMBacklight published (backlight-control, IODisplayParameters brightness 0..%u)\n",
+		    BL_FRACTION_ONE);
+	} else {
+		IOLog("BLUE BL: AppleARMBacklight not published\n");
+		OSSafeReleaseNULL(bl);
+	}
+	fb->release();
+}
+
+/* Test ramp (bluebl_test=1): 100 % down to 20 % in 10 % steps, 4 steps at 20 %, back up. */
+static const uint8_t kTestPercent[] = { 100, 90, 80, 70, 60, 50, 40, 30, 20, 20, 20, 20, 30, 40, 50, 60, 70, 80, 90, 100 };
+
+static void
+bl_test_tick(void)
+{
+	static uint32_t step;
+	if (gBlTicks < BL_TEST_START_TICKS || step >= sizeof(kTestPercent) ||
+	    (gBlTicks - BL_TEST_START_TICKS) % BL_TEST_STEP_TICKS != 0) {
+		return;
+	}
+	uint32_t pct = kTestPercent[step];
+	IOLog("BLUE BL: test step %u/%u: %u%%\n", step + 1, (uint32_t)sizeof(kTestPercent), pct);
+	bl_request((gBlMax * pct + 50) / 100, "bluebl_test", pct);
+	if (++step == sizeof(kTestPercent)) {
+		IOLog("BLUE BL: test done: %u writes, %u failed\n", gBlWrites + 1, gBlFails);
+	}
+}
+
+/*
+ * Every vsync while the display is on (AppleCLCD::vsyncFired, workloop
+ * thread, no framebuffer lock held). present: the 0145 present lock or NULL.
+ */
+void
+blue_bl_tick(IOLock *present)
+{
+	if (gBlMode == 0) {
+		return;
+	}
+	gBlTicks++;
+	if (gBlFb != NULL && gBlTicks >= 60) {
+		bl_publish_service();
+	}
+	if (gBlTest) {
+		bl_test_tick();
+	}
+	if (!gBlDcsOk || gBlTicks - gBlLastWriteTick < BL_MIN_TICKS) {
+		return;
+	}
+	IOLockLock(gBlLock);
+	uint32_t want = gBlWant, merged = gBlMerged;
+	const char *from = gBlFrom;
+	IOLockUnlock(gBlLock);
+	if (want == 0 || want == gBlSent) {
+		return;
+	}
+	if (present != NULL && !IOLockTryLock(present)) {
+		return;                         /* a flip is in progress: next tick */
+	}
+	uint64_t us = 0;
+	bool ok = bl_send(want, &us);
+	if (present != NULL) {
+		IOLockUnlock(present);
+	}
+	gBlLastWriteTick = gBlTicks;
+	uint32_t n = ++gBlWrites;
+	if (ok) {
+		gBlSent = want;
+		IOLockLock(gBlLock);
+		gBlMerged = 0;
+		IOLockUnlock(gBlLock);
+		bl_publish_value(want);
+	} else {
+		gBlFails++;
+	}
+	if (n <= gBlLogN || !ok || (n % 32) == 0) {
+		IOLog("BLUE BL: write %u: 0x51 %02x %02x = level %u (%u%%) from %s (%u requests) -> %s in %llu us\n",
+		    n, want >> 8, want & 0xff, want, want * 100 / gBlMax, from, merged, ok ? "ok" : "FAILED", us);
+	}
+}
+
+/* Display back on (after RequestPowerChange(1)): send the wanted level again. */
+void
+blue_bl_display_on(void)
+{
+	gBlSent = 0;
+}
+
+/* AppleCLCD::setProperties. */
+bool
+blue_bl_set_properties(OSObject *props)
+{
+	return gBlMode != 0 && bl_properties(props, "AppleCLCD", 0);
+}
+
+/*
+ * IOMobileFramebuffer user-client selectors not handled by AppleCLCD.
+ * Logs the brightness-related ones; out/outCount: scalar outputs.
+ */
+void
+blue_bl_iomfb(uint32_t selector, IOExternalMethodArguments *args, uint64_t *out, uint32_t *outCount)
+{
+	static uint32_t counts[4];
+	int slot;
+	switch (selector) {
+	case 50: slot = 0; break;               /* SetBrightnessCorrection */
+	case 66: slot = 1; break;               /* SPLCSetBrightness */
+	case 67: slot = 2; break;               /* SPLCGetBrightness */
+	case 68: slot = 3; break;               /* SetParameter */
+	default: return;
+	}
+	if (gBlMode == 0) {
+		return;
+	}
+	uint32_t n = ++counts[slot];
+	if (selector == 67 && args->scalarOutputCount >= 1) {
+		out[0] = gBlSent != 0 ? gBlSent : gBlMax;
+		*outCount = 1;
+	}
+	if (n > 16 && (n % 64) != 0) {
+		return;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	uint64_t s[4] = { 0, 0, 0, 0 };
+	for (uint32_t i = 0; i < args->scalarInputCount && i < 4; i++) {
+		s[i] = args->scalarInput[i];
+	}
+	uint8_t b[16];
+	uint32_t blen = 0;
+	if (args->structureInputDescriptor == NULL && args->structureInput != NULL) {
+		blen = MIN(args->structureInputSize, (uint32_t)sizeof(b));
+		memcpy(b, args->structureInput, blen);
+	}
+	char hex[40];
+	for (uint32_t i = 0; i < blen; i++) {
+		snprintf(hex + 2 * i, 3, "%02x", b[i]);
+	}
+	hex[2 * blen] = 0;
+	IOLog("BLUE BL: %s IOMFB sel %u #%u scalars %u [0x%llx 0x%llx 0x%llx 0x%llx] struct %u [%s]\n", name,
+	    selector, n, args->scalarInputCount, s[0], s[1], s[2], s[3], args->structureInputSize, hex);
+}

 blueline_spmi_read(uint16_t addr, uint8_t *buf, unsigned len)
 {
diff -ruN a/iokit/Kernel/arm/BlueBattery.cpp b/iokit/Kernel/arm/BlueBattery.cpp
--- a/iokit/Kernel/arm/BlueBattery.cpp	2026-11-21 20:38:42
+++ b/iokit/Kernel/arm/BlueBattery.cpp	2026-11-21 20:38:50
@@ -55,7 +55,47 @@
 /* bsd/dev/blueline_keys.c (0129 observer-channel reads; SID argument from 0130) */
 extern "C" int blueline_spmi_read_sid(uint8_t sid, uint16_t addr, uint8_t *buf, unsigned len);
 extern "C" int blueline_spmi_apid(uint8_t sid, uint8_t periph, uint16_t *apid, uint8_t *owner);
+extern "C" int blueline_spmi_write_sid(uint8_t sid, uint16_t addr, uint8_t val);	/* 0197 */
 
+/*
+ * 0197: bluebatt_usb_off=N (seconds, 10..7200): run from the battery with the cable still in, so
+ * the gauge's current is the phone's own draw. PMI8998 USBIN_CMD_IL (0x1340) bit 0 USBIN_SUSPEND
+ * (smb-reg.h; Linux's charger driver votes the same bit), set at start and cleared after N seconds.
+ * Recovery's charger driver writes the bit again on its own start.
+ */
+#define PMI_USBIN_CMD_IL	0x1340u
+static thread_call_t usbOffCall;
+static void
+usbOffEnd(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint8_t v = 0;
+	int e = blueline_spmi_read_sid(2, PMI_USBIN_CMD_IL, &v, 1);
+	int w = e ? e : blueline_spmi_write_sid(2, PMI_USBIN_CMD_IL, (uint8_t)(v & ~1u));
+	(void)blueline_spmi_read_sid(2, PMI_USBIN_CMD_IL, &v, 1);
+	IOLog("BLUELINE BATTERY: USB input back on (err %d, CMD_IL now %#x)\n", w, v);
+}
+
+static void
+usbOffStart(int secs)
+{
+	uint8_t v = 0;
+	if (blueline_spmi_read_sid(2, PMI_USBIN_CMD_IL, &v, 1)) {
+		IOLog("BLUELINE BATTERY: bluebatt_usb_off: CMD_IL read failed\n");
+		return;
+	}
+	usbOffCall = thread_call_allocate(usbOffEnd, NULL);
+	if (!usbOffCall) {
+		return;
+	}
+	int w = blueline_spmi_write_sid(2, PMI_USBIN_CMD_IL, (uint8_t)(v | 1u));
+	uint8_t now = 0;
+	(void)blueline_spmi_read_sid(2, PMI_USBIN_CMD_IL, &now, 1);
+	IOLog("BLUELINE BATTERY: USB input suspended for %d s: on battery (err %d, CMD_IL %#x -> %#x)\n", secs, w, v, now);
+	uint64_t dl;
+	clock_interval_to_deadline((uint32_t)secs, NSEC_PER_SEC, &dl);
+	thread_call_enter_delayed(usbOffCall, dl);
+}

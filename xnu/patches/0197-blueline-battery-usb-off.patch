0197: run from the battery with the cable in (bluebatt_usb_off=N)

For power measurements on a phone that stays on USB: BlueBattery sets
PMI8998 USBIN_CMD_IL (0x1340) bit 0, USBIN_SUSPEND (smb-reg.h), at start
and clears it after N seconds (10..7200), so the MAX1720x current is the
phone's own draw. blueline_keys.c gains blueline_spmi_write_sid() for
apps-owned PMIC peripherals.

diff -ruN a/bsd/dev/blueline_keys.c b/bsd/dev/blueline_keys.c
diff -ruN a/bsd/dev/blueline_keys.c b/bsd/dev/blueline_keys.c
--- a/bsd/dev/blueline_keys.c
+++ b/bsd/dev/blueline_keys.c
@@ -251,6 +251,38 @@
 	return ok ? 0 : EIO;
 }
 
+/*
+ * 0197: write one register of PMIC slave sid through the peripheral's own channel. Only peripherals
+ * the apps EE owns (arb_write checks); the caller decides what is safe to write. 0, EINVAL, ENXIO, EPERM.
+ */
+int blueline_spmi_write_sid(uint8_t sid, uint16_t addr, uint8_t val);
+
+int
+blueline_spmi_write_sid(uint8_t sid, uint16_t addr, uint8_t val)
+{
+	if (sid > 0xfu) {
+		return EINVAL;
+	}
+	if (!arb_setup()) {
+		return ENXIO;
+	}
+	uint16_t ppid = (uint16_t)(((unsigned)sid << 8) | (addr >> 8));
+	lck_mtx_lock(&blueline_arb_lock);
+	uint16_t apid = arb_apid(ppid, arb_count);
+	bool ok = false;
+	static uint16_t map_apid = NO_APID;	/* one channel mapping kept (no ml_io_unmap here) */
+	static vm_offset_t map_ch;
+	if (apid != NO_APID) {
+		if (apid != map_apid) {
+			map_ch = ml_io_map(ARB_CHNLS_PA + 0x10000u * apid, 0x1000);
+			map_apid = map_ch ? apid : NO_APID;
+		}
+		ok = map_ch && arb_write(map_ch, apid, addr, val);
+	}
+	lck_mtx_unlock(&blueline_arb_lock);
+	return apid == NO_APID ? ENXIO : ok ? 0 : EPERM;
+}

+/* 0158: a flip flushed whose latch has not been seen (lock-free; vsync timer) */
 int
+blue_dpu_latch_pending(void)
+{
+	if (!bd_latch_pending) {
+		return 0;
+	}
+	if ((mdp_rd(CTL_BASE(bd_st.ctl) + CTL_FLUSH) & bd_fplan.flush) != 0) {
+		return 1;
+	}
+	bd_latch_pending = false;
+	return 0;
+}

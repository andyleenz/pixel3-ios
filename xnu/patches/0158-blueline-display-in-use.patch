+}
+
+/* 0158: s is on screen now (flip done; the flip waited for the latch before it). fPresentLock held. */
+void
+AppleCLCD::displayHold(SweetSurface *s)
+{
+	if (s == fShown) {
+		return;
+	}
+	displayDrop(false);     /* the buffer two flips back: its replacement latched before this flip */
+	fRetiring = fShown;
+	s->retain();
+	sweet_surface_display_use(s, 1);
+	fShown = s;
+}
+
+/* Retiring (latched, or all: flipping stopped). fPresentLock held. */
+void
+AppleCLCD::displayDrop(bool all)
+{
+	if (fRetiring != NULL) {
+		sweet_surface_display_use(fRetiring, -1);
+		OSSafeReleaseNULL(fRetiring);
+	}
+	if (all && fShown != NULL) {
+		sweet_surface_display_use(fShown, -1);
+		OSSafeReleaseNULL(fShown);
 	}
 }
 

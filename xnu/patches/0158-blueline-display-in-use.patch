From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 19 Nov 2026 16:30:00 +0100
Subject: [PATCH] 0158: the display holds IOSurface uses (IOSurfaceIsInUse)

backboardd alternated two framebuffers because no surface ever read as in
use: iOS 16's IOSurfaceIsInUse reads a u64 at +0x18 of the shared state
page, which stayed 0. The flip path now holds a use on the surface shown
and on the one it replaced until that flip latches (released from the
vsync tick), so CoreAnimation takes a third buffer instead of waiting.
0157's GPU wait applies only to a surface still held.
---
--- a/iokit/Kernel/arm/SweetSurface.h
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -50,6 +50,9 @@
 
 /* Retained surface for an id, or NULL. */
 SweetSurface *sweet_surface_copy(uint32_t id);
+/* 0158: the display's use of a surface, seen by IOSurfaceIsInUse (u64 at +0x18 of the state page) */
+void sweet_surface_display_use(SweetSurface *s, int delta);
+bool sweet_surface_in_use(SweetSurface *s);
 
 /*
  * Publish physical memory (the panel framebuffer) as a surface. Returns a
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -123,6 +123,28 @@
 sweet_surface_seed(SweetSurface *s)
 {
 	return (uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED);
+}
+
+/*
+ * 0158: IOSurfaceIsInUse (iOS 16 IOSurface.framework) reads a u64 use count at
+ * +0x18 of the shared state page, no call. The display holds a use on the
+ * buffer it shows until the flip replacing it latches, so CoreAnimation does
+ * not draw into a buffer that is still being fetched (it takes another one).
+ * Client use-count traps stay ignored.
+ */
+#define SWEET_SURFACE_STATE_USE         0x18
+
+void
+sweet_surface_display_use(SweetSurface *s, int delta)
+{
+	volatile SInt64 *use = (volatile SInt64 *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USE);
+	(void)OSAddAtomic64(delta, use);
+}
+
+bool
+sweet_surface_in_use(SweetSurface *s)
+{
+	return *(volatile int64_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USE) > 0;
 }
 

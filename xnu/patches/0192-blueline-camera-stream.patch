+/* ---- 0192: stream the front IMX355 (bluecam_stream=1) ---- */
+
+static int cam_stream;
+
+/* Sony write: S addr+W reg[15:8] reg[7:0] data P. 0, or the stage not acknowledged (1-3, 4 data). */
+static int
+bus_write(const struct cam_bus *b, uint8_t addr, uint16_t reg, uint8_t v)
+{
+	boolean_t intr = ml_set_interrupts_enabled(FALSE);
+	int stage = 0;
+
+	bus_start(b);
+	if (bus_wbyte(b, (uint8_t)(addr << 1))) {
+		stage = 1;
+	} else if (bus_wbyte(b, (uint8_t)(reg >> 8))) {
+		stage = 2;
+	} else if (bus_wbyte(b, (uint8_t)reg)) {
+		stage = 3;
+	} else if (bus_wbyte(b, v)) {
+		stage = 4;
+	}
+	bus_stop(b);
+	ml_set_interrupts_enabled(intr);
+	return stage;
+}
+
+/*
+ * IMX355 register values for a 19.2 MHz INCK, 4 lanes at 360 MHz, as in Linux's

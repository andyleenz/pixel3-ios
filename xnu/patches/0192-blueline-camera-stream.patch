+
+static bool
+write_list(const struct cam_bus *b, uint8_t addr, const uint16_t (*t)[2], size_t n, const char *what)
+{
+	for (size_t i = 0; i < n; i++) {
+		int e = bus_write(b, addr, t[i][0], (uint8_t)t[i][1]);
+		if (e) {
+			printf("BLUE CAM: stream: %s entry %zu (0x%04x) NACK at stage %d\n", what, i, t[i][0], e);
+			return false;
+		}
+	}
+	printf("BLUE CAM: stream: %s written (%zu registers)\n", what, n);
+	return true;
+}
+
+static uint8_t
+rd8(const struct cam_bus *b, uint8_t addr, uint16_t reg)
+{
+	uint8_t v = 0xee;
+	(void)bus_read(b, addr, reg, &v, 1);
+	return v;
+}
+
+/* Settings, stream on, read the sensor's own frame counter (0x0005) for 1 s, stream off. */
+static void
+stream_test(const struct cam_bus *b, uint8_t addr)
+{
+	if (!write_list(b, addr, imx355_global, sizeof(imx355_global) / sizeof(imx355_global[0]), "global") ||
+	    !write_list(b, addr, imx355_820x616, sizeof(imx355_820x616) / sizeof(imx355_820x616[0]), "820x616")) {
+		return;
+	}
+	(void)bus_write(b, addr, 0x3070, 1);	/* digital gain for all colours */
+	uint8_t f0 = rd8(b, addr, 0x0005);
+	printf("BLUE CAM: stream: frame count %u, mode 0x%02x; streaming on\n", f0, rd8(b, addr, 0x0100));
+	if (bus_write(b, addr, 0x0100, 1)) {
+		printf("BLUE CAM: stream: stream-on NACK\n");
+		return;
+	}
+	uint64_t t0 = mach_absolute_time();
+	for (int i = 0; i < 10; i++) {
+		IOSleep(100);
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		printf("BLUE CAM: stream: +%llu ms frame count %u, mode 0x%02x\n", ns / 1000000, rd8(b, addr, 0x0005),
+		    rd8(b, addr, 0x0100));
+	}
+	(void)bus_write(b, addr, 0x0100, 0);
+	IOSleep(50);
+	printf("BLUE CAM: stream: off, mode 0x%02x\n", rd8(b, addr, 0x0100));
+}

-			int error = exec_add_user_string(imgp, CAST_USER_ADDR_T(var), UIO_SYSSPACE, TRUE);
-			if (error) {
-				return error;
+		while (n < end && e[n] != ':') {
+			n++;
+		}
+		bool match = false;
+		for (size_t a = 0, z; a < n && !match; a = z + 1) {   /* NAME|NAME|... */
+			for (z = a; z < n && e[z] != '|'; z++) {
 			}
-			if (imgp->ip_argspace < ptr_size) {
-				return E2BIG;
+			match = strlen(base) == z - a && strncmp(base, e + a, z - a) == 0;
+		}
+		if (n < end && match) {
+			const char *p = e + n + 1, *stop = e + end;

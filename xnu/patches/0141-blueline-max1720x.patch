+	    "vcell %04x cur %04x avgcur %04x fullcap %04x tte %04x cycles %04x design %04x "
+	    "avgvcell %04x ttf %04x devname %04x fullcaprep %04x\n", n, m->status, m->repCap,
+	    m->repSoc, m->age, m->temp, m->vcell, m->cur, m->avgCur, m->fullCap, m->tte, m->cycles,
+	    m->designCap, m->avgVcell, m->ttf, m->devName, m->fullCapRep);
+	IOLog("BLUELINE MAX1720X: #%u %u%% %u mV (avg %u) %d mA (avg %d, + = charging) %s%d.%d C, "
+	    "RepCap %u / FullCapRep %u mAh (FullCap %u, design %u), %u cycles, TTE %d min, "
+	    "TTF %d min%s%s\n", n, m->percent, m->mV, m->avgMV, m->mA, m->avgMA,
+	    m->deciC < 0 ? "-" : "", absDeci / 10, absDeci % 10, m->repMah, m->fullMah,
+	    m->fullCapMah, m->designMah, m->cycleCount, m->tteMin, m->ttfMin,
+	    m->present ? "" : ", BATTERY ABSENT", !m->sane ? ", implausible: not published" :
+	    maxMode == 2 ? (dry ? " (dry run)" : " -> published") : " (log only, bluemax=1)");
+}

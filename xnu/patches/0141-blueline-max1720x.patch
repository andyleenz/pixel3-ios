+/* ---- 0141: MAX1720x fuel gauge ---- */
+
+/* n (1..4) 16-bit little-endian registers from reg on, one transaction (~1 ms, IRQs off). */
+bool
+BlueBattery::maxRegs(uint8_t addr, uint8_t reg, uint16_t *out, unsigned n, bool trace)
+{
+	uint8_t buf[8];
+
+	if (n < 1 || n > 4) {
+		return false;
+	}
+	if (trace) {
+		IOLog("BLUELINE MAX1720X: about to read 0x%02x reg 0x%02x, %u word(s)\n", addr, reg, n);
+	}
+	int error = blueline_bbi2c_xfer(maxBus, addr, &reg, 1, buf, 2 * n);
+	if (error) {
+		maxErrors++;
+		if (maxErrors <= 5 || (maxErrors % 100) == 0) {
+			IOLog("BLUELINE MAX1720X: read 0x%02x reg 0x%02x failed: error %d (%u errors)\n",
+			    addr, reg, error, maxErrors);
+		}
+		return false;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		out[i] = (uint16_t)(buf[2 * i] | (buf[2 * i + 1] << 8));
+	}
+	return true;
+}
+
+/* Bus, clocks (logged only), identity, Rsense. false leaves maxBus NULL. */
+bool
+BlueBattery::maxSetup(void)
+{
+	/* What ABL left running on QUP wrapper 1 / SE4: GCC is always readable. */
+	vm_offset_t vote = ml_io_map(GCC_VOTE_PA & ~0xfffu, 0x1000);
+	vm_offset_t qup1 = ml_io_map(GCC_QUP1_PA, 0x1000);
+	if (vote && qup1) {
+		IOLog("BLUELINE MAX1720X: about to read GCC vote 0x%x and QUP1 CBCRs 0x%x\n",
+		    GCC_VOTE_PA, GCC_QUP1_PA);
+		uint32_t v = *(volatile uint32_t *)(vote + (GCC_VOTE_PA & 0xfffu));
+		uint32_t mahb = *(volatile uint32_t *)(qup1 + 0x00cu);
+		uint32_t sahb = *(volatile uint32_t *)(qup1 + 0x010u);
+		uint32_t s4 = *(volatile uint32_t *)(qup1 + 0x4d4u);
+		IOLog("BLUELINE MAX1720X: GCC vote 0x%08x (wrap1 s4 %u, m_ahb %u, s_ahb %u); CBCR "
+		    "m_ahb 0x%08x s_ahb 0x%08x s4 0x%08x: SE12 clock %s (not needed: bit-banged)\n", v,
+		    (v >> GCC_VOTE_S4) & 1u, (v >> GCC_VOTE_MAHB1) & 1u, (v >> GCC_VOTE_SAHB1) & 1u,
+		    mahb, sahb, s4, (s4 & CBCR_CLK_OFF) ? "off" : "on");
+	}
+
+	IOLog("BLUELINE MAX1720X: about to bit-bang I2C on GPIO %d SDA / %d SCL (TLMM 0x%x, "
+	    "qupv3_se12 pins, taken from function qup12)\n", MAX_SDA, MAX_SCL, MAX_TLMM_NORTH_PA);
+	maxBus = blueline_bbi2c_open(MAX_TLMM_NORTH_PA, MAX_SDA, MAX_SCL);
+	if (!maxBus) {
+		IOLog("BLUELINE MAX1720X: no bus (mapping or slots); gauge off\n");
+		return false;
+	}
+	uint16_t id[2] = { 0, 0 };	/* TTF 0x20, DevName 0x21 */
+	if (!maxRegs(MAX_ADDR, 0x20, id, 2, true)) {
+		IOLog("BLUELINE MAX1720X: no answer at 0x%02x; gauge off\n", MAX_ADDR);
+		maxBus = NULL;
+		return false;
+	}
+	uint16_t status = 0, nrsense = 0;
+	(void)maxRegs(MAX_ADDR, 0x00, &status, 1, true);
+	bool nvOk = maxRegs(MAX_ADDR_NV, MAX_NRSENSE, &nrsense, 1, true);
+	int forced = 0;
+	(void)PE_parse_boot_argn("bluemax_rsense", &forced, sizeof(forced));
+	if (forced >= 50 && forced <= 5000) {
+		maxRsense = (uint32_t)forced;
+	} else if (nvOk && nrsense >= 50 && nrsense <= 5000) {
+		maxRsense = nrsense;
+	} else {
+		maxRsense = MAX_RSENSE_DEFAULT;
+	}
+	IOLog("BLUELINE MAX1720X: DevName 0x%04x (low nibble 1 = MAX17201, 5 = MAX17205), "
+	    "Status 0x%04x%s, nRSense %s0x%04x -> Rsense %u.%02u mOhm%s\n", id[1], status,
+	    (status & MAX_STATUS_BST) ? " (BATTERY ABSENT)" : "", nvOk ? "" : "(read failed) ",
+	    nrsense, maxRsense / 100, maxRsense % 100, forced ? " (bluemax_rsense)" : "");
+	return true;
+}
+
+bool
+BlueBattery::maxRead(BlueMaxReading *m, bool trace)
+{
+	uint16_t a[4], b[3], c[2], d[3], e[2];
+
+	bzero(m, sizeof(*m));
+	if (!maxRegs(MAX_ADDR, 0x00, &m->status, 1, trace) ||
+	    !maxRegs(MAX_ADDR, 0x05, a, 4, trace) ||		/* RepCap RepSOC Age Temp */
+	    !maxRegs(MAX_ADDR, 0x09, b, 3, trace) ||		/* VCell Current AvgCurrent */
+	    !maxRegs(MAX_ADDR, 0x10, c, 2, trace) ||		/* FullCap TTE */
+	    !maxRegs(MAX_ADDR, 0x17, d, 3, trace) ||		/* Cycles DesignCap AvgVCell */
+	    !maxRegs(MAX_ADDR, 0x20, e, 2, trace) ||		/* TTF DevName */
+	    !maxRegs(MAX_ADDR, 0x35, &m->fullCapRep, 1, trace)) {
+		return false;
+	}
+	m->repCap = a[0];
+	m->repSoc = a[1];
+	m->age = a[2];
+	m->temp = a[3];
+	m->vcell = b[0];
+	m->cur = b[1];
+	m->avgCur = b[2];
+	m->fullCap = c[0];
+	m->tte = c[1];
+	m->cycles = d[0];
+	m->designCap = d[1];
+	m->avgVcell = d[2];
+	m->ttf = e[0];
+	m->devName = e[1];
+
+	/* Scaling as Google's max1720x_battery.c (crosshatch 862f51ba), Rsense in 10 uOhm */
+	uint64_t rs = maxRsense;
+	m->percent = m->repSoc >> 8;				/* reg_to_percentage() */
+	if (m->percent > 100) {
+		m->percent = 100;
+	}
+	m->mV = (unsigned)((uint64_t)m->vcell * 78125u / 1000000u);	/* reg_to_micro_volt() */
+	m->avgMV = (unsigned)((uint64_t)m->avgVcell * 78125u / 1000000u);
+	m->mA = (int)((int64_t)(int16_t)m->cur * 156250 / (int64_t)rs / 1000);	/* reg_to_micro_amp() */
+	m->avgMA = (int)((int64_t)(int16_t)m->avgCur * 156250 / (int64_t)rs / 1000);
+	m->repMah = (unsigned)((uint64_t)m->repCap * 500u / rs);	/* reg_to_micro_amp_h() */
+	m->fullMah = (unsigned)((uint64_t)m->fullCapRep * 500u / rs);
+	m->fullCapMah = (unsigned)((uint64_t)m->fullCap * 500u / rs);
+	m->designMah = (unsigned)((uint64_t)m->designCap * 500u / rs);
+	m->deciC = (int)(int16_t)m->temp * 10 / 256;		/* reg_to_deci_deg_cel() */
+	m->cycleCount = ((unsigned)m->cycles * 16u + 50u) / 100u;	/* reg_to_cycles(): 16 % LSB */
+	/* reg_to_seconds(): 5.625 s */
+	m->tteMin = m->tte == MAX_NONE ? -1 : (int)(((uint64_t)m->tte * 5625u / 1000u + 30u) / 60u);
+	m->ttfMin = m->ttf == MAX_NONE ? -1 : (int)(((uint64_t)m->ttf * 5625u / 1000u + 30u) / 60u);
+
+	m->present = !(m->status & MAX_STATUS_BST);
+	m->sane = m->present && m->repSoc <= 0x6480u /* 100.5 % */ && m->mV >= 2500 &&
+	    m->mV <= 4800 && m->deciC > -400 && m->deciC < 900 && m->fullMah >= 500 &&
+	    m->fullMah <= 4000;
+	return true;
+}

-/* ---- I2C, bit-banged ---- */
+/*
+ * ---- I2C, bit-banged ----
+ *
+ * Shared with the battery (0141: the MAX1720x fuel gauge on SE12's pins,
+ * GPIO 49/50, TLMM north) through blueline_bbi2c_open()/_xfer(): a bus is a
+ * mapped TLMM tile plus its SDA and SCL pins. Each transfer runs with
+ * interrupts masked on its own CPU; callers serialize transfers on one bus.
+ */
+
+struct bbi2c {
+	vm_offset_t tlmm;	/* mapped TLMM tile holding both pins */
+	int sda, scl;
+};
+
+static struct bbi2c touch_bus;
 
 static void
-bb_pin(int pin, int high)
+bb_pin(const struct bbi2c *b, int pin, int high)
 {
 	/* released: input with pull-up; low: output enabled, driving 0 */
-	wr(east + GPIO_CFG(pin), (high ? 0u : (1u << 9)) | (2u << 6) | 3u);
+	wr(b->tlmm + GPIO_CFG(pin), (high ? 0u : (1u << 9)) | (2u << 6) | 3u);
 }
 
 static int
-bb_get(int pin)
+bb_get(const struct bbi2c *b, int pin)
 {
-	return rd(east + GPIO_IO(pin)) & 1;
+	return rd(b->tlmm + GPIO_IO(pin)) & 1;
 }
 
 static void
-bb_scl_high(void)
+bb_scl_high(const struct bbi2c *b)
 {
-	bb_pin(BB_SCL, 1);
-	for (int i = 0; i < 1000 && !bb_get(BB_SCL); i++) {	/* clock stretching, 1 ms at most */
+	bb_pin(b, b->scl, 1);
+	for (int i = 0; i < 1000 && !bb_get(b, b->scl); i++) {	/* clock stretching, 1 ms at most */
 		delay(1);
 	}
 }
 
 static void
-bb_start(void)
+bb_start(const struct bbi2c *b)
 {
-	bb_pin(BB_SDA, 1);
-	bb_scl_high();
+	bb_pin(b, b->sda, 1);
+	bb_scl_high(b);
 	delay(5);
-	bb_pin(BB_SDA, 0);
+	bb_pin(b, b->sda, 0);
 	delay(5);
-	bb_pin(BB_SCL, 0);
+	bb_pin(b, b->scl, 0);
 	delay(5);
 }
 
 static void
-bb_stop(void)
+bb_stop(const struct bbi2c *b)
 {
-	bb_pin(BB_SDA, 0);
+	bb_pin(b, b->sda, 0);
 	delay(5);
-	bb_scl_high();
+	bb_scl_high(b);
 	delay(5);
-	bb_pin(BB_SDA, 1);
+	bb_pin(b, b->sda, 1);
 	delay(5);
 }
 
 static int
-bb_write(uint8_t b)
+bb_write(const struct bbi2c *b, uint8_t v)
 {
 	for (int i = 7; i >= 0; i--) {
-		bb_pin(BB_SDA, b >> i & 1);
+		bb_pin(b, b->sda, v >> i & 1);
 		delay(5);
-		bb_scl_high();
+		bb_scl_high(b);
 		delay(5);
-		bb_pin(BB_SCL, 0);
+		bb_pin(b, b->scl, 0);
 	}
-	bb_pin(BB_SDA, 1);
+	bb_pin(b, b->sda, 1);
 	delay(5);
-	bb_scl_high();
-	int nack = bb_get(BB_SDA);
+	bb_scl_high(b);
+	int nack = bb_get(b, b->sda);
 	delay(5);
-	bb_pin(BB_SCL, 0);
+	bb_pin(b, b->scl, 0);
 	return nack ? EIO : 0;
 }
 
 static uint8_t
-bb_read(int ack)
+bb_read(const struct bbi2c *b, int ack)
 {
-	uint8_t b = 0;
+	uint8_t v = 0;
 
-	bb_pin(BB_SDA, 1);
+	bb_pin(b, b->sda, 1);
 	for (int i = 0; i < 8; i++) {
 		delay(5);
-		bb_scl_high();
-		b = (uint8_t)(b << 1 | bb_get(BB_SDA));
+		bb_scl_high(b);
+		v = (uint8_t)(v << 1 | bb_get(b, b->sda));
 		delay(5);
-		bb_pin(BB_SCL, 0);
+		bb_pin(b, b->scl, 0);
 	}
-	bb_pin(BB_SDA, !ack);
+	bb_pin(b, b->sda, !ack);
 	delay(5);
-	bb_scl_high();
+	bb_scl_high(b);
 	delay(5);
-	bb_pin(BB_SCL, 0);
-	bb_pin(BB_SDA, 1);
-	return b;
+	bb_pin(b, b->scl, 0);
+	bb_pin(b, b->sda, 1);
+	return v;
 }
 
-/* Write cmd, then (if len) a repeated start and read len bytes. */
+/* Write cmd to 7-bit addr, then (if len) a repeated start and read len bytes. */
 static int
-fts_xfer(const uint8_t *cmd, uint32_t clen, uint8_t *out, uint32_t len)
+bb_xfer(const struct bbi2c *b, uint8_t addr, const uint8_t *cmd, uint32_t clen, uint8_t *out,
+    uint32_t len)
 {
 	boolean_t intr = ml_set_interrupts_enabled(FALSE);
 	int err = 0;
 
-	bb_start();
-	err = bb_write(FTS_ADDR << 1);
+	bb_start(b);
+	err = bb_write(b, (uint8_t)(addr << 1));
 	for (uint32_t i = 0; i < clen && !err; i++) {
-		err = bb_write(cmd[i]);
+		err = bb_write(b, cmd[i]);
 	}
 	if (!err && len) {
-		bb_start();
-		err = bb_write(FTS_ADDR << 1 | 1);
+		bb_start(b);
+		err = bb_write(b, (uint8_t)(addr << 1 | 1));
 		for (uint32_t i = 0; i < len && !err; i++) {
-			out[i] = bb_read(i + 1 < len);
+			out[i] = bb_read(b, i + 1 < len);
 		}
 	}
-	bb_stop();
+	bb_stop(b);
 	ml_set_interrupts_enabled(intr);
 	return err;
 }
 
+/* Both pins as plain GPIOs (output value 0, released), then free a device stuck mid-byte. */
+static void
+bb_reset(const struct bbi2c *b)
+{
+	wr(b->tlmm + GPIO_IO(b->sda), 0);
+	wr(b->tlmm + GPIO_IO(b->scl), 0);
+	bb_pin(b, b->sda, 1);
+	bb_pin(b, b->scl, 1);
+	delay(1000);
+	for (int i = 0; i < 9; i++) {
+		bb_pin(b, b->scl, 0);
+		delay(5);
+		bb_scl_high(b);
+		delay(5);
+	}
+	bb_stop(b);
+}
+
+static int
+fts_xfer(const uint8_t *cmd, uint32_t clen, uint8_t *out, uint32_t len)
+{
+	return bb_xfer(&touch_bus, FTS_ADDR, cmd, clen, out, len);
+}
+
+/*
+ * Exported bit-banged buses for other drivers (C and C++), at most
+ * BBI2C_MAX_BUSES. tlmm_pa is the TLMM tile holding both pins (pin n's
+ * registers at + 0x1000 * n). Returns a handle, or NULL (bad pins, no slot,
+ * mapping failed). Opening switches both pins to the GPIO function (away
+ * from their QUP function) and sends 9 clocks and a stop with no start, so
+ * no device sees a command. Then: blueline_bbi2c_xfer(), 0 or EIO (NACK) /
+ * EINVAL. Thread context; one caller at a time per bus.
+ */
+#define BBI2C_MAX_BUSES	2
+void *blueline_bbi2c_open(uint32_t tlmm_pa, int sda, int scl);
+int blueline_bbi2c_xfer(void *bus, uint8_t addr, const uint8_t *w, uint32_t wlen, uint8_t *r,
+    uint32_t rlen);
+
+void *
+blueline_bbi2c_open(uint32_t tlmm_pa, int sda, int scl)
+{
+	static struct bbi2c buses[BBI2C_MAX_BUSES];
+	static int nbuses;
+	int top = sda > scl ? sda : scl;
+
+	if (sda < 0 || scl < 0 || sda == scl || top > 149 || nbuses >= BBI2C_MAX_BUSES) {
+		return NULL;
+	}
+	vm_offset_t tlmm = ml_io_map(tlmm_pa, GPIO_CFG(top + 1));
+	if (!tlmm) {
+		return NULL;
+	}
+	struct bbi2c *b = &buses[nbuses++];
+	b->tlmm = tlmm;
+	b->sda = sda;
+	b->scl = scl;
+	bb_reset(b);
+	return b;
+}
+
+int
+blueline_bbi2c_xfer(void *bus, uint8_t addr, const uint8_t *w, uint32_t wlen, uint8_t *r,
+    uint32_t rlen)
+{
+	if (!bus || addr > 0x7fu || (wlen && !w) || (rlen && !r) || wlen + rlen == 0) {
+		return EINVAL;
+	}
+	return bb_xfer((const struct bbi2c *)bus, addr, w, wlen, r, rlen);
+}

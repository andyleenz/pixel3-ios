index 49872f4de..b72771b9d 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -113,6 +113,7 @@ bsd/dev/blueline_scm.c			standard
 bsd/dev/blueline_wdt.c			standard
 bsd/dev/blueline_wifi.c			standard

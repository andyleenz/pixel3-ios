From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 25 Nov 2026 21:00:00 +1100
Subject: [PATCH] 0224: a swap is complete once its own flip latched

0159 answered SwapWait complete only after the next swap latched.
DCP's swap_complete means the swap is on screen. backboardd's buffers
come back a frame earlier: GPU latch holds on the GL home-screen swipes
176 -> 81, flips unchanged (336). MetalHello flips per 5 s 274-303 ->
280-299. bluefb_swapdone=0 restores 0159. Trace event Q: SwapWait id
and whether it answered complete.
---
diff -ru a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp	2026-11-25 20:23:12
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp	2026-11-25 20:23:12
@@ -105,6 +105,13 @@
 extern "C" int blue_dpu_latch_pending(void);  /* 0158 */
 extern "C" int blue_dpu_te_since(uint64_t *ns);        /* 0222 */
 static uint32_t sweet_fb_te_us = 1000;  /* 0222: tick this long after TE (bluefb_vsync_te_us; 0 = free grid) */
+/*
+ * 0224: a swap is complete once it is on screen (its own flip latched), as
+ * DCP's swap_complete. 0159 waited for the next swap's latch: CoreAnimation
+ * then freed an app's drawable a frame late (3 frames round trip with 3
+ * drawables, no slack). bluefb_swapdone=0: the 0159 rule.
+ */
+static uint32_t sweet_fb_swapdone = 1;
 static uint32_t sweet_fb_swapwait_n[2];        /* 0159: SwapWaits answered complete / pending */
 extern "C" int blue_dpu_flip(IOMemoryDescriptor *md, uintptr_t kva, uint32_t offset, uint32_t bpr,
     uint32_t w, uint32_t h, uint32_t fmt);
@@ -392,6 +399,7 @@
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
 	PE_parse_boot_argn("bluefb_vsync_te_us", &sweet_fb_te_us, sizeof(sweet_fb_te_us));
+	PE_parse_boot_argn("bluefb_swapdone", &sweet_fb_swapdone, sizeof(sweet_fb_swapdone));   /* 0224 */
 	fVsyncNext = mach_absolute_time();
 	armVsync(fVsync);
 	powerStart();
@@ -1081,7 +1089,7 @@
 			fSwapPending = false;
 			frameInfoLatched(fSwapPendingID);
 		}
-		bool done = id == 0 || (int32_t)(id - fSwapLatchedID) < 0;
+		bool done = id == 0 || (int32_t)(id - fSwapLatchedID) < (sweet_fb_swapdone ? 1 : 0);
 		IOLockUnlock(fLock);
 		if (done) {
 			return kIOReturnSuccess;
@@ -1509,6 +1517,7 @@
 	case kSweetFBSwapWait:
 		if (args->scalarInputCount >= 2) {
 			ret = fFB->swapWait((uint32_t)args->scalarInput[0], (uint32_t)args->scalarInput[1]);
+			blue_trace('Q', (uint32_t)args->scalarInput[0], ret == kIOReturnSuccess);   /* 0224 */
 			sweet_fb_swapwait_n[ret == kIOReturnSuccess ? 0 : 1]++;
 			if (sweet_fb_swapwait_n[0] + sweet_fb_swapwait_n[1] <= 24) {
 				IOLog("SWEET FB: SwapWait id %llu flags 0x%llx (in %u, shown id %u, pending id %u%s) -> 0x%x\n",

-	if (coachz_baseband_enabled()) {
-		return;	/* the bridge publishes it with the rest */
-	}
 	if (coachz_ipappender_publish()) {
 		IOLog("BLUE PDP: AppleIPAppender published (every method unsupported; bluepdp=0 leaves it out)\n");
 	} else {

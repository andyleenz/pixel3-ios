 				    s->planeCount, s->offset, s->allocSize);
+				pooled = mem != NULL;
 			}
 			if (mem == NULL) {
 				mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
@@ -875,6 +919,8 @@

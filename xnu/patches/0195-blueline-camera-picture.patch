+/* 0195: linear 0..255 to roughly sRGB (gamma 2): isqrt(v * 255) */
+static uint8_t cap_gamma[256];
 static void
+cap_gamma_init(void)
+{
+	for (uint32_t v = 0, r = 0; v < 256; v++) {
+		while ((r + 1) * (r + 1) <= v * 255) {
+			r++;
+		}
+		cap_gamma[v] = (uint8_t)r;
+	}
+}
+
+static inline uint8_t
+cap_out(uint32_t v, uint32_t gain256, uint32_t top)
+{
+	v = (v * gain256 >> 8) * 255 / top;
+	return cap_gamma[v > 255 ? 255 : v];
+}

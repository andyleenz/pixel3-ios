+static bool
+gx_stage(struct gmu_mem *m, bool keep)
+{
+	bool hfi = false;
+
+	gx.gdscr_was = rd(gpucc + GPUCC_GX_GDSCR);
+	gx.misc_was = rd(gpucc + GPUCC_GX_DOMAIN_MISC);
+	gx.spt_ctl_was = gmu_rd(GMU_GX_SPTPRAC_POWER_CONTROL);
+	gx.started = true;
+	gx_report("stage 3 start");
+	if (gx.bw) {
+		gx_bw_vote();
+	}
+	if (gx_rail_on()) {
+		gx_sptprac_on();
+		hfi = hfi_run(m);
+	} else {
+		printf("BLUELINE GPU: no BOOT_SLUMBER ack: no HFI, straight to slumber\n");
+	}
+	if (hfi && gx.step >= 2) {
+		hfi = gx_hfi_tables(m);
+	}
+	if (hfi && gx.step >= 3) {
+		gx_dcvs();
+	}
+	if (hfi && gx.step >= 4) {
+		printf("BLUELINE GPU: OOB GPU_SET: asking the GMU for GX (a6xx_hw_init)\n");
+		gx.gpu_oob = true;
+		if (gmu_oob_set("GPU_SET", OOB_GPU_SET, OOB_GPU_ACK)) {
+			(void)gx_probe();
+		}
+		gx_report("after OOB GPU_SET");
+	}
+	hfi_dump(m);
+	printf("BLUELINE GPU: stage 3 %s (step %d)\n", gx.up ? "GX UP: THE GPU CORE ANSWERS" :
+	    gx.step < 4 ? "stopped early" : "GX NOT UP", gx.step);
+	if (keep) {
+		printf("BLUELINE GPU: GX, its votes%s and the OOB requests left as they are (bluegpu_keep=1)\n",
+		    gx.bw_voted ? ", the DDR vote" : "");
+		return hfi;
+	}
+	gx_down();
+	return hfi;
+}

+/* Its aux data (ARC: u16 levels; BCM: unit, width, vcd): up to max bytes into buf; returns the full length. */
+uint32_t blueline_cmddb_aux(const char *id, uint8_t *buf, uint32_t max);
+uint32_t
+blueline_cmddb_aux(const char *id, uint8_t *buf, uint32_t max)
+{
+	vm_offset_t aux = 0;
+	uint32_t len = 0;
+
+	if (!cmddb_find(id, 0, &aux, &len) || !aux) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < len && i < max; i++) {
+		buf[i] = rd8(aux + i);
+	}
+	return len;
 }
 
+/* The name of the resource at an RPMh address ("" and false if cmd-db has none). */
+bool blueline_cmddb_name(uint32_t addr, char name[9]);
+bool
+blueline_cmddb_name(uint32_t addr, char name[9])
+{
+	vm_offset_t e = cmddb_find(NULL, addr, NULL, NULL);
+
+	for (int k = 0; k < 8; k++) {
+		name[k] = e ? (char)rd8(e + k) : 0;
+	}
+	name[8] = 0;
+	return e != 0;
+}

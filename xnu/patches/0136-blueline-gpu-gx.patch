+/* a6xx_gmu_stop's gxpd_put (gdsc_disable) if GX still reads on; then GX's GPU CC words back to boot values. */
+static void
+gx_off_check(void)
+{
+	uint32_t gd = rd(gpucc + GPUCC_GX_GDSCR);
+
+	if (!gx.started) {
+		return;		/* nothing of stage 3 ran */
+	}
+	if (gd & GDSC_PWR_ON) {
+		printf("BLUELINE GPU: GX GDSC still on (%#x cfg %#x): collapsing it from the CPU\n", gd,
+		    rd(gpucc + GPUCC_GX_CFG_GDSCR));
+		wr(gpucc + GPUCC_GX_GDSCR, gd | GDSC_SW_COLLAPSE);
+		bool down = poll(gpucc + GPUCC_GX_CFG_GDSCR, GX_CFG_DOWN_DONE, GX_CFG_DOWN_DONE, 2000);
+		wr(gpucc + GPUCC_GX_DOMAIN_MISC, rd(gpucc + GPUCC_GX_DOMAIN_MISC) | 1u);	/* clamp the outputs */
+		printf("BLUELINE GPU: GX GDSC %#x cfg %#x: %s\n", rd(gpucc + GPUCC_GX_GDSCR), rd(gpucc + GPUCC_GX_CFG_GDSCR),
+		    down ? "collapsed" : "STILL ON after 2 ms");
+	}
+	gd = rd(gpucc + GPUCC_GX_GDSCR);
+	uint32_t misc = rd(gpucc + GPUCC_GX_DOMAIN_MISC), spt = gmu_rd(GMU_GX_SPTPRAC_POWER_CONTROL);
+	if (!(gd & GDSC_PWR_ON)) {
+		if (misc != gx.misc_was) {
+			wr(gpucc + GPUCC_GX_DOMAIN_MISC, gx.misc_was);
+		}
+		if ((gd ^ gx.gdscr_was) == GX_RETAIN_FF) {
+			wr(gpucc + GPUCC_GX_GDSCR, gx.gdscr_was);	/* only the retention bit differs */
+		}
+		if (spt != gx.spt_ctl_was && (gx.spt_ctl_was & 1u)) {
+			wr(gmu + GMU_REG(GMU_GX_SPTPRAC_POWER_CONTROL), gx.spt_ctl_was);	/* an "off" word */
+		}
+	}
+	printf("BLUELINE GPU: GX after stage 3: gdscr %#x (boot %#x) misc %#x (boot %#x) sptprac control %#x (boot %#x)%s\n",
+	    rd(gpucc + GPUCC_GX_GDSCR), gx.gdscr_was, rd(gpucc + GPUCC_GX_DOMAIN_MISC), gx.misc_was,
+	    gmu_rd(GMU_GX_SPTPRAC_POWER_CONTROL), gx.spt_ctl_was,
+	    (rd(gpucc + GPUCC_GX_GDSCR) & GDSC_PWR_ON) ? ": GX STILL POWERED" : "");
+}

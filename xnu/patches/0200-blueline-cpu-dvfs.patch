 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 0200: one CPU's idle time so far (mach absolute, up to now if it is idle), for
+ * the CPU clock governor in bsd/dev/blueline_cpufreq.c. Read without locks; the
+ * stamp is read on both sides of the total and the read retried if it moved.
+ */
+uint64_t blue_cpu_idle_abs(int cpu);
+uint64_t
+blue_cpu_idle_abs(int cpu)
+{
+	processor_t p = cpu_to_processor(cpu);
+	if (p == PROCESSOR_NULL) {
+		return 0;
+	}
+	struct recount_processor *pr = &p->pr_recount;
+	for (int tries = 0;; tries++) {
+		uint64_t s1 = os_atomic_load_wide(&pr->rpr_state_last_abs_time, acquire);
+		uint64_t idle = os_atomic_load_wide(&pr->rpr_idle_time_mach, acquire);
+		uint64_t now = mach_absolute_time();
+		uint64_t s2 = os_atomic_load_wide(&pr->rpr_state_last_abs_time, acquire);
+		if (s1 != s2 && tries < 4) {
+			continue;
+		}
+		if ((s2 & RCT_PR_IDLING) == RCT_PR_IDLING && now > _state_time(s2)) {
+			idle += now - _state_time(s2);
+		}
+		return idle;
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 bool
 recount_task_thread_perf_level_usage(struct task *task, uint64_t tid,
     struct recount_usage *usage_levels)

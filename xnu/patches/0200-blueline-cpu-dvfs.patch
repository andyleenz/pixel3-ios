+/* ---- 0200: load-based levels ---- */
+
+extern uint64_t blue_cpu_idle_abs(int cpu);	/* osfmk/kern/recount.c */
+void blue_cpu_input(void);
+
+/* Lowest level of d at or above khz, within [0, top]; top if none. */
+static uint32_t
+gov_level_at(const struct osm_dom *d, uint32_t khz, uint32_t top)
+{
+	for (uint32_t i = 0; i < top; i++) {
+		if (d->lut[i].khz >= khz) {
+			return i;
+		}
+	}
+	return top;
+}
+
 static void
+gov_set(uint32_t di, uint32_t idx)
+{
+	struct osm_dom *d = &doms[di];
+	for (uint32_t i = 0; i < (d->per_core ? 4u : 1u); i++) {
+		wr(d->base, REG_PERF_STATE + 4 * i, idx);
+	}
+	gov.cur[di] = idx;
+	gov.changes[di]++;
+}
+
+static void
+gov_account(uint64_t now)
+{
+	if (gov.lvl_t) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(now - gov.lvl_t, &ns);
+		for (uint32_t di = 0; di < G_DOMS; di++) {
+			gov.lvl_ns[di][gov.cur[di]] += ns;
+		}
+	}
+	gov.lvl_t = now;
+}
+
+static void
+gov_tick(uint64_t now)
+{
+	unsigned ncpu = ml_get_cpu_count() < 8 ? ml_get_cpu_count() : 8;
+	uint32_t busy[G_DOMS] = { 0, 0 };
+	uint64_t dt = now - gov.t_prev;
+	for (unsigned c = 0; c < ncpu; c++) {
+		uint64_t idle = blue_cpu_idle_abs((int)c), di = idle > gov.idle_prev[c] ? idle - gov.idle_prev[c] : 0;
+		gov.idle_prev[c] = idle;
+		uint32_t b = (dt && di < dt) ? (uint32_t)((dt - di) * 100 / dt) : 0;
+		gov.core_acc[c] += b;
+		uint32_t dom = c < 4 ? D_SILVER : D_GOLD;
+		if (b > busy[dom]) {
+			busy[dom] = b;
+		}
+	}
+	gov.t_prev = now;
+	uint64_t in_t = __atomic_load_n(&gov.input_t, __ATOMIC_ACQUIRE), boost_abs;
+	nanoseconds_to_absolutetime((uint64_t)gov.boost_ms * NSEC_PER_MSEC, &boost_abs);
+	bool boosted = gov.boost_ms > 0 && in_t && now - in_t < boost_abs;
+	uint64_t down_abs;
+	nanoseconds_to_absolutetime((uint64_t)gov.down_ms * NSEC_PER_MSEC, &down_abs);
+	gov.busy_n++;
+	for (uint32_t di = 0; di < G_DOMS; di++) {
+		struct osm_dom *d = &doms[di];
+		uint32_t cur = gov.cur[di], top = gov.cap[di];
+		gov.busy_acc[di] += busy[di];
+		uint32_t want = gov_level_at(d, (uint32_t)((uint64_t)d->lut[cur].khz * busy[di] /
+		    (uint32_t)gov.target), top);
+		if ((int)busy[di] >= gov.jump) {
+			uint32_t j = cur >= gov.hi[di] ? top : gov.hi[di];
+			if (want < j) {
+				want = j;
+			}
+		}
+		if (boosted && want < gov.boost[di]) {
+			if (cur < gov.boost[di]) {
+				gov.boosts++;
+			}
+			want = gov.boost[di];
+		}
+		if (want > top) {
+			want = top;
+		}
+		if (want > cur || cur > top) {
+			gov.down_since[di] = 0;
+			gov_set(di, want);
+		} else if (want == cur) {
+			gov.down_since[di] = 0;
+		} else if (!gov.down_since[di]) {
+			gov.down_since[di] = now;
+			gov.hold[di] = want;
+		} else {
+			if (want > gov.hold[di]) {
+				gov.hold[di] = want;
+			}
+			if (now - gov.down_since[di] >= down_abs) {
+				gov.down_since[di] = 0;
+				gov_set(di, gov.hold[di]);
+			}
+		}
+	}
+}
+
+static void
+gov_report(uint64_t now)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(now - gov.sum_t, &ns);
+	if (ns < 10ull * NSEC_PER_SEC) {
+		return;
+	}
+	for (uint32_t di = 0; di < G_DOMS; di++) {
+		char line[200];
+		int o = 0;
+		for (uint32_t l = 0; l < doms[di].rows && o < (int)sizeof(line) - 16; l++) {
+			uint64_t pct = gov.lvl_ns[di][l] * 100 / ns;
+			if (pct) {
+				o += snprintf(line + o, sizeof(line) - (size_t)o, " %u:%llu%%",
+				    doms[di].lut[l].khz / 1000u, pct);
+			}
+			gov.lvl_ns[di][l] = 0;
+		}
+		printf(TAG "DVFS 10s: %s busy %llu%%, now %u MHz, %u changes; MHz:time%s\n",
+		    doms[di].name, gov.busy_n ? gov.busy_acc[di] / gov.busy_n : 0,
+		    doms[di].lut[gov.cur[di]].khz / 1000u, gov.changes[di], line);
+		gov.busy_acc[di] = 0;
+		gov.changes[di] = 0;
+	}
+	uint64_t n = gov.busy_n ? gov.busy_n : 1, *ca = gov.core_acc;
+	printf(TAG "DVFS 10s: busy per core %llu %llu %llu %llu | %llu %llu %llu %llu %%, %u input boosts\n",
+	    ca[0] / n, ca[1] / n, ca[2] / n, ca[3] / n, ca[4] / n, ca[5] / n, ca[6] / n, ca[7] / n, gov.boosts);
+	for (int c = 0; c < 8; c++) {
+		ca[c] = 0;
+	}
+	gov.boosts = 0;
+	gov.busy_n = 0;
+	gov.sum_t = now;
+}
+
+static void
+gov_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		assert_wait_timeout((event_t)&gov.input_t, THREAD_UNINT, (uint32_t)gov.period_ms, NSEC_PER_MSEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);	/* the period, or at once on input */
+		uint64_t now = mach_absolute_time();
+		gov_account(now);
+		gov_tick(now);
+		gov_report(now);
+	}
+}
+
+/* SweetHID on every touch event and key (0200). */
+void
+blue_cpu_input(void)
+{
+	__atomic_store_n(&gov.input_t, mach_absolute_time(), __ATOMIC_RELEASE);
+	if (gov.on && (gov.cur[D_SILVER] < gov.boost[D_SILVER] || gov.cur[D_GOLD] < gov.boost[D_GOLD])) {
+		thread_wakeup((event_t)&gov.input_t);
+	}
+}
+
+static int
+gov_arg_mhz(const char *name, int def)
+{
+	int v = def;
+	(void)PE_parse_boot_argn(name, &v, sizeof(v));
+	return v;
+}
+
+static void
+gov_start(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("bluecpu_dvfs", &on, sizeof(on));
+	if (!on) {
+		printf(TAG "DVFS: off (bluecpu_dvfs=0); fixed levels\n");
+		return;
+	}
+	for (uint32_t di = 0; di < G_DOMS; di++) {
+		if (!doms[di].base || !doms[di].enabled || !doms[di].rows) {
+			printf(TAG "DVFS: %s OSM not usable; fixed levels\n", doms[di].name);
+			return;
+		}
+	}
+	gov.period_ms = 20;
+	gov.target = 80;
+	gov.jump = 90;
+	gov.down_ms = 60;
+	gov.boost_ms = 1000;
+	(void)PE_parse_boot_argn("bluecpu_dvfs_ms", &gov.period_ms, sizeof(gov.period_ms));
+	(void)PE_parse_boot_argn("bluecpu_dvfs_target", &gov.target, sizeof(gov.target));
+	(void)PE_parse_boot_argn("bluecpu_dvfs_jump", &gov.jump, sizeof(gov.jump));
+	(void)PE_parse_boot_argn("bluecpu_dvfs_down_ms", &gov.down_ms, sizeof(gov.down_ms));
+	(void)PE_parse_boot_argn("bluecpu_dvfs_boost_ms", &gov.boost_ms, sizeof(gov.boost_ms));
+	if (gov.period_ms < 5 || gov.period_ms > 1000) {
+		gov.period_ms = 20;
+	}
+	if (gov.target < 20 || gov.target > 100) {
+		gov.target = 80;
+	}
+	static const char *const nm[G_DOMS][4] = {
+		{ "bluecpu_max_silver", "bluecpu_hi_silver", "bluecpu_boost_silver", NULL },
+		{ "bluecpu_max_gold", "bluecpu_hi_gold", "bluecpu_boost_gold", NULL },
+	};
+	static const int def_hi[G_DOMS] = { 1228, 1459 }, def_boost[G_DOMS] = { 1228, 1459 };
+	for (uint32_t di = 0; di < G_DOMS; di++) {
+		struct osm_dom *d = &doms[di];
+		uint32_t top = osm_top(d, false);
+		int mx = gov_arg_mhz(nm[di][0], 0);
+		if (mx > 0) {
+			top = gov_level_at(d, (uint32_t)mx * 1000u, top);
+		}
+		gov.max[di] = gov.cap[di] = top;
+		gov.hi[di] = gov_level_at(d, (uint32_t)gov_arg_mhz(nm[di][1], def_hi[di]) * 1000u, top);
+		gov.boost[di] = gov_level_at(d, (uint32_t)gov_arg_mhz(nm[di][2], def_boost[di]) * 1000u, top);
+		uint32_t ps = rd(d->base, REG_PERF_STATE);
+		gov.cur[di] = ps < d->rows ? ps : top;
+	}
+	unsigned ncpu = ml_get_cpu_count() < 8 ? ml_get_cpu_count() : 8;
+	for (unsigned c = 0; c < ncpu; c++) {
+		gov.idle_prev[c] = blue_cpu_idle_abs((int)c);
+	}
+	gov.t_prev = gov.lvl_t = gov.sum_t = mach_absolute_time();
+	gov.on = true;
+	thread_t th;
+	if (kernel_thread_start(gov_thread, NULL, &th) != KERN_SUCCESS) {
+		gov.on = false;
+		printf(TAG "DVFS: no thread; fixed levels\n");
+		return;
+	}
+	thread_deallocate(th);
+	printf(TAG "DVFS: on (0200), every %d ms, target busy %d%%, jump at %d%%, down after %d ms; "
+	    "silver %u-%u MHz (hi %u, boost %u), gold %u-%u MHz (hi %u, boost %u) for %d ms after input\n",
+	    gov.period_ms, gov.target, gov.jump, gov.down_ms,
+	    doms[D_SILVER].lut[0].khz / 1000u, doms[D_SILVER].lut[gov.max[D_SILVER]].khz / 1000u,
+	    doms[D_SILVER].lut[gov.hi[D_SILVER]].khz / 1000u, doms[D_SILVER].lut[gov.boost[D_SILVER]].khz / 1000u,
+	    doms[D_GOLD].lut[0].khz / 1000u, doms[D_GOLD].lut[gov.max[D_GOLD]].khz / 1000u,
+	    doms[D_GOLD].lut[gov.hi[D_GOLD]].khz / 1000u, doms[D_GOLD].lut[gov.boost[D_GOLD]].khz / 1000u,
+	    gov.boost_ms);
+}

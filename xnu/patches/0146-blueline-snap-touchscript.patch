 }
+
+/*
+ * Scripted touches (patch 0146): the agent drives iOS without a hand.
+ *
+ *   bluetouchscript=STEP;STEP;...      ('/' works between steps too)
+ *   STEP = TIME:ACTION,ARG,...         (fields by ',': boot-args end at a space)
+ *   TIME = T | sb+T                    (sweet_ufs.c: s after the UFS driver
+ *                                       started, or after SpringBoard appeared)
+ *   tap,X,Y                down, 80 ms, up
+ *   hold,X,Y,MS            down, MS, up (long press)
+ *   swipe,X1,Y1,X2,Y2,MS   down at 1, a move every 16 ms along the line, at 2
+ *                          after MS, up
+ *   key,NAME               home|power|volup|voldown pressed for 100 ms
+ *                          (sweet_hid_key, as the hardware keys)
+ *   volchord               a fake-accelerometer quarter turn, as volume up +
+ *                          down (needs bluefakeaccel=1; BlueFakeMotion.cpp)
+ *   snap                   a screenshot now (bluesnap, sweet_ufs.c)
+ * Steps run in order, each at its time (at once if that has passed).
+ * X, Y are panel pixels (0..1079, 0..2159) and go through sweet_hid_touch's
+ * mapping, as finger 0. While a touch step runs, the touch screen's own
+ * contacts are dropped (SweetHID.cpp). The home and app-switcher gestures
+ * need an edge touch: the swipe must start within 48 px of the bottom
+ * (Y >= 2112, patch 0118), e.g. swipe,540,2150,540,900,300.
+ */
+extern void sweet_hid_touch_inject(int finger, int down, int x, int y);
+extern int sweet_hid_touch_script(int on);
+extern void sweet_hid_key(int key, int down);
+extern int blueline_fake_accel_turn(const char *why);
+extern int bluesnap_take(const char *why);
+extern bool blue_when_parse(const char **s, bool *sb, uint32_t *ms);
+extern bool blue_when_wait(bool sb, uint32_t ms);
+extern void blue_when_now(uint32_t *ms, int32_t *sb_ms);
+extern void blue_sleep_until(uint64_t deadline);
+void blueline_touchscript_start(void);
+
+#define SCRIPT_MOVE_MS  16
+static char touch_script[512];
+
+static uint64_t
+script_ms(uint32_t ms)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &abs);
+	return abs;
+}
+
+static bool
+script_int(const char **p, int *v)
+{
+	const char *s = *p;
+	int sign = 1, n = 0;
+
+	if (*s == ',') {
+		s++;
+	}
+	if (*s == '-') {
+		sign = -1;
+		s++;
+	}
+	if (*s < '0' || *s > '9') {
+		return false;
+	}
+	for (; *s >= '0' && *s <= '9'; s++) {
+		if (n > 1000000) {
+			return false;
+		}
+		n = n * 10 + (*s - '0');
+	}
+	*v = sign * n;
+	*p = s;
+	return true;
+}
+
+static bool
+script_word(const char **p, const char *w)
+{
+	size_t n = strlen(w);
+	if (strncmp(*p, w, n) != 0) {
+		return false;
+	}
+	char c = (*p)[n];
+	if (c != 0 && c != ',' && c != ';' && c != '/') {
+		return false;
+	}
+	*p += n;
+	return true;
+}
+
+/* One touch contact: down at 1, moves to 2 over ms (0: stays), up. */
+static void
+script_contact(int x1, int y1, int x2, int y2, uint32_t ms)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint32_t steps = ms / SCRIPT_MOVE_MS;
+
+	sweet_hid_touch_inject(0, 1, x1, y1);
+	for (uint32_t i = 1; i <= steps; i++) {
+		blue_sleep_until(t0 + script_ms(i * SCRIPT_MOVE_MS));
+		int x = x1 + (int)((int64_t)(x2 - x1) * i / steps);
+		int y = y1 + (int)((int64_t)(y2 - y1) * i / steps);
+		sweet_hid_touch_inject(0, 1, x, y);
+	}
+	blue_sleep_until(t0 + script_ms(ms));
+	sweet_hid_touch_inject(0, 1, x2, y2);
+	sweet_hid_touch_inject(0, 0, x2, y2);
+}
+
+static void
+touchscript_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const char *const keys[] = { "power", "volup", "voldown", "home" };
+	const char *p = touch_script;
+	unsigned n = 0;
+
+	while (*p) {
+		const char *step = p;
+		bool sb;
+		uint32_t when, ms;
+		int32_t sb_ms;
+		int a[5];
+		int k = -1;
+
+		if (!blue_when_parse(&p, &sb, &when) || *p++ != ':') {
+			printf("BLUELINE SCRIPT: bad time at \"%s\"; script stopped\n", step);
+			return;
+		}
+		const char *act = p;
+		bool ok = true;
+		enum { S_TAP, S_HOLD, S_SWIPE, S_KEY, S_CHORD, S_SNAP } kind;
+		if (script_word(&p, "tap")) {
+			kind = S_TAP;
+			ok = script_int(&p, &a[0]) && script_int(&p, &a[1]);
+		} else if (script_word(&p, "hold")) {
+			kind = S_HOLD;
+			ok = script_int(&p, &a[0]) && script_int(&p, &a[1]) && script_int(&p, &a[2]) &&
+			    a[2] >= 0 && a[2] <= 60000;
+		} else if (script_word(&p, "swipe")) {
+			kind = S_SWIPE;
+			ok = script_int(&p, &a[0]) && script_int(&p, &a[1]) && script_int(&p, &a[2]) &&
+			    script_int(&p, &a[3]) && script_int(&p, &a[4]) && a[4] >= 0 && a[4] <= 60000;
+		} else if (script_word(&p, "key")) {
+			kind = S_KEY;
+			ok = *p++ == ',';
+			for (int i = 0; ok && i < 4; i++) {
+				if (script_word(&p, keys[i])) {
+					k = i;
+				}
+			}
+			ok = ok && k >= 0;
+		} else if (script_word(&p, "volchord")) {
+			kind = S_CHORD;
+		} else if (script_word(&p, "snap")) {
+			kind = S_SNAP;
+		} else {
+			ok = false;
+			kind = S_SNAP;
+		}
+		if (!ok || (*p && *p != ';' && *p != '/')) {
+			printf("BLUELINE SCRIPT: bad step \"%s\"; script stopped\n", step);
+			return;
+		}
+		int act_len = (int)(p - act);
+		if (*p) {
+			p++;
+		}
+		if (!blue_when_wait(sb, when)) {
+			printf("BLUELINE SCRIPT: no SpringBoard in time; script stopped before \"%.*s\"\n",
+			    act_len, act);
+			return;
+		}
+		blue_when_now(&ms, &sb_ms);
+		printf("BLUELINE SCRIPT: step %u at %u.%03u s (SpringBoard %d ms): %.*s\n",
+		    n++, ms / 1000, ms % 1000, sb_ms, act_len, act);
+		if (kind == S_SWIPE && a[1] < 2112 && a[1] >= 2160 - 150) {
+			printf("BLUELINE SCRIPT: note: the swipe starts at y %d, above the 48 px bottom "
+			    "edge band (y >= 2112): no home gesture\n", a[1]);
+		}
+		switch (kind) {
+		case S_TAP:
+		case S_HOLD:
+		case S_SWIPE:
+			if (!sweet_hid_touch_script(1)) {
+				printf("BLUELINE SCRIPT: no touch service yet; step skipped\n");
+				break;
+			}
+			if (kind == S_TAP) {
+				script_contact(a[0], a[1], a[0], a[1], 80);
+			} else if (kind == S_HOLD) {
+				script_contact(a[0], a[1], a[0], a[1], (uint32_t)a[2]);
+			} else {
+				script_contact(a[0], a[1], a[2], a[3], (uint32_t)a[4]);
+			}
+			(void)sweet_hid_touch_script(0);
+			break;
+		case S_KEY:
+			sweet_hid_key(k, 1);
+			blue_sleep_until(mach_absolute_time() + script_ms(100));
+			sweet_hid_key(k, 0);
+			break;
+		case S_CHORD:
+			if (!blueline_fake_accel_turn("bluetouchscript volchord")) {
+				printf("BLUELINE SCRIPT: volchord: fake accelerometer off (needs bluefakeaccel=1)\n");
+			}
+			break;
+		case S_SNAP:
+			(void)bluesnap_take("bluetouchscript");
+			break;
+		}
+	}
+	printf("BLUELINE SCRIPT: done (%u steps)\n", n);
+}
+
+void
+blueline_touchscript_start(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_arg_str("bluetouchscript", touch_script, sizeof(touch_script)) ||
+	    !touch_script[0]) {
+		return;
+	}
+	printf("BLUELINE SCRIPT: %s\n", touch_script);
+	if (kernel_thread_start(touchscript_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */

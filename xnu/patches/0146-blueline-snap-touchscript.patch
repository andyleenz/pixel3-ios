 /*
+ * Timed test actions (patch 0146): screenshots here (bluesnap=) and
+ * scripted touches in blueline_touch.c (bluetouchscript=) share one clock.
+ * A time is
+ *   T        seconds (decimals allowed: 25.5) after this driver started,
+ *            the same clock as bluereboot_after=N
+ *   sb+T     T seconds after a process named SpringBoard first exists
+ *            (looked for every second, for up to bluereboot_timeout s, 300)
+ */
+static uint64_t blue_when_t0;                   /* mach time of sweet_ufs_init */
+static uint64_t _Atomic blue_when_sb;           /* mach time SpringBoard was first seen */
+static uint32_t blue_when_timeout = 300;
+static int blue_when_chan;
+
+bool blue_when_parse(const char **s, bool *sb, uint32_t *ms);
+bool blue_when_wait(bool sb, uint32_t ms);
+void blue_when_now(uint32_t *ms, int32_t *sb_ms);
+void blue_sleep_until(uint64_t deadline);
+
+static void
+blue_when_init(void)
+{
+	blue_when_t0 = mach_absolute_time();
+	(void)PE_parse_boot_argn("bluereboot_timeout", &blue_when_timeout, sizeof(blue_when_timeout));
+}
+
+void
+blue_sleep_until(uint64_t deadline)
+{
+	if (mach_absolute_time() < deadline) {
+		(void)assert_wait_deadline(&blue_when_chan, THREAD_UNINT, deadline);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static uint64_t
+blue_ms_to_abs(uint32_t ms)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &abs);
+	return abs;
+}
+
+static uint32_t
+blue_abs_to_ms(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
+
+/* "T" or "sb+T" at *s, T = digits [. up to 3 digits]; *s moves past it. */
+bool
+blue_when_parse(const char **s, bool *sb, uint32_t *ms)
+{
+	const char *p = *s;
+	uint32_t v = 0, frac = 0, scale = 1000;
+
+	*sb = false;
+	if ((p[0] == 's' || p[0] == 'S') && (p[1] == 'b' || p[1] == 'B')) {
+		*sb = true;
+		p += 2;
+		if (*p == '+') {
+			p++;
+		}
+	}
+	if (*p < '0' || *p > '9') {
+		return false;
+	}
+	for (; *p >= '0' && *p <= '9'; p++) {
+		if (v > 100000) {
+			return false;
+		}
+		v = v * 10 + (uint32_t)(*p - '0');
+	}
+	if (*p == '.') {
+		for (p++; *p >= '0' && *p <= '9'; p++) {
+			if (scale > 1) {
+				scale /= 10;
+				frac += (uint32_t)(*p - '0') * scale;
+			}
+		}
+	}
+	*ms = v * 1000 + frac;
+	*s = p;
+	return true;
+}
+
+static int
+blue_when_find_springboard(proc_t p, void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, "SpringBoard") == 0) {
+		*(bool *)arg = true;
+	}
+	return PROC_RETURNED;
+}
+
+/* Milliseconds since the driver started, and since SpringBoard (-1: not seen). */
+void
+blue_when_now(uint32_t *ms, int32_t *sb_ms)
+{
+	uint64_t now = mach_absolute_time(), sb = os_atomic_load(&blue_when_sb, relaxed);
+	*ms = blue_abs_to_ms(now - blue_when_t0);
+	*sb_ms = sb ? (int32_t)blue_abs_to_ms(now - sb) : -1;
+}
+
+/* Sleep until the time; false when SpringBoard did not come in time. */
+bool
+blue_when_wait(bool sb, uint32_t ms)
+{
+	uint64_t base = blue_when_t0;
+
+	if (sb) {
+		uint64_t limit = mach_absolute_time() + blue_ms_to_abs(blue_when_timeout * 1000u);
+		while ((base = os_atomic_load(&blue_when_sb, relaxed)) == 0) {
+			bool found = false;
+			proc_iterate(PROC_ALLPROCLIST, blue_when_find_springboard, &found, NULL, NULL);
+			if (found) {
+				(void)os_atomic_cmpxchg(&blue_when_sb, 0ull, mach_absolute_time(), relaxed);
+				continue;
+			}
+			if (mach_absolute_time() > limit) {
+				return false;
+			}
+			blue_sleep_until(mach_absolute_time() + blue_ms_to_abs(1000));
+		}
+	}
+	blue_sleep_until(base + blue_ms_to_abs(ms));
+	return true;
+}
+
+/*
+ * Screenshots (patch 0146): the agent sees the screen without a camera.
+ *
+ *   bluesnap=TIME,TIME,...     a snap at each time (see above), in list order
+ *   bluesnap_on_reboot=1       one more right before bluereboot resets
+ *   bluesnap_scale=2           1, 2 (default) or 4: box-filtered downscale
+ *   bluesnap_bpp=16            16 (RGB565, default) or 32 (B, G, R, A)
+ * bluetouchscript= can take one too (its "snap" action).
+ *
+ * A snap reads the panel memory (blue_fb_snapinfo(), SweetFramebuffer.cpp:
+ * 1080x2160 BGRA, stride 4320) through the kernel mapping AppleCLCD uses,
+ * averages scale x scale pixels and writes the picture to UFS through the
+ * same path as the console log ring: 2x, 16 bpp = 540x1080, 1139 KiB.
+ *
+ * Where: the 128 MiB of userdata right below the log area (the last
+ * 4100 KiB), so tools/phonetest.sh reads it from recovery with dd as it does
+ * the log. userdata holds only the 16 GiB HFS+ root image at its start; the
+ * rest (~35 GiB) is unused. Before the first write the HFS+ volume header
+ * is read and the snaps stay off unless the volume ends before the area.
+ * ufs_write_blocks() still refuses anything outside userdata.
+ *
+ * Area layout, 4 KiB blocks; block 0 (rewritten after each snap, and with
+ * count 0 when the snaps are armed, so a later pull never sees an older
+ * boot's pictures):
+ *   "BLUESNPS" | u64 boot nonce | u32 version 1 | u32 count
+ *   | u32 used blocks (with block 0) | u32 area blocks
+ * then each snap: one header block
+ *   "BLUESNAP" | u64 boot nonce | u32 version 1 | u32 index | u32 width
+ *   | u32 height | u32 bpp | u32 scale | u32 bytes | u32 ms since start
+ *   | i32 ms since SpringBoard (-1) | u32 panel width | u32 panel height
+ *   | u32 0 | char why[32]
+ * and the pixels (rows top to bottom, little endian), padded to a block.
+ */
+#define BLUESNAP_BLOCKS         ((128u << 20) / UFS_BLOCK)
+#define BLUESNAP_MAX            64u
+
+struct bluesnap_area {
+	char magic[8];
+	uint64_t nonce;
+	uint32_t version, count, used, blocks;
+};
+
+struct bluesnap_header {
+	char magic[8];
+	uint64_t nonce;
+	uint32_t version, index, width, height, bpp, scale, bytes, ms;
+	int32_t sb_ms;
+	uint32_t src_w, src_h, rsvd;
+	char why[32];
+};
+
+extern int blue_fb_snapinfo(uintptr_t *pixels, uint32_t *w, uint32_t *h, uint32_t *stride);
+int bluesnap_take(const char *why);
+
+static LCK_MTX_DECLARE(bluesnap_lock, &sweet_ufs_grp);
+static struct {
+	bool on, on_reboot;
+	uint32_t scale, bpp;
+	uint64_t area;                          /* first device block of the area */
+	uint64_t nonce;
+	uint32_t count, used;                   /* under bluesnap_lock */
+	vm_offset_t buf;
+	vm_size_t bufsize;
+	char times[256];
+} bs;
+
+/* Area block 0 into the bounce buffer and out. Caller holds sweet_ufs_lock. */
+static int
+bluesnap_write_area_locked(uint32_t count, uint32_t used)
+{
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	struct bluesnap_area a = {
+		.magic = { 'B', 'L', 'U', 'E', 'S', 'N', 'P', 'S' },
+		.nonce = bs.nonce, .version = 1, .count = count, .used = used,
+		.blocks = BLUESNAP_BLOCKS,
+	};
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &a, sizeof(a));
+	return ufs_write_blocks(bs.area, 1);
+}
+
+static inline uint32_t
+be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+/* Make the box-filtered copy of the panel in bs.buf. Returns the byte count. */
+static uint32_t
+bluesnap_convert(uintptr_t px, uint32_t w, uint32_t h, uint32_t stride, uint32_t *ow, uint32_t *oh)
+{
+	uint32_t sc = bs.scale, n = sc * sc;
+	*ow = w / sc;
+	*oh = h / sc;
+	uint32_t bytes = *ow * *oh * (bs.bpp / 8);
+	uint8_t *out = (uint8_t *)bs.buf;
+	/* scale rows of the panel, copied out of the write-combined mapping in one go each */
+	const uint8_t *rows = (const uint8_t *)(bs.buf + ((bytes + 63u) & ~63u));
+
+	for (uint32_t oy = 0; oy < *oh; oy++) {
+		for (uint32_t r = 0; r < sc; r++) {
+			memcpy((void *)(uintptr_t)(rows + (uint64_t)r * w * 4),
+			    (const void *)(px + (uint64_t)(oy * sc + r) * stride), (size_t)w * 4);
+		}
+		for (uint32_t ox = 0; ox < *ow; ox++) {
+			uint32_t b = 0, g = 0, rd = 0;
+			for (uint32_t r = 0; r < sc; r++) {
+				const uint8_t *p = rows + ((uint64_t)r * w + (uint64_t)ox * sc) * 4;
+				for (uint32_t c = 0; c < sc; c++, p += 4) {
+					b += p[0];
+					g += p[1];
+					rd += p[2];
+				}
+			}
+			b /= n;
+			g /= n;
+			rd /= n;
+			if (bs.bpp == 16) {
+				uint16_t v = (uint16_t)((rd >> 3) << 11 | (g >> 2) << 5 | (b >> 3));
+				out[0] = (uint8_t)v;
+				out[1] = (uint8_t)(v >> 8);
+				out += 2;
+			} else {
+				out[0] = (uint8_t)b;
+				out[1] = (uint8_t)g;
+				out[2] = (uint8_t)rd;
+				out[3] = 0xff;
+				out += 4;
+			}
+		}
+	}
+	return bytes;
+}
+
+/* One snap now. Thread context only (it sleeps on locks and UFS commands). */
+int
+bluesnap_take(const char *why)
+{
+	uintptr_t px;
+	uint32_t w, h, stride, ow, oh, ms;
+	int32_t sb_ms;
+	int error = 0;
+
+	if (!bs.on) {
+		return ENXIO;
+	}
+	if (!blue_fb_snapinfo(&px, &w, &h, &stride) || w < bs.scale || h < bs.scale) {
+		printf("BLUELINE SNAP: %s: no framebuffer yet, no snap\n", why);
+		return ENXIO;
+	}
+	lck_mtx_lock(&bluesnap_lock);
+	uint32_t need_bytes = (w / bs.scale) * (h / bs.scale) * (bs.bpp / 8);
+	uint32_t blocks = 1 + (need_bytes + UFS_BLOCK - 1) / UFS_BLOCK;
+	if (bs.count >= BLUESNAP_MAX || bs.used + blocks > BLUESNAP_BLOCKS) {
+		printf("BLUELINE SNAP: %s: area full (%u snaps), no snap\n", why, bs.count);
+		lck_mtx_unlock(&bluesnap_lock);
+		return ENOSPC;
+	}
+	vm_size_t want = round_page((vm_size_t)((need_bytes + 63u) & ~63u) + (vm_size_t)bs.scale * w * 4);
+	if (bs.bufsize < want) {
+		if (bs.buf) {
+			kmem_free(kernel_map, bs.buf, bs.bufsize);
+			bs.buf = 0;
+			bs.bufsize = 0;
+		}
+		if (kmem_alloc(kernel_map, &bs.buf, want, KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			bs.buf = 0;
+			printf("BLUELINE SNAP: %s: no memory for %lu KiB, no snap\n", why, (unsigned long)(want >> 10));
+			lck_mtx_unlock(&bluesnap_lock);
+			return ENOMEM;
+		}
+		bs.bufsize = want;
+	}
+
+	blue_when_now(&ms, &sb_ms);
+	uint64_t t = mach_absolute_time();
+	uint32_t bytes = bluesnap_convert(px, w, h, stride, &ow, &oh);
+	uint32_t conv_ms = blue_abs_to_ms(mach_absolute_time() - t);
+
+	uint64_t at = bs.area + bs.used;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	struct bluesnap_header hd = {
+		.magic = { 'B', 'L', 'U', 'E', 'S', 'N', 'A', 'P' },
+		.nonce = bs.nonce, .version = 1, .index = bs.count, .width = ow, .height = oh,
+		.bpp = bs.bpp, .scale = bs.scale, .bytes = bytes, .ms = ms, .sb_ms = sb_ms,
+		.src_w = w, .src_h = h,
+	};
+	strlcpy(hd.why, why, sizeof(hd.why));
+
+	t = mach_absolute_time();
+	lck_mtx_lock(&sweet_ufs_lock);
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &hd, sizeof(hd));
+	error = ufs_write_blocks(at, 1);
+	for (uint32_t off = 0; !error && off < bytes; off += BOUNCE_SIZE) {
+		uint32_t n = MIN(BOUNCE_SIZE, bytes - off);
+		uint32_t nb = (n + UFS_BLOCK - 1) / UFS_BLOCK;
+		memcpy(bounce, (const void *)(bs.buf + off), n);
+		bzero((char *)bounce + n, nb * UFS_BLOCK - n);
+		error = ufs_write_blocks(at + 1 + off / UFS_BLOCK, nb);
+	}
+	if (!error) {
+		error = bluesnap_write_area_locked(bs.count + 1, bs.used + blocks);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	uint32_t write_ms = blue_abs_to_ms(mach_absolute_time() - t);
+
+	if (error) {
+		printf("BLUELINE SNAP: %s: UFS write failed (%d); snaps off\n", why, error);
+		bs.on = false;
+	} else {
+		printf("BLUELINE SNAP: #%u %s at %u.%03u s (SpringBoard %d ms): %ux%u, %u bpp, %u KiB "
+		    "at block 0x%llx; %u ms to read, %u ms to write\n",
+		    bs.count, why, ms / 1000, ms % 1000, sb_ms, ow, oh, bs.bpp, bytes >> 10, at,
+		    conv_ms, write_ms);
+		bs.count++;
+		bs.used += blocks;
+	}
+	lck_mtx_unlock(&bluesnap_lock);
+	return error;
+}
+
+static void
+bluesnap_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	const char *p = bs.times;
+	char why[32];
+
+	while (*p) {
+		const char *item = p;
+		bool sb;
+		uint32_t ms;
+		if (!blue_when_parse(&p, &sb, &ms) || (*p && *p != ',')) {
+			printf("BLUELINE SNAP: bad time at \"%s\" in bluesnap=; stopping\n", item);
+			return;
+		}
+		snprintf(why, sizeof(why), "bluesnap %.*s", (int)(p - item), item);
+		if (*p == ',') {
+			p++;
+		}
+		if (!blue_when_wait(sb, ms)) {
+			printf("BLUELINE SNAP: no SpringBoard after %u s; snaps at sb+ times dropped\n",
+			    blue_when_timeout);
+			(void)bluesnap_take("SpringBoard timeout");
+			return;
+		}
+		(void)bluesnap_take(why);
+	}
+}
+
+static void
+bluesnap_arm(void)
+{
+	char script[8];
+	thread_t thread;
+
+	bool have_times = PE_parse_boot_arg_str("bluesnap", bs.times, sizeof(bs.times)) && bs.times[0];
+	uint32_t on_reboot = 0;
+	(void)PE_parse_boot_argn("bluesnap_on_reboot", &on_reboot, sizeof(on_reboot));
+	bool have_script = PE_parse_boot_arg_str("bluetouchscript", script, sizeof(script)) && script[0];
+	if (!have_times && !on_reboot && !have_script) {
+		return;
+	}
+	bs.scale = 2;
+	bs.bpp = 16;
+	(void)PE_parse_boot_argn("bluesnap_scale", &bs.scale, sizeof(bs.scale));
+	(void)PE_parse_boot_argn("bluesnap_bpp", &bs.bpp, sizeof(bs.bpp));
+	if (bs.scale != 1 && bs.scale != 2 && bs.scale != 4) {
+		bs.scale = 2;
+	}
+	if (bs.bpp != 16 && bs.bpp != 32) {
+		bs.bpp = 16;
+	}
+	if (!su.writable) {
+		printf("BLUELINE SNAP: off: needs ufsrw=1\n");
+		return;
+	}
+	if (su.nblocks < 2 * (SWEET_LOG_BLOCKS + BLUESNAP_BLOCKS)) {
+		printf("BLUELINE SNAP: off: partition too small\n");
+		return;
+	}
+	uint64_t rel = su.nblocks - SWEET_LOG_BLOCKS - BLUESNAP_BLOCKS;
+	bs.area = su.first_block + rel;
+	bs.nonce = mach_absolute_time();
+
+	/* The HFS+ volume header (partition byte 1024) must end before the area. */
+	lck_mtx_lock(&sweet_ufs_lock);
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(su.first_block, 1);
+	uint64_t hfs_end = 0;
+	uint32_t sig = 0;
+	if (!error) {
+		sig = (uint32_t)b[1024] << 8 | b[1025];
+		hfs_end = ((uint64_t)be32(b + 1024 + 40) * be32(b + 1024 + 44) + UFS_BLOCK - 1) / UFS_BLOCK;
+	}
+	if (error || (sig != 0x482b && sig != 0x4858) || hfs_end == 0 || hfs_end > rel) {
+		lck_mtx_unlock(&sweet_ufs_lock);
+		printf("BLUELINE SNAP: off: HFS+ volume header %s (signature 0x%04x, ends at block 0x%llx, "
+		    "area at 0x%llx); not writing\n", error ? "unreadable" : "does not clear the area",
+		    sig, hfs_end, rel);
+		return;
+	}
+	error = bluesnap_write_area_locked(0, 1);
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		printf("BLUELINE SNAP: off: area header write failed (%d)\n", error);
+		return;
+	}
+	bs.used = 1;
+	bs.on_reboot = on_reboot != 0;
+	bs.on = true;
+	printf("BLUELINE SNAP: %u MiB at block 0x%llx (userdata +%llu MiB; HFS+ ends at %llu MiB), "
+	    "scale %u, %u bpp; at %s%s\n",
+	    BLUESNAP_BLOCKS * UFS_BLOCK >> 20, bs.area, rel * UFS_BLOCK >> 20, hfs_end * UFS_BLOCK >> 20,
+	    bs.scale, bs.bpp, have_times ? bs.times : "-", bs.on_reboot ? ", and before reboot" : "");
+	if (have_times && kernel_thread_start(bluesnap_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}

+extern "C" IOBufferMemoryDescriptor *blue_dpu_pool_take(uint32_t w, uint32_t h, uint32_t bpr, uint32_t fmt,
+    uint32_t planes, uint32_t offset, uint64_t size);
+extern "C" void blue_dpu_pool_put(IOMemoryDescriptor *md);
 
 #define BD_MDSS_PA      0x0ae00000ULL   /* sdm845.dtsi mdss */
 #define BD_MDSS_SIZE    0x90000         /* MDSS 0x1000 + MDP 0x8f000 */
@@ -170,6 +211,39 @@ static const char *const bd_intr2_names[32] = {
 #define SSPP_OUT_SIZE_REC1      0x160
 #define SSPP_OUT_XY_REC1        0x164
 #define SSPP_QSEED3             0xa00   /* VIG: dpu_vig_sblk_qseed3_1_3 */
+#define SSPP_PE_C0_LR           0x100   /* SW pixel extension (SRC_OP_MODE bit 31 PE_OVERRIDE) */
+#define SSPP_PE_C0_TB           0x104
+#define SSPP_PE_C0_REQ          0x108
+#define SSPP_PE_C1C2_LR         0x110
+#define SSPP_PE_C1C2_TB         0x114
+#define SSPP_PE_C1C2_REQ        0x118
+#define SSPP_PE_C3_LR           0x120
+#define SSPP_PE_C3_TB           0x124
+#define SSPP_PE_C3_REQ          0x128
+/* QSEED3 (dpu_hw_util.c), at SSPP_QSEED3; version 0x1003 has the 21-bit phase inits */
+#define QS3_HW_VERSION          0x00
+#define QS3_OP_MODE             0x04
+#define QS3_PHASE_STEP_Y_H      0x10
+#define QS3_PHASE_STEP_Y_V      0x14
+#define QS3_PHASE_STEP_UV_H     0x18
+#define QS3_PHASE_STEP_UV_V     0x1c
+#define QS3_PRELOAD             0x20
+#define QS3_SRC_SIZE_Y_RGB_A    0x40
+#define QS3_SRC_SIZE_UV         0x44
+#define QS3_DST_SIZE            0x48
+#define QS3_PHASE_INIT_Y_H      0x90
+#define QS3_PHASE_INIT_Y_V      0x94
+#define QS3_PHASE_INIT_UV_H     0x98
+#define QS3_PHASE_INIT_UV_V     0x9c
+#define QS3_PHASE_SHIFT         21
+/*
+ * dpu_hw_setup_scaler3 for an RGB source with alpha, as _dpu_plane_setup_scaler3:
+ * enable, y/rgb filter DPU_SCALE_BIL (3), alpha filter BIL (1 << 29),
+ * blend_cfg 1 (bit 31), not DX (bit 14), alpha enable (bit 10).
+ */
+#define QS3_OP_RGB_BIL          (1u << 0 | 3u << 16 | 1u << 10 | 1u << 14 | 1u << 29 | 1u << 31)
+#define QS3_PRELOAD_DEFAULT     (4u << 0 | 3u << 8 | 4u << 16 | 3u << 24)      /* H 4, V 3 */
+#define BD_FMT_BGRA             0x42475241u     /* 'BGRA', SweetFramebuffer's pixel format */
 
 /* LM (dpu_hw_lm.c), blend stage 0 at 0x20 */
 #define LM_OP_MODE              0x00
@@ -780,12 +854,18 @@ struct bd_rect_plan {
 	uint32_t xy_off;        /* SRC_XY(_REC1) */
 	uint32_t byte_off;      /* address = buffer + byte_off */
 	uint32_t xy;            /* new source x/y */
+	/* fit (0145): new rect geometry and QSEED3 setup, only if fit */
+	bool     fit;
+	uint32_t src_size, out_size, out_xy;    /* h << 16 | w, y << 16 | x */
+	uint32_t step_h, step_v;                /* 21-bit fraction source pixels per output pixel */
 };
 
 struct bd_plan {
 	int      n;
+	bool     fit;
 	uint32_t stride;        /* bytes per row of the buffer */
 	uint32_t flush;
+	uint32_t fit_x, fit_w;  /* fit: panel columns the picture covers */
 	struct bd_rect_plan r[16];
 };
 
@@ -841,13 +921,124 @@ bd_plan_crop(const struct bd_state *st, uint32_t lw, uint32_t lh, uint32_t strid
 			    p->name, r, bad, addr, xy, sz, ys, fmt);
 			return why;
 		}
-		pl->r[pl->n++] = (struct bd_rect_plan){
-			p->base, r, a_off, x_off, row0 * stride + col0 * 4, y << 16 | x,
+		struct bd_rect_plan *rp = &pl->r[pl->n++];
+		bzero(rp, sizeof(*rp));
+		rp->base = p->base;
+		rp->rect = r;
+		rp->addr_off = a_off;
+		rp->xy_off = x_off;
+		rp->byte_off = row0 * stride + col0 * 4;
+		rp->xy = y << 16 | x;
+	}
+	return NULL;
+}
+
+/*
+ * Fit (0145): the whole lw x lh buffer scaled to the panel height and
+ * centred, as AppleCLCD's bluefb_fit=1 copy (fit_w = lw * H / lh = 997 of
+ * 1080 columns for 1125x2436). Each LM drives one half of the panel; its
+ * VIG pipe takes the source columns that land in that half and its QSEED3
+ * scales them (bilinear) to the half's share of the picture. The columns
+ * outside fit_x..fit_x+fit_w show the layer mixer's border colour.
+ */
+static const char *
+bd_plan_fit(const struct bd_state *st, uint32_t lw, uint32_t lh, uint32_t stride, struct bd_plan *pl)
+{
+	static char why[200];
+	bzero(pl, sizeof(*pl));
+	pl->fit = true;
+	pl->stride = stride;
+	pl->flush = st->flush;
+	if (st->ctl < 0 || st->pp < 0 || st->nsrc == 0 || st->intf < 0) {
+		snprintf(why, sizeof(why), "pipeline not as expected (ctl %d pp %d rects %d intf %d)",
+		    st->ctl, st->pp, st->nsrc, st->intf);
+		return why;
+	}
+	if (lh <= bd_h || stride < lw * 4 || (stride & 15) || lw > 4096 || lh > 4096) {
+		snprintf(why, sizeof(why), "buffer %ux%u stride %u: nothing to fit to %ux%u", lw, lh, stride, bd_w, bd_h);
+		return why;
+	}
+	pl->fit_w = (uint32_t)((uint64_t)lw * bd_h / lh);
+	pl->fit_x = pl->fit_w < bd_w ? (bd_w - pl->fit_w) / 2 : 0;
+	if (pl->fit_w > bd_w) {
+		snprintf(why, sizeof(why), "fitted width %u wider than the panel", pl->fit_w);
+		return why;
+	}
+	if (st->nlm < 1 || st->nlm > 2 || st->nsrc != st->nlm) {
+		snprintf(why, sizeof(why), "%d LM / %d rects, want one rect per LM, 1 or 2 LMs", st->nlm, st->nsrc);
+		return why;
+	}
+	for (int s = 0; s < st->nsrc; s++) {
+		const struct bd_src *src = &st->src[s];
+		const struct bd_pipe_desc *p = &bd_pipes[src->pipe];
+		int k = -1;
+		for (int j = 0; j < st->nlm; j++) {
+			k = st->lm[j] == src->lm ? j : k;
+		}
+		uint32_t lmsz = mdp_rd(bd_lms[src->lm].base + LM_OUT_SIZE), lmw = lmsz & 0xffff;
+		uint32_t osz = bd_abl(p->base + SSPP_OUT_SIZE), oxy = bd_abl(p->base + SSPP_OUT_XY);
+		uint32_t fmt = mdp_rd(p->base + SSPP_SRC_FORMAT);
+		const char *bad = NULL;
+		if (!p->vig || src->rect != 0 || mdp_rd(p->base + SSPP_MULTIRECT_OPMODE) != 0) {
+			bad = "not a single-rect VIG pipe (no scaler)";
+		} else if ((mdp_rd(p->base + SSPP_QSEED3 + QS3_HW_VERSION) >> 8) == 0) {
+			bad = "no QSEED3 version";
+		} else if (k < 0 || (lmsz >> 16) != bd_h || lmw * (uint32_t)st->nlm != bd_w) {
+			bad = "layer mixers do not split the panel evenly";
+		} else if (osz != (bd_h << 16 | lmw) || (oxy >> 16) != 0) {
+			bad = "ABL's rect does not fill its LM";
+		} else if (((fmt >> 9) & 3) != 3 || ((fmt >> 30) & 3) != 0 || (fmt & (1u << 22))) {
+			bad = "not a linear 32-bit source";
+		} else if (mdp_rd(p->base + SSPP_ADDR_SW_STATUS) != 0) {
+			bad = "secure fetch";
+		}
+		uint32_t p0 = (uint32_t)k * lmw, p1 = p0 + lmw;
+		uint32_t d0 = p0 > pl->fit_x ? p0 : pl->fit_x;
+		uint32_t d1 = p1 < pl->fit_x + pl->fit_w ? p1 : pl->fit_x + pl->fit_w;
+		if (bad == NULL && d1 <= d0) {
+			bad = "LM half gets none of the picture";
+		}
+		if (bad != NULL) {
+			snprintf(why, sizeof(why), "%s rect %d on %s: %s (out 0x%x at 0x%x, LM out 0x%x, fmt 0x%x)",
+			    p->name, src->rect, bd_lms[src->lm].name, bad, osz, oxy, lmsz, fmt);
+			return why;
+		}
+		uint32_t s0 = (uint32_t)((uint64_t)(d0 - pl->fit_x) * lw / pl->fit_w);
+		uint32_t s1 = (uint32_t)(((uint64_t)(d1 - pl->fit_x) * lw + pl->fit_w - 1) / pl->fit_w);
+		s1 = s1 > lw ? lw : s1;
+		uint32_t sw = s1 - s0, dw = d1 - d0;
+		struct bd_rect_plan *r = &pl->r[pl->n++];
+		*r = (struct bd_rect_plan){
+			.base = p->base, .rect = 0,
+			.addr_off = p->base + SSPP_SRC0_ADDR, .xy_off = p->base + SSPP_SRC_XY,
+			.byte_off = 0, .xy = s0,
+			.fit = true,
+			.src_size = lh << 16 | sw,
+			.out_size = bd_h << 16 | dw,
+			.out_xy = (oxy & 0xffff) + (d0 - p0),       /* ABL's x convention (absolute with source split) */
+			.step_h = (uint32_t)(((uint64_t)sw << QS3_PHASE_SHIFT) / dw),
+			.step_v = (uint32_t)(((uint64_t)lh << QS3_PHASE_SHIFT) / bd_h),
 		};
 	}
 	return NULL;
 }
 
+static void
+bd_plan_log(const char *tag, const struct bd_plan *pl)
+{
+	for (int i = 0; i < pl->n; i++) {
+		const struct bd_rect_plan *r = &pl->r[i];
+		if (r->fit) {
+			IOLog("BLUE DPU: %s: SSPP 0x%x fit: src x %u size %ux%u -> out x %u size %ux%u, step h 0x%x v 0x%x (fit %u+%u, stride %u)\n",
+			    tag, r->base, r->xy & 0xffff, r->src_size & 0xffff, r->src_size >> 16, r->out_xy & 0xffff,
+			    r->out_size & 0xffff, r->out_size >> 16, r->step_h, r->step_v, pl->fit_x, pl->fit_w, pl->stride);
+		} else {
+			IOLog("BLUE DPU: %s: SSPP 0x%x rect %d crop: +0x%x xy 0x%x stride %u\n", tag, r->base, r->rect,
+			    r->byte_off, r->xy, pl->stride);
+		}
+	}
+}
+
 /* Flush the planned pipes and wait until the CTL took the change (the next frame start). */
 static int64_t
 bd_flush(const struct bd_state *st, uint32_t bits, const char *tag, bool sleep, uint32_t max_ms)
@@ -896,6 +1087,33 @@ bd_plan_write(const struct bd_plan *pl, uint64_t pa, bool all)
 		bd_set(r->xy_off, r->xy);
 		uint32_t sh = r->rect ? 16 : 0, ys = mdp_rd(r->base + SSPP_SRC_YSTRIDE0);
 		bd_set(r->base + SSPP_SRC_YSTRIDE0, (ys & ~(0xffffu << sh)) | (pl->stride << sh));
+		if (!r->fit) {
+			continue;
+		}
+		/* rect geometry, pixel extension (ABL runs PE_OVERRIDE: requested = source size), QSEED3 */
+		uint32_t q = r->base + SSPP_QSEED3;
+		bd_set(r->base + SSPP_SRC_SIZE, r->src_size);
+		bd_set(r->base + SSPP_OUT_SIZE, r->out_size);
+		bd_set(r->base + SSPP_OUT_XY, r->out_xy);
+		static const uint32_t pe_lr[] = { SSPP_PE_C0_LR, SSPP_PE_C1C2_LR, SSPP_PE_C3_LR };
+		for (int c = 0; c < 3; c++) {
+			bd_set(r->base + pe_lr[c], 0);                  /* LR */
+			bd_set(r->base + pe_lr[c] + 4, 0);              /* TB */
+			bd_set(r->base + pe_lr[c] + 8, r->src_size);    /* REQ_PIXELS: h << 16 | w */
+		}
+		bd_set(q + QS3_PHASE_INIT_Y_H, 0);
+		bd_set(q + QS3_PHASE_INIT_Y_V, 0);
+		bd_set(q + QS3_PHASE_INIT_UV_H, 0);
+		bd_set(q + QS3_PHASE_INIT_UV_V, 0);
+		bd_set(q + QS3_PHASE_STEP_Y_H, r->step_h);
+		bd_set(q + QS3_PHASE_STEP_Y_V, r->step_v);
+		bd_set(q + QS3_PHASE_STEP_UV_H, r->step_h);
+		bd_set(q + QS3_PHASE_STEP_UV_V, r->step_v);
+		bd_set(q + QS3_PRELOAD, QS3_PRELOAD_DEFAULT);
+		bd_set(q + QS3_SRC_SIZE_Y_RGB_A, r->src_size);
+		bd_set(q + QS3_SRC_SIZE_UV, r->src_size);
+		bd_set(q + QS3_DST_SIZE, r->out_size);
+		bd_set(q + QS3_OP_MODE, QS3_OP_RGB_BIL);
 	}
 }
 
@@ -1037,11 +1255,12 @@ bd_test(struct bd_state *st)
 	struct bd_plan plan;
 	struct bd_rate rate;
 
-	const char *bad = bd_plan_crop(st, lw, lh, bstride, &plan);
+	const char *bad = bd_mode == 3 ? bd_plan_fit(st, lw, lh, bstride, &plan) : bd_plan_crop(st, lw, lh, bstride, &plan);
 	if (bad != NULL) {
 		IOLog("BLUE DPU: test skipped: %s\n", bad);
 		return;
 	}
+	bd_plan_log(bd_mode == 3 ? "test plan (fit)" : "test plan (crop)", &plan);
 	if (bd_target == 2) {
 		ram = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, size, 0x00000000ffffc000ULL);
@@ -1085,7 +1304,15 @@ bd_test(struct bd_state *st)
 		if (in) {
 			memcpy(row + offx, (const void *)(bd_panel_va + (uint64_t)(y - offy) * bd_stride), (size_t)bd_w * 4);
 		}
-		/* marker: 12 px magenta frame around the visible part, 160 px checker below the status bar */

     uintptr_t panel_va, uint32_t lw, uint32_t lh);
+extern "C" int blue_dpu_flip_init(int fit);
 extern "C" void blue_dpu_stat(int kind, uint64_t dt);
+extern "C" int blue_dpu_flip(IOMemoryDescriptor *md, uintptr_t kva, uint32_t offset, uint32_t bpr,
+    uint32_t w, uint32_t h, uint32_t fmt);

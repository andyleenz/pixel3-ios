+		if (bd_mode == 3) {
+			for (uint32_t x = 0; x < lw; x++) {
+				if (y < 12 || y >= lh - 12 || x < 12 || x >= lw - 12) {
+					row[x] = 0xffff00ffu;
+				}
+			}
+		}
+		/* marker: 12 px magenta frame around the panel crop, 160 px checker below the status bar */
 		if (in) {
 			uint32_t vy = y - offy;
 			for (uint32_t x = 0; x < bd_w; x++) {
@@ -1179,6 +1406,7 @@ out:
 	IOLog("BLUE DPU: test done\n");
 }
 
+
 static void
 bd_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -1196,11 +1424,367 @@ bd_thread(__unused void *arg, __unused wait_result_t wr)
 	}

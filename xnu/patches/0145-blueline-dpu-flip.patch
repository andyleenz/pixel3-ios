+		    s->pixelFormat) != 0;
+	}
+	if (ok) {
+		consoleOnce();
+		IOLockLock(fLock);
+		memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);  /* the latest frame, for wake / fallback */
+		fDirty = false;
+		IOLockUnlock(fLock);
+	}
+	IOLockUnlock(fPresentLock);
+	s->release();
+	return ok;
+}

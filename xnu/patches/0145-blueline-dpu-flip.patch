+/* ---------------- 0145: zero-copy present (bluedpu_flip=1) ---------------- */
+
+#define BD_POOL_MAX     4
+#define BD_FLIP_WAIT_MS 50      /* > 2 frames at 60 Hz; dpu2 latched in 1.9 ms */
+#define BD_ONCE_MAX     24
+
+static IOLock *bd_flip_lock;            /* flip state, plan, pool */
+static bool bd_flip_on;                 /* allowed (turned off for the boot on any trouble) */
+static volatile bool bd_flipped;        /* the SSPPs fetch a pool buffer, not the panel buffer */
+static bool bd_geom;                    /* the plan's geometry is written (only addresses change) */
+static int bd_fit;                      /* AppleCLCD's bluefb_fit */
+static struct bd_plan bd_fplan;
+static uint32_t bd_fplan_stride;        /* stride bd_fplan was made for, 0 none */
+static uint64_t bd_flip_pa;             /* buffer being fetched */
+static IOBufferMemoryDescriptor *bd_pool[BD_POOL_MAX];
+static uint64_t bd_pool_pa[BD_POOL_MAX];
+static bool bd_pool_used[BD_POOL_MAX];
+static int bd_pool_n;
+static uint64_t bd_pool_size;
+static const char *bd_once_seen[BD_ONCE_MAX];
+static uint32_t bd_n_flip, bd_n_unflip, bd_latch_max_us;
+static uint64_t bd_clean_us, bd_latch_us;
+
+/* Log a reason for not flipping the first time it happens (why is a string literal). */
+static void
+bd_once(const char *why, const char *detail)
+{
+	for (int i = 0; i < BD_ONCE_MAX; i++) {
+		if (bd_once_seen[i] == why) {
+			return;
+		}
+		if (bd_once_seen[i] == NULL) {
+			bd_once_seen[i] = why;
+			IOLog("BLUE DPU: flip: copying instead: %s%s%s (logged once)\n", why, detail ? ": " : "",
+			    detail ? detail : "");
+			return;
+		}
+	}
+}
+
+/* Back to the panel buffer (flip lock held). */
+static void
+bd_unflip_locked(const char *why)
+{
+	if (!bd_flipped) {
+		return;
+	}
+	char tag[64];
+	snprintf(tag, sizeof(tag), "unflip (%s)", why);
+	bd_n_unflip++;
+	if (bd_restore(&bd_st, bd_n_unflip <= 8 ? tag : NULL, true, BD_FLIP_WAIT_MS) < 0) {
+		IOLog("BLUE DPU: %s: the panel buffer is not being fetched yet\n", tag);
+	}
+	bd_flipped = false;
+	bd_geom = false;
+	bd_flip_pa = 0;
+}
+
+/* Something is wrong: no more flips this boot (flip lock held). */
+static void
+bd_flip_off(const char *why)
+{
+	if (bd_flip_on) {
+		IOLog("BLUE DPU: flip: turned off for this boot: %s\n", why);
+	}
+	bd_flip_on = false;
+	bd_unflip_locked(why);
+}
+
+static int
+bd_pool_index(IOMemoryDescriptor *md)
+{
+	for (int i = 0; i < bd_pool_n; i++) {
+		if (bd_pool[i] == md) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+/*
+ * Present one full-screen BGRA surface by pointing the pipes at it. 1 when
+ * the DPU took it (the flush latched: the next frame fetched from it), 0
+ * when the caller has to copy.
+ */
+int
+blue_dpu_flip(IOMemoryDescriptor *md, uintptr_t kva, uint32_t offset, uint32_t bpr, uint32_t w, uint32_t h,
+    uint32_t fmt)
+{
+	char detail[128];
+	if (!bd_flip_on) {
+		return 0;
+	}
+	if (w != bd_lw || h != bd_lh || fmt != BD_FMT_BGRA || md == NULL || kva == 0) {
+		snprintf(detail, sizeof(detail), "%ux%u fmt 0x%x", w, h, fmt);
+		bd_once("not a full-screen BGRA surface", detail);
+		return 0;
+	}
+	if (offset != 0 || bpr < w * 4 || (bpr & 15)) {
+		snprintf(detail, sizeof(detail), "offset %u bpr %u", offset, bpr);
+		bd_once("surface layout the SSPP cannot fetch", detail);
+		return 0;
+	}
+	uint64_t len = (uint64_t)bpr * h, seg = 0;
+	IOLockLock(bd_flip_lock);
+	int slot = bd_pool_index(md);
+	if (slot < 0) {
+		IOLockUnlock(bd_flip_lock);
+		bd_once("surface not from the scanout pool", NULL);
+		return 0;
+	}
+	uint64_t pa = md->getPhysicalSegment(0, &seg, kIOMemoryMapperNone);
+	if (pa == 0 || seg < len || pa != bd_pool_pa[slot]) {
+		IOLockUnlock(bd_flip_lock);
+		snprintf(detail, sizeof(detail), "pa 0x%llx segment %llu of %llu", pa, seg, len);
+		bd_once("surface not physically contiguous", detail);
+		return 0;
+	}
+	if (pa + len > 0x100000000ULL) {
+		IOLockUnlock(bd_flip_lock);
+		snprintf(detail, sizeof(detail), "pa 0x%llx", pa);
+		bd_once("surface above 4 GiB (32-bit SSPP address)", detail);
+		return 0;
+	}
+	if (!bd_flip_on) {
+		IOLockUnlock(bd_flip_lock);
+		return 0;
+	}
+	if (bd_fplan_stride != bpr) {
+		if (bd_flipped) {
+			bd_unflip_locked("new stride");
+		}
+		const char *bad = bd_fit ? bd_plan_fit(&bd_st, bd_lw, bd_lh, bpr, &bd_fplan) :
+		    bd_plan_crop(&bd_st, bd_lw, bd_lh, bpr, &bd_fplan);
+		if (bad != NULL) {
+			bd_fplan_stride = 0;
+			bd_flip_off(bad);
+			IOLockUnlock(bd_flip_lock);
+			return 0;
+		}
+		bd_fplan_stride = bpr;
+		bd_plan_log(bd_fit ? "flip plan (fit)" : "flip plan (crop)", &bd_fplan);
+	}
+	if (mdp_rd(CTL_BASE(bd_st.ctl) + CTL_FLUSH) & bd_fplan.flush) {
+		IOLockUnlock(bd_flip_lock);
+		bd_once("a flush is still pending", NULL);
+		return 0;
+	}
+
+	/* The DPU is not IO-coherent: the frame has to be in DRAM before it is fetched. */
+	uint64_t t0 = mach_absolute_time();
+	CleanPoC_DcacheRegion((vm_offset_t)kva, (size_t)len);
+	bd_dsb();
+	uint64_t t1 = mach_absolute_time();
+	if (!bd_geom) {
+		/* entering: forget latches from the copy period */
+		mdp_wr(MDP_INTR_CLEAR, INTR_INTF_UNDERRUN(bd_st.intf) | INTR_PP_DONE(bd_st.pp));
+	}
+	bool first = bd_n_flip == 0;
+	bd_plan_write(&bd_fplan, pa, !bd_geom);
+	bd_geom = true;
+	bd_flipped = true;
+	bd_flip_pa = pa;
+	int64_t lat = bd_flush(&bd_st, bd_fplan.flush, first ? "first flip" : NULL, true, BD_FLIP_WAIT_MS);
+	if (lat < 0) {
+		bd_flip_off("flush did not latch");
+		IOLockUnlock(bd_flip_lock);
+		return 0;
+	}
+	bd_n_flip++;
+	bd_clean_us += bd_us(t1 - t0);
+	bd_latch_us += (uint64_t)lat;
+	bd_latch_max_us = (uint32_t)lat > bd_latch_max_us ? (uint32_t)lat : bd_latch_max_us;
+	if (first) {
+		IOLog("BLUE DPU: first flip: pool buffer %d at 0x%llx, %ux%u bpr %u, clean %llu us, latched after %lld us\n",
+		    slot, pa, w, h, bpr, bd_us(t1 - t0), lat);
+		for (int s = 0; s < bd_st.nsrc; s++) {
+			bd_dump_pipe("flipped", bd_st.src[s].pipe);
+		}
+	}
+	IOLockUnlock(bd_flip_lock);
+	return 1;
+}
+
+/* The pipes back on the panel buffer; 1 if they were flipped. */
+int
+blue_dpu_unflip(const char *why)
+{
+	if (bd_flip_lock == NULL || !bd_flipped) {
+		return 0;
+	}
+	IOLockLock(bd_flip_lock);
+	bool was = bd_flipped;
+	bd_unflip_locked(why);
+	IOLockUnlock(bd_flip_lock);
+	return was;
+}
+
+int
+blue_dpu_scanout(void)
+{
+	return bd_flipped;
+}
+
+/*
+ * About once a second while flipped (vsync timer): a new INTF underrun, a
+ * change of the MDP streams' SMMU fault state, or no frame sent since the
+ * last check turns the flip off. 1 if it did (the caller redraws the panel
+ * buffer).
+ */
+int
+blue_dpu_flip_tick(void)
+{
+	if (bd_flip_lock == NULL || !bd_flipped) {
+		return 0;
+	}
+	IOLockLock(bd_flip_lock);
+	const char *why = bd_flipped ? bd_health(&bd_st, true) : NULL;
+	if (why != NULL) {
+		bd_log_intr("flip health", mdp_rd(MDP_INTR_STATUS), mdp_rd(MDP_INTR2_STATUS));
+		bd_flip_off(why);
+	}
+	IOLockUnlock(bd_flip_lock);
+	return why != NULL;
+}
+
+/* Halt / restart (PEHaltRestart): back to the panel buffer, no more flips. */
+void
+blue_dpu_flip_stop(const char *why)
+{
+	if (bd_flip_lock == NULL) {
+		return;
+	}
+	IOLockLock(bd_flip_lock);
+	bd_flip_off(why);
+	IOLockUnlock(bd_flip_lock);
+}
+
+/*
+ * Panic (PEInitiatePanic, before the panic text is drawn into the panel
+ * buffer): ABL's registers back and one flush, no lock, no waiting.
+ */
+void
+blue_dpu_panic(void)
+{
+	bd_flip_on = false;
+	if (!bd_flipped || bd_mdss == NULL || bd_st.ctl < 0) {
+		return;
+	}
+	for (int i = bd_nregs - 1; i >= 0; i--) {
+		if (bd_regs[i].touched) {
+			mdp_wr(bd_regs[i].off, bd_regs[i].abl);
+		}
+	}
+	bd_dsb();
+	mdp_wr(CTL_BASE(bd_st.ctl) + CTL_FLUSH, bd_st.flush);
+	bd_dsb();
+	bd_flipped = false;
+}
+
+/*
+ * Backing store for backboardd's display surfaces (SweetSurface create):
+ * contiguous, below 4 GiB, allocated once and never freed, so the DPU
+ * never fetches memory that went back to the VM. The buffer being scanned
+ * out is not handed out again. Retained for the caller.
+ */
+IOBufferMemoryDescriptor *
+blue_dpu_pool_take(uint32_t w, uint32_t h, uint32_t bpr, uint32_t fmt, uint32_t planes, uint32_t offset,
+    uint64_t size)
+{
+	if (!bd_flip_on || bd_flip_lock == NULL || w != bd_lw || h != bd_lh || fmt != BD_FMT_BGRA ||
+	    planes != 0 || offset != 0 || size > bd_pool_size || (uint64_t)bpr * h > bd_pool_size) {
+		return NULL;
+	}
+	IOBufferMemoryDescriptor *md = NULL;
+	IOLockLock(bd_flip_lock);
+	for (int i = 0; i < bd_pool_n && md == NULL; i++) {
+		if (!bd_pool_used[i] && !(bd_flipped && bd_pool_pa[i] == bd_flip_pa)) {
+			bd_pool_used[i] = true;
+			md = bd_pool[i];
+			md->retain();
+			IOLog("BLUE DPU: pool buffer %d (0x%llx) -> %ux%u bpr %u surface\n", i, bd_pool_pa[i], w, h, bpr);
+		}
+	}
+	IOLockUnlock(bd_flip_lock);
+	if (md == NULL) {
+		bd_once("scanout pool empty", NULL);
+	}
+	return md;
+}
+
+void
+blue_dpu_pool_put(IOMemoryDescriptor *md)
+{
+	if (bd_flip_lock == NULL || md == NULL) {
+		return;
+	}
+	IOLockLock(bd_flip_lock);
+	int i = bd_pool_index(md);
+	if (i >= 0) {
+		bd_pool_used[i] = false;
+	}
+	IOLockUnlock(bd_flip_lock);
+}
+
+/* Synchronous setup at AppleCLCD::start. 1: flips allowed. */
+static int
+bd_flip_setup(void)
+{
+	int bufs = 3;
+	struct bd_rate rate;
+	PE_parse_boot_argn("bluedpu_flip_bufs", &bufs, sizeof(bufs));
+	bufs = bufs < 2 ? 2 : (bufs > BD_POOL_MAX ? BD_POOL_MAX : bufs);
+	bd_flip_lock = IOLockAlloc();
+	if (bd_flip_lock == NULL) {
+		return 0;
+	}
+	bd_survey(&bd_st);
+	bd_regs_record(&bd_st);
+	bd_rate_measure(&bd_st, "rate (100 ms)", 100, &rate);
+	bd_done_live = rate.done != 0;
+	uint32_t stride = (bd_lw * 4 + 255) & ~255u;        /* backboardd: 4608 for 1125 */
+	const char *bad = bd_fit ? bd_plan_fit(&bd_st, bd_lw, bd_lh, stride, &bd_fplan) :
+	    bd_plan_crop(&bd_st, bd_lw, bd_lh, stride, &bd_fplan);
+	if (bad != NULL) {
+		IOLog("BLUE DPU: flip: off: %s\n", bad);
+		return 0;
+	}
+	bd_fplan_stride = stride;
+	bd_plan_log(bd_fit ? "flip plan (fit)" : "flip plan (crop)", &bd_fplan);
+	bd_pool_size = round_page((uint64_t)stride * ((bd_lh + 3) & ~3u));	/* (0189: whole groups of 4 rows, as SweetSurface allocates) */
+	for (int i = 0; i < bufs; i++) {
+		IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous |
+		    kIOMemoryHostPhysicallyContiguous, bd_pool_size, 0x00000000ffffc000ULL);
+		uint64_t seg = 0, pa = md != NULL ? md->getPhysicalSegment(0, &seg, kIOMemoryMapperNone) : 0;
+		if (md == NULL || pa == 0 || seg < bd_pool_size || pa + bd_pool_size > 0x100000000ULL ||
+		    md->getBytesNoCopy() == NULL) {
+			IOLog("BLUE DPU: flip: pool buffer %d: no contiguous %llu bytes below 4 GiB (pa 0x%llx seg %llu)\n",
+			    i, bd_pool_size, pa, seg);
+			OSSafeReleaseNULL(md);
+			break;
+		}
+		bd_pool[bd_pool_n] = md;
+		bd_pool_pa[bd_pool_n++] = pa;
+		IOLog("BLUE DPU: flip: pool buffer %d at 0x%llx, %llu bytes\n", i, pa, bd_pool_size);
+	}
+	if (bd_pool_n < 2) {
+		IOLog("BLUE DPU: flip: off: %d pool buffers, need 2\n", bd_pool_n);
+		return 0;
+	}
+	bd_health_baseline(&bd_st, "flip baseline");
+	return 1;
+}

+/*
+ * bluegpu_present_clean=2: does the GPU see what the CPU left dirty in its
+ * cache through a cacheable mapping (KGSL's IOCOHERENT: IOMMU_CACHE)? A
+ * 16K kernel page in slot 3 (free now) with LPAE_PAGE_RO_WB; per round
+ * the page holds A in DRAM (clean + invalidate) and B in this CPU's cache,
+ * and CP_MEM_TO_MEM copies 8 words into the CP's NC memory: B everywhere
+ * (4 rounds) = coherent, any A = the GPU read DRAM. Unmapped afterwards.
+ */
+static void
+rs_coherence_probe(void)
+{
+	const uint32_t n = RS_SLOTS - 1, words = PAGE_SIZE / 4;
+	uint32_t good = 0, stale = 0, other = 0;
+	vm_offset_t va = 0;
+
+	if (kmem_alloc(kernel_map, &va, PAGE_SIZE, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("BLUELINE GPU: coherence probe: no page: cleaning stays\n");
+		return;
+	}
+	for (uint32_t o = 0; o < PAGE_SIZE; o += 0x1000u) {
+		uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)va)) + o;
+		rs_l3(n * RS_L3_PER_SLOT)[o >> 12] = LPAE_PAGE_RO_WB(pa);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bool tlb = smmu_tlbi_cb(0), sub = tlb;
+	volatile uint32_t *w = (volatile uint32_t *)va;
+	for (uint32_t r = 0; sub && r < 4; r++) {
+		uint32_t a = 0xa0000000u | (r << 20), b = 0xb0000000u | (r << 20);
+		for (uint32_t i = 0; i < words; i++) {
+			w[i] = a ^ i;
+		}
+		FlushPoC_DcacheRegion(va, PAGE_SIZE);	/* A in DRAM, nothing of the page cached */
+		for (uint32_t i = 0; i < words; i++) {
+			w[i] = b ^ i;			/* B only in this CPU's cache */
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t k = 0; k < 8; k++) {
+			cp_mem(RS_PROBE_OFF)[k] = CP_TARGET_FILL;
+		}
+		dr_event(EV_CACHE_INVALIDATE);
+		for (uint32_t k = 0; k < 8; k++) {
+			uint32_t idx = k * (words / 8) + r * 17;
+			cp_put(pkt7(CP_MEM_TO_MEM, 5));
+			cp_put(0);
+			cp_put(CP_VA + RS_PROBE_OFF + 4 * k);
+			cp_put(0);
+			cp_put(RS_SLOT_VA(n) + 4 * idx);
+			cp_put(0);
+		}
+		cp_put(pkt7(CP_WAIT_FOR_IDLE, 0));
+		sub = rs_sync("coherence probe", true);
+		for (uint32_t k = 0; sub && k < 8; k++) {
+			uint32_t idx = k * (words / 8) + r * 17, v = cp_mem(RS_PROBE_OFF)[k];
+			good += v == (b ^ idx);
+			stale += v == (a ^ idx);
+			other += v != (b ^ idx) && v != (a ^ idx);
+		}
+	}
+	for (uint32_t o = 0; o < PAGE_SIZE; o += 0x1000u) {
+		rs_l3(n * RS_L3_PER_SLOT)[o >> 12] = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bool unmapped = smmu_tlbi_cb(0);
+	rs.coherent = sub && good == 32;
+	printf("BLUELINE GPU: coherence probe: 32 words this CPU left dirty, read by the CP through a cacheable inner-"
+	    "shareable mapping: %u new, %u stale (DRAM), %u other%s: %s\n", good, stale, other, sub ? "" :
+	    " (SUBMIT FAILED)", rs.coherent ? "THE GPU SEES THE CPU CACHES: surface slots cacheable, NO CLEAN per present"
+	    " (the first present's self-check confirms)" : "not coherent: the clean per present stays");
+	if (unmapped) {
+		kmem_free(kernel_map, va, PAGE_SIZE);
+	} else {
+		printf("BLUELINE GPU: coherence probe: TLB sync timeout: the page stays allocated (leaked on purpose)\n");
+	}
+}

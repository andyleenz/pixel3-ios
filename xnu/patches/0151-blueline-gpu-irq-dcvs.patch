+/* 0151 interrupts on (after the ring check): GPU SPI 300 with a fenced check, GMU SPIs 304/305. */
+static void
+rs_irq_attach(void)
+{
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &rs_abs_sec);
+	rs.irq_window_t = mach_absolute_time();
+	if (rs.irq) {
+		cp_wr(GXR_RBBM_INT_CLEAR_CMD, 0xffffffffu);
+		if (sweet_spi_attach(RS_INTID_GPU, false, rs_irq, NULL)) {
+			uint32_t f0 = rs.irq_fence, n0 = rs.irq_n;
+			rs.irq_on = true;
+			bool ok = rs_sync("interrupt check", false);
+			for (int t = 0; ok && rs.irq_fence == f0 && t < cp.ms * 100; t++) {
+				delay(10);
+			}
+			bool got = rs.irq_fence != f0 && rs.irq_seq == rs.seq;
+			printf("BLUELINE GPU: interrupts: GPU INTID %u (SPI 300, level) attached; RBBM_INT_0_MASK %#x; fence"
+			    " interrupt for seq %u: %s (%u interrupts, %u fence, irq seq %u)\n", RS_INTID_GPU,
+			    cp_rd(GXR_RBBM_INT_0_MASK), rs.seq, got ? "RECEIVED: fences interrupt-driven" : ok ?
+			    "NOT RECEIVED: fences polled (error interrupts stay attached)" : "RING CHECK FAILED",
+			    rs.irq_n - n0, rs.irq_fence - f0, rs.irq_seq);
+			rs.irq_on = got;
+			rs.busy = false;
+		} else {
+			printf("BLUELINE GPU: interrupts: INTID %u not attached (no GIC distributor?): polled\n", RS_INTID_GPU);
+		}
+	}
+	if (rs.gmu_irq) {
+		wr(gmu + GMU_REG(GMU_AO_HOST_INT_CLR), 0xffffffffu);
+		wr(gmu + GMU_REG(GMU_GMU2HOST_INTR_CLR), GMU2HOST_CM3_FAULT);
+		rs.gmu_on = sweet_spi_attach(RS_INTID_GMU, false, rs_gmu_irq, NULL);
+		rs.hfi_on = sweet_spi_attach(RS_INTID_HFI, false, rs_hfi_irq, NULL);
+		if (rs.gmu_on) {
+			wr(gmu + GMU_REG(GMU_AO_HOST_INT_MASK), ~GMU_AO_IRQS);
+		}
+		if (rs.hfi_on) {
+			wr(gmu + GMU_REG(GMU_GMU2HOST_INTR_MASK), ~GMU2HOST_CM3_FAULT);
+		}
+		printf("BLUELINE GPU: interrupts: GMU INTID %u (gmu, SPI 305) %s, mask %#x; INTID %u (hfi, SPI 304) %s, mask"
+		    " %#x; AO host status %#x gmu2host %#x\n", RS_INTID_GMU, rs.gmu_on ? "attached" : "NOT attached",
+		    gmu_rd(GMU_AO_HOST_INT_MASK), RS_INTID_HFI, rs.hfi_on ? "attached" : "NOT attached",
+		    gmu_rd(GMU_GMU2HOST_INTR_MASK), gmu_rd(GMU_AO_HOST_INT_STATUS), gmu_rd(GMU_GMU2HOST_INTR_INFO));
+	}
+}

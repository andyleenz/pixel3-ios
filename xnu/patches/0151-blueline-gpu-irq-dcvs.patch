+/*
+ * 0151 recovery, on the vsync thread after a hang (RBBM hang detect or the
+ * software guard): dump once, SQE halt, VBIF halt, RBBM soft reset, then
+ * the CP again as cp_stage brought it up (hw_init, SQE/RB registers,
+ * ME_INIT, secure mode off as the zap left it: CP_SET_SECURE_MODE 0 or
+ * SECVID_TRUST_CNTL 0, as Linux's hw_init does after a reset), 0138's 2D
+ * setup, cb0 TLB invalidate (the page tables are memory: unchanged) and a
+ * fenced no-op on the circle. The hung blit is abandoned. More than
+ * bluegpu_recover_max recoveries in a minute, a GMU fault, or a failed
+ * step: rs_hang (CPU presents for the boot). Returns whether the GPU is
+ * presenting again.
+ */
+static bool
+rs_recover(const char *why)
+{
+	uint64_t t0 = mach_absolute_time(), ns, minute = 60ull * NSEC_PER_SEC;
+	const char *bad = NULL;
+	uint32_t recent = 0, hung = rs.seq;
+
+	rs_log_errors();
+	if (!rs.recover) {
+		rs_hang(why);
+		return false;
+	}
+	if (rs.gmu_cm3 || (rs.gmu_ao & GMU_AO_WDOG_BITE)) {
+		rs_hang("GMU fault: no recovery without restarting the GMU");
+		return false;
+	}
+	for (int i = 0; i < RS_REC_MAX; i++) {
+		recent += rs.rec_t[i] && rs_ns_since(rs.rec_t[i]) < minute;
+	}
+	if (recent >= (uint32_t)rs.recover_max) {
+		printf("BLUELINE GPU: recovery: %u recoveries in the last minute (bluegpu_recover_max=%d): giving up\n",
+		    recent, rs.recover_max);
+		rs_hang(why);
+		return false;
+	}
+	rs.rec_t[rs.n_recover_total % RS_REC_MAX] = t0;
+	rs.n_recover_total++;
+	rs.n_recover++;
+	printf("BLUELINE GPU: RECOVERY %u (%s): blit seq %u abandoned (%u recoveries in the last minute before this one)\n",
+	    rs.n_recover_total, why, hung, recent);
+	if (!rs.dumped) {
+		rs.dumped = true;
+		cp_dump("GPU hang (first; later recoveries log one line)");
+		rs_ring_dump();
+		gx_report("before recovery");
+	} else {
+		cp_report("before recovery");
+	}
+
+	/* 1. Stop: interrupts, SQE, VBIF (a6xx_bus_clear_pending_transactions). */
+	cp_wr(GXR_RBBM_INT_0_MASK, 0);
+	cp_wr(GXR_CP_SQE_CNTL, 0);
+	cp.started = false;
+	gx_bus_halt();
+
+	/* 2. a6xx_gpu_sw_reset: asserted for 100 us. */
+	cp_wr(GXR_RBBM_SW_RESET_CMD, 1);
+	(void)cp_rd(GXR_RBBM_SW_RESET_CMD);
+	delay(100);
+	cp_wr(GXR_RBBM_SW_RESET_CMD, 0);
+	(void)cp_rd(GXR_RBBM_SW_RESET_CMD);
+	delay(1);
+	cp_wr(GXR_RBBM_INT_CLEAR_CMD, 0xffffffffu);
+	uint32_t fsr = rd(cbn(0, CB_FSR));
+	if (fsr) {
+		wr(cbn(0, CB_FSR), fsr);
+	}
+	uint32_t rp = cp_rd(GXR_CP_RB_RPTR), wp = cp_rd(GXR_CP_RB_WPTR), sq = cp_rd(GXR_CP_SQE_CNTL);
+	printf("BLUELINE GPU: recovery: after the soft reset: rbbm status %#x, rptr %u wptr %u sqe_cntl %#x, sqe_instr_base"
+	    " %#x; cb0 fsr was %#x%s\n", cp_rd(GXR_RBBM_STATUS), rp, wp, sq, cp_rd(GXR_CP_SQE_INSTR_BASE), fsr,
+	    fsr ? " (cleared)" : "");
+	if (rp || wp || (sq & 1)) {
+		bad = "ring pointers or SQE not reset";
+		goto out;
+	}
+	rs.irq_hang = 0;
+	__atomic_store_n(&rs.fault_taken, 0, __ATOMIC_RELEASE);
+
+	/* 3. The CP as cp_stage: hw_init (RBBM_INT_0_MASK back on), SQE and ring registers, ME_INIT. */
+	cp.wrap = false;
+	cp.wptr = 0;
+	rs.busy = false;
+	cp_hw_init(true);
+	cp_wr(GXR_CP_SQE_INSTR_BASE, CP_VA);
+	cp_wr(GXR_CP_SQE_INSTR_BASE + 1, 0);
+	cp_wr(GXR_CP_RB_BASE, CP_VA + CP_RING_OFF);
+	cp_wr(GXR_CP_RB_BASE + 1, 0);
+	cp_wr(GXR_CP_RB_CNTL, CP_RB_CNTL_VAL);
+	cp_wr(GXR_CP_RB_RPTR_ADDR, CP_VA + CP_SHADOW_OFF);
+	cp_wr(GXR_CP_RB_RPTR_ADDR + 1, 0);
+	if (cp_rd(GXR_CP_SQE_INSTR_BASE) != CP_VA || cp_rd(GXR_CP_RB_BASE) != CP_VA + CP_RING_OFF ||
+	    cp_rd(GXR_CP_RB_CNTL) != CP_RB_CNTL_VAL) {
+		bad = "CP base registers did not take";
+		goto out;
+	}
+	cp_put(pkt7(CP_ME_INIT, 8));
+	cp_put(0x0000002f);
+	cp_put(0x00000003);
+	cp_put(0x20000000);
+	for (int i = 0; i < 5; i++) {
+		cp_put(0);
+	}
+	cp_wr(GXR_CP_SQE_CNTL, 1);

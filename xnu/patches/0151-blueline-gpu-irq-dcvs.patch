+/* GPU core clock: CP perf counter 0 (ALWAYS_COUNT, hw_init) against CP_ALWAYS_ON (19.2 MHz) over 1 ms. */
+static uint32_t
+rs_clock_mhz(void)
+{
+	uint64_t c0 = dr_ctr(GXR_RBBM_PERFCTR_CP0), a0 = dr_ctr(GXR_CP_ALWAYS_ON);
+	delay(1000);
+	uint64_t c1 = dr_ctr(GXR_RBBM_PERFCTR_CP0), a1 = dr_ctr(GXR_CP_ALWAYS_ON);
+	return a1 > a0 ? (uint32_t)((c1 - c0) * 192 / ((a1 - a0) * 10)) : 0;
+}
+
+/* GMU XOCLK_0: GPU busy in 19.2 MHz ticks (a6xx_gpu_busy). */
+static uint64_t
+rs_xoclk(void)
+{
+	uint32_t h = gmu_rd(GMU_POWER_COUNTER_XOCLK_0 + 1), l = gmu_rd(GMU_POWER_COUNTER_XOCLK_0);
+	uint32_t h2 = gmu_rd(GMU_POWER_COUNTER_XOCLK_0 + 1);
+	if (h2 != h) {
+		l = gmu_rd(GMU_POWER_COUNTER_XOCLK_0);
+	}
+	return ((uint64_t)h2 << 32) | l;
+}
+
+/* a6xx_gpu.c hw_init: the busy counter (GMU power counter 0, countable 5 = GPU busy, CX_BUSY_MASK 0xff000000). */
+static void
+rs_busy_setup(void)
+{
+	wr(gmu + GMU_REG(GMU_AO_GPU_CX_BUSY_MASK), 0xff000000u);
+	uint32_t sel = gmu_rd(GMU_POWER_COUNTER_SELECT_0);
+	wr(gmu + GMU_REG(GMU_POWER_COUNTER_SELECT_0), (sel & ~0xffu) | (1u << 5));
+	wr(gmu + GMU_REG(GMU_POWER_COUNTER_ENABLE), 1);
+	uint64_t x0 = rs_xoclk();
+	delay(1000);
+	uint64_t x1 = rs_xoclk();
+	printf("BLUELINE GPU: busy counter: GMU power counter select_0 %#x -> %#x, enable %#x, XOCLK_0 %#llx -> %#llx"
+	    " over 1 ms idle (busy ticks %llu)\n", sel, gmu_rd(GMU_POWER_COUNTER_SELECT_0),
+	    gmu_rd(GMU_POWER_COUNTER_ENABLE), (unsigned long long)x0, (unsigned long long)x1,
+	    (unsigned long long)(x1 - x0));
+}
+
+/* The lowest level at or above mhz (1 .. GX_LEVELS - 1). */
+static int
+gx_level_at(int mhz)
+{
+	int l = 1;
+	while (l < GX_LEVELS - 1 && gpu_khz[l] < (uint32_t)mhz * 1000u) {
+		l++;
+	}
+	return l;
+}
+
 /*
+ * a6xx_gmu_set_freq, legacy, then the level's DDR vote (dev_pm_opp_set_opp:
+ * before raising the clock, after lowering it). One line per change.
+ */
+static bool
+gx_set_level(int l, const char *why)
+{
+	int old = gx.perf, err = 0;
+	uint32_t info, ret;
+	uint64_t ns;
+
+	if (l == old || l < 1 || l >= GX_LEVELS) {
+		return false;
+	}
+	if (gx.bw_voted && gx_level_kbps(l) > gx.bw_kbps) {
+		err = gx_bw_vote_kbps(gx_level_kbps(l), true);
+	}
+	wr(gmu + GMU_REG(GMU_DCVS_ACK_OPTION), 0);
+	wr(gmu + GMU_REG(GMU_DCVS_PERF_SETTING), (3u << 28) | (uint32_t)l);
+	wr(gmu + GMU_REG(GMU_DCVS_BW_SETTING), 0xff);
+	bool ok = gmu_oob_quiet(OOB_DCVS_SET, OOB_DCVS_ACK, &info, &ns);
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << OOB_DCVS_ACK);	/* gmu_oob_clear */
+	ret = gmu_rd(GMU_DCVS_RETURN);
+	if (ok && !ret) {
+		gx.perf = l;
+	}
+	if (gx.bw_voted && gx_level_kbps(gx.perf) < gx.bw_kbps) {
+		err = gx_bw_vote_kbps(gx_level_kbps(gx.perf), true);
+	}
+	uint32_t mhz = rs_clock_mhz();
+	rs.dcvs_changes++;
+	printf("BLUELINE GPU: DCVS %u -> %u MHz (%s): OOB %s after %llu us (gmu2host %#x), DCVS_RETURN %#x%s, DDR vote %u kBps"
+	    "%s%d, measured %u MHz\n", gpu_khz[old] / 1000, gpu_khz[l] / 1000, why, ok ? "acked" : "NOT ACKED", ns / 1000,
+	    info, ret, ret ? " (ERROR: level kept)" : "", gx.bw_voted ? gx.bw_kbps : 0,
+	    gx.bw_voted ? " err " : " (no vote, bluegpu_bw=0) ", err, mhz);
+	return gx.perf == l;
+}
+
+/* bluegpu_dcvs=1: every >= 100 ms (on presents), busy % -> the level that would run it at the target busy. */
+static void
+rs_dcvs_tick(void)
+{
+	uint64_t now = mach_absolute_time(), ns;
+
+	if (!rs.dcvs) {
+		return;
+	}
+	if (!rs.dcvs_t) {
+		rs.dcvs_t = now;
+		rs.dcvs_xo = rs_xoclk();
+		rs.dcvs_ticks = rs.blit_total;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - rs.dcvs_t, &ns);
+	if (ns < 100ull * NSEC_PER_MSEC) {
+		return;
+	}
+	uint64_t xo = rs_xoclk(), dxo = xo - rs.dcvs_xo, dbl = rs.blit_total - rs.dcvs_ticks;
+	rs.busy_gmu = dxo != 0 || dbl == 0;	/* a counter that never moves while blits run: blit time instead */
+	uint64_t busy = rs.busy_gmu ? dxo : dbl, pct = busy * 10000 / 192 * 100 / ns;
+	rs.busy_pct = (uint32_t)MIN(pct, 100ull);
+	rs.dcvs_t = now;
+	rs.dcvs_xo = xo;
+	rs.dcvs_ticks = rs.blit_total;
+
+	int lmin = gx_level_at(rs.dcvs_min), lmax = gx_level_at(rs.dcvs_max);
+	if (lmax > lmin && gpu_khz[lmax] > (uint32_t)rs.dcvs_max * 1000u) {
+		lmax--;
+	}
+	uint64_t want = (uint64_t)gpu_khz[gx.perf] / 1000 * rs.busy_pct / (uint32_t)rs.dcvs_target;
+	int l = lmin;
+	while (l < lmax && gpu_khz[l] < want * 1000) {
+		l++;
+	}
+	char why[48];
+	snprintf(why, sizeof(why), "busy %u%% (%s)", rs.busy_pct, rs.busy_gmu ? "GMU counter" : "blit time");
+	if (l > gx.perf) {
+		rs.dcvs_low = 0;
+		(void)gx_set_level(l, why);
+	} else if (l < gx.perf) {
+		if (++rs.dcvs_low >= 3) {	/* down only after 3 windows in a row */
+			rs.dcvs_low = 0;
+			(void)gx_set_level(l, why);
+		}
+	} else {
+		rs.dcvs_low = 0;
+	}
+}

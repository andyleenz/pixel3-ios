 	}
-	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, ns);
 	wr(gmu + GMU_REG(GMU_GMU2HOST_INTR_CLR), 1u << ack);
+	*info_out = info;
+	return ok;
+}
+
+static bool
+gmu_oob_set(const char *name, uint32_t req, uint32_t ack)
+{
+	uint64_t ns;
+	uint32_t info;

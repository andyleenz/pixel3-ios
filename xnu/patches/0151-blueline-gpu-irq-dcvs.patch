 	printf("BLUELINE GPU: OOB %s (host2gmu bit %u): %s after %llu us (gmu2host %#x)\n", name, req,
 	    ok ? "acked" : (info & GMU2HOST_CM3_FAULT) ? "CM3 FAULT" : "NO ACK", ns / 1000, info);

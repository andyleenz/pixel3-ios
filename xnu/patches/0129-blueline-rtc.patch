+/*
+ * Read len (1..4) registers of PMIC SID 0 starting at addr (peripheral =
+ * addr >> 8, PPID = addr >> 8 for SID 0), through the observer channel and
+ * under the arbiter lock. Read-only: no ownership needed. Thread context
+ * only (takes a mutex). 0, or EINVAL / ENXIO (no arbiter, peripheral not in
+ * the APID table) / EIO (no answer, or an error status).
+ */
+int
+blueline_spmi_read(uint16_t addr, uint8_t *buf, unsigned len)
+{
+	static uint16_t last_ppid = NO_APID, last_apid = NO_APID;
+
+	if (!buf || len < 1 || len > 4 || ((addr & 0xffu) + len) > 0x100u) {
+		return EINVAL;
+	}
+	if (!arb_setup()) {
+		return ENXIO;
+	}
+	uint16_t ppid = addr >> 8;
+	lck_mtx_lock(&blueline_arb_lock);
+	if (ppid != last_ppid) {
+		last_apid = arb_apid(ppid, arb_count);
+		last_ppid = ppid;
+	}
+	uint16_t apid = last_apid;
+	bool ok = arb_read_n(apid, addr, buf, len);
+	lck_mtx_unlock(&blueline_arb_lock);
+	if (apid == NO_APID) {
+		return ENXIO;
+	}
+	return ok ? 0 : EIO;
+}

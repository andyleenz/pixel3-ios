+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Time of day from the PM8998 RTC (blueline, patch 0129). Boot-args:
+ *   bluertc=0  (default) off: no RTC access, the calendar starts at 0 (1970)
+ *   bluertc=1  probe: read and log the RTC once from start(); time unchanged
+ *   bluertc=2  time of day = raw RTC + bluertc_offset, IORTC published so
+ *              IOKitInitializeTime (patch 0129) waits for it, up to 10 s
+ *   bluertc_offset=SECONDS  added to the raw count (default 0)
+ *
+ * RTC_RW is SPMI SID 0 peripheral 0x60 (pm8998.dtsi rtc@6000, "rtc";
+ * the alarm at 0x61 is not touched). Registers, as Linux rtc-pm8xxx.c
+ * pm8941_regs: RTC_CTRL 0x6046 (bit 7 enable), RDATA0..3 0x6048..0x604b,
+ * a little-endian 32-bit count of seconds. The read is Linux's
+ * pm8xxx_rtc_read_raw(): read the 4 bytes, read byte 0 again, and if it went
+ * down (a carry between the bytes) read the 4 bytes once more.
+ *
+ * The count is not the Unix time. On this phone the RTC is read-only to the
+ * HLOS: the stock device tree has qcom,qpnp-rtc-write = <0>, so Android never
+ * sets it; it keeps the difference to the real time in userland (Qualcomm's
+ * time-services offset on /data, gone with our userdata). The count runs from
+ * whenever the PMIC last lost power or the RTC was last set, so the offset is
+ * calibrated from the Mac (see the 0129 notes) and given as bluertc_offset.
+ * It stays valid until the battery is fully drained or disconnected.
+ * Nothing here writes a PMIC register.
+ */
+extern "C" int blueline_spmi_read(uint16_t addr, uint8_t *buf, unsigned len);
+
+#define PM8998_RTC_TYPE         0x6004  /* PERPH_TYPE / SUBTYPE */
+#define PM8998_RTC_CTRL         0x6046
+#define PM8998_RTC_RDATA0       0x6048
+
+static int bluertc_mode;
+static bool bluertc_ok;         /* the probe read the RTC and RTC_CTRL has it enabled */
+static uint64_t bluertc_offset;
+
+static int
+bluertc_read_raw(uint32_t *secs, bool *carried)
+{
+	uint8_t b[4], again;
+	int rc;
+
+	*carried = false;
+	if ((rc = blueline_spmi_read(PM8998_RTC_RDATA0, b, 4)) != 0 ||
+	    (rc = blueline_spmi_read(PM8998_RTC_RDATA0, &again, 1)) != 0) {
+		return rc;
+	}
+	if (again < b[0]) {
+		*carried = true;
+		if ((rc = blueline_spmi_read(PM8998_RTC_RDATA0, b, 4)) != 0) {
+			return rc;
+		}
+	}
+	*secs = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) |
+	    ((uint32_t)b[3] << 24);
+	return 0;
+}
+
+static uint64_t
+bluertc_uptime_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* Survey + first read, from start(). True if the RTC answered and runs. */
+static bool
+bluertc_probe(void)
+{
+	uint8_t type[2] = { 0, 0 }, ctrl = 0;
+	uint32_t raw = 0;
+	bool carried;
+	int rc;
+
+	IOLog("BLUELINE RTC: mode %d, offset %llu; about to read PM8998 RTC_RW type at %#x (SPMI SID 0)\n",
+	    bluertc_mode, bluertc_offset, PM8998_RTC_TYPE);
+	if ((rc = blueline_spmi_read(PM8998_RTC_TYPE, type, 2)) != 0) {
+		IOLog("BLUELINE RTC: type read failed (%d); no RTC\n", rc);
+		return false;
+	}
+	if ((rc = blueline_spmi_read(PM8998_RTC_CTRL, &ctrl, 1)) != 0) {
+		IOLog("BLUELINE RTC: type %#04x subtype %#04x, RTC_CTRL read failed (%d); no RTC\n",
+		    type[0], type[1], rc);
+		return false;
+	}
+	if ((rc = bluertc_read_raw(&raw, &carried)) != 0) {
+		IOLog("BLUELINE RTC: type %#04x subtype %#04x ctrl %#04x, RDATA read failed (%d); no RTC\n",
+		    type[0], type[1], ctrl, rc);
+		return false;
+	}
+	IOLog("BLUELINE RTC: type %#04x subtype %#04x ctrl %#04x (%s), raw %u s (%#010x)%s at uptime %llu ms;"
+	    " raw + offset = %llu\n", type[0], type[1], ctrl, (ctrl & 0x80) ? "enabled" : "NOT enabled",
+	    raw, raw, carried ? " (re-read after a carry)" : "", bluertc_uptime_ms(),
+	    (unsigned long long)raw + bluertc_offset);
+	return (ctrl & 0x80) != 0;
+}
+
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint32_t raw = 0;
+	bool carried;
+	int rc;
+
+	if (bluertc_mode < 2 || !bluertc_ok) {
+		return 0;
+	}
+	if ((rc = bluertc_read_raw(&raw, &carried)) != 0) {
+		IOLog("BLUELINE RTC: read failed (%d); time of day 0\n", rc);
+		return 0;
+	}
+	long secs = (long)((uint64_t)raw + bluertc_offset);
+	IOLog("BLUELINE RTC: time of day %ld (raw %u + offset %llu)%s at uptime %llu ms\n", secs, raw,
+	    bluertc_offset, carried ? ", re-read after a carry" : "", bluertc_uptime_ms());
+	return secs;
+}
+
+/*
+ * settimeofday() (timed, date) ends here: the RTC is read-only to us, so only
+ * log the offset that would make the RTC agree. The first 8 calls only.
+ */
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	static unsigned calls;
+	uint32_t raw = 0;
+	bool carried;
+
+	if (bluertc_mode < 1 || calls >= 8) {
+		return;
+	}
+	calls++;
+	if (bluertc_read_raw(&raw, &carried) == 0) {
+		IOLog("BLUELINE RTC: time set to %ld; raw %u, so bluertc_offset=%ld would match (not stored)\n",
+		    secs, raw, secs - (long)raw);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */

 static void bb_sim_request(const struct cbq_result &r, const uint8_t *sdu);
 
 // A request for the modem, with the data port named as this modem has it.
+// 0242: DMS SET_OPERATING_MODE (online) answered QMI_ERR_DEVICE_NOT_READY while the modem is still loading its
+// MCFG files over TFTP (0241; cell6: the one request at 47.7 s, MCFG done a few seconds later, never asked again).
+// The answer is held and the request sent again each second, for at most 8 s (ABM waits 10 s), then passed on.
+#define BB_DMS_SVC          2u
+#define BB_DMS_SET_OP_MODE  0x2eu
+#define BB_QMI_NOT_READY    0x34u
+static struct {
+  uint8_t *data;
+  uint32_t len, local_port, node, port, tries, first_ms, retry_ms;
+  bool waiting;
+} bb_opmode;
+
+static void bb_opmode_note(const struct cbq_result &r, const uint8_t *sdu)
+{
+  if (r.service != BB_DMS_SVC || r.len < 7 || sdu[0] != 0 || cbd_rd16(sdu + 3) != BB_DMS_SET_OP_MODE) return;
+  if (bb_opmode.data) IOFreeData(bb_opmode.data, bb_opmode.len);
+  bb_opmode.data = static_cast<uint8_t *>(IOMallocData(r.len));
+  if (!bb_opmode.data) return;
+  memcpy(bb_opmode.data, sdu, r.len);
+  bb_opmode.len = r.len;
+  bb_opmode.local_port = r.local_port;
+  bb_opmode.node = r.node;
+  bb_opmode.port = r.port;
+  bb_opmode.tries = 0;
+  bb_opmode.first_ms = bb_now_ms();
+  bb_opmode.waiting = false;
+}
+
+// The modem's answer: true when held for a retry.
+static bool bb_opmode_answer(uint32_t dst_port, uint32_t service, const uint8_t *sdu, uint32_t size)
+{
+  if (!bb_opmode.data || service != BB_DMS_SVC || dst_port != bb_opmode.local_port || size < 7 || sdu[0] != 2 ||
+      cbd_rd16(sdu + 3) != BB_DMS_SET_OP_MODE) return false;
+  uint32_t error = 0;
+  for (uint32_t o = 7; o + 3 <= size;) {
+    const uint32_t tl = cbd_rd16(sdu + o + 1);
+    if (o + 3 + tl > size) break;
+    if (sdu[o] == 2 && tl >= 4) error = cbd_rd16(sdu + o + 5);
+    o += 3 + tl;
+  }
+  const uint32_t now = bb_now_ms();
+  if (error == BB_QMI_NOT_READY && now - bb_opmode.first_ms < 8000) {
+    bb_opmode.tries++;
+    bb_opmode.waiting = true;
+    bb_opmode.retry_ms = now + 1000;
+    if (bb_opmode.tries <= 8) printf("COACHZ baseband: DMS SET_OPERATING_MODE: device not ready, again in 1 s (%u)\n", bb_opmode.tries);
+    return true;
+  }
+  printf("COACHZ baseband: DMS SET_OPERATING_MODE: error 0x%x after %u retries, %u ms\n", error, bb_opmode.tries, now - bb_opmode.first_ms);
+  IOFreeData(bb_opmode.data, bb_opmode.len);
+  bb_opmode.data = nullptr;
+  bb_opmode.waiting = false;
+  return false;
+}
+
+static void bb_opmode_poll(void)
+{
+  if (bb_opmode.data && bb_opmode.waiting && (int32_t)(bb_now_ms() - bb_opmode.retry_ms) >= 0) {
+    bb_opmode.waiting = false;
+    bb_queue_tx(bb_opmode.local_port, bb_opmode.node, bb_opmode.port, bb_opmode.data, bb_opmode.len);
+  }
+}

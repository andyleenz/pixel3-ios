+		{ 0xb600, 0x00108000 },		/* TPL1_DBG_ECO_CNTL */
+		{ 0x8600, 0x880 },		/* GRAS_DBG_ECO_CNTL */
+		{ 0xae03, 0x1430 },		/* SP_CHICKEN_BITS */
+		{ 0xae00, 0x0 },		/* SP_DBG_ECO_CNTL */
+		{ 0xbe04, 0x80000 },		/* HLSQ_DBG_ECO_CNTL */
+		{ 0x9600, 0x0 },		/* VPC_DBG_ECO_CNTL */
+		{ 0x0e12, 0x10000001 },		/* UCHE_UNKNOWN_0E12 */
+		{ 0x8e01, 0x1 },		/* RB_RBP_CNTL */
+		{ 0x8e04, 0x04100000 },		/* RB_DBG_ECO_CNTL */
+		/* fd6_emit.cc fd6_emit_static_regs (non-context, A6XX) */
+		{ 0xae04, 0x0 },		/* SP_NC_MODE_CNTL_2 */
+		{ 0x9602, 0x0 },		/* VPC_LB_MODE_CNTL */
+		{ 0x9e72, 0x0 },		/* PC_CONTEXT_SWITCH_GFX_PREEMPTION_MODE */
+		{ 0xae0f, 0x3f },		/* SP_PERFCTR_SHADER_MASK */

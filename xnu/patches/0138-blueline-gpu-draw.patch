+
+/* Our buffer: contiguous, Normal NC like the CP's, mapped by L3 entries at DR_OWN_VA. */
+static bool
+dr_own_map(void)
+{
+	if (kmem_alloc_contig(kernel_map, &dr.va, DR_OWN_SIZE, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("BLUELINE GPU: no contiguous %#x bytes for the draw buffer\n", DR_OWN_SIZE);
+		dr.va = 0;
+		return false;
+	}
+	dr.pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)dr.va));
+	bool contig = dr.pa != 0 && ((dr.pa + DR_OWN_SIZE - 1) >> smmu_oas) == 0;
+	for (uint32_t o = 0; o < DR_OWN_SIZE; o += PAGE_SIZE) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(dr.va + o));
+		contig = contig && ptoa_64(pn) == dr.pa + o;
+		pmap_set_cache_attributes(pn, VM_WIMG_WCOMB);
+	}
+	printf("BLUELINE GPU: draw buffer va %#lx pa %#llx size %#x (%ux%u, stride %u), %s\n", (unsigned long)dr.va,
+	    (unsigned long long)dr.pa, DR_OWN_SIZE, DR_OWN_W, DR_OWN_H, DR_OWN_STRIDE,
+	    contig ? "contiguous" : "NOT CONTIGUOUS OR TOO HIGH");
+	if (!contig) {
+		return false;
+	}
+	volatile uint32_t *p = (volatile uint32_t *)dr.va;
+	for (uint32_t i = 0; i < DR_OWN_SIZE / 4; i++) {
+		p[i] = DR_OWN_FILL;
+	}
+	volatile uint64_t *l3 = (volatile uint64_t *)(cp.va + CP_PT_OFF + 0x2000);
+	for (uint32_t o = 0; o < DR_OWN_SIZE; o += 0x1000u) {
+		l3[((DR_OWN_VA + o) >> 12) & 0x1ff] = LPAE_PAGE(dr.pa + o);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	dr.own_mapped = true;
+	bool ok = smmu_tlbi_cb(0);
+	if (ok && !(rd(smmu + SMMU_IDR0) & (1u << 26))) {
+		ok = smmu_ats_cb(0, DR_OWN_VA, dr.pa) &&
+		    smmu_ats_cb(0, DR_OWN_VA + DR_OWN_SIZE - 0x1000u, dr.pa + DR_OWN_SIZE - 0x1000u);
+	}
+	printf("BLUELINE GPU: draw buffer mapped at GPU VA %#x (L3[%u..%u], first %#llx): %s\n", DR_OWN_VA,
+	    (DR_OWN_VA >> 12) & 0x1ff, ((DR_OWN_VA + DR_OWN_SIZE) >> 12 & 0x1ff) - 1,
+	    (unsigned long long)l3[(DR_OWN_VA >> 12) & 0x1ff], ok ? "ok" : "FAILED");
+	return ok;
+}
+
+/* The scanout buffer: 2M block entries in the CP's L2 at DR_FB_VA. Never freed. */
+static bool
+dr_fb_map(void)
+{
+	volatile uint64_t *l2 = (volatile uint64_t *)(cp.va + CP_PT_OFF + 0x1000);
+	uint32_t i0 = (DR_FB_VA >> 21) & 0x1ff;
+
+	if (((dr.fb_blk + (uint64_t)dr.fb_nblk * BLK_2M - 1) >> smmu_oas) != 0) {
+		printf("BLUELINE GPU: framebuffer above the SMMU's %u-bit output: not mapped\n", smmu_oas);
+		return false;
+	}
+	for (uint32_t i = 0; i < dr.fb_nblk; i++) {
+		if (l2[i0 + i]) {
+			printf("BLUELINE GPU: L2[%u] already %#llx: framebuffer not mapped\n", i0 + i,
+			    (unsigned long long)l2[i0 + i]);
+			return false;
+		}
+	}
+	printf("BLUELINE GPU: about to map the framebuffer (pa %#llx..%#llx, Normal NC, 2M blocks) at GPU VA %#x\n",
+	    (unsigned long long)dr.fb_blk, (unsigned long long)(dr.fb_blk + dr.fb_nblk * BLK_2M), DR_FB_VA);
+	for (uint32_t i = 0; i < dr.fb_nblk; i++) {
+		l2[i0 + i] = LPAE_PAGE(dr.fb_blk + i * BLK_2M) & ~2ull;	/* block: descriptor bits 01 */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	dr.fb_mapped = true;
+	bool ok = smmu_tlbi_cb(0);
+	for (uint32_t i = 0; ok && i < dr.fb_nblk && !(rd(smmu + SMMU_IDR0) & (1u << 26)); i++) {
+		ok = smmu_ats_cb(0, DR_FB_VA + i * (uint32_t)BLK_2M + 0x1ff000u, dr.fb_blk + i * BLK_2M + 0x1ff000u);
+	}
+	printf("BLUELINE GPU: framebuffer mapped: L2[%u..%u] first %#llx: %s\n", i0, i0 + dr.fb_nblk - 1,
+	    (unsigned long long)l2[i0], ok ? "ok" : "FAILED (ATS)");
+	return ok;
+}
+
+/* Clear both mappings, TLB, then the GPU can no longer reach either buffer through cb0. */
+static void
+dr_unmap(void)
+{
+	if (!dr.own_mapped && !dr.fb_mapped) {
+		return;
+	}
+	volatile uint64_t *l2 = (volatile uint64_t *)(cp.va + CP_PT_OFF + 0x1000);
+	volatile uint64_t *l3 = (volatile uint64_t *)(cp.va + CP_PT_OFF + 0x2000);
+	if (dr.fb_mapped) {
+		for (uint32_t i = 0; i < dr.fb_nblk; i++) {
+			l2[((DR_FB_VA >> 21) & 0x1ff) + i] = 0;
+		}
+	}
+	if (dr.own_mapped) {
+		for (uint32_t o = 0; o < DR_OWN_SIZE; o += 0x1000u) {
+			l3[((DR_OWN_VA + o) >> 12) & 0x1ff] = 0;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bool ok = smmu_tlbi_cb(0);
+	dr.unmap_failed = !ok;
+	printf("BLUELINE GPU: draw mappings cleared (framebuffer %d, own buffer %d), cb0 TLB %s\n", dr.fb_mapped,
+	    dr.own_mapped, ok ? "invalidated" : "SYNC TIMEOUT: own buffer will be leaked");
+	dr.fb_mapped = false;
+	dr.own_mapped = false;
+}
+
+/* From cp_smmu_teardown's safe branch: unmapped, TLB clean, cb0 off and GX off. */
+static void
+dr_free(bool safe)
+{
+	if (!dr.va) {
+		return;
+	}
+	if (!safe || dr.own_mapped || dr.unmap_failed) {
+		printf("BLUELINE GPU: draw buffer (pa %#llx) LEAKED on purpose\n", (unsigned long long)dr.pa);
+		return;
+	}
+	for (uint32_t o = 0; o < DR_OWN_SIZE; o += PAGE_SIZE) {
+		pmap_set_cache_attributes(pmap_find_phys(kernel_pmap, (addr64_t)(dr.va + o)), VM_WIMG_DEFAULT);
+	}
+	kmem_free(kernel_map, dr.va, DR_OWN_SIZE);
+	printf("BLUELINE GPU: draw buffer (pa %#llx) freed\n", (unsigned long long)dr.pa);
+	dr.va = 0;
+}
+
+static bool
+dr_in(const struct dr_rect *r, uint32_t x, uint32_t y)
+{
+	return x >= r->x && x < r->x + r->w && y >= r->y && y < r->y + r->h;
+}
+
+static uint32_t
+dr_rb_swap(uint32_t c)
+{
+	return (c & 0xff00ff00u) | ((c >> 16) & 0xffu) | ((c & 0xffu) << 16);
+}
+
+/* Every pixel of our buffer: the rectangles' colour inside, the fill elsewhere. */
+static bool
+dr_own_verify(void)
+{
+	const volatile uint32_t *p = (const volatile uint32_t *)dr.va;
+	uint32_t bad = 0, swapped = 0, shown = 0;
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t y = 0; y < DR_OWN_H; y++) {
+		for (uint32_t x = 0; x < DR_OWN_W; x++) {
+			uint32_t want = DR_OWN_FILL, got = p[y * (DR_OWN_STRIDE / 4) + x];
+			for (uint32_t i = 0; i < DR_NRECT(dr_own_rects); i++) {
+				if (dr_in(&dr_own_rects[i], x, y)) {
+					want = dr_own_rects[i].argb;
+				}
+			}
+			if (got != want) {
+				bad++;
+				swapped += want != DR_OWN_FILL && got == dr_rb_swap(want);
+				if (shown++ < 6) {
+					printf("BLUELINE GPU: own buffer (%u,%u) = %#x, want %#x\n", x, y, got, want);
+				}
+			}
+		}
+	}
+	for (uint32_t i = 0; i < DR_NRECT(dr_own_rects); i++) {
+		const struct dr_rect *r = &dr_own_rects[i];
+		printf("BLUELINE GPU: %s (%u,%u %ux%u): corners %#x %#x %#x %#x, outside %#x\n", r->name, r->x, r->y, r->w,
+		    r->h, p[r->y * (DR_OWN_STRIDE / 4) + r->x], p[r->y * (DR_OWN_STRIDE / 4) + r->x + r->w - 1],
+		    p[(r->y + r->h - 1) * (DR_OWN_STRIDE / 4) + r->x],
+		    p[(r->y + r->h - 1) * (DR_OWN_STRIDE / 4) + r->x + r->w - 1],
+		    p[r->y * (DR_OWN_STRIDE / 4) + r->x - (r->x ? 1 : 0)]);
+	}
+	printf("BLUELINE GPU: own buffer check: %u of %u pixels wrong%s: %s\n", bad, DR_OWN_W * DR_OWN_H,
+	    swapped ? " (some R/B SWAPPED)" : "", bad == 0 ? "THE GPU DREW THE RECTANGLES" : "MISMATCH");
+	return bad == 0;
+}
+
+/* Rows y0..y1 of the scanout buffer, uncached (Device), for checks. */
+static volatile uint32_t *
+dr_fb_rows(uint32_t y0, uint32_t y1, vm_offset_t *base, vm_size_t *size)
+{
+	uint64_t a = dr.fb_pa + (uint64_t)y0 * dr.fb_stride, e = dr.fb_pa + (uint64_t)(y1 + 1) * dr.fb_stride;
+	uint64_t a0 = trunc_page_64(a);
+
+	*size = (vm_size_t)(round_page_64(e) - a0);
+	*base = ml_io_map((vm_offset_t)a0, *size);
+	return *base ? (volatile uint32_t *)(*base + (a - a0)) : NULL;
+}
+
+/*
+ * Each panel rectangle: pixels inside equal to its colour; and its 1-pixel
+ * border unchanged since before (sum and count of the border saved in
+ * border[] when pre). Returns the number of rectangles that pass.
+ */
+static uint32_t
+dr_fb_check(const char *when, bool pre, uint64_t *border)
+{
+	uint32_t ymin = dr.fb_h, ymax = 0, pass = 0;
+	vm_offset_t base;
+	vm_size_t size;
+
+	for (uint32_t i = 0; i < DR_NRECT(dr_fb_rects); i++) {
+		const struct dr_rect *r = &dr_fb_rects[i];
+		ymin = MIN(ymin, r->y ? r->y - 1 : 0);
+		ymax = MAX(ymax, MIN(r->y + r->h, dr.fb_h - 1));
+	}
+	volatile uint32_t *fb = dr_fb_rows(ymin, ymax, &base, &size);
+	if (!fb) {
+		printf("BLUELINE GPU: framebuffer rows %u..%u not mappable for the check\n", ymin, ymax);
+		return 0;
+	}
+	uint32_t sw = dr.fb_stride / 4;
+	for (uint32_t i = 0; i < DR_NRECT(dr_fb_rects); i++) {
+		const struct dr_rect *r = &dr_fb_rects[i];
+		uint32_t bad = 0, swapped = 0, first = 0, fx = 0, fy = 0;
+		uint64_t bsum = 0;
+		int32_t x0 = (int32_t)r->x - 1, y0 = (int32_t)r->y - 1, x1 = (int32_t)(r->x + r->w), y1 = (int32_t)(r->y + r->h);
+		for (int32_t y = y0; y <= y1; y++) {
+			for (int32_t x = x0; x <= x1; x++) {
+				if (x < 0 || y < 0 || x >= (int32_t)dr.fb_w || y >= (int32_t)dr.fb_h) {
+					continue;
+				}
+				uint32_t got = fb[(uint32_t)(y - (int32_t)ymin) * sw + (uint32_t)x];
+				if (dr_in(r, (uint32_t)x, (uint32_t)y)) {
+					if (!pre && got != r->argb) {
+						if (!bad++) {
+							first = got;
+							fx = (uint32_t)x;
+							fy = (uint32_t)y;
+						}
+						swapped += got == dr_rb_swap(r->argb);
+					}
+				} else {
+					bsum += (uint64_t)got * (uint32_t)(x * 7 + y * 13 + 1);
+				}
+			}
+		}
+		if (pre) {
+			border[i] = bsum;
+			continue;
+		}
+		bool ok = bad == 0 && bsum == border[i];
+		pass += ok;
+		printf("BLUELINE GPU: %s %s (%u,%u %ux%u, %#x): %u of %u inside wrong%s, border %s: %s\n", when, r->name,
+		    r->x, r->y, r->w, r->h, r->argb, bad, r->w * r->h, swapped ? " (R/B SWAPPED)" : "", bsum == border[i] ? "unchanged" : "CHANGED", ok ? "ok" : "MISMATCH");
+		if (bad) {
+			printf("BLUELINE GPU:  first wrong pixel (%u,%u) = %#x\n", fx, fy, first);
+		}
+	}
+	ml_io_unmap(base, size);
+	return pass;
+}
+
+/* One pixel per panel rectangle, centre, during the hold. */
+static void
+dr_fb_sample(uint32_t t)
+{
+	vm_offset_t base;
+	vm_size_t size;
+
+	printf("BLUELINE GPU: hold %u ms:", t);
+	for (uint32_t i = 0; i < DR_NRECT(dr_fb_rects); i++) {
+		const struct dr_rect *r = &dr_fb_rects[i];
+		uint32_t y = r->y + r->h / 2;
+		volatile uint32_t *row = dr_fb_rows(y, y, &base, &size);
+		if (row) {
+			printf(" %s %#x", r->name, row[r->x + r->w / 2]);
+			ml_io_unmap(base, size);
+		}
+	}
+	printf("\n");
+}
+
+extern int sweet_console_muted;	/* osfmk/console/serial_console.c: log only, no drawing */
+
+/*
+ * The draw stage, CP running and idle after stage 4's WHERE_AM_I. Always
+ * leaves both draw mappings cleared from cb0 (TLB invalidated) on return.
+ */
+static void
+dr_stage(void)
+{
+	const char *res = "stopped early";
+	uint64_t border[DR_NRECT(dr_fb_rects)];
+	int muted_was = sweet_console_muted;
+	bool muted = false;
+
+	bzero(border, sizeof(border));
+	printf("BLUELINE GPU: draw stage: ring at %u of %u dwords\n", cp.wptr, CP_RING_DWORDS);
+	if (!dr_setup()) {
+		res = "2D SETUP FAILED";
+		goto out;
+	}
+
+	/* Step 1: our buffer, every pixel checked. */
+	if (!dr_own_map()) {
+		res = "OWN BUFFER NOT MAPPED";
+		goto out;
+	}
+	uint32_t n = DR_NRECT(dr_own_rects), from = cp.wptr;
+	if (!dr_room(n * 56 + 17, "own buffer")) {
+		res = "RING FULL";
+		goto out;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		dr_emit_rect(DR_OWN_VA, DR_OWN_STRIDE, &dr_own_rects[i]);
+	}
+	uint32_t off = dr_emit_tail();
+	printf("BLUELINE GPU: about to let the 2D engine fill %u rectangles into GPU VA %#x (pa %#llx)\n", n, DR_OWN_VA,
+	    (unsigned long long)dr.pa);
+	bool sub = dr_submit("2D fill own buffer", from, off);
+	bool own_ok = dr_own_verify();
+	if (!sub || !own_ok) {
+		if (sub && !rd(cbn(0, CB_FSR)) && *(volatile uint32_t *)dr.va == DR_OWN_FILL) {
+			printf("BLUELINE GPU: fences written, no pixels, no cb0 fault: suspect the RB's writes going out on"
+			    " another stream (secure mode: sGFSYNR1) or a missing CCU flush\n");
+		}
+		cp_report("after own-buffer fill");
+		res = sub ? "OWN BUFFER WRONG" : "OWN BUFFER FILL FAILED";
+		goto out;
+	}
+	if (dr.step < 2) {
+		res = "THE GPU DREW INTO OUR BUFFER (step 1)";
+		goto out;
+	}
+
+	/* Step 2: the panel. */
+	if (!dr_fb_map()) {
+		res = "FRAMEBUFFER NOT MAPPED";
+		goto out;
+	}
+	n = DR_NRECT(dr_fb_rects);
+	from = cp.wptr;
+	if (!dr_room(n * 56 + 17, "framebuffer")) {
+		res = "RING FULL";
+		goto out;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		dr_emit_rect(DR_FB_VA + (uint32_t)(dr.fb_pa - dr.fb_blk), dr.fb_stride, &dr_fb_rects[i]);
+	}
+	off = dr_emit_tail();
+	printf("BLUELINE GPU: muting console drawing for the fill and %d ms hold (log continues)\n", dr.hold_ms);
+	sweet_console_muted = 1;
+	muted = true;
+	delay(50000);
+	(void)dr_fb_check("before", true, border);
+	printf("BLUELINE GPU: about to let the 2D engine fill %u rectangles into the scanout buffer at pa %#llx\n", n,
+	    (unsigned long long)dr.fb_pa);
+	sub = dr_submit("2D fill framebuffer", from, off);
+	uint32_t pass = dr_fb_check("after fill", false, border);
+	if (sub && pass != n) {
+		cp_report("after framebuffer fill");
+	}
+	if (!sub) {
+		res = "FRAMEBUFFER FILL FAILED";
+		goto out;
+	}
+	for (int t = 0; t < dr.hold_ms; t += 1000) {
+		delay((uint32_t)MIN(1000, dr.hold_ms - t) * 1000);
+		dr_fb_sample((uint32_t)MIN(t + 1000, dr.hold_ms));
+	}
+	uint32_t pass2 = dr_fb_check("after hold", false, border);
+	printf("BLUELINE GPU: panel rectangles: %u of %u right after the fill, %u after %d ms\n", pass, n, pass2,
+	    dr.hold_ms);
+	res = pass == n && pass2 == n ? "THE GPU DREW ON THE PANEL" : pass == n ? "DRAWN, THEN OVERWRITTEN DURING THE HOLD" :
+	    pass ? "PARTLY DRAWN ON THE PANEL" : "NOTHING RIGHT ON THE PANEL";
+
+out:
+	dr_unmap();	/* before anything is freed; the framebuffer itself never is */
+	if (muted) {
+		sweet_console_muted = muted_was;
+	}
+	cp_smmu_faults("after draw");
+	printf("BLUELINE GPU: draw stage %s (step %d, ring %u of %u dwords)\n", res, dr.step, cp.wptr, CP_RING_DWORDS);
 }
 

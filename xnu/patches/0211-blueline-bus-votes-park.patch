+/* 0211 (blueline_bw.c): the panel is waking, put the last DDR vote back. */
+void blue_gpu_bw_revote(void);
+void
+blue_gpu_bw_revote(void)
+{
+	if (gx.bw_voted) {
+		int err = blueline_rpmh_write(gx.bw_addr, gx.bw_data, 2);
+		printf("BLUELINE GPU: DDR vote %u kBps put back: err %d\n", gx.bw_kbps, err);
+	}
+}
+
 /* Back to Linux's keepalive vote for MC0/SH0 (x 1, y 1): never 0, which could collapse DDR. */
 static void
 gx_bw_drop(void)

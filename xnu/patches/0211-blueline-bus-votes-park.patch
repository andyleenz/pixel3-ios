--- a/bsd/dev/blueline_bw.c	1970-01-01 10:00:00
+++ b/bsd/dev/blueline_bw.c	2026-11-23 22:11:41
@@ -0,0 +1,157 @@
+/*
+ * Pixel 3 (blueline): the apps-side bus votes go down while the panel sleeps
+ * (boot-arg bluebw_park=1, off by default; an experiment for the screen-off
+ * draw).
+ *
+ * The apps RSC (DRV 2) holds whatever the bootloader voted for the display
+ * and DDR, then the GPU's DDR vote (blueline_gpu.c, MC0 and SH0 at the GPU
+ * level's peak bandwidth). Nothing lowers them with the screen off. Here,
+ * once the panel is in sleep (SweetFramebuffer.cpp panelSleep), each BCM in
+ * bluebw_bcms (MC0 SH0 MM0 MM1 MM2 MM3 by default) gets Linux's keepalive
+ * vote (x 1, y 1; icc-rpmh never sends 0 for these). Before the panel
+ * wakes, the MM BCMs go to their highest level (the display's real need is
+ * not known yet) and the GPU puts its last DDR vote back
+ * (blue_gpu_bw_revote; with no GPU vote, MC0 and SH0 stay at keepalive).
+ *
+ * bluecensus=S: S seconds after the panel first sleeps, one dump of what is
+ * powered: every SPMI peripheral of PM8998 (SID 1), PMI8998 (SID 3) and
+ * PM8005 (SID 5) that answers, as TYPE SUBTYPE and registers 08 (status),
+ * 40 41 (voltage), 45 (mode), 46 (enable); and the GDSCRs Linux names in
+ * GCC, DISPCC and GPUCC (bit 31 = powered).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern uint32_t blueline_cmddb_addr(const char *id);	/* blueline_touch.c */
+extern int blueline_rpmh_write(const uint32_t *addr, const uint32_t *data, int n);
+extern void blue_gpu_bw_revote(void);			/* blueline_gpu.c */
+void blue_bw_park(int park);
+extern int blueline_spmi_read_sid(uint8_t sid, uint16_t addr, uint8_t *buf, unsigned len);	/* blueline_keys.c */
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define TAG "BLUELINE BW: "
+#define BCM_CMD(commit, valid, x, y) (((uint32_t)(commit) << 30) | ((uint32_t)(valid) << 29) | \
+	(((uint32_t)(x) & 0x3fffu) << 14) | ((uint32_t)(y) & 0x3fffu))
+#define MAXB 12
+
+static int bw_mode = -1;
+static int nb;
+static char names[MAXB][8];
+static uint32_t addrs[MAXB];
+
+static void
+bw_init(void)
+{
+	char list[96] = "MC0,SH0,MM0,MM1,MM2,MM3";
+
+	bw_mode = 0;
+	(void)PE_parse_boot_argn("bluebw_park", &bw_mode, sizeof(bw_mode));
+	(void)PE_parse_boot_argn("bluebw_bcms", list, sizeof(list));
+	if (bw_mode <= 0) {
+		return;
+	}
+	for (char *p = list; *p && nb < MAXB;) {
+		int n = 0;
+		while (p[n] && p[n] != ',' && n < 7) {
+			names[nb][n] = p[n];
+			n++;
+		}
+		names[nb][n] = 0;
+		uint32_t a = blueline_cmddb_addr(names[nb]);
+		printf(TAG "BCM %s at %#x\n", names[nb], a);
+		if (a) {
+			addrs[nb++] = a;
+		}
+		p += n;
+		while (*p && *p != ',') {
+			p++;
+		}
+		if (*p == ',') {
+			p++;
+		}
+	}
+}
+
+static const struct {
+	const char *name;
+	uint32_t pa;
+} gdscs[] = {
+	{ "gcc pcie_0", 0x0016b004 }, { "gcc pcie_1", 0x0018d004 }, { "gcc ufs_card", 0x00175004 },
+	{ "gcc ufs_phy", 0x00177004 }, { "gcc usb30_prim", 0x0010f004 }, { "gcc usb30_sec", 0x00110004 },
+	{ "gcc vote aggre_noc_mmu_audio_tbu", 0x0017d030 }, { "gcc vote aggre_noc_mmu_pcie_tbu", 0x0017d03c },
+	{ "gcc vote aggre_noc_mmu_tbu1", 0x0017d034 }, { "gcc vote aggre_noc_mmu_tbu2", 0x0017d038 },
+	{ "gcc vote mmnoc_mmu_tbu_hf0", 0x0017d040 }, { "gcc vote mmnoc_mmu_tbu_hf1", 0x0017d048 },
+	{ "gcc vote mmnoc_mmu_tbu_sf", 0x0017d044 },
+	{ "dispcc mdss", 0x0af03000 }, { "gpucc cx", 0x0509106c }, { "gpucc gx", 0x0509100c },
+};
+
+static void
+census_thread(void *arg, wait_result_t wr __unused)
+{
+	static const uint8_t sids[3] = { 1, 3, 5 };
+	int secs = (int)(uintptr_t)arg;
+
+	delay((uint64_t)secs * 1000000ULL);
+	printf(TAG "census, %d s after the panel slept\n", secs);
+	for (int i = 0; i < 3; i++) {
+		for (unsigned per = 0; per < 0x100; per++) {
+			uint8_t t[2], st[1], v[2], m[2];
+			uint16_t base = (uint16_t)(per << 8);
+			if (blueline_spmi_read_sid(sids[i], base + 0x04, t, 2) != 0) {
+				continue;
+			}
+			if (t[0] == 0 && t[1] == 0) {
+				continue;
+			}
+			bool okst = blueline_spmi_read_sid(sids[i], base + 0x08, st, 1) == 0;
+			bool okv = blueline_spmi_read_sid(sids[i], base + 0x40, v, 2) == 0;
+			bool okm = blueline_spmi_read_sid(sids[i], base + 0x45, m, 2) == 0;
+			printf(TAG "pmic sid %u periph %#04x: type %#04x sub %#04x st %#04x v %02x %02x mode %#04x en %#04x%s\n",
+			    sids[i], per, t[0], t[1], okst ? st[0] : 0xff, okv ? v[0] : 0xff, okv ? v[1] : 0xff,
+			    okm ? m[0] : 0xff, okm ? m[1] : 0xff, okst && okv && okm ? "" : " (some reads failed)");
+		}
+	}
+	for (unsigned i = 0; i < sizeof(gdscs) / sizeof(gdscs[0]); i++) {
+		vm_offset_t va = ml_io_map(gdscs[i].pa & ~0xfffu, 0x1000);
+		uint32_t val = va ? *(volatile uint32_t *)(va + (gdscs[i].pa & 0xfffu)) : 0;
+		printf(TAG "gdsc %s (%#x): %#010x%s\n", gdscs[i].name, gdscs[i].pa, val,
+		    (val >> 31) ? " powered" : "");
+	}
+	printf(TAG "census done\n");
+}
+
+/* From the vsync workloop thread: 1 once the panel sleeps, 0 before it wakes. */
+void
+blue_bw_park(int park)
+{
+	uint32_t data[MAXB];
+
+	if (bw_mode < 0) {
+		bw_init();
+		int secs = 0;
+		(void)PE_parse_boot_argn("bluecensus", &secs, sizeof(secs));
+		thread_t th;
+		if (park && secs > 0 && kernel_thread_start(census_thread, (void *)(uintptr_t)secs, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		}
+	}
+	if (bw_mode <= 0 || nb == 0) {
+		return;
+	}
+	for (int i = 0; i < nb; i++) {
+		bool mm = names[i][0] == 'M' && names[i][1] == 'M';
+		data[i] = park ? BCM_CMD(1, 1, 1, 1) : mm ? BCM_CMD(1, 1, 0x3fff, 0x3fff) : BCM_CMD(1, 1, 1, 1);
+	}
+	int err = blueline_rpmh_write(addrs, data, nb);
+	if (!park) {
+		blue_gpu_bw_revote();
+	}
+	printf(TAG "%s: %d BCMs %s: err %d\n", park ? "panel asleep" : "panel waking", nb,
+	    park ? "at keepalive (x 1, y 1)" : "MM at their top, MC0/SH0 back to the GPU's vote", err);
+}
+#endif
